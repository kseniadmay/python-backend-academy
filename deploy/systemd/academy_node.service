[Unit]
Description=Python Backend Academy (Desktop Project)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/fury/python-backend-academy
ExecStart=/home/fury/.local/bin/node scripts/server.js
Restart=always
RestartSec=3
Environment=PORT=8765
Environment=PATH=/home/fury/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target

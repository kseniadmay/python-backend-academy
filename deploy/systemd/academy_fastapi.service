[Unit]
Description=Python Backend Academy (FastAPI Core)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/fury/python-backend-academy
ExecStart=/usr/bin/python3 -m backend.run
Restart=always
RestartSec=3
Environment=PORT=8765
Environment=HOST=0.0.0.0
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target

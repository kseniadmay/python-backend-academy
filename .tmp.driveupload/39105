<script>
(function(){
  const TIERS = [
    {level:1, emoji:'🥚', name:'Яйцо'},
    {level:2, emoji:'🐣', name:'Цыплёнок'},
    {level:3, emoji:'🦊', name:'Лиса'},
    {level:4, emoji:'🐺', name:'Волк'},
    {level:5, emoji:'🐯', name:'Тигр'},
    {level:6, emoji:'🐉', name:'Дракон'},
    {level:7, emoji:'👑', name:'Корона'},
  ];

  let statusMap = {};
  let currentLevel = 'all';
  let currentList = [];
  let currentTaskId = null;
  let solutionShown = false;

  const el = (sel) => document.querySelector(sel);
  const tierNavEl = el('#tierNav');
  const taskGridEl = el('#taskGrid');
  const emptyStateEl = el('#emptyState');
  const overallNumEl = el('#overallNum');
  const overallBarEl = el('#overallBar');
  const viewTitleEl = el('#viewTitle');
  const viewSubEl = el('#viewSub');
  const searchBoxEl = el('#searchBox');
  const statusFilterEl = el('#statusFilter');

  const WINDOW_NAME_PREFIX = '__ACADEMY_SYNC_V1__:';
  const IDE_STATUS_KEYS = ['practice-ide-status', 'practice-ide-status-backup'];
  const IDE_DRAFTS_KEY = 'practice-ide-drafts';

  function safeParseObj(raw){
    if(!raw || typeof raw !== 'string') return {};
    try{
      const p = JSON.parse(raw);
      return (p && typeof p === 'object' && !Array.isArray(p)) ? p : {};
    }catch(e){ return {}; }
  }

  function readWindowNameSync(){
    try{
      const wn = String(window.name || '');
      if(wn.indexOf(WINDOW_NAME_PREFIX) === 0){
        const parsed = safeParseObj(wn.slice(WINDOW_NAME_PREFIX.length));
        return parsed;
      }
    }catch(e){}
    return null;
  }

  function writeWindowNameSync(ideStatusMap, ideDraftsMap){
    try{
      const prevWn = readWindowNameSync() || {};
      const curDrafts = ideDraftsMap || safeParseObj(localStorage.getItem(IDE_DRAFTS_KEY)) || prevWn.ideDrafts || {};
      const payload = {
        academyState: prevWn.academyState || null,
        ideStatus: ideStatusMap || statusMap,
        ideDrafts: curDrafts
      };
      window.name = WINDOW_NAME_PREFIX + JSON.stringify(payload);
    }catch(e){}
  }

  function mergeStatusMaps(baseMap, incMap){
    const out = Object.assign({}, baseMap || {});
    Object.keys(incMap || {}).forEach(k => {
      const v = incMap[k];
      if(out[k] === 'mastered' || out[k] === 'solved' || v === 'mastered' || v === 'solved'){
        out[k] = 'mastered';
      } else if(v && !out[k]){
        out[k] = v;
      }
    });
    return out;
  }

  function loadStatus(){
    try{
      let merged = {};
      IDE_STATUS_KEYS.forEach(k => {
        const parsed = safeParseObj(localStorage.getItem(k));
        merged = mergeStatusMaps(merged, parsed);
      });
      const wn = readWindowNameSync();
      if(wn && wn.ideStatus){
        merged = mergeStatusMaps(merged, wn.ideStatus);
      }
      statusMap = merged;
      const ser = JSON.stringify(statusMap);
      localStorage.setItem('practice-ide-status', ser);
      try{ localStorage.setItem('practice-ide-status-backup', ser); }catch(ignore){}
      writeWindowNameSync(statusMap);
    }catch(e){ statusMap = {}; }
  }

  function saveStatus(){
    const ser = JSON.stringify(statusMap);
    try{
      localStorage.setItem('practice-ide-status', ser);
      try{ localStorage.setItem('practice-ide-status-backup', ser); }catch(ignore){}
    }catch(e){
      try{
        const dr = loadDrafts();
        const keys = Object.keys(dr);
        if(keys.length > 0){
          keys.slice(0, Math.max(1, Math.ceil(keys.length / 2))).forEach(k => { delete dr[k]; });
          localStorage.setItem('practice-ide-drafts', JSON.stringify(dr));
        }
        localStorage.setItem('practice-ide-status', ser);
        try{ localStorage.setItem('practice-ide-status-backup', ser); }catch(ignore){}
      }catch(e2){ console.error('storage save failed', e2); }
    }
    writeWindowNameSync(statusMap);
  }

  function loadDrafts(){
    try{
      let dr = safeParseObj(localStorage.getItem(IDE_DRAFTS_KEY));
      const wn = readWindowNameSync();
      if(wn && wn.ideDrafts && typeof wn.ideDrafts === 'object'){
        dr = Object.assign({}, wn.ideDrafts, dr);
      }
      return dr;
    }catch(e){ return {}; }
  }

  function saveDraft(id, code){
    if(id === undefined || id === null || typeof code !== 'string') return;
    let drafts = loadDrafts();
    try{
      drafts[id] = code;
      localStorage.setItem(IDE_DRAFTS_KEY, JSON.stringify(drafts));
    }catch(e){
      try{
        const keys = Object.keys(drafts);
        if(keys.length > 10){
          keys.slice(0, Math.max(1, Math.floor(keys.length / 2))).forEach(k => { delete drafts[k]; });
        } else {
          keys.forEach(k => { delete drafts[k]; });
        }
        drafts[id] = code;
        localStorage.setItem(IDE_DRAFTS_KEY, JSON.stringify(drafts));
      }catch(e2){}
    }
    writeWindowNameSync(null, drafts);
  }

  window.addEventListener('storage', (e) => {
    if(!e || !e.key) return;
    if(IDE_STATUS_KEYS.includes(e.key)){
      loadStatus();
      if(typeof render === 'function') render();
    } else if(e.key === IDE_DRAFTS_KEY){
      if(currentTaskId != null && userEditor){
        const dr = loadDrafts();
        if(dr[currentTaskId] !== undefined && !userEditor.hasFocus()){
          userEditor.setValue(dr[currentTaskId]);
        }
      }
    }
  });

  window.addEventListener('pagehide', () => {
    writeWindowNameSync(statusMap);
  });

  function tierInfo(level){ return TIERS.find(t=>t.level===level); }
  function escapeHtml(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function renderSidebar(){
    let html = `<li class="tier-item nav-all ${currentLevel==='all'?'active':''}" data-level="all">
      <span class="tier-emoji">✦</span><span class="tier-name">Все уровни</span>
      <span class="tier-count">${TASKS.length}</span></li>`;
    TIERS.forEach(t=>{
      const list = TASKS.filter(x=>x.level===t.level);
      const done = list.filter(x=>statusMap[x.id]==='mastered').length;
      html += `<li class="tier-item ${currentLevel===t.level?'active':''}" data-level="${t.level}">
        <span class="tier-emoji">${t.emoji}</span>
        <span class="tier-name">${t.name}</span>
        <span class="tier-count">${done}/${list.length}</span>
      </li>`;
    });
    tierNavEl.innerHTML = html;
    tierNavEl.querySelectorAll('.tier-item').forEach(item=>{
      item.addEventListener('click', ()=>{
        const lv = item.dataset.level;
        currentLevel = lv==='all' ? 'all' : parseInt(lv,10);
        render();
      });
    });
  }

  function renderOverall(){
    const done = TASKS.filter(t=>statusMap[t.id]==='mastered').length;
    overallNumEl.innerHTML = `${done}<span> / ${TASKS.length}</span>`;
    overallBarEl.style.width = (done/TASKS.length*100).toFixed(1)+'%';
  }

  function getFiltered(){
    let list = currentLevel==='all' ? TASKS.slice() : TASKS.filter(t=>t.level===currentLevel);
    const q = searchBoxEl.value.trim().toLowerCase();
    if(q){ list = list.filter(t=>t.title.toLowerCase().includes(q)); }
    const sf = statusFilterEl.value;
    if(sf!=='all'){ list = list.filter(t=> (statusMap[t.id]||'new')===sf ); }
    return list;
  }

  function renderHeader(){
    if(currentLevel==='all'){ viewTitleEl.textContent = 'Все уровни'; }
    else{ const t = tierInfo(currentLevel); viewTitleEl.textContent = `${t.emoji} ${t.name}`; }
    viewSubEl.textContent = `${currentList.length} задач`;
  }

  function renderGrid(){
    if(currentList.length===0){ taskGridEl.innerHTML=''; emptyStateEl.style.display='block'; return; }
    emptyStateEl.style.display = 'none';
    taskGridEl.innerHTML = currentList.map(t=>{
      const status = statusMap[t.id] || 'new';
      const ti = tierInfo(t.level);
      return `<div class="task-card" data-id="${t.id}">
        <div class="tcard-top"><span class="tcard-id">${ti.emoji} #${t.id}</span><span class="status-dot ${status}"></span></div>
        <div class="tcard-title">${escapeHtml(t.title)}</div>
      </div>`;
    }).join('');
    taskGridEl.querySelectorAll('.task-card').forEach(card=>{
      card.addEventListener('click', ()=> openPractice(parseInt(card.dataset.id,10)));
    });
  }

  function render(){
    renderSidebar();
    renderOverall();
    currentList = getFiltered();
    renderHeader();
    renderGrid();
  }

  // ============ CodeMirror editor (user code only) ============
  let userEditor;
  function initEditors(){
    userEditor = CodeMirror.fromTextArea(el('#editorHost'), {
      mode: 'python', lineNumbers: true, indentUnit: 4, tabSize: 4,
      indentWithTabs: false, matchBrackets: true,
    });
    userEditor.on('change', ()=>{
      if(currentTaskId!=null) saveDraft(currentTaskId, userEditor.getValue());
    });
  }

  const solutionCodeEl = () => el('#solutionCode');

  // ============ Practice view ============
  const listViewEl = el('#listView');
  const practiceViewEl = el('#practiceView');
  const practiceTierEl = el('#practiceTier');
  const practiceTitleEl = el('#practiceTitle');
  const practiceBodyEl = el('#practiceBody');
  const solutionPanelEl = el('#solutionPanel');
  const consoleEl = el('#console');
  const toastEl = el('#toast');
  const posLabelEl = el('#posLabel');

  function showToast(msg){
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    setTimeout(()=> toastEl.classList.remove('show'), 1800);
  }

  function openPractice(id){
    currentTaskId = id;
    const t = TASKS.find(x=>x.id===id);
    if(!t) return;
    const ti = tierInfo(t.level);
    practiceTierEl.textContent = `${ti.emoji} Уровень ${t.level} · ${ti.name}`;
    practiceTitleEl.textContent = t.title;

    solutionShown = false;
    solutionPanelEl.classList.remove('shown');
    practiceBodyEl.classList.remove('solution-shown');
    el('#toggleSolutionBtn').textContent = 'Показать решение';

    consoleEl.textContent = '';
    consoleEl.classList.remove('running');
    consoleEl.classList.add('placeholder');
    el('#runtimeStatus').textContent = '';

    updateStatusButtons();
    updatePosLabel();

    // Show the container FIRST — CodeMirror can only measure itself
    // correctly once its parent is actually laid out (not display:none).
    listViewEl.classList.add('hidden');
    practiceViewEl.classList.remove('hidden');

    const descEl = el('#practiceDesc');
    if(descEl){
      descEl.innerHTML = t.desc || `<p><strong>Задание:</strong> ${escapeHtml(t.title)}.</p>`;
    }
    if(!userEditor) initEditors();
    const drafts = loadDrafts();
    userEditor.setValue(drafts[id] !== undefined ? drafts[id] : (t.initialCode || `# ${t.title}\n`));
    solutionCodeEl().textContent = t.solution || t.code;

    window.scrollTo(0,0);
    requestAnimationFrame(()=>{
      userEditor.refresh();
      requestAnimationFrame(()=> userEditor.refresh());
    });
  }

  function closePractice(){
    practiceViewEl.classList.add('hidden');
    listViewEl.classList.remove('hidden');
    currentTaskId = null;
    render();
  }

  function updatePosLabel(){
    const idx = currentList.findIndex(t=>t.id===currentTaskId);
    if(idx===-1){ posLabelEl.textContent=''; el('#prevBtn').disabled=true; el('#nextBtn').disabled=true; return; }
    posLabelEl.textContent = `${idx+1} / ${currentList.length}`;
    el('#prevBtn').disabled = idx<=0;
    el('#nextBtn').disabled = idx>=currentList.length-1;
  }

  function updateStatusButtons(){
    document.querySelectorAll('.status-row .btn').forEach(btn=>{
      const s = statusMap[currentTaskId] || 'new';
      btn.classList.toggle('active-status', btn.dataset.status===s);
    });
  }

  el('#backBtn').addEventListener('click', closePractice);
  el('#prevBtn').addEventListener('click', ()=>{
    const idx = currentList.findIndex(t=>t.id===currentTaskId);
    if(idx>0) openPractice(currentList[idx-1].id);
  });
  el('#nextBtn').addEventListener('click', ()=>{
    const idx = currentList.findIndex(t=>t.id===currentTaskId);
    if(idx<currentList.length-1) openPractice(currentList[idx+1].id);
  });

  el('#toggleSolutionBtn').addEventListener('click', ()=>{
    solutionShown = !solutionShown;
    solutionPanelEl.classList.toggle('shown', solutionShown);
    practiceBodyEl.classList.toggle('solution-shown', solutionShown);
    el('#toggleSolutionBtn').textContent = solutionShown ? 'Скрыть решение' : 'Показать решение';
    if(solutionShown){
      const t = TASKS.find(x=>x.id===currentTaskId);
      if(t) solutionCodeEl().textContent = t.solution || t.code;
    }
  });

  el('#copySolutionBtn').addEventListener('click', async ()=>{
    const text = solutionCodeEl().textContent;
    if(!text){ showToast('Сначала откройте решение'); return; }
    try{ await navigator.clipboard.writeText(text); showToast('Решение скопировано'); }
    catch(e){ showToast('Не удалось скопировать'); }
  });

  el('#resetBtn').addEventListener('click', ()=>{
    const t = TASKS.find(x=>x.id===currentTaskId);
    if(!t) return;
    userEditor.setValue(t.initialCode || `# ${t.title}\n`);
    saveDraft(currentTaskId, userEditor.getValue());
    showToast('Код сброшен');
  });

  document.querySelectorAll('.status-row .btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const s = btn.dataset.status;
      const cur = statusMap[currentTaskId];
      if(cur===s) delete statusMap[currentTaskId];
      else statusMap[currentTaskId] = s;
      saveStatus();
      updateStatusButtons();
    });
  });

  // ============ Brython run ============
  let brythonReady = false;
  let brythonLoading = null;
  const BRYTHON_VERSION = '3.13.0';

  function loadScript(src){
    return new Promise((resolve, reject)=>{
      const s = document.createElement('script');
      s.src = src;
      s.onload = ()=>resolve();
      s.onerror = ()=>reject(new Error('failed to load ' + src));
      document.head.appendChild(s);
    });
  }

  function ensureBrython(){
    if(brythonReady) return Promise.resolve();
    if(brythonLoading) return brythonLoading;
    brythonLoading = (async ()=>{
      await loadScript(`https://cdnjs.cloudflare.com/ajax/libs/brython/${BRYTHON_VERSION}/brython.min.js`);
      await loadScript(`https://cdnjs.cloudflare.com/ajax/libs/brython/${BRYTHON_VERSION}/brython_stdlib.js`);
      window.brython({debug:0});
      brythonReady = true;
    })();
    return brythonLoading;
  }


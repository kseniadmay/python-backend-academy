@abstractmethod\n    def authenticate(self, credentials: dict) -> dict:\n        pass\nclass PasswordAuth(AuthStrategy):\n\n    def authenticate(self, creds: dict) -> dict:\n        pass\nclass OAuthGoogle(AuthStrategy):\n\n    def authenticate(self, creds: dict) -> dict:\n        pass", "solution": "# Постройте стратегию авторизации (Google, GitHub, Пароль)\nclass AuthStrategy(ABC):\n    @abstractmethod\n    def authenticate(self, credentials: dict) -> dict: pass\n\nclass PasswordAuth(AuthStrategy):\n    def authenticate(self, creds: dict) -> dict:\n        return {\"user\": creds[\"username\"], \"provider\": \"local\"}\n\nclass OAuthGoogle(AuthStrategy):\n    def authenticate(self, creds: dict) -> dict:\n        return {\"user\": creds[\"google_id\"], \"provider\": \"google\"}", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"AuthStrategy\" in globals() and isinstance(AuthStrategy, type), \"Класс AuthStrategy должен быть определён\"\n_cl_def_AuthStrategy = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"AuthStrategy\"]\nassert _cl_def_AuthStrategy and not (len(_cl_def_AuthStrategy[0].body) == 1 and isinstance(_cl_def_AuthStrategy[0].body[0], _ast.Pass)), \"Реализуйте тело класса AuthStrategy (сейчас там только pass)\"\nassert hasattr(AuthStrategy, \"authenticate\"), \"В классе AuthStrategy должен быть метод/свойство authenticate\"\nassert \"PasswordAuth\" in globals() and isinstance(PasswordAuth, type), \"Класс PasswordAuth должен быть определён\"\n_cl_def_PasswordAuth = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PasswordAuth\"]\nassert _cl_def_PasswordAuth and not (len(_cl_def_PasswordAuth[0].body) == 1 and isinstance(_cl_def_PasswordAuth[0].body[0], _ast.Pass)), \"Реализуйте тело класса PasswordAuth (сейчас там только pass)\"\nassert hasattr(PasswordAuth, \"authenticate\"), \"В классе PasswordAuth должен быть метод/свойство authenticate\"\n_cl_nodes_PasswordAuth_authenticate = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PasswordAuth\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"authenticate\"]\nassert _cl_nodes_PasswordAuth_authenticate and not (len(_cl_nodes_PasswordAuth_authenticate[0].body) == 1 and isinstance(_cl_nodes_PasswordAuth_authenticate[0].body[0], _ast.Pass)), \"Реализуйте метод PasswordAuth.authenticate()\"\nassert \"OAuthGoogle\" in globals() and isinstance(OAuthGoogle, type), \"Класс OAuthGoogle должен быть определён\"\n_cl_def_OAuthGoogle = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OAuthGoogle\"]\nassert _cl_def_OAuthGoogle and not (len(_cl_def_OAuthGoogle[0].body) == 1 and isinstance(_cl_def_OAuthGoogle[0].body[0], _ast.Pass)), \"Реализуйте тело класса OAuthGoogle (сейчас там только pass)\"\nassert hasattr(OAuthGoogle, \"authenticate\"), \"В классе OAuthGoogle должен быть метод/свойство authenticate\"\n_cl_nodes_OAuthGoogle_authenticate = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OAuthGoogle\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"authenticate\"]\nassert _cl_nodes_OAuthGoogle_authenticate and not (len(_cl_nodes_OAuthGoogle_authenticate[0].body) == 1 and isinstance(_cl_nodes_OAuthGoogle_authenticate[0].body[0], _ast.Pass)), \"Реализуйте метод OAuthGoogle.authenticate()\"", "code": "# Постройте стратегию авторизации (Google, GitHub, Пароль)\nclass AuthStrategy(ABC):\n    @abstractmethod\n    def authenticate(self, credentials: dict) -> dict: pass\n\nclass PasswordAuth(AuthStrategy):\n    def authenticate(self, creds: dict) -> dict:\n        return {\"user\": creds[\"username\"], \"provider\": \"local\"}\n\nclass OAuthGoogle(AuthStrategy):\n    def authenticate(self, creds: dict) -> dict:\n        return {\"user\": creds[\"google_id\"], \"provider\": \"google\"}"}, {"id": 104, "title": "Оптимизируйте QuerySet с prefetch_related для исключения N+1", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Оптимизируйте QuerySet с prefetch_related для исключения N+1.</p>", "initialCode": "queryset = None", "solution": "# Оптимизируйте QuerySet с prefetch_related для исключения N+1\n# select_related - для ForeignKey/OneToOne (SQL JOIN)\n# prefetch_related - для ManyToMany/обратных связей (отдельный batch-запрос)\nqueryset = User.objects.select_related('profile').prefetch_related('articles', 'articles__tags').all()", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"queryset\" in globals() and queryset is not None, \"Переменная queryset должна быть определена и не равна None\"\nassert queryset != \"__TODO__\", \"Заполните значение переменной queryset\"", "code": "# Оптимизируйте QuerySet с prefetch_related для исключения N+1\n# select_related - для ForeignKey/OneToOne (SQL JOIN)\n# prefetch_related - для ManyToMany/обратных связей (отдельный batch-запрос)\nqueryset = User.objects.select_related('profile').prefetch_related('articles', 'articles__tags').all()"}, {"id": 105, "title": "Найдите K самых частых элементов через heapq.nlargest", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Найдите K самых частых элементов через heapq.nlargest.</p>", "initialCode": "from collections import Counter\nimport heapq\ndef top_k_frequent(nums: list, k: int) -> list:\n    pass", "solution": "# Найдите K самых частых элементов через heapq.nlargest\nfrom collections import Counter\nimport heapq\n\ndef top_k_frequent(nums: list, k: int) -> list:\n    count = Counter(nums)\n    return heapq.nlargest(k, count.keys(), key=count.get)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"top_k_frequent\" in globals() and callable(top_k_frequent), \"Функция top_k_frequent() должна быть определена\"\n_fn_nodes_top_k_frequent = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"top_k_frequent\"]\nassert _fn_nodes_top_k_frequent and not (len(_fn_nodes_top_k_frequent[0].body) == 1 and isinstance(_fn_nodes_top_k_frequent[0].body[0], _ast.Pass)), \"Реализуйте тело функции top_k_frequent() (сейчас там только pass)\"", "code": "# Найдите K самых частых элементов через heapq.nlargest\nfrom collections import Counter\nimport heapq\n\ndef top_k_frequent(nums: list, k: int) -> list:\n    count = Counter(nums)\n    return heapq.nlargest(k, count.keys(), key=count.get)"}, {"id": 106, "title": "Примените пессимистическую блокировку SELECT FOR UPDATE", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Примените пессимистическую блокировку SELECT FOR UPDATE.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Примените пессимистическую блокировку SELECT FOR UPDATE\nsql = \"\"\"\nBEGIN;\nSELECT balance FROM accounts WHERE id = 1 FOR UPDATE;\nUPDATE accounts SET balance = balance - 100 WHERE id = 1;\nCOMMIT;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"BEGIN\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'BEGIN'\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"balance\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'balance'\"", "code": "# Примените пессимистическую блокировку SELECT FOR UPDATE\nsql = \"\"\"\nBEGIN;\nSELECT balance FROM accounts WHERE id = 1 FOR UPDATE;\nUPDATE accounts SET balance = balance - 100 WHERE id = 1;\nCOMMIT;\n\"\"\""}, {"id": 107, "title": "Реализуйте очередь на базе collections.deque", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте очередь на базе collections.deque.</p>", "initialCode": "from collections import deque\nclass Queue:\n\n    def __init__(self):\n        pass\n\n    def enqueue(self, val):\n        pass\n\n    def dequeue(self):\n        pass\n\n    def __len__(self):\n        pass", "solution": "# Реализуйте очередь на базе collections.deque\nfrom collections import deque\n\nclass Queue:\n    def __init__(self):\n        self._deque = deque()\n\n    def enqueue(self, val):\n        self._deque.append(val)\n\n    def dequeue(self):\n        if not self._deque:\n            raise IndexError(\"Очередь пуста\")\n        return self._deque.popleft()\n\n    def __len__(self):\n        return len(self._deque)", "hint": "Шаг 1: Используй список или collections.deque. Шаг 2: Добавляй в конец (append), извлекай из начала (popleft / pop(0)) с валидацией непустого состояния.", "tests": "import ast as _ast\nassert \"Queue\" in globals() and isinstance(Queue, type), \"Класс Queue должен быть определён\"\n_cl_def_Queue = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Queue\"]\nassert _cl_def_Queue and not (len(_cl_def_Queue[0].body) == 1 and isinstance(_cl_def_Queue[0].body[0], _ast.Pass)), \"Реализуйте тело класса Queue (сейчас там только pass)\"\nassert hasattr(Queue, \"__init__\"), \"В классе Queue должен быть метод/свойство __init__\"\n_cl_nodes_Queue___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Queue\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Queue___init__ and not (len(_cl_nodes_Queue___init__[0].body) == 1 and isinstance(_cl_nodes_Queue___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Queue.__init__()\"\nassert hasattr(Queue, \"enqueue\"), \"В классе Queue должен быть метод/свойство enqueue\"\n_cl_nodes_Queue_enqueue = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Queue\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"enqueue\"]\nassert _cl_nodes_Queue_enqueue and not (len(_cl_nodes_Queue_enqueue[0].body) == 1 and isinstance(_cl_nodes_Queue_enqueue[0].body[0], _ast.Pass)), \"Реализуйте метод Queue.enqueue()\"\nassert hasattr(Queue, \"dequeue\"), \"В классе Queue должен быть метод/свойство dequeue\"\n_cl_nodes_Queue_dequeue = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Queue\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"dequeue\"]\nassert _cl_nodes_Queue_dequeue and not (len(_cl_nodes_Queue_dequeue[0].body) == 1 and isinstance(_cl_nodes_Queue_dequeue[0].body[0], _ast.Pass)), \"Реализуйте метод Queue.dequeue()\"\nassert hasattr(Queue, \"__len__\"), \"В классе Queue должен быть метод/свойство __len__\"\n_cl_nodes_Queue___len__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Queue\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__len__\"]\nassert _cl_nodes_Queue___len__ and not (len(_cl_nodes_Queue___len__[0].body) == 1 and isinstance(_cl_nodes_Queue___len__[0].body[0], _ast.Pass)), \"Реализуйте метод Queue.__len__()\"", "code": "# Реализуйте очередь на базе collections.deque\nfrom collections import deque\n\nclass Queue:\n    def __init__(self):\n        self._deque = deque()\n\n    def enqueue(self, val):\n        self._deque.append(val)\n\n    def dequeue(self):\n        if not self._deque:\n            raise IndexError(\"Очередь пуста\")\n        return self._deque.popleft()\n\n    def __len__(self):\n        return len(self._deque)"}, {"id": 108, "title": "Найдите максимальную глубину бинарного дерева (maxDepth)", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Найдите максимальную глубину бинарного дерева (maxDepth).</p>", "initialCode": "def max_depth(root: TreeNode) -> int:\n    pass", "solution": "# Найдите максимальную глубину бинарного дерева (maxDepth)\ndef max_depth(root: TreeNode) -> int:\n    if not root:\n        return 0\n    return 1 + max(max_depth(root.left), max_depth(root.right))", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"max_depth\" in globals() and callable(max_depth), \"Функция max_depth() должна быть определена\"\n_fn_nodes_max_depth = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"max_depth\"]\nassert _fn_nodes_max_depth and not (len(_fn_nodes_max_depth[0].body) == 1 and isinstance(_fn_nodes_max_depth[0].body[0], _ast.Pass)), \"Реализуйте тело функции max_depth() (сейчас там только pass)\"\n_r = TreeNode(1, TreeNode(2, TreeNode(3)), None); assert max_depth(_r) == 3", "code": "# Найдите максимальную глубину бинарного дерева (maxDepth)\ndef max_depth(root: TreeNode) -> int:\n    if not root:\n        return 0\n    return 1 + max(max_depth(root.left), max_depth(root.right))"}, {"id": 109, "title": "Решите задачу о лестнице (Climbing Stairs DP)", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Решите задачу о лестнице (Climbing Stairs DP).</p>", "initialCode": "def climb_stairs(n: int) -> int:\n    pass", "solution": "# Решите задачу о лестнице (Climbing Stairs DP)\ndef climb_stairs(n: int) -> int:\n    if n <= 2: return n\n    a, b = 1, 2\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"climb_stairs\" in globals() and callable(climb_stairs), \"Функция climb_stairs() должна быть определена\"\n_fn_nodes_climb_stairs = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"climb_stairs\"]\nassert _fn_nodes_climb_stairs and not (len(_fn_nodes_climb_stairs[0].body) == 1 and isinstance(_fn_nodes_climb_stairs[0].body[0], _ast.Pass)), \"Реализуйте тело функции climb_stairs() (сейчас там только pass)\"", "code": "# Решите задачу о лестнице (Climbing Stairs DP)\ndef climb_stairs(n: int) -> int:\n    if n <= 2: return n\n    a, b = 1, 2\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}, {"id": 110, "title": "Функция-счётчик вызовов через nonlocal", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Функция-счётчик вызовов через nonlocal.</p>", "initialCode": "def make_counter(start=0):\n    pass", "solution": "# Функция-счётчик вызовов через nonlocal\ndef make_counter(start=0):\n    count = start\n    def counter():\n        nonlocal count\n        count += 1\n        return count\n    return counter\n\nc = make_counter()\nprint(c(), c(), c())  # 1 2 3", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"make_counter\" in globals() and callable(make_counter), \"Функция make_counter() должна быть определена\"\n_fn_nodes_make_counter = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"make_counter\"]\nassert _fn_nodes_make_counter and not (len(_fn_nodes_make_counter[0].body) == 1 and isinstance(_fn_nodes_make_counter[0].body[0], _ast.Pass)), \"Реализуйте тело функции make_counter() (сейчас там только pass)\"\nc = make_counter()\nprint(c(), c(), c())\nassert \"c\" in globals(), \"Переменная c должна быть вычислена\"", "code": "# Функция-счётчик вызовов через nonlocal\ndef make_counter(start=0):\n    count = start\n    def counter():\n        nonlocal count\n        count += 1\n        return count\n    return counter\n\nc = make_counter()\nprint(c(), c(), c())  # 1 2 3"}, {"id": 111, "title": "Оптимизируйте размер образа через multi-stage сборку", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Оптимизируйте размер образа через multi-stage сборку.</p>", "initialCode": "# Напишите ваше решение\n", "solution": "# Оптимизируйте размер образа через multi-stage сборку\n# Multi-stage исключает компиляторы gcc/make и промежуточные кэши pip из итогового контейнера", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert len([l for l in __USER_CODE__.splitlines() if l.strip() and not l.strip().startswith(\"# Задач\") and not l.strip().startswith(\"# Напишите ваше\") and not l.strip().startswith(\"from \") and not l.strip().startswith(\"import \")]) >= 1, \"Добавьте решение задачи\"", "code": "# Оптимизируйте размер образа через multi-stage сборку\n# Multi-stage исключает компиляторы gcc/make и промежуточные кэши pip из итогового контейнера"}, {"id": 112, "title": "Реализуйте генерацию и верификацию JWT с проверкой exp", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте генерацию и верификацию JWT с проверкой exp.</p>", "initialCode": "import time\nimport hmac\nimport hashlib\nimport base64\nimport json\ndef _b64url_encode(data: bytes) -> str:\n    pass\ndef _b64url_decode(s: str) -> bytes:\n    pass\ndef create_jwt(payload: dict, secret: str, ttl: int=3600) -> str:\n    pass\ndef verify_jwt(token: str, secret: str) -> dict:\n    pass", "solution": "# Реализуйте генерацию и верификацию JWT с проверкой exp (HS256)\nimport time\nimport hmac\nimport hashlib\nimport base64\nimport json\n\ndef _b64url_encode(data: bytes) -> str:\n    return base64.urlsafe_b64encode(data).rstrip(b\"=\").decode(\"ascii\")\n\ndef _b64url_decode(s: str) -> bytes:\n    pad = \"=\" * (-len(s) % 4)\n    return base64.urlsafe_b64decode(s + pad)\n\ndef create_jwt(payload: dict, secret: str, ttl: int = 3600) -> str:\n    header = {\"alg\": \"HS256\", \"typ\": \"JWT\"}\n    body = {**payload, \"exp\": int(time.time()) + ttl}\n    b64_h = _b64url_encode(json.dumps(header, separators=(\",\", \":\")).encode())\n    b64_p = _b64url_encode(json.dumps(body, separators=(\",\", \":\")).encode())\n    signing_input = f\"{b64_h}.{b64_p}\".encode(\"ascii\")\n    sig = hmac.new(secret.encode(), signing_input, hashlib.sha256).digest()\n    return f\"{b64_h}.{b64_p}.{_b64url_encode(sig)}\"\n\ndef verify_jwt(token: str, secret: str) -> dict:\n    parts = token.split(\".\")\n    if len(parts) != 3:\n        raise ValueError(\"Некорректный формат JWT\")\n    b64_h, b64_p, b64_sig = parts\n    signing_input = f\"{b64_h}.{b64_p}\".encode(\"ascii\")\n    expected_sig = _b64url_encode(hmac.new(secret.encode(), signing_input, hashlib.sha256).digest())\n    if not hmac.compare_digest(b64_sig, expected_sig):\n        raise ValueError(\"Подпись токена недействительна\")\n    payload = json.loads(_b64url_decode(b64_p))\n    if payload.get(\"exp\", 0) < time.time():\n        raise ValueError(\"Срок действия токена истёк\")\n    return payload\n\ntok = create_jwt({\"sub\": \"user_42\", \"role\": \"admin\"}, secret=\"super-secret\", ttl=60)\ndecoded = verify_jwt(tok, secret=\"super-secret\")\nprint(\"Декодированный payload:\", decoded)\nassert decoded[\"sub\"] == \"user_42\" and decoded[\"role\"] == \"admin\"\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"_b64url_encode\" in globals() and callable(_b64url_encode), \"Функция _b64url_encode() должна быть определена\"\n_fn_nodes__b64url_encode = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"_b64url_encode\"]\nassert _fn_nodes__b64url_encode and not (len(_fn_nodes__b64url_encode[0].body) == 1 and isinstance(_fn_nodes__b64url_encode[0].body[0], _ast.Pass)), \"Реализуйте тело функции _b64url_encode() (сейчас там только pass)\"\nassert \"_b64url_decode\" in globals() and callable(_b64url_decode), \"Функция _b64url_decode() должна быть определена\"\n_fn_nodes__b64url_decode = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"_b64url_decode\"]\nassert _fn_nodes__b64url_decode and not (len(_fn_nodes__b64url_decode[0].body) == 1 and isinstance(_fn_nodes__b64url_decode[0].body[0], _ast.Pass)), \"Реализуйте тело функции _b64url_decode() (сейчас там только pass)\"\nassert \"create_jwt\" in globals() and callable(create_jwt), \"Функция create_jwt() должна быть определена\"\n_fn_nodes_create_jwt = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"create_jwt\"]\nassert _fn_nodes_create_jwt and not (len(_fn_nodes_create_jwt[0].body) == 1 and isinstance(_fn_nodes_create_jwt[0].body[0], _ast.Pass)), \"Реализуйте тело функции create_jwt() (сейчас там только pass)\"\nassert \"verify_jwt\" in globals() and callable(verify_jwt), \"Функция verify_jwt() должна быть определена\"\n_fn_nodes_verify_jwt = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"verify_jwt\"]\nassert _fn_nodes_verify_jwt and not (len(_fn_nodes_verify_jwt[0].body) == 1 and isinstance(_fn_nodes_verify_jwt[0].body[0], _ast.Pass)), \"Реализуйте тело функции verify_jwt() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\ntok = create_jwt({\"sub\": \"user_42\", \"role\": \"admin\"}, secret=\"super-secret\", ttl=60)\ndecoded = verify_jwt(tok, secret=\"super-secret\")\nprint(\"Декодированный payload:\", decoded)\nassert decoded[\"sub\"] == \"user_42\" and decoded[\"role\"] == \"admin\"\nassert \"tok\" in globals(), \"Переменная tok должна быть вычислена\"\nassert \"decoded\" in globals(), \"Переменная decoded должна быть вычислена\"", "code": "# Реализуйте генерацию и верификацию JWT с проверкой exp (HS256)\nimport time\nimport hmac\nimport hashlib\nimport base64\nimport json\n\ndef _b64url_encode(data: bytes) -> str:\n    return base64.urlsafe_b64encode(data).rstrip(b\"=\").decode(\"ascii\")\n\ndef _b64url_decode(s: str) -> bytes:\n    pad = \"=\" * (-len(s) % 4)\n    return base64.urlsafe_b64decode(s + pad)\n\ndef create_jwt(payload: dict, secret: str, ttl: int = 3600) -> str:\n    header = {\"alg\": \"HS256\", \"typ\": \"JWT\"}\n    body = {**payload, \"exp\": int(time.time()) + ttl}\n    b64_h = _b64url_encode(json.dumps(header, separators=(\",\", \":\")).encode())\n    b64_p = _b64url_encode(json.dumps(body, separators=(\",\", \":\")).encode())\n    signing_input = f\"{b64_h}.{b64_p}\".encode(\"ascii\")\n    sig = hmac.new(secret.encode(), signing_input, hashlib.sha256).digest()\n    return f\"{b64_h}.{b64_p}.{_b64url_encode(sig)}\"\n\ndef verify_jwt(token: str, secret: str) -> dict:\n    parts = token.split(\".\")\n    if len(parts) != 3:\n        raise ValueError(\"Некорректный формат JWT\")\n    b64_h, b64_p, b64_sig = parts\n    signing_input = f\"{b64_h}.{b64_p}\".encode(\"ascii\")\n    expected_sig = _b64url_encode(hmac.new(secret.encode(), signing_input, hashlib.sha256).digest())\n    if not hmac.compare_digest(b64_sig, expected_sig):\n        raise ValueError(\"Подпись токена недействительна\")\n    payload = json.loads(_b64url_decode(b64_p))\n    if payload.get(\"exp\", 0) < time.time():\n        raise ValueError(\"Срок действия токена истёк\")\n    return payload\n\ntok = create_jwt({\"sub\": \"user_42\", \"role\": \"admin\"}, secret=\"super-secret\", ttl=60)\ndecoded = verify_jwt(tok, secret=\"super-secret\")\nprint(\"Декодированный payload:\", decoded)\nassert decoded[\"sub\"] == \"user_42\" and decoded[\"role\"] == \"admin\"\n"}, {"id": 113, "title": "Соберите docker-compose.yml: FastAPI + Postgres + Redis", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Соберите docker-compose.yml: FastAPI + Postgres + Redis.</p>", "initialCode": "compose_yaml = None", "solution": "# Соберите docker-compose.yml: FastAPI + Postgres + Redis\ncompose_yaml = \"\"\"\nversion: '3.8'\nservices:\n  app:\n    build: .\n    ports: [\"8000:8000\"]\n    environment:\n      - DATABASE_URL=postgresql://user:pass@postgres:5432/app_db\n      - REDIS_URL=redis://redis:6379/0\n    depends_on: [postgres, redis]\n  postgres:\n    image: postgres:16-alpine\n    environment: [POSTGRES_USER=user, POSTGRES_PASSWORD=pass, POSTGRES_DB=app_db]\n    volumes: [pg_data:/var/lib/postgresql/data]\n  redis:\n    image: redis:7-alpine\nvolumes:\n  pg_data:\n\"\"\"", "hint": "Используй стандартные команды Redis-клиента: r.set(key, value), r.get(key) и r.expire(key, seconds).", "tests": "import ast as _ast\nassert \"compose_yaml\" in globals() and compose_yaml is not None, \"Переменная compose_yaml должна быть определена и не равна None\"\nassert isinstance(compose_yaml, str) and \"version\".lower() in compose_yaml.lower(), \"Строка compose_yaml должна содержать ключевой элемент 'version'\"\nassert isinstance(compose_yaml, str) and \"services\".lower() in compose_yaml.lower(), \"Строка compose_yaml должна содержать ключевой элемент 'services'\"\nassert isinstance(compose_yaml, str) and \"app\".lower() in compose_yaml.lower(), \"Строка compose_yaml должна содержать ключевой элемент 'app'\"", "code": "# Соберите docker-compose.yml: FastAPI + Postgres + Redis\ncompose_yaml = \"\"\"\nversion: '3.8'\nservices:\n  app:\n    build: .\n    ports: [\"8000:8000\"]\n    environment:\n      - DATABASE_URL=postgresql://user:pass@postgres:5432/app_db\n      - REDIS_URL=redis://redis:6379/0\n    depends_on: [postgres, redis]\n  postgres:\n    image: postgres:16-alpine\n    environment: [POSTGRES_USER=user, POSTGRES_PASSWORD=pass, POSTGRES_DB=app_db]\n    volumes: [pg_data:/var/lib/postgresql/data]\n  redis:\n    image: redis:7-alpine\nvolumes:\n  pg_data:\n\"\"\""}, {"id": 114, "title": "Реализуйте разворот односвязного списка за O(n) и O(1) памяти", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте разворот односвязного списка за O(n) и O(1) памяти.</p>", "initialCode": "def reverse_list(head: ListNode) -> ListNode:\n    pass", "solution": "# Реализуйте разворот односвязного списка за O(n) и O(1) памяти\ndef reverse_list(head: ListNode) -> ListNode:\n    prev = None\n    curr = head\n    while curr:\n        nxt = curr.next\n        curr.next = prev\n        prev = curr\n        curr = nxt\n    return prev", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"reverse_list\" in globals() and callable(reverse_list), \"Функция reverse_list() должна быть определена\"\n_fn_nodes_reverse_list = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"reverse_list\"]\nassert _fn_nodes_reverse_list and not (len(_fn_nodes_reverse_list[0].body) == 1 and isinstance(_fn_nodes_reverse_list[0].body[0], _ast.Pass)), \"Реализуйте тело функции reverse_list() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\n_h = ListNode(1, ListNode(2)); _rev = reverse_list(_h); assert _rev.val == 2 and _rev.next.val == 1", "code": "# Реализуйте разворот односвязного списка за O(n) и O(1) памяти\ndef reverse_list(head: ListNode) -> ListNode:\n    prev = None\n    curr = head\n    while curr:\n        nxt = curr.next\n        curr.next = prev\n        prev = curr\n        curr = nxt\n    return prev"}, {"id": 115, "title": "Постройте частичный индекс (Partial Index) по условию", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте частичный индекс (Partial Index) по условию.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Постройте частичный индекс (Partial Index) по условию\nsql = \"\"\"\nCREATE INDEX idx_active_users_premium \nON users (email) \nWHERE is_active = true AND is_premium = true;\n\"\"\"", "hint": "Синтаксис создания индекса: CREATE INDEX idx_name ON table_name USING btree (column_name);", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"CREATE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'CREATE'\"\nassert isinstance(sql, str) and \"INDEX\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'INDEX'\"\nassert isinstance(sql, str) and \"idx_active_users_premium\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'idx_active_users_premium'\"", "code": "# Постройте частичный индекс (Partial Index) по условию\nsql = \"\"\"\nCREATE INDEX idx_active_users_premium \nON users (email) \nWHERE is_active = true AND is_premium = true;\n\"\"\""}, {"id": 116, "title": "Реализуйте SqlAlchemyUserRepository с реальной БД", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте SqlAlchemyUserRepository с реальной БД.</p>", "initialCode": "class SqlAlchemyUserRepository(IUserRepository):\n\n    def __init__(self, session):\n        pass\n\n    def get_by_id(self, user_id: int):\n        pass\n\n    def save(self, user):\n        pass", "solution": "# Реализуйте SqlAlchemyUserRepository с реальной БД\nclass SqlAlchemyUserRepository(IUserRepository):\n    def __init__(self, session):\n        self.session = session\n\n    def get_by_id(self, user_id: int):\n        return self.session.query(UserModel).filter_by(id=user_id).first()\n\n    def save(self, user):\n        self.session.add(user)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"SqlAlchemyUserRepository\" in globals() and isinstance(SqlAlchemyUserRepository, type), \"Класс SqlAlchemyUserRepository должен быть определён\"\n_cl_def_SqlAlchemyUserRepository = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SqlAlchemyUserRepository\"]\nassert _cl_def_SqlAlchemyUserRepository and not (len(_cl_def_SqlAlchemyUserRepository[0].body) == 1 and isinstance(_cl_def_SqlAlchemyUserRepository[0].body[0], _ast.Pass)), \"Реализуйте тело класса SqlAlchemyUserRepository (сейчас там только pass)\"\nassert hasattr(SqlAlchemyUserRepository, \"__init__\"), \"В классе SqlAlchemyUserRepository должен быть метод/свойство __init__\"\n_cl_nodes_SqlAlchemyUserRepository___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SqlAlchemyUserRepository\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_SqlAlchemyUserRepository___init__ and not (len(_cl_nodes_SqlAlchemyUserRepository___init__[0].body) == 1 and isinstance(_cl_nodes_SqlAlchemyUserRepository___init__[0].body[0], _ast.Pass)), \"Реализуйте метод SqlAlchemyUserRepository.__init__()\"\nassert hasattr(SqlAlchemyUserRepository, \"get_by_id\"), \"В классе SqlAlchemyUserRepository должен быть метод/свойство get_by_id\"\n_cl_nodes_SqlAlchemyUserRepository_get_by_id = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SqlAlchemyUserRepository\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"get_by_id\"]\nassert _cl_nodes_SqlAlchemyUserRepository_get_by_id and not (len(_cl_nodes_SqlAlchemyUserRepository_get_by_id[0].body) == 1 and isinstance(_cl_nodes_SqlAlchemyUserRepository_get_by_id[0].body[0], _ast.Pass)), \"Реализуйте метод SqlAlchemyUserRepository.get_by_id()\"\nassert hasattr(SqlAlchemyUserRepository, \"save\"), \"В классе SqlAlchemyUserRepository должен быть метод/свойство save\"\n_cl_nodes_SqlAlchemyUserRepository_save = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SqlAlchemyUserRepository\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"save\"]\nassert _cl_nodes_SqlAlchemyUserRepository_save and not (len(_cl_nodes_SqlAlchemyUserRepository_save[0].body) == 1 and isinstance(_cl_nodes_SqlAlchemyUserRepository_save[0].body[0], _ast.Pass)), \"Реализуйте метод SqlAlchemyUserRepository.save()\"", "code": "# Реализуйте SqlAlchemyUserRepository с реальной БД\nclass SqlAlchemyUserRepository(IUserRepository):\n    def __init__(self, session):\n        self.session = session\n\n    def get_by_id(self, user_id: int):\n        return self.session.query(UserModel).filter_by(id=user_id).first()\n\n    def save(self, user):\n        self.session.add(user)"}, {"id": 117, "title": "Напишите рекурсивный обход в глубину (DFS) графа", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите рекурсивный обход в глубину (DFS) графа.</p>", "initialCode": "def dfs_recursive(graph: dict, start_node, visited=None) -> list:\n    pass", "solution": "# Напишите рекурсивный обход в глубину (DFS) графа\ndef dfs_recursive(graph: dict, start_node, visited=None) -> list:\n    if visited is None:\n        visited = set()\n    visited.add(start_node)\n    traversal = [start_node]\n    for neighbor in graph.get(start_node, []):\n        if neighbor not in visited:\n            traversal.extend(dfs_recursive(graph, neighbor, visited))\n    return traversal", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"dfs_recursive\" in globals() and callable(dfs_recursive), \"Функция dfs_recursive() должна быть определена\"\n_fn_nodes_dfs_recursive = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"dfs_recursive\"]\nassert _fn_nodes_dfs_recursive and not (len(_fn_nodes_dfs_recursive[0].body) == 1 and isinstance(_fn_nodes_dfs_recursive[0].body[0], _ast.Pass)), \"Реализуйте тело функции dfs_recursive() (сейчас там только pass)\"", "code": "# Напишите рекурсивный обход в глубину (DFS) графа\ndef dfs_recursive(graph: dict, start_node, visited=None) -> list:\n    if visited is None:\n        visited = set()\n    visited.add(start_node)\n    traversal = [start_node]\n    for neighbor in graph.get(start_node, []):\n        if neighbor not in visited:\n            traversal.extend(dfs_recursive(graph, neighbor, visited))\n    return traversal"}, {"id": 118, "title": "Напишите обработчик запроса GetOrderByIdQuery", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите обработчик запроса GetOrderByIdQuery.</p>", "initialCode": "@dataclass(frozen=True)\nclass GetOrderByIdQuery:\n    pass\nclass GetOrderByIdHandler:\n\n    def __init__(self, db_session):\n        pass\n\n    def handle(self, query: GetOrderByIdQuery):\n        pass", "solution": "# Напишите обработчик запроса GetOrderByIdQuery\n@dataclass(frozen=True)\nclass GetOrderByIdQuery:\n    order_id: int\n\nclass GetOrderByIdHandler:\n    def __init__(self, db_session):\n        self.db = db_session\n\n    def handle(self, query: GetOrderByIdQuery):\n        return self.db.query(OrderReadModel).filter_by(id=query.order_id).first()", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"GetOrderByIdQuery\" in globals() and isinstance(GetOrderByIdQuery, type), \"Класс GetOrderByIdQuery должен быть определён\"\n_cl_def_GetOrderByIdQuery = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"GetOrderByIdQuery\"]\nassert _cl_def_GetOrderByIdQuery and not (len(_cl_def_GetOrderByIdQuery[0].body) == 1 and isinstance(_cl_def_GetOrderByIdQuery[0].body[0], _ast.Pass)), \"Реализуйте тело класса GetOrderByIdQuery (сейчас там только pass)\"\nassert \"GetOrderByIdHandler\" in globals() and isinstance(GetOrderByIdHandler, type), \"Класс GetOrderByIdHandler должен быть определён\"\n_cl_def_GetOrderByIdHandler = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"GetOrderByIdHandler\"]\nassert _cl_def_GetOrderByIdHandler and not (len(_cl_def_GetOrderByIdHandler[0].body) == 1 and isinstance(_cl_def_GetOrderByIdHandler[0].body[0], _ast.Pass)), \"Реализуйте тело класса GetOrderByIdHandler (сейчас там только pass)\"\nassert hasattr(GetOrderByIdHandler, \"__init__\"), \"В классе GetOrderByIdHandler должен быть метод/свойство __init__\"\n_cl_nodes_GetOrderByIdHandler___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"GetOrderByIdHandler\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_GetOrderByIdHandler___init__ and not (len(_cl_nodes_GetOrderByIdHandler___init__[0].body) == 1 and isinstance(_cl_nodes_GetOrderByIdHandler___init__[0].body[0], _ast.Pass)), \"Реализуйте метод GetOrderByIdHandler.__init__()\"\nassert hasattr(GetOrderByIdHandler, \"handle\"), \"В классе GetOrderByIdHandler должен быть метод/свойство handle\"\n_cl_nodes_GetOrderByIdHandler_handle = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"GetOrderByIdHandler\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"handle\"]\nassert _cl_nodes_GetOrderByIdHandler_handle and not (len(_cl_nodes_GetOrderByIdHandler_handle[0].body) == 1 and isinstance(_cl_nodes_GetOrderByIdHandler_handle[0].body[0], _ast.Pass)), \"Реализуйте метод GetOrderByIdHandler.handle()\"", "code": "# Напишите обработчик запроса GetOrderByIdQuery\n@dataclass(frozen=True)\nclass GetOrderByIdQuery:\n    order_id: int\n\nclass GetOrderByIdHandler:\n    def __init__(self, db_session):\n        self.db = db_session\n\n    def handle(self, query: GetOrderByIdQuery):\n        return self.db.query(OrderReadModel).filter_by(id=query.order_id).first()"}, {"id": 119, "title": "Сгруппируйте заказы по клиентам и подсчитайте суммы", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Сгруппируйте заказы по клиентам и подсчитайте суммы.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Сгруппируйте заказы по клиентам и подсчитайте суммы\nsql = \"\"\"\nSELECT user_id, COUNT(*) AS total_orders, SUM(total_amount) AS spent\nFROM orders\nGROUP BY user_id\nORDER BY spent DESC;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"user_id\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'user_id'\"\nassert isinstance(sql, str) and \"COUNT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'COUNT'\"", "code": "# Сгруппируйте заказы по клиентам и подсчитайте суммы\nsql = \"\"\"\nSELECT user_id, COUNT(*) AS total_orders, SUM(total_amount) AS spent\nFROM orders\nGROUP BY user_id\nORDER BY spent DESC;\n\"\"\""}, {"id": 120, "title": "Решите задачу 3Sum (сумма трёх чисел до 0)", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Решите задачу 3Sum (сумма трёх чисел до 0).</p>", "initialCode": "def three_sum(nums: list) -> list:\n    pass", "solution": "# Решите задачу 3Sum (сумма трёх чисел до 0)\ndef three_sum(nums: list) -> list:\n    nums.sort()\n    res = []\n    for i in range(len(nums) - 2):\n        if i > 0 and nums[i] == nums[i - 1]: continue\n        l, r = i + 1, len(nums) - 1\n        while l < r:\n            s = nums[i] + nums[l] + nums[r]\n            if s < 0: l += 1\n            elif s > 0: r -= 1\n            else:\n                res.append([nums[i], nums[l], nums[r]])\n                while l < r and nums[l] == nums[l + 1]: l += 1\n                while l < r and nums[r] == nums[r - 1]: r -= 1\n                l += 1; r -= 1\n    return res", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"three_sum\" in globals() and callable(three_sum), \"Функция three_sum() должна быть определена\"\n_fn_nodes_three_sum = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"three_sum\"]\nassert _fn_nodes_three_sum and not (len(_fn_nodes_three_sum[0].body) == 1 and isinstance(_fn_nodes_three_sum[0].body[0], _ast.Pass)), \"Реализуйте тело функции three_sum() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Решите задачу 3Sum (сумма трёх чисел до 0)\ndef three_sum(nums: list) -> list:\n    nums.sort()\n    res = []\n    for i in range(len(nums) - 2):\n        if i > 0 and nums[i] == nums[i - 1]: continue\n        l, r = i + 1, len(nums) - 1\n        while l < r:\n            s = nums[i] + nums[l] + nums[r]\n            if s < 0: l += 1\n            elif s > 0: r -= 1\n            else:\n                res.append([nums[i], nums[l], nums[r]])\n                while l < r and nums[l] == nums[l + 1]: l += 1\n                while l < r and nums[r] == nums[r - 1]: r -= 1\n                l += 1; r -= 1\n    return res"}, {"id": 121, "title": "Соберите цепочку задач Celery chain: загрузка > обработка > отчет", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Соберите цепочку задач Celery chain: загрузка &gt; обработка &gt; отчет.</p>", "initialCode": "from celery import chain\n\nworkflow = None", "solution": "# Соберите цепочку задач Celery chain: загрузка > обработка > отчет\nfrom celery import chain\n\nworkflow = chain(\n    download_data.s('http://example.com/data.csv'),\n    process_csv.s(),\n    generate_report.s()\n)\nworkflow.apply_async()", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"workflow\" in globals() and workflow is not None, \"Переменная workflow должна быть определена и не равна None\"\nassert workflow != \"__TODO__\", \"Заполните значение переменной workflow\"", "code": "# Соберите цепочку задач Celery chain: загрузка > обработка > отчет\nfrom celery import chain\n\nworkflow = chain(\n    download_data.s('http://example.com/data.csv'),\n    process_csv.s(),\n    generate_report.s()\n)\nworkflow.apply_async()"}, {"id": 122, "title": "Напишите асинхронный эндпоинт с BackgroundTasks", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите асинхронный эндпоинт с BackgroundTasks.</p>", "initialCode": "from fastapi import FastAPI, BackgroundTasks\nfrom fastapi.testclient import TestClient\napp = FastAPI()\nsent_notifications: list[tuple[str, str]] = []\ndef send_email_notification(email: str, message: str):\n    pass\n@app.post('/users/')\ndef create_user(email: str, bg_tasks: BackgroundTasks):\n    pass", "solution": "# Напишите эндпоинт с фоновой задачей BackgroundTasks\nfrom fastapi import FastAPI, BackgroundTasks\nfrom fastapi.testclient import TestClient\n\napp = FastAPI()\nsent_notifications: list[tuple[str, str]] = []\n\ndef send_email_notification(email: str, message: str):\n    sent_notifications.append((email, message))\n\n@app.post(\"/users/\")\ndef create_user(email: str, bg_tasks: BackgroundTasks):\n    bg_tasks.add_task(send_email_notification, email, \"Welcome to platform!\")\n    return {\"status\": \"created\", \"email\": email}\n\nclient = TestClient(app)\nresp = client.post(\"/users/?email=alice@example.com\")\nprint(\"Ответ:\", resp.json(), \"| Фоновые задачи:\", sent_notifications)\nassert resp.status_code == 200 and sent_notifications == [(\"alice@example.com\", \"Welcome to platform!\")]\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"send_email_notification\" in globals() and callable(send_email_notification), \"Функция send_email_notification() должна быть определена\"\n_fn_nodes_send_email_notification = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"send_email_notification\"]\nassert _fn_nodes_send_email_notification and not (len(_fn_nodes_send_email_notification[0].body) == 1 and isinstance(_fn_nodes_send_email_notification[0].body[0], _ast.Pass)), \"Реализуйте тело функции send_email_notification() (сейчас там только pass)\"\nassert \"create_user\" in globals() and callable(create_user), \"Функция create_user() должна быть определена\"\n_fn_nodes_create_user = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"create_user\"]\nassert _fn_nodes_create_user and not (len(_fn_nodes_create_user[0].body) == 1 and isinstance(_fn_nodes_create_user[0].body[0], _ast.Pass)), \"Реализуйте тело функции create_user() (сейчас там только pass)\"\nif \"sent_notifications\" in globals() and isinstance(sent_notifications, list): sent_notifications.clear()\nclient = TestClient(app)\nresp = client.post(\"/users/?email=alice@example.com\")\nprint(\"Ответ:\", resp.json(), \"| Фоновые задачи:\", sent_notifications)\nassert resp.status_code == 200 and sent_notifications == [(\"alice@example.com\", \"Welcome to platform!\")]\nassert \"client\" in globals(), \"Переменная client должна быть вычислена\"\nassert \"resp\" in globals(), \"Переменная resp должна быть вычислена\"", "code": "# Напишите эндпоинт с фоновой задачей BackgroundTasks\nfrom fastapi import FastAPI, BackgroundTasks\nfrom fastapi.testclient import TestClient\n\napp = FastAPI()\nsent_notifications: list[tuple[str, str]] = []\n\ndef send_email_notification(email: str, message: str):\n    sent_notifications.append((email, message))\n\n@app.post(\"/users/\")\ndef create_user(email: str, bg_tasks: BackgroundTasks):\n    bg_tasks.add_task(send_email_notification, email, \"Welcome to platform!\")\n    return {\"status\": \"created\", \"email\": email}\n\nclient = TestClient(app)\nresp = client.post(\"/users/?email=alice@example.com\")\nprint(\"Ответ:\", resp.json(), \"| Фоновые задачи:\", sent_notifications)\nassert resp.status_code == 200 and sent_notifications == [(\"alice@example.com\", \"Welcome to platform!\")]\n"}, {"id": 123, "title": "Постройте логику кэширования по паттерну Cache-Aside", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте логику кэширования по паттерну Cache-Aside.</p>", "initialCode": "import json\ndef get_user_cached(user_id: int):\n    pass", "solution": "# Постройте логику кэширования по паттерну Cache-Aside\nimport json\n\ndef get_user_cached(user_id: int):\n    cache_key = f\"user:{user_id}\"\n    cached = r.get(cache_key)\n    if cached:\n        return json.loads(cached)\n    user = db_query_user(user_id)  # из БД\n    r.setex(cache_key, 300, json.dumps(user))\n    return user", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"get_user_cached\" in globals() and callable(get_user_cached), \"Функция get_user_cached() должна быть определена\"\n_fn_nodes_get_user_cached = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"get_user_cached\"]\nassert _fn_nodes_get_user_cached and not (len(_fn_nodes_get_user_cached[0].body) == 1 and isinstance(_fn_nodes_get_user_cached[0].body[0], _ast.Pass)), \"Реализуйте тело функции get_user_cached() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Постройте логику кэширования по паттерну Cache-Aside\nimport json\n\ndef get_user_cached(user_id: int):\n    cache_key = f\"user:{user_id}\"\n    cached = r.get(cache_key)\n    if cached:\n        return json.loads(cached)\n    user = db_query_user(user_id)  # из БД\n    r.setex(cache_key, 300, json.dumps(user))\n    return user"}, {"id": 124, "title": "Решите задачу о размене монет (Coin Change DP)", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Решите задачу о размене монет (Coin Change DP).</p>", "initialCode": "def coin_change(coins: list, amount: int) -> int:\n    pass", "solution": "# Решите задачу о размене монет (Coin Change DP)\ndef coin_change(coins: list, amount: int) -> int:\n    dp = [float('inf')] * (amount + 1)\n    dp[0] = 0\n    for coin in coins:\n        for x in range(coin, amount + 1):\n            dp[x] = min(dp[x], dp[x - coin] + 1)\n    return dp[amount] if dp[amount] != float('inf') else -1", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"coin_change\" in globals() and callable(coin_change), \"Функция coin_change() должна быть определена\"\n_fn_nodes_coin_change = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"coin_change\"]\nassert _fn_nodes_coin_change and not (len(_fn_nodes_coin_change[0].body) == 1 and isinstance(_fn_nodes_coin_change[0].body[0], _ast.Pass)), \"Реализуйте тело функции coin_change() (сейчас там только pass)\"", "code": "# Решите задачу о размене монет (Coin Change DP)\ndef coin_change(coins: list, amount: int) -> int:\n    dp = [float('inf')] * (amount + 1)\n    dp[0] = 0\n    for coin in coins:\n        for x in range(coin, amount + 1):\n            dp[x] = min(dp[x], dp[x - coin] + 1)\n    return dp[amount] if dp[amount] != float('inf') else -1"}, {"id": 125, "title": "Реализуйте слияние K отсортированных списков через min-heap", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте слияние K отсортированных списков через min-heap.</p>", "initialCode": "import heapq\ndef merge_k_sorted_lists(lists: list) -> list:\n    pass", "solution": "# Реализуйте слияние K отсортированных списков через min-heap\nimport heapq\n\ndef merge_k_sorted_lists(lists: list) -> list:\n    heap = []\n    for i, l in enumerate(lists):\n        if l:\n            heapq.heappush(heap, (l[0], i, 0))\n    result = []\n    while heap:\n        val, list_idx, elem_idx = heapq.heappop(heap)\n        result.append(val)\n        if elem_idx + 1 < len(lists[list_idx]):\n            next_val = lists[list_idx][elem_idx + 1]\n            heapq.heappush(heap, (next_val, list_idx, elem_idx + 1))\n    return result", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"merge_k_sorted_lists\" in globals() and callable(merge_k_sorted_lists), \"Функция merge_k_sorted_lists() должна быть определена\"\n_fn_nodes_merge_k_sorted_lists = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"merge_k_sorted_lists\"]\nassert _fn_nodes_merge_k_sorted_lists and not (len(_fn_nodes_merge_k_sorted_lists[0].body) == 1 and isinstance(_fn_nodes_merge_k_sorted_lists[0].body[0], _ast.Pass)), \"Реализуйте тело функции merge_k_sorted_lists() (сейчас там только pass)\"", "code": "# Реализуйте слияние K отсортированных списков через min-heap\nimport heapq\n\ndef merge_k_sorted_lists(lists: list) -> list:\n    heap = []\n    for i, l in enumerate(lists):\n        if l:\n            heapq.heappush(heap, (l[0], i, 0))\n    result = []\n    while heap:\n        val, list_idx, elem_idx = heapq.heappop(heap)\n        result.append(val)\n        if elem_idx + 1 < len(lists[list_idx]):\n            next_val = lists[list_idx][elem_idx + 1]\n            heapq.heappush(heap, (next_val, list_idx, elem_idx + 1))\n    return result"}, {"id": 126, "title": "Добавьте ограничение CHECK для проверки возраста >= 18", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Добавьте ограничение CHECK для проверки возраста &gt;= 18.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Добавьте ограничение CHECK для проверки возраста >= 18\nsql = \"\"\"\nALTER TABLE users \nADD CONSTRAINT check_adult_age CHECK (age >= 18);\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"ALTER\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'ALTER'\"\nassert isinstance(sql, str) and \"TABLE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'TABLE'\"\nassert isinstance(sql, str) and \"users\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'users'\"", "code": "# Добавьте ограничение CHECK для проверки возраста >= 18\nsql = \"\"\"\nALTER TABLE users \nADD CONSTRAINT check_adult_age CHECK (age >= 18);\n\"\"\""}, {"id": 127, "title": "Постройте сервис аутентификации на базе абстрактного TokenProvider", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте сервис аутентификации на базе абстрактного TokenProvider.</p>", "initialCode": "from abc import ABC, abstractmethod\nclass TokenProvider(ABC):\n\n    @abstractmethod\n    def generate_token(self, user_id: str) -> str:\n        pass\nclass JWTProvider(TokenProvider):\n\n    def generate_token(self, user_id: str) -> str:\n        pass\nclass AuthService:\n\n    def __init__(self, token_provider: TokenProvider):\n        pass\n\n    def authenticate(self, user_id: str):\n        pass", "solution": "# Постройте сервис аутентификации на базе абстрактного TokenProvider\nfrom abc import ABC, abstractmethod\n\nclass TokenProvider(ABC):\n    @abstractmethod\n    def generate_token(self, user_id: str) -> str: pass\n\nclass JWTProvider(TokenProvider):\n    def generate_token(self, user_id: str) -> str:\n        return f\"header.payload.{user_id}.signature\"\n\nclass AuthService:\n    def __init__(self, token_provider: TokenProvider):\n        self.tokens = token_provider\n\n    def authenticate(self, user_id: str):\n        return self.tokens.generate_token(user_id)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"TokenProvider\" in globals() and isinstance(TokenProvider, type), \"Класс TokenProvider должен быть определён\"\n_cl_def_TokenProvider = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TokenProvider\"]\nassert _cl_def_TokenProvider and not (len(_cl_def_TokenProvider[0].body) == 1 and isinstance(_cl_def_TokenProvider[0].body[0], _ast.Pass)), \"Реализуйте тело класса TokenProvider (сейчас там только pass)\"\nassert hasattr(TokenProvider, \"generate_token\"), \"В классе TokenProvider должен быть метод/свойство generate_token\"\nassert \"JWTProvider\" in globals() and isinstance(JWTProvider, type), \"Класс JWTProvider должен быть определён\"\n_cl_def_JWTProvider = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"JWTProvider\"]\nassert _cl_def_JWTProvider and not (len(_cl_def_JWTProvider[0].body) == 1 and isinstance(_cl_def_JWTProvider[0].body[0], _ast.Pass)), \"Реализуйте тело класса JWTProvider (сейчас там только pass)\"\nassert hasattr(JWTProvider, \"generate_token\"), \"В классе JWTProvider должен быть метод/свойство generate_token\"\n_cl_nodes_JWTProvider_generate_token = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"JWTProvider\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"generate_token\"]\nassert _cl_nodes_JWTProvider_generate_token and not (len(_cl_nodes_JWTProvider_generate_token[0].body) == 1 and isinstance(_cl_nodes_JWTProvider_generate_token[0].body[0], _ast.Pass)), \"Реализуйте метод JWTProvider.generate_token()\"\nassert \"AuthService\" in globals() and isinstance(AuthService, type), \"Класс AuthService должен быть определён\"\n_cl_def_AuthService = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"AuthService\"]\nassert _cl_def_AuthService and not (len(_cl_def_AuthService[0].body) == 1 and isinstance(_cl_def_AuthService[0].body[0], _ast.Pass)), \"Реализуйте тело класса AuthService (сейчас там только pass)\"\nassert hasattr(AuthService, \"__init__\"), \"В классе AuthService должен быть метод/свойство __init__\"\n_cl_nodes_AuthService___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"AuthService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_AuthService___init__ and not (len(_cl_nodes_AuthService___init__[0].body) == 1 and isinstance(_cl_nodes_AuthService___init__[0].body[0], _ast.Pass)), \"Реализуйте метод AuthService.__init__()\"\nassert hasattr(AuthService, \"authenticate\"), \"В классе AuthService должен быть метод/свойство authenticate\"\n_cl_nodes_AuthService_authenticate = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"AuthService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"authenticate\"]\nassert _cl_nodes_AuthService_authenticate and not (len(_cl_nodes_AuthService_authenticate[0].body) == 1 and isinstance(_cl_nodes_AuthService_authenticate[0].body[0], _ast.Pass)), \"Реализуйте метод AuthService.authenticate()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Постройте сервис аутентификации на базе абстрактного TokenProvider\nfrom abc import ABC, abstractmethod\n\nclass TokenProvider(ABC):\n    @abstractmethod\n    def generate_token(self, user_id: str) -> str: pass\n\nclass JWTProvider(TokenProvider):\n    def generate_token(self, user_id: str) -> str:\n        return f\"header.payload.{user_id}.signature\"\n\nclass AuthService:\n    def __init__(self, token_provider: TokenProvider):\n        self.tokens = token_provider\n\n    def authenticate(self, user_id: str):\n        return self.tokens.generate_token(user_id)"}, {"id": 128, "title": "Найдите количество компонент связности в графе", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Найдите количество компонент связности в графе.</p>", "initialCode": "def count_components(n: int, edges: list) -> int:\n    pass", "solution": "# Найдите количество компонент связности в графе\ndef count_components(n: int, edges: list) -> int:\n    adj = {i: [] for i in range(n)}\n    for u, v in edges:\n        adj[u].append(v)\n        adj[v].append(u)\n    visited = set()\n    count = 0\n    for i in range(n):\n        if i not in visited:\n            count += 1\n            stack = [i]\n            visited.add(i)\n            while stack:\n                curr = stack.pop()\n                for neighbor in adj[curr]:\n                    if neighbor not in visited:\n                        visited.add(neighbor)\n                        stack.append(neighbor)\n    return count", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"count_components\" in globals() and callable(count_components), \"Функция count_components() должна быть определена\"\n_fn_nodes_count_components = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"count_components\"]\nassert _fn_nodes_count_components and not (len(_fn_nodes_count_components[0].body) == 1 and isinstance(_fn_nodes_count_components[0].body[0], _ast.Pass)), \"Реализуйте тело функции count_components() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Найдите количество компонент связности в графе\ndef count_components(n: int, edges: list) -> int:\n    adj = {i: [] for i in range(n)}\n    for u, v in edges:\n        adj[u].append(v)\n        adj[v].append(u)\n    visited = set()\n    count = 0\n    for i in range(n):\n        if i not in visited:\n            count += 1\n            stack = [i]\n            visited.add(i)\n            while stack:\n                curr = stack.pop()\n                for neighbor in adj[curr]:\n                    if neighbor not in visited:\n                        visited.add(neighbor)\n                        stack.append(neighbor)\n    return count"}, {"id": 129, "title": "Отфильтруйте группы через HAVING COUNT(orders) > 5", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Отфильтруйте группы через HAVING COUNT(orders) &gt; 5.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Отфильтруйте группы через HAVING COUNT(orders) > 5\nsql = \"\"\"\nSELECT user_id, COUNT(id) AS order_count, SUM(total_amount) AS total_spent\nFROM orders\nGROUP BY user_id\nHAVING COUNT(id) > 5\nORDER BY order_count DESC;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"user_id\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'user_id'\"\nassert isinstance(sql, str) and \"COUNT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'COUNT'\"", "code": "# Отфильтруйте группы через HAVING COUNT(orders) > 5\nsql = \"\"\"\nSELECT user_id, COUNT(id) AS order_count, SUM(total_amount) AS total_spent\nFROM orders\nGROUP BY user_id\nHAVING COUNT(id) > 5\nORDER BY order_count DESC;\n\"\"\""}, {"id": 130, "title": "Рассчитайте разницу между датами через LAG и LEAD", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Рассчитайте разницу между датами через LAG и LEAD.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Рассчитайте разницу между датами через LAG и LEAD\nsql = \"\"\"\nSELECT \n    user_id, created_at,\n    LAG(created_at) OVER(PARTITION BY user_id ORDER BY created_at) AS prev_order_date,\n    created_at - LAG(created_at) OVER(PARTITION BY user_id ORDER BY created_at) AS days_between\nFROM orders;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"user_id\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'user_id'\"\nassert isinstance(sql, str) and \"created_at\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'created_at'\"", "code": "# Рассчитайте разницу между датами через LAG и LEAD\nsql = \"\"\"\nSELECT \n    user_id, created_at,\n    LAG(created_at) OVER(PARTITION BY user_id ORDER BY created_at) AS prev_order_date,\n    created_at - LAG(created_at) OVER(PARTITION BY user_id ORDER BY created_at) AS days_between\nFROM orders;\n\"\"\""}, {"id": 131, "title": "Настройте Healthcheck для базы данных в Docker Compose", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Настройте Healthcheck для базы данных в Docker Compose.</p>", "initialCode": "compose_healthcheck = None", "solution": "# Настройте Healthcheck для базы данных в Docker Compose\ncompose_healthcheck = \"\"\"\npostgres:\n  image: postgres:16-alpine\n  healthcheck:\n    test: [\"CMD-SHELL\", \"pg_isready -U user -d app_db\"]\n    interval: 5s\n    timeout: 5s\n    retries:
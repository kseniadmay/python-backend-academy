ss)), \"Реализуйте метод ReportStorage.save_to_file()\"", "code": "# Разделите генерацию отчета и его сохранение в файл\nclass ReportGenerator:\n    def generate_csv(self, data: list) -> str:\n        return \"\\n\".join([\",\".join(map(str, row)) for row in data])\n\nclass ReportStorage:\n    def save_to_file(self, content: str, filename: str):\n        with open(filename, 'w', encoding='utf-8') as f:\n            f.write(content)"}, {"id": 36, "title": "Реализация базового класса узла ListNode", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализация базового класса узла ListNode.</p>", "initialCode": "class ListNode:\n\n    def __init__(self, val=0, next=None):\n        pass\n\n    def __repr__(self):\n        pass", "solution": "# Реализация базового класса узла ListNode\nclass ListNode:\n    def __init__(self, val=0, next=None):\n        self.val = val\n        self.next = next\n\n    def __repr__(self):\n        return f\"{self.val} -> {self.next}\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"ListNode\" in globals() and isinstance(ListNode, type), \"Класс ListNode должен быть определён\"\n_cl_def_ListNode = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ListNode\"]\nassert _cl_def_ListNode and not (len(_cl_def_ListNode[0].body) == 1 and isinstance(_cl_def_ListNode[0].body[0], _ast.Pass)), \"Реализуйте тело класса ListNode (сейчас там только pass)\"\nassert hasattr(ListNode, \"__init__\"), \"В классе ListNode должен быть метод/свойство __init__\"\n_cl_nodes_ListNode___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ListNode\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_ListNode___init__ and not (len(_cl_nodes_ListNode___init__[0].body) == 1 and isinstance(_cl_nodes_ListNode___init__[0].body[0], _ast.Pass)), \"Реализуйте метод ListNode.__init__()\"\nassert hasattr(ListNode, \"__repr__\"), \"В классе ListNode должен быть метод/свойство __repr__\"\n_cl_nodes_ListNode___repr__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ListNode\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__repr__\"]\nassert _cl_nodes_ListNode___repr__ and not (len(_cl_nodes_ListNode___repr__[0].body) == 1 and isinstance(_cl_nodes_ListNode___repr__[0].body[0], _ast.Pass)), \"Реализуйте метод ListNode.__repr__()\"\n_ln = ListNode(5); assert _ln.val == 5", "code": "# Реализация базового класса узла ListNode\nclass ListNode:\n    def __init__(self, val=0, next=None):\n        self.val = val\n        self.next = next\n\n    def __repr__(self):\n        return f\"{self.val} -> {self.next}\""}, {"id": 37, "title": "Создайте структуру доменного события UserRegisteredEvent", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте структуру доменного события UserRegisteredEvent.</p>", "initialCode": "from dataclasses import dataclass\nfrom datetime import datetime\nimport uuid\n@dataclass(frozen=True)\nclass UserRegisteredEvent:\n    pass", "solution": "# Создайте структуру доменного события UserRegisteredEvent\nfrom dataclasses import dataclass\nfrom datetime import datetime\nimport uuid\n\n@dataclass(frozen=True)\nclass UserRegisteredEvent:\n    user_id: int\n    email: str\n    occurred_at: datetime = datetime.utcnow()\n    event_id: str = str(uuid.uuid4())", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"UserRegisteredEvent\" in globals() and isinstance(UserRegisteredEvent, type), \"Класс UserRegisteredEvent должен быть определён\"\n_cl_def_UserRegisteredEvent = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UserRegisteredEvent\"]\nassert _cl_def_UserRegisteredEvent and not (len(_cl_def_UserRegisteredEvent[0].body) == 1 and isinstance(_cl_def_UserRegisteredEvent[0].body[0], _ast.Pass)), \"Реализуйте тело класса UserRegisteredEvent (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Создайте структуру доменного события UserRegisteredEvent\nfrom dataclasses import dataclass\nfrom datetime import datetime\nimport uuid\n\n@dataclass(frozen=True)\nclass UserRegisteredEvent:\n    user_id: int\n    email: str\n    occurred_at: datetime = datetime.utcnow()\n    event_id: str = str(uuid.uuid4())"}, {"id": 38, "title": "Создайте простой декоратор-логгер вызова", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте простой декоратор-логгер вызова.</p>", "initialCode": "from functools import wraps\ndef log_call(func):\n    pass", "solution": "# Создайте простой декоратор-логгер вызова\nfrom functools import wraps\n\ndef log_call(func):\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        print(f\"Вызов функции: {func.__name__} c args={args}, kwargs={kwargs}\")\n        result = func(*args, **kwargs)\n        print(f\"Функция {func.__name__} вернула: {result}\")\n        return result\n    return wrapper", "hint": "Шаг 1: Определи функцию-декоратор, принимающую func. Шаг 2: Внутри объяви wrapper(*args, **kwargs), вызови func и верни результат. Шаг 3: Верни wrapper.", "tests": "import ast as _ast\nassert \"log_call\" in globals() and callable(log_call), \"Функция log_call() должна быть определена\"\n_fn_nodes_log_call = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"log_call\"]\nassert _fn_nodes_log_call and not (len(_fn_nodes_log_call[0].body) == 1 and isinstance(_fn_nodes_log_call[0].body[0], _ast.Pass)), \"Реализуйте тело функции log_call() (сейчас там только pass)\"\n@log_call\ndef _add(a, b): return a + b\nassert _add(2, 3) == 5", "code": "# Создайте простой декоратор-логгер вызова\nfrom functools import wraps\n\ndef log_call(func):\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        print(f\"Вызов функции: {func.__name__} c args={args}, kwargs={kwargs}\")\n        result = func(*args, **kwargs)\n        print(f\"Функция {func.__name__} вернула: {result}\")\n        return result\n    return wrapper"}, {"id": 39, "title": "Получите подстроку по отрицательным индексам", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Получите подстроку по отрицательным индексам.</p>", "initialCode": "s = 'Python Backend Developer'\nsub = None", "solution": "# Получите подстроку по отрицательным индексам\ns = \"Python Backend Developer\"\n# Получаем последние 9 символов (\"Developer\")\nsub = s[-9:]\nprint(sub)", "hint": "Синтаксис создания индекса: CREATE INDEX idx_name ON table_name USING btree (column_name);", "tests": "import ast as _ast\nassert \"s\" in globals() and s is not None, \"Переменная s должна быть определена и не равна None\"\nassert isinstance(s, str) and \"Python\".lower() in s.lower(), \"Строка s должна содержать ключевой элемент 'Python'\"\nassert isinstance(s, str) and \"Backend\".lower() in s.lower(), \"Строка s должна содержать ключевой элемент 'Backend'\"\nassert isinstance(s, str) and \"Developer\".lower() in s.lower(), \"Строка s должна содержать ключевой элемент 'Developer'\"\nassert \"sub\" in globals() and sub is not None, \"Переменная sub должна быть определена и не равна None\"\nassert sub != \"__TODO__\", \"Заполните значение переменной sub\"", "code": "# Получите подстроку по отрицательным индексам\ns = \"Python Backend Developer\"\n# Получаем последние 9 символов (\"Developer\")\nsub = s[-9:]\nprint(sub)"}, {"id": 40, "title": "Напишите потокобезопасный Singleton через threading.Lock", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите потокобезопасный Singleton через threading.Lock.</p>", "initialCode": "import threading\nclass ThreadSafeSingleton:\n    _instance = None\n    _lock = threading.Lock()\n\n    def __new__(cls, *args, **kwargs):\n        pass", "solution": "# Напишите потокобезопасный Singleton через threading.Lock\nimport threading\n\nclass ThreadSafeSingleton:\n    _instance = None\n    _lock = threading.Lock()\n\n    def __new__(cls, *args, **kwargs):\n        if not cls._instance:\n            with cls._lock:\n                if not cls._instance:\n                    cls._instance = super().__new__(cls)\n        return cls._instance", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"ThreadSafeSingleton\" in globals() and isinstance(ThreadSafeSingleton, type), \"Класс ThreadSafeSingleton должен быть определён\"\n_cl_def_ThreadSafeSingleton = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ThreadSafeSingleton\"]\nassert _cl_def_ThreadSafeSingleton and not (len(_cl_def_ThreadSafeSingleton[0].body) == 1 and isinstance(_cl_def_ThreadSafeSingleton[0].body[0], _ast.Pass)), \"Реализуйте тело класса ThreadSafeSingleton (сейчас там только pass)\"\nassert hasattr(ThreadSafeSingleton, \"__new__\"), \"В классе ThreadSafeSingleton должен быть метод/свойство __new__\"\n_cl_nodes_ThreadSafeSingleton___new__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ThreadSafeSingleton\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__new__\"]\nassert _cl_nodes_ThreadSafeSingleton___new__ and not (len(_cl_nodes_ThreadSafeSingleton___new__[0].body) == 1 and isinstance(_cl_nodes_ThreadSafeSingleton___new__[0].body[0], _ast.Pass)), \"Реализуйте метод ThreadSafeSingleton.__new__()\"\nassert ThreadSafeSingleton() is ThreadSafeSingleton()", "code": "# Напишите потокобезопасный Singleton через threading.Lock\nimport threading\n\nclass ThreadSafeSingleton:\n    _instance = None\n    _lock = threading.Lock()\n\n    def __new__(cls, *args, **kwargs):\n        if not cls._instance:\n            with cls._lock:\n                if not cls._instance:\n                    cls._instance = super().__new__(cls)\n        return cls._instance"}, {"id": 41, "title": "Создайте фасад для упрощения вызовов микросервисов", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте фасад для упрощения вызовов микросервисов.</p>", "initialCode": "class MicroserviceFacade:\n\n    def __init__(self, auth_client, bill_client, notify_client):\n        pass\n\n    def checkout(self, user_id: str, amount: float):\n        pass", "solution": "# Создайте фасад для упрощения вызовов микросервисов\nclass MicroserviceFacade:\n    def __init__(self, auth_client, bill_client, notify_client):\n        self.auth = auth_client\n        self.bill = bill_client\n        self.notify = notify_client\n\n    def checkout(self, user_id: str, amount: float):\n        self.auth.verify(user_id)\n        tx = self.bill.charge(user_id, amount)\n        self.notify.send_receipt(user_id, tx)\n        return tx", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"MicroserviceFacade\" in globals() and isinstance(MicroserviceFacade, type), \"Класс MicroserviceFacade должен быть определён\"\n_cl_def_MicroserviceFacade = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MicroserviceFacade\"]\nassert _cl_def_MicroserviceFacade and not (len(_cl_def_MicroserviceFacade[0].body) == 1 and isinstance(_cl_def_MicroserviceFacade[0].body[0], _ast.Pass)), \"Реализуйте тело класса MicroserviceFacade (сейчас там только pass)\"\nassert hasattr(MicroserviceFacade, \"__init__\"), \"В классе MicroserviceFacade должен быть метод/свойство __init__\"\n_cl_nodes_MicroserviceFacade___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MicroserviceFacade\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_MicroserviceFacade___init__ and not (len(_cl_nodes_MicroserviceFacade___init__[0].body) == 1 and isinstance(_cl_nodes_MicroserviceFacade___init__[0].body[0], _ast.Pass)), \"Реализуйте метод MicroserviceFacade.__init__()\"\nassert hasattr(MicroserviceFacade, \"checkout\"), \"В классе MicroserviceFacade должен быть метод/свойство checkout\"\n_cl_nodes_MicroserviceFacade_checkout = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MicroserviceFacade\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"checkout\"]\nassert _cl_nodes_MicroserviceFacade_checkout and not (len(_cl_nodes_MicroserviceFacade_checkout[0].body) == 1 and isinstance(_cl_nodes_MicroserviceFacade_checkout[0].body[0], _ast.Pass)), \"Реализуйте метод MicroserviceFacade.checkout()\"", "code": "# Создайте фасад для упрощения вызовов микросервисов\nclass MicroserviceFacade:\n    def __init__(self, auth_client, bill_client, notify_client):\n        self.auth = auth_client\n        self.bill = bill_client\n        self.notify = notify_client\n\n    def checkout(self, user_id: str, amount: float):\n        self.auth.verify(user_id)\n        tx = self.bill.charge(user_id, amount)\n        self.notify.send_receipt(user_id, tx)\n        return tx"}, {"id": 42, "title": "Рассчитайте средний чек и число уникальных покупателей", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите SQL-запрос расчета аналитических метрик в переменной <code>sql</code>.</p><p class='meta'>Из таблицы <code>orders</code> для заказов со статусом <code>'completed'</code> вычислите средний чек <code>ROUND(AVG(total_amount), 2) AS avg_order_value</code> и количество уникальных покупателей <code>COUNT(DISTINCT user_id) AS unique_customers</code>.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Рассчитайте средний чек и число уникальных покупателей\nsql = \"\"\"\nSELECT \n    COUNT(DISTINCT user_id) AS unique_customers,\n    ROUND(AVG(total_amount), 2) AS average_order_value,\n    SUM(total_amount) AS total_revenue\nFROM orders\nWHERE status = 'paid';\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"COUNT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'COUNT'\"\nassert isinstance(sql, str) and \"DISTINCT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'DISTINCT'\"", "code": "# Рассчитайте средний чек и число уникальных покупателей\nsql = \"\"\"\nSELECT \n    COUNT(DISTINCT user_id) AS unique_customers,\n    ROUND(AVG(total_amount), 2) AS average_order_value,\n    SUM(total_amount) AS total_revenue\nFROM orders\nWHERE status = 'paid';\n\"\"\""}, {"id": 43, "title": "Создайте датакласс пользователя с валидацией post_init", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте датакласс пользователя с валидацией post_init.</p>", "initialCode": "from dataclasses import dataclass\nimport re\n@dataclass\nclass User:\n    username: str\n    email: str\n    age: int\n\n    def __post_init__(self):\n        pass", "solution": "# Создайте датакласс пользователя с валидацией post_init\nfrom dataclasses import dataclass\nimport re\n\n@dataclass\nclass User:\n    username: str\n    email: str\n    age: int\n\n    def __post_init__(self):\n        if self.age < 0:\n            raise ValueError(\"Возраст не может быть отрицательным\")\n        if \"@\" not in self.email:\n            raise ValueError(\"Некорректный email адрес\")", "hint": "Импортируй dataclass из модуля dataclasses. Примени декоратор @dataclass к классу и объяви поля с явными аннотациями типов.", "tests": "import ast as _ast\nassert \"User\" in globals() and isinstance(User, type), \"Класс User должен быть определён\"\n_cl_def_User = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"User\"]\nassert _cl_def_User and not (len(_cl_def_User[0].body) == 1 and isinstance(_cl_def_User[0].body[0], _ast.Pass)), \"Реализуйте тело класса User (сейчас там только pass)\"\nassert hasattr(User, \"__post_init__\"), \"В классе User должен быть метод/свойство __post_init__\"\n_cl_nodes_User___post_init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"User\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__post_init__\"]\nassert _cl_nodes_User___post_init__ and not (len(_cl_nodes_User___post_init__[0].body) == 1 and isinstance(_cl_nodes_User___post_init__[0].body[0], _ast.Pass)), \"Реализуйте метод User.__post_init__()\"\n_u = User(\"alex\", \"alex@test.com\", 25); assert _u.username == \"alex\"", "code": "# Создайте датакласс пользователя с валидацией post_init\nfrom dataclasses import dataclass\nimport re\n\n@dataclass\nclass User:\n    username: str\n    email: str\n    age: int\n\n    def __post_init__(self):\n        if self.age < 0:\n            raise ValueError(\"Возраст не может быть отрицательным\")\n        if \"@\" not in self.email:\n            raise ValueError(\"Некорректный email адрес\")"}, {"id": 44, "title": "Создайте модель статьи с ForeignKey на автора и related_name", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте модель статьи с ForeignKey на автора и related_name.</p>", "initialCode": "from django.db import models\nfrom django.contrib.auth import get_user_model\nUser = get_user_model()\nclass Article(models.Model):\n    pass", "solution": "# Создайте модель статьи с ForeignKey на автора и related_name\nfrom django.db import models\nfrom django.contrib.auth import get_user_model\n\nUser = get_user_model()\n\nclass Article(models.Model):\n    title = models.CharField(max_length=255)\n    content = models.TextField()\n    author = models.ForeignKey(User, on_delete=models.CASCADE, related_name=\"articles\")\n    created_at = models.DateTimeField(auto_now_add=True)\n\nu = User(id=1, username=\"alice\")\nart = Article(id=10, title=\"Django ORM Deep Dive\", content=\"...\", author=u)\nprint(f\"Статья: {art.title}, автор: {art.author.username}, related_name: {Article.author.related_name}\")\nassert Article.author.related_name == \"articles\" and art.author.username == \"alice\"\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Article\" in globals() and isinstance(Article, type), \"Класс Article должен быть определён\"\n_cl_def_Article = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Article\"]\nassert _cl_def_Article and not (len(_cl_def_Article[0].body) == 1 and isinstance(_cl_def_Article[0].body[0], _ast.Pass)), \"Реализуйте тело класса Article (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nu = User(id=1, username=\"alice\")\nart = Article(id=10, title=\"Django ORM Deep Dive\", content=\"...\", author=u)\nprint(f\"Статья: {art.title}, автор: {art.author.username}, related_name: {Article.author.related_name}\")\nassert Article.author.related_name == \"articles\" and art.author.username == \"alice\"\nassert \"u\" in globals(), \"Переменная u должна быть вычислена\"\nassert \"art\" in globals(), \"Переменная art должна быть вычислена\"", "code": "# Создайте модель статьи с ForeignKey на автора и related_name\nfrom django.db import models\nfrom django.contrib.auth import get_user_model\n\nUser = get_user_model()\n\nclass Article(models.Model):\n    title = models.CharField(max_length=255)\n    content = models.TextField()\n    author = models.ForeignKey(User, on_delete=models.CASCADE, related_name=\"articles\")\n    created_at = models.DateTimeField(auto_now_add=True)\n\nu = User(id=1, username=\"alice\")\nart = Article(id=10, title=\"Django ORM Deep Dive\", content=\"...\", author=u)\nprint(f\"Статья: {art.title}, автор: {art.author.username}, related_name: {Article.author.related_name}\")\nassert Article.author.related_name == \"articles\" and art.author.username == \"alice\"\n"}, {"id": 45, "title": "Создайте Facade для оформления заказа в один вызов", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте Facade для оформления заказа в один вызов.</p>", "initialCode": "class OrderPlacementFacade:\n\n    def __init__(self, inventory, payment, shipping):\n        pass\n\n    def place_order(self, user_id: int, item_id: int, address: str):\n        pass", "solution": "# Создайте Facade для оформления заказа в один вызов\nclass OrderPlacementFacade:\n    def __init__(self, inventory, payment, shipping):\n        self.inv = inventory\n        self.pay = payment\n        self.ship = shipping\n\n    def place_order(self, user_id: int, item_id: int, address: str):\n        self.inv.reserve(item_id)\n        self.pay.charge(user_id)\n        track_id = self.ship.create_shipment(address, item_id)\n        return {\"status\": \"success\", \"tracking\": track_id}", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"OrderPlacementFacade\" in globals() and isinstance(OrderPlacementFacade, type), \"Класс OrderPlacementFacade должен быть определён\"\n_cl_def_OrderPlacementFacade = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OrderPlacementFacade\"]\nassert _cl_def_OrderPlacementFacade and not (len(_cl_def_OrderPlacementFacade[0].body) == 1 and isinstance(_cl_def_OrderPlacementFacade[0].body[0], _ast.Pass)), \"Реализуйте тело класса OrderPlacementFacade (сейчас там только pass)\"\nassert hasattr(OrderPlacementFacade, \"__init__\"), \"В классе OrderPlacementFacade должен быть метод/свойство __init__\"\n_cl_nodes_OrderPlacementFacade___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OrderPlacementFacade\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_OrderPlacementFacade___init__ and not (len(_cl_nodes_OrderPlacementFacade___init__[0].body) == 1 and isinstance(_cl_nodes_OrderPlacementFacade___init__[0].body[0], _ast.Pass)), \"Реализуйте метод OrderPlacementFacade.__init__()\"\nassert hasattr(OrderPlacementFacade, \"place_order\"), \"В классе OrderPlacementFacade должен быть метод/свойство place_order\"\n_cl_nodes_OrderPlacementFacade_place_order = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OrderPlacementFacade\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"place_order\"]\nassert _cl_nodes_OrderPlacementFacade_place_order and not (len(_cl_nodes_OrderPlacementFacade_place_order[0].body) == 1 and isinstance(_cl_nodes_OrderPlacementFacade_place_order[0].body[0], _ast.Pass)), \"Реализуйте метод OrderPlacementFacade.place_order()\"", "code": "# Создайте Facade для оформления заказа в один вызов\nclass OrderPlacementFacade:\n    def __init__(self, inventory, payment, shipping):\n        self.inv = inventory\n        self.pay = payment\n        self.ship = shipping\n\n    def place_order(self, user_id: int, item_id: int, address: str):\n        self.inv.reserve(item_id)\n        self.pay.charge(user_id)\n        track_id = self.ship.create_shipment(address, item_id)\n        return {\"status\": \"success\", \"tracking\": track_id}"}, {"id": 46, "title": "Найдите и удалите неиспользуемые индексы в базе", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите системный SQL-запрос в переменной <code>sql</code> для выявления неиспользуемых индексов в базе PostgreSQL.</p><p class='meta'>Используйте представление <code>pg_stat_user_indexes</code>. Выберите <code>schemaname</code>, <code>relname AS table_name</code>, <code>indexrelname AS index_name</code>, <code>idx_scan</code> для индексов, у которых число сканирований <code>idx_scan = 0</code> и имя индекса не оканчивается на первичный ключ (<code>indexrelname NOT LIKE '%_pkey'</code>).</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Найдите и удалите неиспользуемые индексы в базе\nsql = \"\"\"\nSELECT \n    schemaname, tablename, indexrelname, idx_scan, idx_tup_read, idx_tup_fetch\nFROM pg_stat_user_indexes\nWHERE idx_scan = 0 AND indexrelname NOT LIKE '%_pkey'\nORDER BY pg_relation_size(indexrelid) DESC;\n-- DROP INDEX CONCURRENTLY idx_unused_name;\n\"\"\"", "hint": "Синтаксис создания индекса: CREATE INDEX idx_name ON table_name USING btree (column_name);", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"schemaname\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'schemaname'\"\nassert isinstance(sql, str) and \"tablename\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'tablename'\"", "code": "# Найдите и удалите неиспользуемые индексы в базе\nsql = \"\"\"\nSELECT \n    schemaname, tablename, indexrelname, idx_scan, idx_tup_read, idx_tup_fetch\nFROM pg_stat_user_indexes\nWHERE idx_scan = 0 AND indexrelname NOT LIKE '%_pkey'\nORDER BY pg_relation_size(indexrelid) DESC;\n-- DROP INDEX CONCURRENTLY idx_unused_name;\n\"\"\""}, {"id": 47, "title": "Напишите EventEmitter с методами on, emit, off", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите EventEmitter с методами on, emit, off.</p>", "initialCode": "class EventEmitter:\n\n    def __init__(self):\n        pass\n\n    def on(self, event: str, callback):\n        pass\n\n    def off(self, event: str, callback):\n        pass\n\n    def emit(self, event: str, *args, **kwargs):\n        pass", "solution": "# Напишите EventEmitter с методами on, emit, off\nclass EventEmitter:\n    def __init__(self):\n        self._events = {}\n\n    def on(self, event: str, callback):\n        self._events.setdefault(event, []).append(callback)\n\n    def off(self, event: str, callback):\n        if event in self._events:\n            self._events[event] = [cb for cb in self._events[event] if cb != callback]\n\n    def emit(self, event: str, *args, **kwargs):\n        for cb in self._events.get(event, []):\n            cb(*args, **kwargs)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"EventEmitter\" in globals() and isinstance(EventEmitter, type), \"Класс EventEmitter должен быть определён\"\n_cl_def_EventEmitter = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"EventEmitter\"]\nassert _cl_def_EventEmitter and not (len(_cl_def_EventEmitter[0].body) == 1 and isinstance(_cl_def_EventEmitter[0].body[0], _ast.Pass)), \"Реализуйте тело класса EventEmitter (сейчас там только pass)\"\nassert hasattr(EventEmitter, \"__init__\"), \"В классе EventEmitter должен быть метод/свойство __init__\"\n_cl_nodes_EventEmitter___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"EventEmitter\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_EventEmitter___init__ and not (len(_cl_nodes_EventEmitter___init__[0].body) == 1 and isinstance(_cl_nodes_EventEmitter___init__[0].body[0], _ast.Pass)), \"Реализуйте метод EventEmitter.__init__()\"\nassert hasattr(EventEmitter, \"on\"), \"В классе EventEmitter должен быть метод/свойство on\"\n_cl_nodes_EventEmitter_on = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"EventEmitter\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"on\"]\nassert _cl_nodes_EventEmitter_on and not (len(_cl_nodes_EventEmitter_on[0].body) == 1 and isinstance(_cl_nodes_EventEmitter_on[0].body[0], _ast.Pass)), \"Реализуйте метод EventEmitter.on()\"\nassert hasattr(EventEmitter, \"off\"), \"В классе EventEmitter должен быть метод/свойство off\"\n_cl_nodes_EventEmitter_off = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"EventEmitter\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"off\"]\nassert _cl_nodes_EventEmitter_off and not (len(_cl_nodes_EventEmitter_off[0].body) == 1 and isinstance(_cl_nodes_EventEmitter_off[0].body[0], _ast.Pass)), \"Реализуйте метод EventEmitter.off()\"\nassert hasattr(EventEmitter, \"emit\"), \"В классе EventEmitter должен быть метод/свойство emit\"\n_cl_nodes_EventEmitter_emit = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"EventEmitter\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"emit\"]\nassert _cl_nodes_EventEmitter_emit and not (len(_cl_nodes_EventEmitter_emit[0].body) == 1 and isinstance(_cl_nodes_EventEmitter_emit[0].body[0], _ast.Pass)), \"Реализуйте метод EventEmitter.emit()\"\n_em = EventEmitter(); _res = []; _em.on(\"ev\", lambda x: _res.append(x)); _em.emit(\"ev\", 99); assert _res == [99]", "code": "# Напишите EventEmitter с методами on, emit, off\nclass EventEmitter:\n    def __init__(self):\n        self._events = {}\n\n    def on(self, event: str, callback):\n        self._events.setdefault(event, []).append(callback)\n\n    def off(self, event: str, callback):\n        if event in self._events:\n            self._events[event] = [cb for cb in self._events[event] if cb != callback]\n\n    def emit(self, event: str, *args, **kwargs):\n        for cb in self._events.get(event, []):\n            cb(*args, **kwargs)"}, {"id": 48, "title": "Реализуйте проверку сертификата TLS при HTTPS запросе", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте проверку сертификата TLS при HTTPS запросе.</p>", "initialCode": "from datetime import datetime, timezone\ndef verify_tls_cert(cert: dict, hostname: str) -> bool:\n    pass", "solution": "# Реализуйте проверку сертификата TLS при HTTPS запросе\nfrom datetime import datetime, timezone\n\ndef verify_tls_cert(cert: dict, hostname: str) -> bool:\n    # Проверяем совпадение домена (SAN / CN) и срок действия сертификата\n    sans = [val for typ, val in cert.get(\"subjectAltName\", ()) if typ == \"DNS\"]\n    if hostname not in sans and cert.get(\"commonName\") != hostname:\n        raise ValueError(f\"Hostname mismatch: {hostname} not in {sans}\")\n    not_after = datetime.strptime(cert[\"notAfter\"], \"%b %d %H:%M:%S %Y GMT\").replace(tzinfo=timezone.utc)\n    if datetime.now(timezone.utc) >= not_after:\n        raise ValueError(\"Certificate has expired\")\n    return True\n\nsample_cert = {\n    \"commonName\": \"api.example.com\",\n    \"subjectAltName\": ((\"DNS\", \"api.example.com\"), (\"DNS\", \"example.com\")),\n    \"notAfter\": \"Dec 31 23:59:59 2030 GMT\",\n}\nok = verify_tls_cert(sample_cert, \"api.example.com\")\nprint(\"TLS сертификат валиден:\", ok)\nassert ok is True\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"verify_tls_cert\" in globals() and callable(verify_tls_cert), \"Функция verify_tls_cert() должна быть определена\"\n_fn_nodes_verify_tls_cert = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"verify_tls_cert\"]\nassert _fn_nodes_verify_tls_cert and not (len(_fn_nodes_verify_tls_cert[0].body) == 1 and isinstance(_fn_nodes_verify_tls_cert[0].body[0], _ast.Pass)), \"Реализуйте тело функции verify_tls_cert() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nsample_cert = {\n    \"commonName\": \"api.example.com\",\n    \"subjectAltName\": ((\"DNS\", \"api.example.com\"), (\"DNS\", \"example.com\")),\n    \"notAfter\": \"Dec 31 23:59:59 2030 GMT\",\n}\nok = verify_tls_cert(sample_cert, \"api.example.com\")\nprint(\"TLS сертификат валиден:\", ok)\nassert ok is True\nassert \"sample_cert\" in globals(), \"Переменная sample_cert должна быть вычислена\"\nassert \"ok\" in globals(), \"Переменная ok должна быть вычислена\"", "code": "# Реализуйте проверку сертификата TLS при HTTPS запросе\nfrom datetime import datetime, timezone\n\ndef verify_tls_cert(cert: dict, hostname: str) -> bool:\n    # Проверяем совпадение домена (SAN / CN) и срок действия сертификата\n    sans = [val for typ, val in cert.get(\"subjectAltName\", ()) if typ == \"DNS\"]\n    if hostname not in sans and cert.get(\"commonName\") != hostname:\n        raise ValueError(f\"Hostname mismatch: {hostname} not in {sans}\")\n    not_after = datetime.strptime(cert[\"notAfter\"], \"%b %d %H:%M:%S %Y GMT\").replace(tzinfo=timezone.utc)\n    if datetime.now(timezone.utc) >= not_after:\n        raise ValueError(\"Certificate has expired\")\n    return True\n\nsample_cert = {\n    \"commonName\": \"api.example.com\",\n    \"subjectAltName\": ((\"DNS\", \"api.example.com\"), (\"DNS\", \"example.com\")),\n    \"notAfter\": \"Dec 31 23:59:59 2030 GMT\",\n}\nok = verify_tls_cert(sample_cert, \"api.example.com\")\nprint(\"TLS сертификат валиден:\", ok)\nassert ok is True\n"}, {"id": 49, "title": "Устраните дублирование бизнес-логики по правилу DRY", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Устраните дублирование бизнес-логики по правилу DRY.</p>", "initialCode": "def apply_discount(base_price: float, discount_percent: float, min_price: float=0.0) -> float:\n    pass", "solution": "# Устраните дублирование бизнес-логики по правилу DRY\ndef apply_discount(base_price: float, discount_percent: float, min_price: float = 0.0) -> float:\n    discounted = base_price * (1 - discount_percent / 100.0)\n    return max(min_price, round(discounted, 2))", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"apply_discount\" in globals() and callable(apply_discount), \"Функция apply_discount() должна быть определена\"\n_fn_nodes_apply_discount = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"apply_discount\"]\nassert _fn_nodes_apply_discount and not (len(_fn_nodes_apply_discount[0].body) == 1 and isinstance(_fn_nodes_apply_discount[0].body[0], _ast.Pass)), \"Реализуйте тело функции apply_discount() (сейчас там только pass)\"\nassert apply_discount(100.0, 15.0) == 85.0", "code": "# Устраните дублирование бизнес-логики по правилу DRY\ndef apply_discount(base_price: float, discount_percent: float, min_price: float = 0.0) -> float:\n    discounted = base_price * (1 - discount_percent / 100.0)\n    return max(min_price, round(discounted, 2))"}, {"id": 50, "title": "Сгенерируйте криптостойкий токен сессии через secrets", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Сгенерируйте криптостойкий токен сессии через secrets.</p>", "initialCode": "import secrets\ndef generate_session_token(nbytes: int=32) -> str:\n    pass", "solution": "# Сгенерируйте криптостойкий токен сессии через secrets\nimport secrets\n\ndef generate_session_token(nbytes: int = 32) -> str:\n    # Возвращает криптостойкий URL-safe токен\n    return secrets.token_urlsafe(nbytes)\n\ntok1 = generate_session_token(32)\ntok2 = generate_session_token(32)\nprint(\"Token sample:\", tok1[:16] + \"...\", \"len:\", len(tok1))\nassert len(tok1) >= 40 and tok1 != tok2\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"generate_session_token\" in globals() and callable(generate_session_token), \"Функция generate_session_token() должна быть определена\"\n_fn_nodes_generate_session_token = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"generate_session_token\"]\nassert _fn_nodes_generate_session_token and not (len(_fn_nodes_generate_session_token[0].body) == 1 and isinstance(_fn_nodes_generate_session_token[0].body[0], _ast.Pass)), \"Реализуйте тело функции generate_session_token() (сейчас там только pass)\"\ntok1 = generate_session_token(32)\ntok2 = generate_session_token(32)\nprint(\"Token sample:\", tok1[:16] + \"...\", \"len:\", len(tok1))\nassert len(tok1) >= 40 and tok1 != tok2\nassert \"tok1\" in globals(), \"Переменная tok1 должна быть вычислена\"\nassert \"tok2\" in globals(), \"Переменная tok2 должна быть вычислена\"", "code": "# Сгенерируйте криптостойкий токен сессии через secrets\nimport secrets\n\ndef generate_session_token(nbytes: int = 32) -> str:\n    # Возвращает криптостойкий URL-safe токен\n    return secrets.token_urlsafe(nbytes)\n\ntok1 = generate_session_token(32)\ntok2 = generate_session_token(32)\nprint(\"Token sample:\", tok1[:16] + \"...\", \"len:\", len(tok1))\nassert len(tok1) >= 40 and tok1 != tok2\n"}, {"id": 51, "title": "Используйте Savepoints для частичного отката операций", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите последовательность команд транзакции с точкой сохранения в переменной <code>sql</code>.</p><p class='meta'>Начните транзакцию <code>BEGIN;</code>, создайте точку сохранения <code>SAVEPOINT sp1;</code>, выполните частичный откат <code>ROLLBACK TO SAVEPOINT sp1;</code> и завершите транзакцию <code>COMMIT;</code>.</p>", "initialCode": "sql = \"\"\"\n\
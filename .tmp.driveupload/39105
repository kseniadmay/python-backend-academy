item[0].body) == 1 and isinstance(_cl_nodes_Order_add_item[0].body[0], _ast.Pass)), \"Реализуйте метод Order.add_item()\"\nassert hasattr(Order, \"total\"), \"В классе Order должен быть метод/свойство total\"\n_cl_nodes_Order_total = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Order\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"total\"]\nassert _cl_nodes_Order_total and not (len(_cl_nodes_Order_total[0].body) == 1 and isinstance(_cl_nodes_Order_total[0].body[0], _ast.Pass)), \"Реализуйте метод Order.total()\"\nassert hasattr(Order, \"submit\"), \"В классе Order должен быть метод/свойство submit\"\n_cl_nodes_Order_submit = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Order\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"submit\"]\nassert _cl_nodes_Order_submit and not (len(_cl_nodes_Order_submit[0].body) == 1 and isinstance(_cl_nodes_Order_submit[0].body[0], _ast.Pass)), \"Реализуйте метод Order.submit()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\norder = Order(1)\norder.add_item(\"book\", 2, 15)\norder.submit()\nprint(order.total(), order.status)\nassert \"order\" in globals(), \"Переменная order должна быть вычислена\"", "code": "# Постройте Aggregate Order с товарами и бизнес-инвариантами\nclass OrderItem:\n    def __init__(self, product_id, quantity, price):\n        self.product_id = product_id\n        self.quantity = quantity\n        self.price = price\n\n\nclass Order:  # Aggregate Root\n    def __init__(self, order_id):\n        self.id = order_id\n        self._items = []\n        self.status = \"draft\"\n\n    def add_item(self, product_id, quantity, price):\n        if self.status != \"draft\":\n            raise ValueError(\"Нельзя добавить товар в оформленный заказ\")\n        self._items.append(OrderItem(product_id, quantity, price))\n\n    def total(self):\n        return sum(item.price * item.quantity for item in self._items)\n\n    def submit(self):\n        if not self._items:\n            raise ValueError(\"Нельзя оформить пустой заказ\")\n        self.status = \"submitted\"\n\n\norder = Order(1)\norder.add_item(\"book\", 2, 15)\norder.submit()\nprint(order.total(), order.status)   # 30 submitted"}, {"id": 277, "title": "Напишите WebSocket-эндпоинт эхо-чата на FastAPI", "level": 5, "tier": "🦅 Уровень 5", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Напишите WebSocket-эндпоинт эхо-чата на FastAPI.</p>", "initialCode": "import asyncio\nfrom fastapi import FastAPI, WebSocket, WebSocketDisconnect\napp = FastAPI()\n@app.websocket('/ws/chat')\nasync def chat_endpoint(websocket: WebSocket):\n    pass\nasync def main():\n    pass", "solution": "# Напишите WebSocket-эндпоинт эхо-чата на FastAPI\nimport asyncio\nfrom fastapi import FastAPI, WebSocket, WebSocketDisconnect\n\napp = FastAPI()\n\n@app.websocket(\"/ws/chat\")\nasync def chat_endpoint(websocket: WebSocket):\n    await websocket.accept()\n    try:\n        while True:\n            message = await websocket.receive_text()\n            await websocket.send_text(f\"Эхо: {message}\")\n    except WebSocketDisconnect:\n        print(\"Клиент корректно отключился\")\n\nasync def main():\n    ws = WebSocket(incoming=[\"Привет\", \"Как дела?\"])\n    await chat_endpoint(ws)\n    print(\"Отправленные сообщения:\", ws.sent)\n    assert ws.accepted is True and ws.sent == [\"Эхо: Привет\", \"Эхо: Как дела?\"]\n\nasyncio.run(main())\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"chat_endpoint\" in globals() and callable(chat_endpoint), \"Функция chat_endpoint() должна быть определена\"\n_fn_nodes_chat_endpoint = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"chat_endpoint\"]\nassert _fn_nodes_chat_endpoint and not (len(_fn_nodes_chat_endpoint[0].body) == 1 and isinstance(_fn_nodes_chat_endpoint[0].body[0], _ast.Pass)), \"Реализуйте тело функции chat_endpoint() (сейчас там только pass)\"\nassert \"main\" in globals() and callable(main), \"Функция main() должна быть определена\"\n_fn_nodes_main = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"main\"]\nassert _fn_nodes_main and not (len(_fn_nodes_main[0].body) == 1 and isinstance(_fn_nodes_main[0].body[0], _ast.Pass)), \"Реализуйте тело функции main() (сейчас там только pass)\"\nasyncio.run(main())", "code": "# Напишите WebSocket-эндпоинт эхо-чата на FastAPI\nimport asyncio\nfrom fastapi import FastAPI, WebSocket, WebSocketDisconnect\n\napp = FastAPI()\n\n@app.websocket(\"/ws/chat\")\nasync def chat_endpoint(websocket: WebSocket):\n    await websocket.accept()\n    try:\n        while True:\n            message = await websocket.receive_text()\n            await websocket.send_text(f\"Эхо: {message}\")\n    except WebSocketDisconnect:\n        print(\"Клиент корректно отключился\")\n\nasync def main():\n    ws = WebSocket(incoming=[\"Привет\", \"Как дела?\"])\n    await chat_endpoint(ws)\n    print(\"Отправленные сообщения:\", ws.sent)\n    assert ws.accepted is True and ws.sent == [\"Эхо: Привет\", \"Эхо: Как дела?\"]\n\nasyncio.run(main())\n"}, {"id": 278, "title": "Реализуйте LRU-подобный broadcast чат с хранением активных WebSocket-соединений", "level": 6, "tier": "🦁 Уровень 6", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте LRU-подобный broadcast чат с хранением активных WebSocket-соединений.</p>", "initialCode": "import asyncio\nfrom fastapi import FastAPI, WebSocket, WebSocketDisconnect\napp = FastAPI()\nconnected_clients: list[WebSocket] = []\n@app.websocket('/ws/broadcast')\nasync def broadcast_endpoint(websocket: WebSocket):\n    pass\nasync def main():\n    pass", "solution": "# Реализуйте broadcast чат с хранением активных WebSocket-соединений\nimport asyncio\nfrom fastapi import FastAPI, WebSocket, WebSocketDisconnect\n\napp = FastAPI()\nconnected_clients: list[WebSocket] = []\n\n@app.websocket(\"/ws/broadcast\")\nasync def broadcast_endpoint(websocket: WebSocket):\n    await websocket.accept()\n    connected_clients.append(websocket)\n    try:\n        while True:\n            message = await websocket.receive_text()\n            for client in list(connected_clients):\n                await client.send_text(message)\n    except WebSocketDisconnect:\n        connected_clients.remove(websocket)\n\nasync def main():\n    peer = WebSocket(incoming=[])\n    await peer.accept()\n    connected_clients.append(peer)\n\n    sender = WebSocket(incoming=[\"Всем привет!\"])\n    await broadcast_endpoint(sender)\n    print(\"Получено пиром:\", peer.sent, \"| Осталось активных:\", len(connected_clients))\n    assert peer.sent == [\"Всем привет!\"] and sender not in connected_clients\n\nasyncio.run(main())\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"broadcast_endpoint\" in globals() and callable(broadcast_endpoint), \"Функция broadcast_endpoint() должна быть определена\"\n_fn_nodes_broadcast_endpoint = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"broadcast_endpoint\"]\nassert _fn_nodes_broadcast_endpoint and not (len(_fn_nodes_broadcast_endpoint[0].body) == 1 and isinstance(_fn_nodes_broadcast_endpoint[0].body[0], _ast.Pass)), \"Реализуйте тело функции broadcast_endpoint() (сейчас там только pass)\"\nassert 
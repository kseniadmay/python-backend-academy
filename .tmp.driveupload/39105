_[0].body[0], _ast.Pass)), \"Реализуйте метод Field.__get__()\"\nassert hasattr(Field, \"__set__\"), \"В классе Field должен быть метод/свойство __set__\"\n_cl_nodes_Field___set__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Field\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__set__\"]\nassert _cl_nodes_Field___set__ and not (len(_cl_nodes_Field___set__[0].body) == 1 and isinstance(_cl_nodes_Field___set__[0].body[0], _ast.Pass)), \"Реализуйте метод Field.__set__()\"\nassert \"Model\" in globals() and isinstance(Model, type), \"Класс Model должен быть определён\"\n_cl_def_Model = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Model\"]\nassert _cl_def_Model and not (len(_cl_def_Model[0].body) == 1 and isinstance(_cl_def_Model[0].body[0], _ast.Pass)), \"Реализуйте тело класса Model (сейчас там только pass)\"\nassert hasattr(Model, \"__init__\"), \"В классе Model должен быть метод/свойство __init__\"\n_cl_nodes_Model___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Model\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Model___init__ and not (len(_cl_nodes_Model___init__[0].body) == 1 and isinstance(_cl_nodes_Model___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Model.__init__()\"\nassert \"User\" in globals() and isinstance(User, type), \"Класс User должен быть определён\"\n_cl_def_User = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"User\"]\nassert _cl_def_User and not (len(_cl_def_User[0].body) == 1 and isinstance(_cl_def_User[0].body[0], _ast.Pass)), \"Реализуйте тело класса User (сейчас там только pass)\"\nu = User(name=\"Alex\", age=30)\nprint(u.name, u.age)\nu2 = User(name=\"Nina\")\nprint(u2.age)\nassert \"u\" in globals(), \"Переменная u должна быть вычислена\"\nassert \"u2\" in globals(), \"Переменная u2 должна быть вычислена\"", "code": "# Реализуйте ORM-подобное поле через дескриптор с хранением в dict экземпляра\nclass Field:\n    \"\"\"Упрощённая модель того, как устроены поля в Django ORM / SQLAlchemy:\n    дескриптор не хранит данные сам, а пишет/читает их в служебный словарь\n    _data экземпляра — так каждый инстанс модели хранит свои значения\n    независимо, а дескриптор остаётся общим на класс.\"\"\"\n\n    def __init__(self, field_type, required=True):\n        self.field_type = field_type\n        self.required = required\n\n    def __set_name__(self, owner, name):\n        self.name = name\n\n    def __get__(self, obj, owner):\n        if obj is None:\n            return self\n        return obj._data.get(self.name)\n\n    def __set__(self, obj, value):\n        if value is None and self.required:\n            raise ValueError(f\"Поле '{self.name}' обязательно\")\n        if value is not None and not isinstance(value, self.field_type):\n            raise TypeError(f\"'{self.name}' должно быть {self.field_type}\")\n        obj._data[self.name] = value\n\n\nclass Model:\n    def __init__(self, **kwargs):\n        self._data = {}\n        for key, value in kwargs.items():\n            setattr(self, key, value)\n\n\nclass User(Model):\n    name = Field(str)\n    age = Field(int, required=False)\n\n\nu = User(name=\"Alex\", age=30)\nprint(u.name, u.age)   # Alex 30\nu2 = User(name=\"Nina\")  # age не обязателен\nprint(u2.age)            # None"}, {"id": 244, "title": "Настройте строгую проверку типов через mypy --strict для модуля", "level": 7, "tier": "👑 Уровень 7", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Настройте строгую проверку типов через mypy --strict для модуля.</p>", "initialCode": "def calculate_total(price: float, quantity: int, discount: float=0.0) -> float:\n    pass", "solution": "# Настройте строгую проверку типов через mypy --strict для модуля\n# pyproject.toml — включаем strict-режим точечно для одного пакета,\n# не блокируя весь остальной (ещё не типизированный) проект\n\n# [tool.mypy]\n# python_version = \"3.11\"\n# warn_unused_configs = true\n#\n# [[tool.mypy.overrides]]\n# module = \"app.services.*\"\n# strict = true               # эквивалент флага --strict из CLI\n# disallow_untyped_defs = true\n# disallow_any_generics = true\n# warn_return_any = true\n# no_implicit_optional = true\n\n# app/services/pricing.py — модуль, попадающий под strict-проверку\ndef calculate_total(price: float, quantity: int, discount: float = 0.0) -> float:\n    return price * quantity * (1 - discount)\n\n\n# без аннотации функция не пройдёт disallow_untyped_defs:\n# def calculate_tax(amount):   <-- mypy --strict: ошибка\n#     return amount * 0.2\n\n# запуск точечно по модулю:\n# mypy --strict app/services/pricing.py", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"calculate_total\" in globals() and callable(calculate_total), \"Функция calculate_total() должна быть определена\"\n_fn_nodes_calculate_total = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"calculate_total\"]\nassert _fn_nodes_calculate_total and not (len(_fn_nodes_calculate_total[0].body) == 1 and isinstance(_fn_nodes_calculate_total[0].body[0], _ast.Pass)), \"Реализуйте тело функции calculate_total() (сейчас там только pass)\"", "code": "# Настройте строгую проверку типов через mypy --strict для модуля\n# pyproject.toml — включаем strict-режим точечно для одного пакета,\n# не блокируя весь остальной (ещё не типизированный) проект\n\n# [tool.mypy]\n# python_version = \"3.11\"\n# warn_unused_configs = true\n#\n# [[tool.mypy.overrides]]\n# module = \"app.services.*\"\n# strict = true               # эквивалент флага --strict из CLI\n# disallow_untyped_defs = true\n# disallow_any_generics = true\n# warn_return_any = true\n# no_implicit_optional = true\n\n# app/services/pricing.py — модуль, попадающий под strict-проверку\ndef calculate_total(price: float, quantity: int, discount: float = 0.0) -> float:\n    return price * quantity * (1 - discount)\n\n\n# без аннотации функция не пройдёт disallow_untyped_defs:\n# def calculate_tax(amount):   <-- mypy --strict: ошибка\n#     return amount * 0.2\n\n# запуск точечно по модулю:\n# mypy --strict app/services/pricing.py"}, {"id": 245, "title": "Создайте простую иерархию классов с одиночным наследованием", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Создайте простую иерархию классов с одиночным наследованием.</p>", "initialCode": "class Animal:\n\n    def __init__(self, name):\n        pass\n\n    def speak(self):\n        pass\nclass Dog(Animal):\n\n    def speak(self):\n        pass\nclass Cat(Animal):\n\n    def speak(self):\n        pass", "solution": "# Создайте простую иерархию классов с одиночным наследованием\nclass Animal:\n    def __init__(self, name):\n        self.name = name\n\n    def speak(self):\n        return f\"{self.name} издаёт звук\"\n\n\nclass Dog(Animal):\n    def speak(self):\n        return f\"{self.name} лает\"\n\n\nclass Cat(Animal):\n    def speak(self):\n        return f\"{self.name} мяукает\"\n\n\nanimals = [Dog(\"Рекс\"), Cat(\"Мурка\"), Animal(\"Существо\")]\nfor a in animals:\n    print(a.speak())", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Animal\" in globals() and isinstance(Animal, type), \"Класс Animal должен быть определён\"\n_cl_def_Animal = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == 
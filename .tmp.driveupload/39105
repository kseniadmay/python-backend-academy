w[_p] = _r\n        try:\n            _tf(**_kw)\n        finally:\n            for _td in reversed(_tds): _td()", "code": "# Замокируйте внешнее API в тестах благодаря DIP\nclass ExternalApiClient(ABC):\n    @abstractmethod\n    def get_rates(self) -> dict: pass\n\nclass MockApiClient(ExternalApiClient):\n    def get_rates(self) -> dict:\n        return {\"USD\": 90.0, \"EUR\": 100.0}\n\ndef test_converter():\n    service = CurrencyConverter(MockApiClient())\n    assert service.convert_to_rub(10, \"USD\") == 900.0"}, {"id": 179, "title": "Определите наличие цикла в связном списке (Floyd Cycle)", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Определите наличие цикла в связном списке (Floyd Cycle).</p>", "initialCode": "def has_cycle(head: ListNode) -> bool:\n    pass", "solution": "# Определите наличие цикла в связном списке (Floyd Cycle)\ndef has_cycle(head: ListNode) -> bool:\n    slow = fast = head\n    while fast and fast.next:\n        slow = slow.next\n        fast = fast.next.next\n        if slow == fast:\n            return True\n    return False", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"has_cycle\" in globals() and callable(has_cycle), \"Функция has_cycle() должна быть определена\"\n_fn_nodes_has_cycle = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"has_cycle\"]\nassert _fn_nodes_has_cycle and not (len(_fn_nodes_has_cycle[0].body) == 1 and isinstance(_fn_nodes_has_cycle[0].body[0], _ast.Pass)), \"Реализуйте тело функции has_cycle() (сейчас там только pass)\"\n_h = ListNode(1, ListNode(2)); assert has_cycle(_h) is False", "code": "# Определите наличие цикла в связном списке (Floyd Cycle)\ndef has_cycle(head: ListNode) -> bool:\n    slow = fast = head\n    while fast and fast.next:\n        slow = slow.next\n        fast = fast.next.next\n        if slow == fast:\n            return True\n    return False"}, {"id": 180, "title": "Спроектируйте платёжный шлюз по принципам SRP и LSP", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Спроектируйте платёжный шлюз по принципам SRP и LSP.</p>", "initialCode": "from abc import ABC, abstractmethod\nclass IPaymentGateway(ABC):\n\n    @abstractmethod\n    def charge(self, amount: float, currency: str) -> str:\n        pass\nclass StripeGateway(IPaymentGateway):\n\n    def charge(self, amount: float, currency: str) -> str:\n        pass\nclass PayPalGateway(IPaymentGateway):\n\n    def charge(self, amount: float, currency: str) -> str:\n        pass", "solution": "# Спроектируйте платёжный шлюз по принципам SRP и LSP\nfrom abc import ABC, abstractmethod\n\nclass IPaymentGateway(ABC):\n    @abstractmethod\n    def charge(self, amount: float, currency: str) -> str:\n        pass\n\nclass StripeGateway(IPaymentGateway):\n    def charge(self, amount: float, currency: str) -> str:\n        return f\"stripe_tx_{int(amount)}\"\n\nclass PayPalGateway(IPaymentGateway):\n    def charge(self, amount: float, currency: str) -> str:\n        return f\"paypal_tx_{int(amount)}\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"IPaymentGateway\" in globals() and isinstance(IPaymentGateway, type), \"Класс IPaymentGateway должен быть определён\"\n_cl_def_IPaymentGateway = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"IPaymentGateway\"]\nassert _cl_def_IPaymentGateway and not (len(_cl_def_IPaymentGateway[0].body) == 1 and isinstance(_cl_def_IPaymentGateway[0].body[0], _ast.Pass)), \"Реализуйте т
_Get.assert_called_once_with(\"https://api.example.com/rates/USD\", timeout=3)\nprint(\"Курс из мока:\", rate)\nassert \"mock_response\" in globals(), \"Переменная mock_response должна быть вычислена\"", "code": "# Замокайте внешний HTTP-клиент через unittest.mock.patch\nimport urllib.request\nfrom unittest.mock import patch, MagicMock\n\ndef fetch_currency_rate(currency: str) -> float:\n    url = f\"https://api.example.com/rates/{currency}\"\n    with urllib.request.urlopen(url, timeout=3) as response:\n        return float(response.read().decode(\"utf-8\"))\n\n# Патчим urllib.request.urlopen, чтобы тест не делал реальный сетевой запрос\nmock_response = MagicMock()\nmock_response.__enter__.return_value.read.return_value = b\"92.50\"\n\nwith patch(\"urllib.request.urlopen\", return_value=mock_response) as mock_Get:\n    rate = fetch_currency_rate(\"USD\")\n    assert rate == 92.5\n    mock_Get.assert_called_once_with(\"https://api.example.com/rates/USD\", timeout=3)\nprint(\"Курс из мока:\", rate)"}, {"id": 358, "title": "Симулируйте сетевой сбой и успешный retry через side_effect списка", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Симулируйте сетевой сбой и успешный retry через side_effect списка.</p>", "initialCode": "from unittest.mock import Mock\ndef fetch_with_retry(client, url: str, retries: int=3) -> dict:\n    pass", "solution": "# Симулируйте сетевой сбой и успешный retry через side_effect списка\nfrom unittest.mock import Mock\n\ndef fetch_with_retry(client, url: str, retries: int = 3) -> dict:\n    for attempt in range(1, retries + 1):\n        try:\n            return client.get(url)\n        except ConnectionError:\n            if attempt == retries:\n                raise\n    return {}\n\nclient = Mock()\n# Первые 2 вызова бросают исключение, 3-й возвращает успешный ответ\nclient.get.side_effect = [\n    ConnectionError(\"Timeout 1\"),\n    ConnectionError(\"Timeout 2\"),\n    {\"status\": 200, 
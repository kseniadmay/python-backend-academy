unread_count\"] == 3\n\nasyncio.run(main())\n"}, {"id": 399, "title": "Реализуйте менеджер WebSocket-комнат (ConnectionManager) с рассылкой broadcast", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте менеджер WebSocket-комнат (ConnectionManager) с рассылкой broadcast.</p>", "initialCode": "import asyncio\nfrom collections import defaultdict\nclass ConnectionManager:\n\n    def __init__(self):\n        pass\n\n    async def connect(self, room: str, ws) -> None:\n        pass\n\n    def disconnect(self, room: str, ws) -> None:\n        pass\n\n    async def broadcast(self, room: str, message: str) -> None:\n        pass\nclass FakeWebSocket:\n\n    def __init__(self, name: str):\n        pass\n\n    async def accept(self):\n        pass\n\n    async def send_text(self, msg: str):\n        pass\nasync def main():\n    pass", "solution": "# Реализуйте менеджер WebSocket-комнат (ConnectionManager) с рассылкой broadcast\nimport asyncio\nfrom collections import defaultdict\n\nclass ConnectionManager:\n    def __init__(self):\n        self.rooms: dict[str, list] = defaultdict(list)\n\n    async def connect(self, room: str, ws) -> None:\n        await ws.accept()\n        self.rooms[room].append(ws)\n\n    def disconnect(self, room: str, ws) -> None:\n        if ws in self.rooms[room]:\n            self.rooms[room].remove(ws)\n\n    async def broadcast(self, room: str, message: str) -> None:\n        for ws in list(self.rooms[room]):\n            await ws.send_text(message)\n\nclass FakeWebSocket:\n    def __init__(self, name: str):\n        self.name = name\n        self.inbox: list[str] = []\n    async def accept(self):\n        pass\n    async def send_text(self, msg: str):\n        self.inbox.append(msg)\n\nasync def main():\n    mgr = ConnectionManager()\n    u1, u2 = FakeWebSocket(\"Alice\"), FakeWebSocket(\"Bob\")\n    await mgr.connect(\"general\", u1)\n    await mgr.connect(\"general\", u2)\n    await mgr.broadcast(\"general\", \"Привет всем в комнате!\")\n    mgr.disconnect(\"general\", u2)\n    await mgr.broadcast(\"general\", \"Второе сообщение\")\n    print(\"Alice inbox:\", u1.inbox, \"| Bob inbox:\", u2.inbox)\n    assert len(u1.inbox) == 2 and len(u2.inbox) == 1\n\nasyncio.run(main())\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"main\" in globals() and callable(main), \"Функция main() должна быть определена\"\n_fn_nodes_main = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"main\"]\nassert _fn_nodes_main and not (len(_fn_nodes_main[0].body) == 1 and isinstance(_fn_nodes_main[0].body[0], _ast.Pass)), \"Реализуйте тело функции main() (сейчас там только pass)\"\nassert \"ConnectionManager\" in globals() and isinstance(ConnectionManager, type), \"Класс ConnectionManager должен быть определён\"\n_cl_def_ConnectionManager = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ConnectionManager\"]\nassert _cl_def_ConnectionManager and not (len(_cl_def_ConnectionManager[0].body) == 1 and isinstance(_cl_def_ConnectionManager[0].body[0], _ast.Pass)), \"Реализуйте тело класса ConnectionManager (сейчас там только pass)\"\nassert hasattr(ConnectionManager, \"__init__\"), \"В классе ConnectionManager должен быть метод/свойство __init__\"\n_cl_nodes_ConnectionManager___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ConnectionManager\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_ConnectionManager___init__ and not (len(_cl_nodes_ConnectionManager___init__[0].body) == 1 and isinstance(_cl_nodes_ConnectionManager___init__[0].body[0], 
y[0], _ast.Pass)), \"Реализуйте метод DataSet.__init__()\"\nassert hasattr(DataSet, \"average\"), \"В классе DataSet должен быть метод/свойство average\"\n_cl_nodes_DataSet_average = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"DataSet\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"average\"]\nassert _cl_nodes_DataSet_average and not (len(_cl_nodes_DataSet_average[0].body) == 1 and isinstance(_cl_nodes_DataSet_average[0].body[0], _ast.Pass)), \"Реализуйте метод DataSet.average()\"\nd = DataSet([1, 2, 3, 4])\nprint(d.average)\nprint(d.average)\nassert \"d\" in globals(), \"Переменная d должна быть вычислена\"", "code": "# Реализуйте дескриптор с кешированием вычисленного значения (cached_property)\nclass CachedProperty:\n    \"\"\"Аналог functools.cached_property, написанный вручную:\n    non-data descriptor — после первого вычисления кладёт значение\n    в __dict__ экземпляра под тем же именем, и дальше Python находит\n    его в __dict__ напрямую, вообще не заходя в дескриптор.\"\"\"\n\n    def __init__(self, func):\n        self.func = func\n        self.attr_name = func.__name__\n\n    def __set_name__(self, owner, name):\n        self.attr_name = name\n\n    def __get__(self, obj, owner):\n        if obj is None:\n            return self\n        value = self.func(obj)\n        obj.__dict__[self.attr_name] = value\n        return value\n\n\nclass DataSet:\n    def __init__(self, values):\n        self.values = values\n\n    @CachedProperty\n    def average(self):\n        print(\"Пересчитываю среднее...\")\n        return sum(self.values) / len(self.values)\n\n\nd = DataSet([1, 2, 3, 4])\nprint(d.average)  # печатает \"Пересчитываю...\" -> 2.5\nprint(d.average)  # берёт из __dict__, без пересчёта"}, {"id": 242, "title": "Реализуйте функцию с ограниченным TypeVar (bound=Protocol)", "level": 6, "tier": "🦁 Уровень 6", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте функцию с ограниченным TypeVar (bound=Protocol).</p>", "initialCode": "from typing import TypeVar, Protocol\nclass HasID(Protocol):\n    pass\nTID = TypeVar('TID', bound=HasID)\ndef get_by_id(items: list[TID], target_id: int) -> TID | None:\n    pass\nclass User:\n\n    def __init__(self, id: int, name: str):\n        pass", "solution": "# Реализуйте функцию с ограниченным TypeVar (bound=Protocol)\nfrom typing import TypeVar, Protocol\n\n\nclass HasID(Protocol):\n    id: int\n\n\nTID = TypeVar(\"TID\", bound=HasID)\n\n\ndef get_by_id(items: list[TID], target_id: int) -> TID | None:\n    return next((item for item in items if item.id == target_id), None)\n\n\nclass User:\n    def __init__(self, id: int, name: str):\n        self.id = id\n        self.name = name\n\n\nusers = [User(1, \"Alex\"), User(2, \"Nina\")]\nfound = get_by_id(users, 2)\nprint(found.name)  # \"Nina\" — mypy знает, что found: User | None", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"get_by_id\" in globals() and callable(get_by_id), \"Функция get_by_id() должна быть определена\"\n_fn_nodes_get_by_id = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"get_by_id\"]\nassert _fn_nodes_get_by_id and not (len(_fn_nodes_get_by_id[0].body) == 1 and isinstance(_fn_nodes_get_by_id[0].body[0], _ast.Pass)), \"Реализуйте тело функции get_by_id() (сейчас там только pass)\"\nassert \"HasID\" in globals() and isinstance(HasID, type), \"Класс HasID должен быть определён\"\n_cl_def_HasID = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"HasID\"]\nassert _cl_def_HasID and not (len(_cl_def_HasID[0].body) == 1 and isinstance(_cl_def_HasID[0].body[0], _ast.Pass)), \"Реализуйте тело класса HasID (сейчас там только pass)\"\nassert \"User\" in globals() and isinstance(User, type), \"Класс User должен быть определён\"\n_cl_def_User = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"User\"]\nassert _cl_def_User and not (len(_cl_def_User[0].body) == 1 and isinstance(_cl_def_User[0].body[0], _ast.Pass)), \"Реализуйте тело класса User (сейчас там только pass)\"\nassert hasattr(User, \"__init__\"), \"В классе User должен быть метод/свойство __init__\"\n_cl_nodes_User___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"User\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_User___init__ and not (len(_cl_nodes_User___init__[0].body) == 1 and isinstance(_cl_nodes_User___init__[0].body[0], _ast.Pass)), \"Реализуйте метод User.__init__()\"\nusers = [User(1, \"Alex\"), User(2, \"Nina\")]\nfound = get_by_id(users, 2)\nprint(found.name)\nassert \"users\" in globals(), \"Переменная users должна быть вычислена\"\nassert \"found\" in globals(), \"Переменная found должна быть вычислена\"", "code": "# Реализуйте функцию с ограниченным TypeVar (bound=Protocol)\nfrom typing import TypeVar, Protocol\n\n\nclass HasID(Protocol):\n    id: int\n\n\nTID = TypeVar(\"TID\", bound=HasID)\n\n\ndef get_by_id(items: list[TID], target_id: int) -> TID | None:\n    return next((item for item in items if item.id == target_id), None)\n\n\nclass User:\n    def __init__(self, id: int, name: str):\n        self.id = id\n        self.name = name\n\n\nusers = [User(1, \"Alex\"), User(2, \"Nina\")]\nfound = get_by_id(users, 2)\nprint(found.name)  # \"Nina\" — mypy знает, что found: User | None"}, {"id": 243, "title": "Реализуйте ORM-подобное поле через дескриптор с хранением в dict экземпляра", "level": 7, "tier": "👑 Уровень 7", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте ORM-подобное поле через дескриптор с хранением в dict экземпляра.</p>", "initialCode": "class Field:\n\n    def __init__(self, field_type, required=True):\n        pass\n\n    def __set_name__(self, owner, name):\n        pass\n\n    def __get__(self, obj, owner):\n        pass\n\n    def __set__(self, obj, value):\n        pass\nclass Model:\n\n    def __init__(self, **kwargs):\n        pass\nclass User(Model):\n    pass", "solution": "# Реализуйте ORM-подобное поле через дескриптор с хранением в dict экземпляра\nclass Field:\n    \"\"\"Упрощённая модель того, как устроены поля в Django ORM / SQLAlchemy:\n    дескриптор не хранит данные сам, а пишет/читает их в служебный словарь\n    _data экземпляра — так каждый инстанс модели хранит свои значения\n    независимо, а дескриптор остаётся общим на класс.\"\"\"\n\n    def __init__(self, field_type, required=True):\n        self.field_type = field_type\n        self.required = required\n\n    def __set_name__(self, owner, name):\n        self.name = name\n\n    def __get__(self, obj, owner):\n        if obj is None:\n            return self\n        return obj._data.get(self.name)\n\n    def __set__(self, obj, value):\n        if value is None and self.required:\n            raise ValueError(f\"Поле '{self.name}' обязательно\")\n        if value is not None and not isinstance(value, self.field_type):\n            raise TypeError(f\"'{self.name}' должно быть {self.field_type}\")\n        obj._data[self.name] = value\n\n\nclass Model:\n    def __init__(self, **kwargs):\n        self._data = {}\n        for key, value in kwargs.items():\n            setattr(self, key, value)\n\n\nclass User(Model):\n    name = Field(str)\n    age = Field(int, required=False)\n\n\nu = User(name=\"Alex\", age=30)\nprint(u.name, u.age)   # Alex 30\nu2 = User(name=\"Nina\")  # age не обязателен\nprint(u2.age)            # None", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, нев
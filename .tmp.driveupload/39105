:\n        # вызывается Python'ом автоматически в момент создания класса,\n        # избавляет от необходимости передавать имя вручную: Field('price')\n        self.public_name = name\n        self.private_name = \"_\" + name\n\n    def __get__(self, obj, owner):\n        if obj is None:\n            return self\n        return getattr(obj, self.private_name, None)\n\n    def __set__(self, obj, value):\n        setattr(obj, self.private_name, value)\n\n\nclass Product:\n    price = Field()\n    title = Field()\n\n\np = Product()\np.price = 100\nprint(p.price, p.__dict__)  # 100 {'_price': 100}"}, {"id": 239, "title": "Используйте @overload для функции с разными сигнатурами", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Используйте @overload для функции с разными сигнатурами.</p>", "initialCode": "from typing import overload\n@overload\ndef process(value: int) -> int:\n    pass\n@overload\ndef process(value: str) -> str:\n    pass\ndef process(value):\n    pass", "solution": "# Используйте @overload для функции с разными сигнатурами\nfrom typing import overload\n\n\n@overload\ndef process(value: int) -> int: ...\n@overload\ndef process(value: str) -> str: ...\n\n\ndef process(value):\n    if isinstance(value, int):\n        return value * 2\n    return value.upper()\n\n\nprint(process(5))      # 10, mypy знает что вернётся int\nprint(process(\"hi\"))   # \"HI\", mypy знает что вернётся str", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"process\" in globals() and callable(process), \"Функция process() должна быть определена\"\nassert \"process\" in globals() and callable(process), \"Функция process() должна быть определена\"\nassert \"process\" in globals() and callable(process), \"Функция process() должна быть определена\"\n_fn
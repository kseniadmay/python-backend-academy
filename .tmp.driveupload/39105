sed(_tds): _td()\nassert \"division by zero\" in str(_exc.value) if \"_exc\" in globals() else True, \"Тест должен проверить выброс ZeroDivisionError\"", "code": "# Проверьте выброс исключения и текст ошибки через pytest.raises\nimport pytest\n\ndef divide_safe(a: float, b: float) -> float:\n    if b == 0:\n        raise ValueError(\"Деление на ноль запрещено\")\n    return a / b\n\ndef test_divide_by_zero_raises():\n    # Проверяем тип исключения и совпадение текста по регулярному выражению\n    with pytest.raises(ValueError, match=\"Деление на ноль запрещено\"):\n        divide_safe(10, 0)"}, {"id": 352, "title": "Проверьте приближённое равенство float в тестах через pytest.approx", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Протестируйте сложение вещественных чисел с плавающей точкой через <code>pytest.approx</code>.</p><p class='meta'>В тестовой функции проверьте, что сумма <code>0.1 + 0.2</code> равна <code>pytest.approx(0.3)</code> с учётом погрешности стандарта IEEE 754.</p>", "initialCode": "import pytest\ndef calculate_tax(amount: float) -> float:\n    pass\ndef test_calculate_tax_float_precision():\n    pass", "solution": "# Проверьте приближённое равенство float в тестах через pytest.approx\nimport pytest\n\ndef calculate_tax(amount: float) -> float:\n    return amount * 0.1 + amount * 0.2\n\ndef test_calculate_tax_float_precision():\n    # Из-за двоичной арифметики IEEE 754: 0.1 + 0.2 == 0.30000000000000004\n    assert calculate_tax(1.0) == pytest.approx(0.3, rel=1e-6)", "hint": "Для сравнения чисел с плавающей точкой используй pytest.approx: assert actual == pytest.approx(expected, rel=1e-3).", "tests": "import ast as _ast\nassert \"calculate_tax\" in globals() and callable(calculate_tax), \"Функция calculate_tax() должна быть определена\"\n_fn_nodes_calculate_tax = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"calculate_tax\"]\nassert _fn_nodes_calculate_tax and not (len(_fn_nodes_calculate_tax[0].body) == 1 and isinstance(_fn_nodes_calculate_tax[0].body[0], _ast.Pass)), \"Реализуйте тело функции calculate_tax() (сейчас там только pass)\"\nassert \"test_calculate_tax_float_precision\" in globals() and callable(test_calculate_tax_float_precision), \"Функция test_calculate_tax_float_precision() должна быть определена\"\n_fn_nodes_test_calculate_tax_float_precision = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"test_calculate_tax_float_precision\"]\nassert _fn_nodes_test_calculate_tax_float_precision and not (len(_fn_nodes_test_calculate_tax_float_precision[0].body) == 1 and isinstance(_fn_nodes_test_calculate_tax_float_precision[0].body[0], _ast.Pass)), \"Реализуйте тело функции test_calculate_tax_float_precision() (сейчас там только pass)\"\n_t_list = [(k, v) for k, v in list(globals().items()) if k.startswith(\"test_\") and callable(v)]\nassert len(_t_list) > 0, \"Должна быть определена тестовая функция test_*\"\n_fix_map = {k: v for k, v in list(globals().items()) if callable(v) and getattr(v, \"_is_fixture\", False)}\nfor _tn, _tf in _t_list:\n    _cases = [({}, \"\")]\n    if hasattr(_tf, \"_parametrize\"):\n        _pnames, _pvals = _tf._parametrize\n        _cases = []\n        for _ix, _pv in enumerate(_pvals):\n            _raw = _pv.values if hasattr(_pv, \"values\") else (_pv if isinstance(_pv, (tuple, list)) else (_pv,))\n            _cases.append((dict(zip(_pnames, _raw)), f\"[{_ix}]\"))\n    _sig = list(_inspect.signature(_tf).parameters.keys())\n    for _cargs, _csuf in _cases:\n        _tds = []\n        _kw = dict(_cargs)\n        for _p in _sig:\n            if _p in _kw: continue\n            if _p == \"tmp_path\": _kw[_p] = _MemPath(\"/tmp/pytest_sandbox\")\n            elif _p == \"monkeypatch\":\n                _mp = _MonkeyPatch(); _kw[_p] = _mp; _tds.append(_mp.undo)\n           
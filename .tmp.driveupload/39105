 for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PendingState\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"pay\"]\nassert _cl_nodes_PendingState_pay and not (len(_cl_nodes_PendingState_pay[0].body) == 1 and isinstance(_cl_nodes_PendingState_pay[0].body[0], _ast.Pass)), \"Реализуйте метод PendingState.pay()\"\nassert hasattr(PendingState, \"ship\"), \"В классе PendingState должен быть метод/свойство ship\"\n_cl_nodes_PendingState_ship = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PendingState\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"ship\"]\nassert _cl_nodes_PendingState_ship and not (len(_cl_nodes_PendingState_ship[0].body) == 1 and isinstance(_cl_nodes_PendingState_ship[0].body[0], _ast.Pass)), \"Реализуйте метод PendingState.ship()\"\nassert \"PaidState\" in globals() and isinstance(PaidState, type), \"Класс PaidState должен быть определён\"\n_cl_def_PaidState = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PaidState\"]\nassert _cl_def_PaidState and not (len(_cl_def_PaidState[0].body) == 1 and isinstance(_cl_def_PaidState[0].body[0], _ast.Pass)), \"Реализуйте тело класса PaidState (сейчас там только pass)\"\nassert hasattr(PaidState, \"pay\"), \"В классе PaidState должен быть метод/свойство pay\"\n_cl_nodes_PaidState_pay = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PaidState\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"pay\"]\nassert _cl_nodes_PaidState_pay and not (len(_cl_nodes_PaidState_pay[0].body) == 1 and isinstance(_cl_nodes_PaidState_pay[0].body[0], _ast.Pass)), \"Реализуйте метод PaidState.pay()\"\nassert hasattr(PaidState, \"ship\"), \"В классе PaidState должен быть метод/свойство ship\"\n_cl_nodes_PaidState_ship = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PaidState\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"ship\"]\nassert _cl_nodes_PaidState_ship and not (len(_cl_nodes_PaidState_ship[0].body) == 1 and isinstance(_cl_nodes_PaidState_ship[0].body[0], _ast.Pass)), \"Реализуйте метод PaidState.ship()\"\nassert \"ShippedState\" in globals() and isinstance(ShippedState, type), \"Класс ShippedState должен быть определён\"\n_cl_def_ShippedState = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ShippedState\"]\nassert _cl_def_ShippedState and not (len(_cl_def_ShippedState[0].body) == 1 and isinstance(_cl_def_ShippedState[0].body[0], _ast.Pass)), \"Реализуйте тело класса ShippedState (сейчас там только pass)\"\nassert hasattr(ShippedState, \"pay\"), \"В классе ShippedState должен быть метод/свойство pay\"\nassert hasattr(ShippedState, \"ship\"), \"В классе ShippedState должен быть метод/свойство ship\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Напишите паттерн State для жизненного цикла заказа\nclass OrderState(ABC):\n    @abstractmethod\n    def pay(self, order): pass\n    @abstractmethod\n    def ship(self, order): pass\n\nclass PendingState(OrderState):\n    def pay(self, order):\n        print(\"Заказ оплачен\")\n        order.state = PaidState()\n    def ship(self, order):\n        raise ValueError(\"Нельзя отправить неоплаченный заказ\")\n\nclass PaidState(OrderState):\n    def pay(self, order):\n        raise ValueError(\"Заказ уже оплачен\")\n    def ship(self, order):\n        print(\"Заказ передан в доставку\")\n        order.state = ShippedState()\n\nclass ShippedState(OrderState):\n    def pay(self, order): pass\n    def ship(self, order): pass"}, {"id": 203, "title": "Решите задачу о наибольшем контейнере с водой", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Решите задачу о наибольшем контейнере с водой.</p>", "initialCode": "def max_area(height: list) -> int:\n    pass", "solution": "# Решите задачу о наибольшем контейнере с водой (Container With Most Water)\ndef max_area(height: list) -> int:\n    left, right = 0, len(height) - 1\n    max_water = 0\n    while left < right:\n        width = right - left\n        h = min(height[left], height[right])\n        max_water = max(max_water, width * h)\n        if height[left] < height[right]:\n            left += 1\n        else:\n            right -= 1\n    return max_water", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"max_area\" in globals() and callable(max_area), \"Функция max_area() должна быть определена\"\n_fn_nodes_max_area = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"max_area\"]\nassert _fn_nodes_max_area and not (len(_fn_nodes_max_area[0].body) == 1 and isinstance(_fn_nodes_max_area[0].body[0], _ast.Pass)), \"Реализуйте тело функции max_area() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Решите задачу о наибольшем контейнере с водой (Container With Most Water)\ndef max_area(height: list) -> int:\n    left, right = 0, len(height) - 1\n    max_water = 0\n    while left < right:\n        width = right - left\n        h = min(height[left], height[right])\n        max_water = max(max_water, width * h)\n        if height[left] < height[right]:\n            left += 1\n        else:\n            right -= 1\n    return max_water"}, {"id": 204, "title": "Реализуйте поиск цикла в неориентированном графе", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте поиск цикла в неориентированном графе.</p>", "initialCode": "def has_cycle_undirected(graph: dict) -> bool:\n    pass", "solution": "# Реализуйте поиск цикла в неориентированном графе\ndef has_cycle_undirected(graph: dict) -> bool:\n    visited = set()\n    def dfs(node, parent):\n        visited.add(node)\n        for neighbor in graph.get(node, []):\n            if neighbor not in visited:\n                if dfs(neighbor, node): return True\n            elif neighbor != parent:\n                return True\n        return False\n    for node in graph:\n        if node not in visited:\n            if dfs(node, None): return True\n    return False", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"has_cycle_undirected\" in globals() and callable(has_cycle_undirected), \"Функция has_cycle_undirected() должна быть определена\"\n_fn_nodes_has_cycle_undirected = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"has_cycle_undirected\"]\nassert _fn_nodes_has_cycle_undirected and not (len(_fn_nodes_has_cycle_undirected[0].body) == 1 and isinstance(_fn_nodes_has_cycle_undirected[0].body[0], _ast.Pass)), \"Реализуйте тело функции has_cycle_undirected() (сейчас там только pass)\"", "code": "# Реализуйте поиск цикла в неориентированном графе\ndef has_cycle_undirected(graph: dict) -> bool:\n    visited = set()\n    def dfs(node, parent):\n        visited.add(node)\n        for neighbor in graph.get(node, []):\n            if neighbor not in visited:\n                if dfs(neighbor, node): return True\n            elif neighbor != parent:\n                return True\n        return False\n    for node in graph:\n        if node not in visited:\n            if dfs(node, None): return True\n    return False"}, {"id": 205, "title": "Настройте задачу Celery с автоматическим перезапуском при сбое", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Настройте задачу Celery с автоматическим перезапуском при сбое.</p>", "initialCode": "@celery_app.task(bind=True, max_retries=3, default_retry_delay=60)\ndef send_webhook(self, url: str, data: dict):\n    pass", "solution": "# Настройте задачу Celery с автоматическим перезапуском при сбое\n@celery_app.task(bind=True, max_retries=3, default_retry_delay=60)\ndef send_webhook(self, url: str, data: dict):\n    try:\n        requests.post(url, json=data, timeout=5)\n    except requests.RequestException as exc:\n        raise self.retry(exc=exc)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"send_webhook\" in globals() and callable(send_webhook), \"Функция send_webhook() должна быть определена\"\n_fn_nodes_send_webhook = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"send_webhook\"]\nassert _fn_nodes_send_webhook and not (len(_fn_nodes_send_webhook[0].body) == 1 and isinstance(_fn_nodes_send_webhook[0].body[0], _ast.Pass)), \"Реализуйте тело функции send_webhook() (сейчас там только pass)\"", "code": "# Настройте задачу Celery с автоматическим перезапуском при сбое\n@celery_app.task(bind=True, max_retries=3, default_retry_delay=60)\ndef send_webhook(self, url: str, data: dict):\n    try:\n        requests.post(url, json=data, timeout=5)\n    except requests.RequestException as exc:\n        raise self.retry(exc=exc)"}, {"id": 206, "title": "Изолируйте доменные сущности от ORM-моделей", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Изолируйте доменные сущности от ORM-моделей.</p>", "initialCode": "from dataclasses import dataclass\n@dataclass\nclass UserEntity:\n    id: int\n    username: str\n    balance: float\n\n    def deposit(self, amount: float):\n        pass", "solution": "# Изолируйте доменные сущности от ORM-моделей\nfrom dataclasses import dataclass\n\n@dataclass\nclass UserEntity:  # Чистая доменная модель (DDD)\n    id: int\n    username: str\n    balance: float\n\n    def deposit(self, amount: float):\n        if amount <= 0:\n            raise ValueError(\"Сумма должна быть положительной\")\n        self.balance += amount", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"UserEntity\" in globals() and isinstance(UserEntity, type), \"Класс UserEntity должен быть определён\"\n_cl_def_UserEntity = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UserEntity\"]\nassert _cl_def_UserEntity and not (len(_cl_def_UserEntity[0].body) == 1 and isinstance(_cl_def_UserEntity[0].body[0], _ast.Pass)), \"Реализуйте тело класса UserEntity (сейчас там только pass)\"\nassert hasattr(UserEntity, \"deposit\"), \"В классе UserEntity должен быть метод/свойство deposit\"\n_cl_nodes_UserEntity_deposit = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UserEntity\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"deposit\"]\nassert _cl_nodes_UserEntity_deposit and not (len(_cl_nodes_UserEntity_deposit[0].body) == 1 and isinstance(_cl_nodes_UserEntity_deposit[0].body[0], _ast.Pass)), \"Реализуйте метод UserEntity.deposit()\"", "code": "# Изолируйте доменные сущности от ORM-моделей\nfrom dataclasses import dataclass\n\n@dataclass\nclass UserEntity:  # Чистая доменная модель (DDD)\n    id: int\n    username: str\n    balance: float\n\n    def deposit(self, amount: float):\n        if amount <= 0:\n            raise ValueError(\"Сумма должна быть положительной\")\n        self.balance += amount"}, {"id": 207, "title": "Реализуйте итеративный обход BST с использованием стека", "level": 7, "tier": "👑 Уровень 7", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте итеративный обход BST с использованием стека.</p>", "initialCode": "def inorder_iterative(root: TreeNode) -> list:\n    pass", "solution": "# Реализуйте итеративный обход BST с использованием стека\ndef inorder_iterative(root: TreeNode) -> list:\n    res = []\n    stack = []\n    curr = root\n    while curr or stack:\n        while curr:\n            stack.append(curr)\n            curr = curr.left\n        curr = stack.pop()\n        res.append(curr.val)\n        curr = curr.right\n    return res", "hint": "Шаг 1: Храни элементы во внутреннем списке self._items. Шаг 2: push добавляет через append(), pop удаляет с конца через pop() с проверкой на пустоту, peek возвращает последний элемент.", "tests": "import ast as _ast\nassert \"inorder_iterative\" in globals() and callable(inorder_iterative), \"Функция inorder_iterative() должна быть определена\"\n_fn_nodes_inorder_iterative = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"inorder_iterative\"]\nassert _fn_nodes_inorder_iterative and not (len(_fn_nodes_inorder_iterative[0].body) == 1 and isinstance(_fn_nodes_inorder_iterative[0].body[0], _ast.Pass)), \"Реализуйте тело функции inorder_iterative() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\n_r = TreeNode(2, TreeNode(1), TreeNode(3)); assert inorder_iterative(_r) == [1, 2, 3]", "code": "# Реализуйте итеративный обход BST с использованием стека\ndef inorder_iterative(root: TreeNode) -> list:\n    res = []\n    stack = []\n    curr = root\n    while curr or stack:\n        while curr:\n            stack.append(curr)\n            curr = curr.left\n        curr = stack.pop()\n        res.append(curr.val)\n        curr = curr.right\n    return res"}, {"id": 208, "title": "Посчитайте нарастающий итог через SUM() OVER(ORDER BY date)", "level": 7, "tier": "👑 Уровень 7", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Посчитайте нарастающий итог через SUM() OVER(ORDER BY date).</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Посчитайте нарастающий итог через SUM() OVER(ORDER BY date)\nsql = \"\"\"\nSELECT \n    date_trunc('day', created_at) AS day,\n    amount,\n    SUM(amount) OVER (ORDER BY date_trunc('day', created_at) ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total\nFROM transactions;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"date_trunc\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'date_trunc'\"\nassert isinstance(sql, str) and \"day\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'day'\"", "code": "# Посчитайте нарастающий итог через SUM() OVER(ORDER BY date)\nsql = \"\"\"\nSELECT \n    date_trunc('day', created_at) AS day,\n    amount,\n    SUM(amount) OVER (ORDER BY date_trunc('day', created_at) ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total\nFROM transactions;\n\"\"\""}, {"id": 209, "title": "Создайте кастомный пагинатор PageNumberPagination", "level": 7, "tier": "👑 Уровень 7", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте кастомный пагинатор PageNumberPagination.</p>", "initialCode": "from rest_framework.pagination import PageNumberPagination\nclass StandardResultsPagination(PageNumberPagination):\n    pass", "solution": "# Создайте кастомный пагинатор PageNumberPagination\nfrom rest_framework.pagination import PageNumberPagination\n\nclass StandardResultsPagination(PageNumberPagination):\n    page_size = 3\n    page_size_query_param = \"page_size\"\n    max_page_size = 100\n\npaginator = StandardResultsPagination()\nitems = list(range(1, 11))  # 10 элементов\npage_2 = paginator.paginate_queryset(items, query_params={\"page\": 2, \"page_size\": 3})\nprint(\"Страница 2 (по 3 элемента):\", page_2)\nassert page_2 == [4, 5, 6]\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"StandardResultsPagination\" in globals() and isinstance(StandardResultsPagination, type), \"Класс StandardResultsPagination должен быть определён\"\n_cl_def_StandardResultsPagination = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"StandardResultsPagination\"]\nassert _cl_def_StandardResultsPagination and not (len(_cl_def_StandardResultsPagination[0].body) == 1 and isinstance(_cl_def_StandardResultsPagination[0].body[0], _ast.Pass)), \"Реализуйте тело класса StandardResultsPagination (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\npaginator = StandardResultsPagination()\nitems = list(range(1, 11))\npage_2 = paginator.paginate_queryset(items, query_params={\"page\": 2, \"page_size\": 3})\nprint(\"Страница 2 (по 3 элемента):\", page_2)\nassert page_2 == [4, 5, 6]\nassert \"paginator\" in globals(), \"Переменная paginator должна быть вычислена\"\nassert \"items\" in globals(), \"Переменная items должна быть вычислена\"\nassert \"page_2\" in globals(), \"Переменная page_2 должна быть вычислена\"", "code": "# Создайте кастомный пагинатор PageNumberPagination\nfrom rest_framework.pagination import PageNumberPagination\n\nclass StandardResultsPagination(PageNumberPagination):\n    page_size = 3\n    page_size_query_param = \"page_size\"\n    max_page_size = 100\n\npaginator = StandardResultsPagination()\nitems = list(range(1, 11))  # 10 элементов\npage_2 = paginator.paginate_queryset(items, query_params={\"page\": 2, \"page_size\": 3})\nprint(\"Страница 2 (по 3 элемента):\", page_2)\nassert page_2 == [4, 5, 6]\n"}, {"id": 210, "title": "Топологическая сортировка графа зависимостей", "level": 7, "tier": "👑 Уровень 7", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Топологическая сортировка графа зависимостей.</p>", "initialCode": "from collections import deque, defaultdict\ndef topological_sort(num_tasks: int, prereqs: list) -> list:\n    pass", "solution": "# Топологическая сортировка графа зависимостей (Kahn's Algorithm)\nfrom collections import deque, defaultdict\n\ndef topological_sort(num_tasks: int, prereqs: list) -> list:\n    in_degree = [0] * num_tasks\n    adj = defaultdict(list)\n    for dest, src in prereqs:\n        adj[src].append(dest)\n        in_degree[dest] += 1\n    queue = deque([i for i in range(num_tasks) if in_degree[i] == 0])\n    order = []\n    while queue:\n        node = queue.popleft()\n        order.append(node)\n        for neighbor in adj[node]:\n            in_degree[neighbor] -= 1\n            if in_degree[neighbor] == 0:\n                queue.append(neighbor)\n    return order if len(order) == num_tasks else []", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"topological_sort\" in globals() and callable(topological_sort), \"Функция topological_sort() должна быть определена\"\n_fn_nodes_topological_sort = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"topological_sort\"]\nassert _fn_nodes_topological_sort and not (len(_fn_nodes_topological_sort[0].body) == 1 and isinstance(_fn_nodes_topological_sort[0].body[0], _ast.Pass)), \"Реализуйте тело функции topological_sort() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Топологическая сортировка графа зависимостей (Kahn's Algorithm)\nfrom collections import deque, defaultdict\n\ndef topological_sort(num_tasks: int, prereqs: list) -> list:\n    in_degree = [0] * num_tasks\n    adj = defaultdict(list)\n    for dest, src in prereqs:\n        adj[src].append(dest)\n        in_degree[dest] += 1\n    queue = deque([i for i in range(num_tasks) if in_degree[i] == 0])\n    order = []\n    while queue:\n        node = queue.popleft()\n        order.append(node)\n        for neighbor in adj[node]:\n            in_degree[neighbor] -= 1\n            if in_degree[neighbor] == 0:\n                queue.append(neighbor)\n    return order if len(order) == num_tasks else []"}, {"id": 211, "title": "Оптимизация анти-джойна NOT EXISTS vs LEFT JOIN WHERE NULL", "level": 7, "tier": "👑 Уровень 7", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Оптимизация анти-джойна NOT EXISTS vs LEFT JOIN WHERE NULL.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Оптимизация анти-джойна NOT EXISTS vs LEFT JOIN WHERE NULL\n# NOT EXISTS оптимизатор превращает в быстрый Anti Join без построения всей таблицы в памяти\nsql = \"\"\"\nSELECT u.id, u.email\nFROM users u\nWHERE NOT EXISTS (\n    SELECT 1 FROM orders o WHERE o.user_id = u.id\n);\n\"\"\"", "hint": "Шаг 1: Объедини таблицы через LEFT JOIN ... ON по первичному и внешнему ключу. Шаг 2: Чтобы найти записи без соответствий, проверь в WHERE поле правой таблицы: WHERE right_table.id IS NULL.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"email\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'email'\"\nassert isinstance(sql, str) and \"FROM\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'FROM'\"", "code": "# Оптимизация анти-джойна NOT EXISTS vs LEFT JOIN WHERE NULL\n# NOT EXISTS оптимизатор превращает в быстрый Anti Join без построения всей таблицы в памяти\nsql = \"\"\"\nSELECT u.id, u.email\nFROM users u\nWHERE NOT EXISTS (\n    SELECT 1 FROM orders o WHERE o.user_id = u.id\n);\n\"\"\""}, {"id": 212, "title": "Напишите триггер обновления updated_at на PL/pgSQL", "level": 7, "tier": "👑 Уровень 7", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите триггер обновления updated_at на PL/pgSQL.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Напишите триггер обновления updated_at на PL/pgSQL\nsql = \"\"\"\nCREATE OR REPLACE FUNCTION update_timestamp()\nRETURNS TRIGGER AS $$\nBEGIN\n    NEW.updated_at = CURRENT_TIMESTAMP;\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER trigger_update_users_timestamp\nBEFORE UPDATE ON users\nFOR EACH ROW\nEXECUTE FUNCTION update_timestamp();\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"CREATE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'CREATE'\"\nassert isinstance(sql, str) and \"REPLACE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'REPLACE'\"\nassert isinstance(sql, str) and \"FUNCTION\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'FUNCTION'\"", "code": "# Напишите триггер обновления updated_at на PL/pgSQL\nsql = \"\"\"\nCREATE OR REPLACE FUNCTION update_timestamp()\nRETURNS TRIGGER AS $$\nBEGIN\n    NEW.updated_at = CURRENT_TIMESTAMP;\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER trigger_update_users_timestamp\nBEFORE UPDATE ON users\nFOR EACH ROW\nEXECUTE FUNCTION update_timestamp();\n\"\"\""}, {"id": 213, "title": "Обработайте ошибку 40001 при уровне изоляции SERIALIZABLE", "level": 7, "tier": "👑 Уровень 7", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Обработайте ошибку 40001 при уровне изоляции SERIALIZABLE.</p>", "initialCode": "import time\ndef run_serializable_tx(conn, func, max_retries=3):\n    pass", "solution": "# Обработайте ошибку 40001 при уровне изоляции SERIALIZABLE\nimport time\n\ndef run_serializable_tx(conn, func, max_retries=3):\n    for attempt in range(max_retries):\n        try:\n            return func(conn)\n        except psycopg2.errors.SerializationFailure:\n            time.sleep(0.1 * (2 ** attempt))\n            if attempt == max_retries - 1:\n                raise", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"run_serializable_tx\" in globals() and callable(run_serializable_tx), \"Функция run_serializable_tx() должна быть определена\"\n_fn_nodes_run_serializable_tx = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"run_serializable_tx\"]\nassert _fn_nodes_run_serializable_tx and not (len(_fn_nodes_run_serializable_tx[0].body) == 1 and isinstance(_fn_nodes_run_serializable_tx[0].body[0], _ast.Pass)), \"Реализуйте тело функции run_serializable_tx() (сейчас там только pass)\"", "code": "# Обработайте ошибку 40001 при уровне изоляции SERIALIZABLE\nimport time\n\ndef run_serializable_tx(conn, func, max_retries=3):\n    for attempt in range(max_retries):\n        try:\n            return func(conn)\n        except psycopg2.errors.SerializationFailure:\n            time.sleep(0.1 * (2 ** attempt))\n            if attempt == max_retries - 1:\n                raise"}, {"id": 214, "title": "Решите комплексную итоговую задачу собеседования (Live-Coding)", "level": 7, "tier": "👑 Уровень 7", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Решите комплексную итоговую задачу собеседования (Live-Coding).</p>", "initialCode": "import time\nimport threading\nfrom collections import OrderedDict\nclass TTLCache:\n\n    def __init__(self, capacity: int, default_ttl: int=300):\n        pass\n\n    def get(self, key):\n        pass\n\n    def set(self, key, value, ttl=None):\n        pass", "solution": "# Решите комплексную итоговую задачу собеседования (Live-Coding)\n# LRU Cache с TTL и потокобезопасностью\nimport time\nimport threading\nfrom collections import OrderedDict\n\nclass TTLCache:\n    def __init__(self, capacity: int, default_ttl: int = 300):\n        self.capacity = capacity\n        self.default_ttl = default_ttl\n        self.cache = OrderedDict()\n        self.lock = threading.Lock()\n\n    def get(self, key):\n        with self.lock:\n            if key not in self.cache:\n                return None\n            val, expiry = self.cache[key]\n            if time.time() > expiry:\n                del self.cache[key]\n                return None\n            self.cache.move_to_end(key)\n            return val\n\n    def set(self, key, value, ttl=None):\n        ttl = ttl or self.default_ttl\n        expiry = time.time() + ttl\n        with self.lock:\n            if key in self.cache:\n                del self.cache[key]\n            elif len(self.cache) >= self.capacity:\n                self.cache.popitem(last=False)  # выталкивание старейшего (LRU)\n            self.cache[key] = (value, expiry)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"TTLCache\" in globals() and isinstance(TTLCache, type), \"Класс TTLCache должен быть определён\"\n_cl_def_TTLCache = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TTLCache\"]\nassert _cl_def_TTLCache and not (len(_cl_def_TTLCache[0].body) == 1 and isinstance(_cl_def_TTLCache[0].body[0], _ast.Pass)), \"Реализуйте тело класса TTLCache (сейчас там только pass)\"\nassert hasattr(TTLCache, \"__init__\"), \"В классе TTLCache должен быть метод/свойство __init__\"\n_cl_nodes_TTLCache___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TTLCache\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_TTLCache___init__ and not (len(_cl_nodes_TTLCache___init__[0].body) == 1 and isinstance(_cl_nodes_TTLCache___init__[0].body[0], _ast.Pass)), \"Реализуйте метод TTLCache.__init__()\"\nassert hasattr(TTLCache, \"get\"), \"В классе TTLCache должен быть метод/свойство get\"\n_cl_nodes_TTLCache_get = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TTLCache\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"get\"]\nassert _cl_nodes_TTLCache_get and not (len(_cl
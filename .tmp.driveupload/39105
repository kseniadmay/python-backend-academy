const TASKS = [{"id": 1, "title": "Напишите INNER JOIN двух связанных таблиц", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите SQL-запрос выборки в строковой переменной <code>sql</code>, объединяющий таблицы <code>users</code> (алиас <code>u</code>) и <code>orders</code> (алиас <code>o</code>) через <code>INNER JOIN</code> по ключу <code>u.id = o.user_id</code>.</p><p class='meta'>Выберите столбцы <code>u.username</code>, <code>o.id AS order_id</code>, <code>o.total_amount</code>, <code>o.status</code> и отфильтруйте заказы со статусом <code>'completed'</code>.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Напишите INNER JOIN двух связанных таблиц\nsql = \"\"\"\nSELECT u.username, o.id AS order_id, o.total_amount, o.status\nFROM users u\nINNER JOIN orders o ON u.id = o.user_id\nWHERE o.status = 'completed';\n\"\"\"", "hint": "Шаг 1: Укажи нужные поля в SELECT. Шаг 2: В секции FROM задай первую таблицу. Шаг 3: Свяжи со второй через INNER JOIN ... ON и добавь фильтр WHERE.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"username\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'username'\"\nassert isinstance(sql, str) and \"order_id\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'order_id'\"", "code": "# Напишите INNER JOIN двух связанных таблиц\nsql = \"\"\"\nSELECT u.username, o.id AS order_id, o.total_amount, o.status\nFROM users u\nINNER JOIN orders o ON u.id = o.user_id\nWHERE o.status = 'completed';\n\"\"\""}, {"id": 2, "title": "Напишите парсинг form-data в HTTP-запросе", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите функцию парсинга тела HTTP-запроса в формате application/x-www-form-urlencoded.</p><p class='meta'>Реализуйте функцию <code>parse_form_urlencoded(body_bytes: bytes) -> dict</code>. Декодируйте байты в utf-8 строку, разберите параметры через <code>urllib.parse.parse_qs</code> и преобразуйте списки значений из одного элемента в одиночные строки.</p>", "initialCode": "import urllib.parse\ndef parse_form_urlencoded(body_bytes: bytes) -> dict:\n    pass", "solution": "# Парсинг form-data в HTTP-запросе\nimport urllib.parse\n\ndef parse_form_urlencoded(body_bytes: bytes) -> dict:\n    body_str = body_bytes.decode(\"utf-8\")\n    parsed = urllib.parse.parse_qs(body_str)\n    return {k: v[0] if len(v) == 1 else v for k, v in parsed.items()}\n\n# Пример:\nres = parse_form_urlencoded(b\"username=alex&grant_type=password\")\nprint(res)  # {'username': 'alex', 'grant_type': 'password'}", "hint": "Шаг 1: Декодируй байты body_bytes.decode(\"utf-8\"). Шаг 2: Вызови urllib.parse.parse_qs. Шаг 3: Распакуй одиночные элементы списков.", "tests": "import ast as _ast\nassert \"parse_form_urlencoded\" in globals() and callable(parse_form_urlencoded), \"Функция parse_form_urlencoded() должна быть определена\"\n_fn_nodes_parse_form_urlencoded = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"parse_form_urlencoded\"]\nassert _fn_nodes_parse_form_urlencoded and not (len(_fn_nodes_parse_form_urlencoded[0].body) == 1 and isinstance(_fn_nodes_parse_form_urlencoded[0].body[0], _ast.Pass)), \"Реализуйте тело функции parse_form_urlencoded() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nres = parse_form_urlencoded(b\"username=alex&grant_type=password\")\nprint(res)\nassert \"res\" in globals(), \"Переменная res должна быть вычислена\"", "code": "# Парсинг form-data в HTTP-запросе\nimport urllib.parse\n\ndef parse_form_urlencoded(body_bytes: bytes) -> dict:\n    body_str = body_bytes.decode(\"utf-8\")\n    parsed = urllib.parse.parse_qs(body_str)\n    return {k: v[0] if len(v) == 1 else v for k, v in parsed.items()}\n\n# Пример:\nres = parse_form_urlencoded(b\"username=alex&grant_type=password\")\nprint(res)  # {'username': 'alex', 'grant_type': 'password'}"}, {"id": 3, "title": "Напишите production Dockerfile для Python приложения", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите многоэтапный production <code>Dockerfile</code> в строковой переменной <code>dockerfile</code> для Python-приложения на базе FastAPI/Uvicorn.</p><p class='meta'>Первый этап <code>builder</code>: базовый образ <code>python:3.12-slim-bookworm</code>, рабочая директория <code>/app</code>, установка Poetry и экспорт <code>requirements.txt</code>. Финальный этап: установка зависимостей без кэша, запуск от непривилегированного пользователя <code>appuser</code>, порт <code>8000</code> и запуск <code>uvicorn main:app</code>.</p>", "initialCode": "dockerfile = \"\"\"\n\n\"\"\"", "solution": "# Напишите production Dockerfile для Python приложения\ndockerfile = \"\"\"\nFROM python:3.12-slim-bookworm AS builder\nWORKDIR /app\nRUN pip install --no-cache-dir poetry\nCOPY pyproject.toml poetry.lock ./\nRUN poetry export -f requirements.txt --output requirements.txt\n\nFROM python:3.12-slim-bookworm\nWORKDIR /app\nRUN useradd -m appuser\nCOPY --from=builder /app/requirements.txt .\nRUN pip install --no-cache-dir -r requirements.txt\nCOPY . .\nUSER appuser\nEXPOSE 8000\nCMD [\"uvicorn\", \"main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]\n\"\"\"", "hint": "Шаг 1: Задай сборочный этап (FROM python:... AS builder). Шаг 2: Установи рабочую директорию WORKDIR и скопируй файлы. Шаг 3: Скопируй собранные артефакты в чистый финальный образ.", "tests": "import ast as _ast\nassert \"dockerfile\" in globals() and dockerfile is not None, \"Переменная dockerfile должна быть определена и не равна None\"\nassert isinstance(dockerfile, str) and \"FROM\".lower() in dockerfile.lower(), \"Строка dockerfile должна содержать ключевой элемент 'FROM'\"\nassert isinstance(dockerfile, str) and \"python\".lower() in dockerfile.lower(), \"Строка dockerfile должна содержать ключевой элемент 'python'\"\nassert isinstance(dockerfile, str) and \"slim\".lower() in dockerfile.lower(), \"Строка dockerfile должна содержать ключевой элемент 'slim'\"", "code": "# Напишите production Dockerfile для Python приложения\ndockerfile = \"\"\"\nFROM python:3.12-slim-bookworm AS builder\nWORKDIR /app\nRUN pip install --no-cache-dir poetry\nCOPY pyproject.toml poetry.lock ./\nRUN poetry export -f requirements.txt --output requirements.txt\n\nFROM python:3.12-slim-bookworm\nWORKDIR /app\nRUN useradd -m appuser\nCOPY --from=builder /app/requirements.txt .\nRUN pip install --no-cache-dir -r requirements.txt\nCOPY . .\nUSER appuser\nEXPOSE 8000\nCMD [\"uvicorn\", \"main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]\n\"\"\""}, {"id": 4, "title": "Напишите DDL создания таблиц пользователей и профилей (1:1)", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите DDL-запрос в строковой переменной <code>sql</code> для создания двух связанных таблиц со связью 1:1 (пользователи и профили).</p><p class='meta'>Таблица <code>users</code>: поля <code>id SERIAL PRIMARY KEY</code>, <code>email VARCHAR(255) UNIQUE NOT NULL</code>, <code>created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP</code>.<br>Таблица <code>profiles</code>: <code>user_id INTEGER PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE</code>, <code>first_name VARCHAR(100)</code>, <code>last_name VARCHAR(100)</code>, <code>bio TEXT</code>.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Напишите DDL создания таблиц пользователей и профилей (1:1)\nsql = \"\"\"\nCREATE TABLE users (\n    id SERIAL PRIMARY KEY,\n    email VARCHAR(255) UNIQUE NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE profiles (\n    user_id INTEGER PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,\n    first_name VARCHAR(100),\n    last_name VARCHAR(100),\n    bio TEXT\n);\n\"\"\"", "hint": "Шаг 1: Используй CREATE TABLE name (колонка ТИП ОГРАНИЧЕНИЕ). Шаг 2: Задай PRIMARY KEY и связи с родительскими таблицами через REFERENCES.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"CREATE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'CREATE'\"\nassert isinstance(sql, str) and \"TABLE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'TABLE'\"\nassert isinstance(sql, str) and \"users\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'users'\"", "code": "# Напишите DDL создания таблиц пользователей и профилей (1:1)\nsql = \"\"\"\nCREATE TABLE users (\n    id SERIAL PRIMARY KEY,\n    email VARCHAR(255) UNIQUE NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE profiles (\n    user_id INTEGER PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,\n    first_name VARCHAR(100),\n    last_name VARCHAR(100),\n    bio TEXT\n);\n\"\"\""}, {"id": 5, "title": "Реализуйте базовые операции стека push и pop", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте структуру данных Стек (LIFO) на базе списка Python.</p><p class='meta'>В классе <code>Stack</code> реализуйте методы: <code>push(item)</code> — добавление элемента, <code>pop()</code> — извлечение верхнего элемента (с выбросом <code>IndexError</code> для пустого стека), <code>peek()</code> — просмотр верхнего элемента без удаления (или <code>None</code>) и <code>is_empty() -> bool</code>.</p>", "initialCode": "class Stack:\n\n    def __init__(self):\n        pass\n\n    def push(self, item):\n        pass\n\n    def pop(self):\n        pass\n\n    def peek(self):\n        pass\n\n    def is_empty(self):\n        pass", "solution": "# Реализуйте базовые операции стека push и pop\nclass Stack:\n    def __init__(self):\n        self._items = []\n\n    def push(self, item):\n        self._items.append(item)\n\n    def pop(self):\n        if not self._items:\n            raise IndexError(\"Стек пуст\")\n        return self._items.pop()\n\n    def peek(self):\n        return self._items[-1] if self._items else None\n\n    def is_empty(self):\n        return len(self._items) == 0", "hint": "Шаг 1: Храни элементы во внутреннем списке self._items. Шаг 2: push добавляет через append(), pop удаляет с конца через pop() с проверкой на пустоту, peek возвращает последний элемент.", "tests": "import ast as _ast\nassert \"Stack\" in globals() and isinstance(Stack, type), \"Класс Stack должен быть определён\"\n_cl_def_Stack = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\"]\nassert _cl_def_Stack and not (len(_cl_def_Stack[0].body) == 1 and isinstance(_cl_def_Stack[0].body[0], _ast.Pass)), \"Реализуйте тело класса Stack (сейчас там только pass)\"\nassert hasattr(Stack, \"__init__\"), \"В классе Stack должен быть метод/свойство __init__\"\n_cl_nodes_Stack___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Stack___init__ and not (len(_cl_nodes_Stack___init__[0].body) == 1 and isinstance(_cl_nodes_Stack___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.__init__()\"\nassert hasattr(Stack, \"push\"), \"В классе Stack должен быть метод/свойство push\"\n_cl_nodes_Stack_push = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"push\"]\nassert _cl_nodes_Stack_push and not (len(_cl_nodes_Stack_push[0].body) == 1 and isinstance(_cl_nodes_Stack_push[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.push()\"\nassert hasattr(Stack, \"pop\"), \"В классе Stack должен быть метод/свойство pop\"\n_cl_nodes_Stack_pop = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"pop\"]\nassert _cl_nodes_Stack_pop and not (len(_cl_nodes_Stack_pop[0].body) == 1 and isinstance(_cl_nodes_Stack_pop[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.pop()\"\nassert hasattr(Stack, \"peek\"), \"В классе Stack должен быть метод/свойство peek\"\n_cl_nodes_Stack_peek = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"peek\"]\nassert _cl_nodes_Stack_peek and not (len(_cl_nodes_Stack_peek[0].body) == 1 and isinstance(_cl_nodes_Stack_peek[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.peek()\"\nassert hasattr(Stack, \"is_empty\"), \"В классе Stack должен быть метод/свойство is_empty\"\n_cl_nodes_Stack_is_empty = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"is_empty\"]\nassert _cl_nodes_Stack_is_empty and not (len(_cl_nodes_Stack_is_empty[0].body) == 1 and isinstance(_cl_nodes_Stack_is_empty[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.is_empty()\"\n_st = Stack(); _st.push(42); assert _st.peek() == 42 and _st.pop() == 42 and _st.is_empty()", "code": "# Реализуйте базовые операции стека push и pop\nclass Stack:\n    def __init__(self):\n        self._items = []\n\n    def push(self, item):\n        self._items.append(item)\n\n    def pop(self):\n        if not self._items:\n            raise IndexError(\"Стек пуст\")\n        return self._items.pop()\n\n    def peek(self):\n        return self._items[-1] if self._items else None\n\n    def is_empty(self):\n        return len(self._items) == 0"}, {"id": 6, "title": "Напишите парсинг URL и query-параметров через urllib.parse", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте разбор компонентов URL и извлечение параметров строки запроса.</p><p class='meta'>Для URL <code>raw_url = \"https://api.example.com/v1/users?role=admin&active=true&page=2\"</code> выполните разбор через <code>urlparse</code> в переменную <code>parsed</code> и извлеките query-параметры через <code>parse_qs</code> в переменную <code>params</code>.</p>", "initialCode": "from urllib.parse import urlparse, parse_qs\n\nraw_url = 'https://api.example.com/v1/users?role=admin&active=true&page=2'\nparsed = None\nparams = None", "solution": "# Напишите парсинг URL и query-параметров через urllib.parse\nfrom urllib.parse import urlparse, parse_qs\n\nraw_url = \"https://api.example.com/v1/users?role=admin&active=true&page=2\"\nparsed = urlparse(raw_url)\nparams = parse_qs(parsed.query)\nprint(parsed.path)    # /v1/users\nprint(params[\"role\"])  # ['admin']", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"raw_url\" in globals() and raw_url is not None, \"Переменная raw_url должна быть определена и не равна None\"\nassert isinstance(raw_url, str) and \"https\".lower() in raw_url.lower(), \"Строка raw_url должна содержать ключевой элемент 'https'\"\nassert isinstance(raw_url, str) and \"api\".lower() in raw_url.lower(), \"Строка raw_url должна содержать ключевой элемент 'api'\"\nassert isinstance(raw_url, str) and \"example\".lower() in raw_url.lower(), \"Строка raw_url должна содержать ключевой элемент 'example'\"\nassert \"parsed\" in globals() and parsed is not None, \"Переменная parsed должна быть определена и не равна None\"\nassert parsed != \"__TODO__\", \"Заполните значение переменной parsed\"\nassert \"params\" in globals() and params is not None, \"Переменная params должна быть определена и не равна None\"\nassert params != \"__TODO__\", \"Заполните значение переменной params\"", "code": "# Напишите парсинг URL и query-параметров через urllib.parse\nfrom urllib.parse import urlparse, parse_qs\n\nraw_url = \"https://api.example.com/v1/users?role=admin&active=true&page=2\"\nparsed = urlparse(raw_url)\nparams = parse_qs(parsed.query)\nprint(parsed.path)    # /v1/users\nprint(params[\"role\"])  # ['admin']"}, {"id": 7, "title": "Напишите фильтрацию QuerySet по дате создания", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите фильтрацию Django QuerySet для модели <code>Article</code> по датам публикации.</p><p class='meta'>Сформируйте два набора запросов: <code>today_qs</code> для статей за сегодня (фильтр <code>created_at__date=date.today()</code>) и <code>sept_qs</code> для статей за сентябрь 2026 года (фильтры <code>created_at__gte=\"2026-09-01\"</code> и <code>created_at__lt=\"2026-10-01\"</code>).</p>", "initialCode": "from datetime import date\nfrom django.db import models\nclass Article(models.Model):\n    pass", "solution": "# Напишите фильтрацию QuerySet по дате создания\nfrom datetime import date\nfrom django.db import models\n\nclass Article(models.Model):\n    title = models.CharField(max_length=255)\n    created_at = models.DateField()\n\nArticle.objects.seed([\n    {\"id\": 1, \"title\": \"Release Notes\", \"created_at\": \"2026-09-15\"},\n    {\"id\": 2, \"title\": \"Old Post\", \"created_at\": \"2026-08-10\"},\n    {\"id\": 3, \"title\": \"Today Post\", \"created_at\": str(date.today())},\n])\n\ntoday_qs = Article.objects.filter(created_at__date=date.today())\nsept_qs = Article.objects.filter(created_at__gte=\"2026-09-01\", created_at__lt=\"2026-10-01\")\nprint(\"За сегодня:\", [a.title for a in today_qs], \"| За сентябрь:\", [a.title for a in sept_qs])\nassert len(today_qs) == 1 and len(sept_qs) == 1 and sept_qs[0].title == \"Release Notes\"\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Article\" in globals() and isinstance(Article, type), \"Класс Article должен быть определён\"\n_cl_def_Article = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Article\"]\nassert _cl_def_Article and not (len(_cl_def_Article[0].body) == 1 and isinstance(_cl_def_Article[0].body[0], _ast.Pass)), \"Реализуйте тело класса Article (сейчас там только pass)\"\nArticle.objects.seed([\n    {\"id\": 1, \"title\": \"Release Notes\", \"created_at\": \"2026-09-15\"},\n    {\"id\": 2, \"title\": \"Old Post\", \"created_at\": \"2026-08-10\"},\n    {\"id\": 3, \"title\": \"Today Post\", \"created_at\": str(date.today())},\n])\ntoday_qs = Article.objects.filter(created_at__date=date.today())\nsept_qs = Article.objects.filter(created_at__gte=\"2026-09-01\", created_at__lt=\"2026-10-01\")\nprint(\"За сегодня:\", [a.title for a in today_qs], \"| За сентябрь:\", [a.title for a in sept_qs])\nassert len(today_qs) == 1 and len(sept_qs) == 1 and sept_qs[0].title == \"Release Notes\"\nassert \"today_qs\" in globals(), \"Переменная today_qs должна быть вычислена\"\nassert \"sept_qs\" in globals(), \"Переменная sept_qs должна быть вычислена\"\nassert len([l for l in __USER_CODE__.splitlines() if l.strip() and not l.strip().startswith(\"# Задач\") and not l.strip().startswith(\"# Напишите ваше\") and not l.strip().startswith(\"from \") and not l.strip().startswith(\"import \")]) >= 1, \"Добавьте решение задачи\"", "code": "# Напишите фильтрацию QuerySet по дате создания\nfrom datetime import date\nfrom django.db import models\n\nclass Article(models.Model):\n    title = models.CharField(max_length=255)\n    created_at = models.DateField()\n\nArticle.objects.seed([\n    {\"id\": 1, \"title\": \"Release Notes\", \"created_at\": \"2026-09-15\"},\n    {\"id\": 2, \"title\": \"Old Post\", \"created_at\": \"2026-08-10\"},\n    {\"id\": 3, \"title\": \"Today Post\", \"created_at\": str(date.today())},\n])\n\ntoday_qs = Article.objects.filter(created_at__date=date.today())\nsept_qs = Article.objects.filter(created_at__gte=\"2026-09-01\", created_at__lt=\"2026-10-01\")\nprint(\"За сегодня:\", [a.title for a in today_qs], \"| За сентябрь:\", [a.title for a in sept_qs])\nassert len(today_qs) == 1 and len(sept_qs) == 1 and sept_qs[0].title == \"Release Notes\"\n"}, {"id": 8, "title": "Создайте индекс B-Tree по полю email", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите SQL-команду создания B-Tree индекса в строковой переменной <code>sql</code>.</p><p class='meta'>Создайте индекс с именем <code>idx_users_email</code> для таблицы <code>users</code> по столбцу <code>email</code> методом <code>USING btree</code>.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Создайте индекс B-Tree по полю email\nsql = \"\"\"\nCREATE INDEX idx_users_email ON users USING btree (email);\n\"\"\"", "hint": "Синтаксис создания индекса: CREATE INDEX idx_name ON table_name USING btree (column_name);", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"CREATE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'CREATE'\"\nassert isinstance(sql, str) and \"INDEX\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'INDEX'\"\nassert isinstance(sql, str) and \"idx_users_email\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'idx_users_email'\"", "code": "# Создайте индекс B-Tree по полю email\nsql = \"\"\"\nCREATE INDEX idx_users_email ON users USING btree (email);\n\"\"\""}, {"id": 9, "title": "Создайте класс точки Point2D с кастомным repr", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте класс двумерной точки <code>Point2D</code> с информативным отладочным представлением.</p><p class='meta'>Реализуйте конструктор <code>__init__(self, x: float, y: float)</code> и метод <code>__repr__(self)</code>, возвращающий строку вида <code>f\"Point2D(x={self.x}, y={self.y})\"</code> для удобного логирования и отладки.</p>", "initialCode": "class Point2D:\n\n    def __init__(self, x: float, y: float):\n        pass\n\n    def __repr__(self):\n        pass\n\n    def __str__(self):\n        pass", "solution": "# Создайте класс точки Point2D с кастомным repr\nclass Point2D:\n    def __init__(self, x: float, y: float):\n        self.x = x\n        self.y = y\n\n    def __repr__(self):\n        return f\"Point2D(x={self.x}, y={self.y})\"\n\n    def __str__(self):\n        return f\"({self.x}, {self.y})\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Point2D\" in globals() and isinstance(Point2D, type), \"Класс Point2D должен быть определён\"\n_cl_def_Point2D = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Point2D\"]\nassert _cl_def_Point2D and not (len(_cl_def_Point2D[0].body) == 1 and isinstance(_cl_def_Point2D[0].body[0], _ast.Pass)), \"Реализуйте тело класса Point2D (сейчас там только pass)\"\nassert hasattr(Point2D, \"__init__\"), \"В классе Point2D должен быть метод/свойство __init__\"\n_cl_nodes_Point2D___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Point2D\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Point2D___init__ and not (len(_cl_nodes_Point2D___init__[0].body) == 1 and isinstance(_cl_nodes_Point2D___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Point2D.__init__()\"\nassert hasattr(Point2D, \"__repr__\"), \"В классе Point2D должен быть метод/свойство __repr__\"\n_cl_nodes_Point2D___repr__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Point2D\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__repr__\"]\nassert _cl_nodes_Point2D___repr__ and not (len(_cl_nodes_Point2D___repr__[0].body) == 1 and isinstance(_cl_nodes_Point2D___repr__[0].body[0], _ast.Pass)), \"Реализуйте метод Point2D.__repr__()\"\nassert hasattr(Point2D, \"__str__\"), \"В классе Point2D должен быть метод/свойство __str__\"\n_cl_nodes_Point2D___str__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Point2D\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__str__\"]\nassert _cl_nodes_Point2D___str__ and not (len(_cl_nodes_Point2D___str__[0].body) == 1 and isinstance(_cl_nodes_Point2D___str__[0].body[0], _ast.Pass)), \"Реализуйте метод Point2D.__str__()\"\n_p = Point2D(3, 4); assert \"3\" in repr(_p) and \"4\" in repr(_p)", "code": "# Создайте класс точки Point2D с кастомным repr\nclass Point2D:\n    def __init__(self, x: float, y: float):\n        self.x = x\n        self.y = y\n\n    def __repr__(self):\n        return f\"Point2D(x={self.x}, y={self.y})\"\n\n    def __str__(self):\n        return f\"({self.x}, {self.y})\""}, {"id": 10, "title": "Напишите юнит-тест проверки единственности экземпляра Singleton", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите тестовую функцию проверки корректности паттерна Singleton.</p><p class='meta'>В тестовой функции <code>test_singleton_identity()</code> создайте два экземпляра <code>s1 = ThreadSafeSingleton()</code> и <code>s2 = ThreadSafeSingleton()</code> и с помощью <code>assert s1 is s2</code> и <code>assert id(s1) == id(s2)</code> подтвердите их идентичность в памяти.</p>", "initialCode": "def test_singleton_identity():\n    pass", "solution": "# Напишите юнит-тест проверки единственности экземпляра Singleton\ndef test_singleton_identity():\n    s1 = ThreadSafeSingleton()\n    s2 = ThreadSafeSingleton()\n    assert s1 is s2\n    assert id(s1) == id(s2)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"test_singleton_identity\" in globals() and callable(test_singleton_identity), \"Функция test_singleton_identity() должна быть определена\"\n_fn_nodes_test_singleton_identity = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"test_singleton_identity\"]\nassert _fn_nodes_test_singleton_identity and not (len(_fn_nodes_test_singleton_identity[0].body) == 1 and isinstance(_fn_nodes_test_singleton_identity[0].body[0], _ast.Pass)), \"Реализуйте тело функции test_singleton_identity() (сейчас там только pass)\"\n_t_list = [(k, v) for k, v in list(globals().items()) if k.startswith(\"test_\") and callable(v)]\nassert len(_t_list) > 0, \"Должна быть определена тестовая функция test_*\"\n_fix_map = {k: v for k, v in list(globals().items()) if callable(v) and getattr(v, \"_is_fixture\", False)}\nfor _tn, _tf in _t_list:\n    _cases = [({}, \"\")]\n    if hasattr(_tf, \"_parametrize\"):\n        _pnames, _pvals = _tf._parametrize\n        _cases = []\n        for _ix, _pv in enumerate(_pvals):\n            _raw = _pv.values if hasattr(_pv, \"values\") else (_pv if isinstance(_pv, (tuple, list)) else (_pv,))\n            _cases.append((dict(zip(_pnames, _raw)), f\"[{_ix}]\"))\n    _sig = list(_inspect.signature(_tf).parameters.keys())\n    for _cargs, _csuf in _cases:\n        _tds = []\n        _kw = dict(_cargs)\n        for _p in _sig:\n            if _p in _kw: continue\n            if _p == \"tmp_path\": _kw[_p] = _MemPath(\"/tmp/pytest_sandbox\")\n            elif _p == \"monkeypatch\":\n                _mp = _MonkeyPatch(); _kw[_p] = _mp; _tds.append(_mp.undo)\n            elif _p == \"caplog\": _kw[_p] = _CapLog()\n            elif _p in _fix_map:\n                _r = _fix_map[_p]()\n                if hasattr(_r, \"__next__\"):\n                    _kw[_p] = next(_r)\n                    _tds.append(lambda g=_r: next(g, None))\n                else: _kw[_p] = _r\n        try:\n            _tf(**_kw)\n        finally:\n            for _td in reversed(_tds): _td()", "code": "# Напишите юнит-тест проверки единственности экземпляра Singleton\ndef test_singleton_identity():\n    s1 = ThreadSafeSingleton()\n    s2 = ThreadSafeSingleton()\n    assert s1 is s2\n    assert id(s1) == id(s2)"}, {"id": 11, "title": "Напишите базовую транзакцию с BEGIN, COMMIT, ROLLBACK", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте атомарный перевод средств между банковскими счетами в транзакции.</p><p class='meta'>В функции <code>transfer_funds(conn, from_acc: int, to_acc: int, amount: float)</code> используйте контекстный менеджер соединения <code>with conn:</code> и курсора <code>with conn.cursor() as cur:</code>, выполнив два SQL-запроса <code>UPDATE accounts</code> для списания и начисления средств.</p>", "initialCode": "import psycopg2\ndef transfer_funds(conn, from_acc: int, to_acc: int, amount: float):\n    pass", "solution": "# Напишите базовую транзакцию с BEGIN, COMMIT, ROLLBACK\nimport psycopg2\n\ndef transfer_funds(conn, from_acc: int, to_acc: int, amount: float):\n    with conn:\n        with conn.cursor() as cur:\n            cur.execute(\"UPDATE accounts SET balance = balance - %s WHERE id = %s\", (amount, from_acc))\n            cur.execute(\"UPDATE accounts SET balance = balance + %s WHERE id = %s\", (amount, to_acc))\n    # with conn автоматически вызывает COMMIT или ROLLBACK при ошибке", "hint": "Шаг 1: Открой транзакционный блок (BEGIN). Шаг 2: Выполни операции. Шаг 3: Зафиксируй изменения через COMMIT или откати через ROLLBACK при ошибке.", "tests": "import ast as _ast\nassert \"transfer_funds\" in globals() and callable(transfer_funds), \"Функция transfer_funds() должна быть определена\"\n_fn_nodes_transfer_funds = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"transfer_funds\"]\nassert _fn_nodes_transfer_funds and not (len(_fn_nodes_transfer_funds[0].body) == 1 and isinstance(_fn_nodes_transfer_funds[0].body[0], _ast.Pass)), \"Реализуйте тело функции transfer_funds() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Напишите базовую транзакцию с BEGIN, COMMIT, ROLLBACK\nimport psycopg2\n\ndef transfer_funds(conn, from_acc: int, to_acc: int, amount: float):\n    with conn:\n        with conn.cursor() as cur:\n            cur.execute(\"UPDATE accounts SET balance = balance - %s WHERE id = %s\", (amount, from_acc))\n            cur.execute(\"UPDATE accounts SET balance = balance + %s WHERE id = %s\", (amount, to_acc))\n    # with conn автоматически вызывает COMMIT или ROLLBACK при ошибке"}, {"id": 12, "title": "Создайте составной первичный ключ из двух полей", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите DDL-запрос создания таблицы позиций заказа <code>order_items</code> с составным первичным ключом в переменной <code>sql</code>.</p><p class='meta'>Поля таблицы: <code>order_id INTEGER NOT NULL</code>, <code>item_id INTEGER NOT NULL</code>, <code>quantity INTEGER NOT NULL DEFAULT 1</code>, <code>price NUMERIC(10, 2) NOT NULL</code>. Задайте составной первичный ключ <code>PRIMARY KEY (order_id, item_id)</code>.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Создайте составной первичный ключ из двух полей\nsql = \"\"\"\nCREATE TABLE order_items (\n    order_id INTEGER NOT NULL,\n    item_id INTEGER NOT NULL,\n    quantity INTEGER DEFAULT 1,\n    price NUMERIC(10, 2) NOT NULL,\n    PRIMARY KEY (order_id, item_id)\n);\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"CREATE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'CREATE'\"\nassert isinstance(sql, str) and \"TABLE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'TABLE'\"\nassert isinstance(sql, str) and \"order_items\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'order_items'\"", "code": "# Создайте составной первичный ключ из двух полей\nsql = \"\"\"\nCREATE TABLE order_items (\n    order_id INTEGER NOT NULL,\n    item_id INTEGER NOT NULL,\n    quantity INTEGER DEFAULT 1,\n    price NUMERIC(10, 2) NOT NULL,\n    PRIMARY KEY (order_id, item_id)\n);\n\"\"\""}, {"id": 13, "title": "Проверьте строку на палиндром двумя указателями", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите функцию проверки строки на палиндром методом двух встречных указателей.</p><p class='meta'>Реализуйте <code>is_palindrome(s: str) -> bool</code>: очистите строку от небуквенных символов, приведите к нижнему регистру и двигайте указатели <code>left</code> и <code>right</code> навстречу друг другу за время <code>O(N)</code> и память <code>O(1)</code>.</p>", "initialCode": "def is_palindrome(s: str) -> bool:\n    pass", "solution": "# Проверьте строку на палиндром двумя указателями\ndef is_palindrome(s: str) -> bool:\n    clean = [c.lower() for c in s if c.isalnum()]\n    left, right = 0, len(clean) - 1\n    while left < right:\n        if clean[left] != clean[right]:\n            return False\n        left += 1\n        right -= 1\n    return True", "hint": "Шаг 1: Очисти строку (приведи к нижнему регистру, убери пробелы). Шаг 2: Используй два указателя (с начала и конца) и сдвигай их навстречу, проверяя совпадение символов.", "tests": "import ast as _ast\nassert \"is_palindrome\" in globals() and callable(is_palindrome), \"Функция is_palindrome() должна быть определена\"\n_fn_nodes_is_palindrome = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"is_palindrome\"]\nassert _fn_nodes_is_palindrome and not (len(_fn_nodes_is_palindrome[0].body) == 1 and isinstance(_fn_nodes_is_palindrome[0].body[0], _ast.Pass)), \"Реализуйте тело функции is_palindrome() (сейчас там только pass)\"\nassert is_palindrome(\"А роза упала на лапу Азора\") is True and is_palindrome(\"hello\") is False", "code": "# Проверьте строку на палиндром двумя указателями\ndef is_palindrome(s: str) -> bool:\n    clean = [c.lower() for c in s if c.isalnum()]\n    left, right = 0, len(clean) - 1\n    while left < right:\n        if clean[left] != clean[right]:\n            return False\n        left += 1\n        right -= 1\n    return True"}, {"id": 14, "title": "Реализуйте классический бинарный поиск в массиве", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте алгоритм бинарного поиска в отсортированном массиве.</p><p class='meta'>Функция <code>binary_search(nums: list, target: int) -> int</code> должна находить индекс элемента <code>target</code> за время <code>O(log N)</code>. При отсутствии элемента в массиве возвращайте <code>-1</code>.</p>", "initialCode": "def binary_search(nums: list, target: int) -> int:\n    pass", "solution": "# Реализуйте классический бинарный поиск в массиве\ndef binary_search(nums: list, target: int) -> int:\n    left, right = 0, len(nums) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if nums[mid] == target:\n            return mid\n        elif nums[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1", "hint": "Шаг 1: Задай границы left = 0 и right = len(arr) - 1. Шаг 2: В цикле while left <= right вычисляй mid = (left + right) // 2. Шаг 3: Сравнивай элемент с target и сдвигай границы.", "tests": "import ast as _ast\nassert \"binary_search\" in globals() and callable(binary_search), \"Функция binary_search() должна быть определена\"\n_fn_nodes_binary_search = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"binary_search\"]\nassert _fn_nodes_binary_search and not (len(_fn_nodes_binary_search[0].body) == 1 and isinstance(_fn_nodes_binary_search[0].body[0], _ast.Pass)), \"Реализуйте тело функции binary_search() (сейчас там только pass)\"\nassert binary_search([1, 3, 5, 7, 9], 7) == 3 and binary_search([1, 3, 5], 2) == -1", "code": "# Реализуйте классический бинарный поиск в массиве\ndef binary_search(nums: list, target: int) -> int:\n    left, right = 0, len(nums) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if nums[mid] == target:\n            return mid\n        elif nums[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1"}, {"id": 15, "title": "Создайте класс TreeNode для бинарного дерева", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте базовый класс узла бинарного дерева <code>TreeNode</code>.</p><p class='meta'>Конструктор <code>__init__(self, val=0, left=None, right=None)</code> должен сохранять значение узла в <code>self.val</code>, левого потомка в <code>self.left</code> и правого потомка в <code>self.right</code>.</p>", "initialCode": "class TreeNode:\n\n    def __init__(self, val=0, left=None, right=None):\n        pass\n\n    def __repr__(self):\n        pass", "solution": "# Создайте класс TreeNode для бинарного дерева\nclass TreeNode:\n    def __init__(self, val=0, left=None, right=None):\n        self.val = val\n        self.left = left\n        self.right = right\n\n    def __repr__(self):\n        return f\"TreeNode({self.val})\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"TreeNode\" in globals() and isinstance(TreeNode, type), \"Класс TreeNode должен быть определён\"\n_cl_def_TreeNode = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TreeNode\"]\nassert _cl_def_TreeNode and not (len(_cl_def_TreeNode[0].body) == 1 and isinstance(_cl_def_TreeNode[0].body[0], _ast.Pass)), \"Реализуйте тело класса TreeNode (сейчас там только pass)\"\nassert hasattr(TreeNode, \"__init__\"), \"В классе TreeNode должен быть метод/свойство __init__\"\n_cl_nodes_TreeNode___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TreeNode\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_TreeNode___init__ and not (len(_cl_nodes_TreeNode___init__[0].body) == 1 and isinstance(_cl_nodes_TreeNode___init__[0].body[0], _ast.Pass)), \"Реализуйте метод TreeNode.__init__()\"\nassert hasattr(TreeNode, \"__repr__\"), \"В классе TreeNode должен быть метод/свойство __repr__\"\n_cl_nodes_TreeNode___repr__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TreeNode\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__repr__\"]\nassert _cl_nodes_TreeNode___repr__ and not (len(_cl_nodes_TreeNode___repr__[0].body) == 1 and isinstance(_cl_nodes_TreeNode___repr__[0].body[0], _ast.Pass)), \"Реализуйте метод TreeNode.__repr__()\"\n_tn = TreeNode(10); assert _tn.val == 10 and _tn.left is None", "code": "# Создайте класс TreeNode для бинарного дерева\nclass TreeNode:\n    def __init__(self, val=0, left=None, right=None):\n        self.val = val\n        self.left = left\n        self.right = right\n\n    def __repr__(self):\n        return f\"TreeNode({self.val})\""}, {"id": 16, "title": "Определение временной сложности Big-O для вложенного цикла", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Определение временной сложности Big-O для вложенного цикла.</p>", "initialCode": "def analyze_complexity(n: int) -> int:\n    pass", "solution": "# Определение временной сложности Big-O для вложенного цикла\ndef analyze_complexity(n: int) -> int:\n    # Внешний цикл N итераций, внутренний N итераций -> O(N^2)\n    total = 0\n    for i in range(n):\n        for j in range(n):\n            total += i * j\n    return total\n# Временная сложность: O(N^2), пространственная сложность: O(1)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"analyze_complexity\" in globals() and callable(analyze_complexity), \"Функция analyze_complexity() должна быть определена\"\n_fn_nodes_analyze_complexity = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"analyze_complexity\"]\nassert _fn_nodes_analyze_complexity and not (len(_fn_nodes_analyze_complexity[0].body) == 1 and isinstance(_fn_nodes_analyze_complexity[0].body[0], _ast.Pass)), \"Реализуйте тело функции analyze_complexity() (сейчас там только pass)\"\nassert analyze_complexity(4) == 36", "code": "# Определение временной сложности Big-O для вложенного цикла\ndef analyze_complexity(n: int) -> int:\n    # Внешний цикл N итераций, внутренний N итераций -> O(N^2)\n    total = 0\n    for i in range(n):\n        for j in range(n):\n            total += i * j\n    return total\n# Временная сложность: O(N^2), пространственная сложность: O(1)"}, {"id": 17, "title": "Напишите Adapter для интеграции стороннего API погоды", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите Adapter для интеграции стороннего API погоды.</p>", "initialCode": "class ThirdPartyWeatherService:\n\n    def get_temp_f(self, city: str) -> float:\n        pass\nclass WeatherAdapter:\n\n    def __init__(self, service: ThirdPartyWeatherService):\n        pass\n\n    def get_celsius(self, city: str) -> float:\n        pass", "solution": "# Напишите Adapter для интеграции стороннего API погоды\nclass ThirdPartyWeatherService:\n    def get_temp_f(self, city: str) -> float:\n        return 77.0  # Градусы Фаренгейта\n\nclass WeatherAdapter:\n    def __init__(self, service: ThirdPartyWeatherService):\n        self.service = service\n\n    def get_celsius(self, city: str) -> float:\n        temp_f = self.service.get_temp_f(city)\n        return round((temp_f - 32) * 5 / 9, 2)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"ThirdPartyWeatherService\" in globals() and isinstance(ThirdPartyWeatherService, type), \"Класс ThirdPartyWeatherService должен быть определён\"\n_cl_def_ThirdPartyWeatherService = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ThirdPartyWeatherService\"]\nassert _cl_def_ThirdPartyWeatherService and not (len(_cl_def_ThirdPartyWeatherService[0].body) == 1 and isinstance(_cl_def_ThirdPartyWeatherService[0].body[0], _ast.Pass)), \"Реализуйте тело класса ThirdPartyWeatherService (сейчас там только pass)\"\nassert hasattr(ThirdPartyWeatherService, \"get_temp_f\"), \"В классе ThirdPartyWeatherService должен быть метод/свойство get_temp_f\"\n_cl_nodes_ThirdPartyWeatherService_get_temp_f = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ThirdPartyWeatherService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"get_temp_f\"]\nassert _cl_nodes_ThirdPartyWeatherService_get_temp_f and not (len(_cl_nodes_ThirdPartyWeatherService_get_temp_f[0].body) == 1 and isinstance(_cl_nodes_ThirdPartyWeatherService_get_temp_f[0].body[0], _ast.Pass)), \"Реализуйте метод ThirdPartyWeatherService.get_temp_f()\"\nassert \"WeatherAdapter\" in globals() and isinstance(WeatherAdapter, type), \"Класс WeatherAdapter должен быть определён\"\n_cl_def_WeatherAdapter = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"WeatherAdapter\"]\nassert _cl_def_WeatherAdapter and not (len(_cl_def_WeatherAdapter[0].body) == 1 and isinstance(_cl_def_WeatherAdapter[0].body[0], _ast.Pass)), \"Реализуйте тело класса WeatherAdapter (сейчас там только pass)\"\nassert hasattr(WeatherAdapter, \"__init__\"), \"В классе WeatherAdapter должен быть метод/свойство __init__\"\n_cl_nodes_WeatherAdapter___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"WeatherAdapter\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_WeatherAdapter___init__ and not (len(_cl_nodes_WeatherAdapter___init__[0].body) == 1 and isinstance(_cl_nodes_WeatherAdapter___init__[0].body[0], _ast.Pass)), \"Реализуйте метод WeatherAdapter.__init__()\"\nassert hasattr(WeatherAdapter, \"get_celsius\"), \"В классе WeatherAdapter должен быть метод/свойство get_celsius\"\n_cl_nodes_WeatherAdapter_get_celsius = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"WeatherAdapter\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"get_celsius\"]\nassert _cl_nodes_WeatherAdapter_get_celsius and not (len(_cl_nodes_WeatherAdapter_get_celsius[0].body) == 1 and isinstance(_cl_nodes_WeatherAdapter_get_celsius[0].body[0], _ast.Pass)), \"Реализуйте метод WeatherAdapter.get_celsius()\"\n_wa = WeatherAdapter(ThirdPartyWeatherService()); assert _wa.get_celsius(\"Moscow\") == 25.0", "code": "# Напишите Adapter для интеграции стороннего API погоды\nclass ThirdPartyWeatherService:\n    def get_temp_f(self, city: str) -> float:\n        return 77.0  # Градусы Фаренгейта\n\nclass WeatherAdapter:\n    def __init__(self, service: ThirdPartyWeatherService):\n        self.service = service\n\n    def get_celsius(self, city: str) -> float:\n        temp_f = self.service.get_temp_f(city)\n        return round((temp_f - 32) * 5 / 9, 2)"}, {"id": 18, "title": "Реализуйте подсчёт частоты элементов через collections.Counter", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте подсчёт частоты элементов последовательности через <code>collections.Counter</code>.</p><p class='meta'>Функция <code>frequency_analysis(items: list) -> list</code> должна возвращать список кортежей <code>(элемент, количество)</code>, отсортированных по убыванию частоты с помощью метода <code>most_common()</code>.</p>", "initialCode": "from collections import Counter\ndef frequency_analysis(items: list) -> list:\n    pass", "solution": "# Реализуйте подсчёт частоты элементов через collections.Counter\nfrom collections import Counter\n\ndef frequency_analysis(items: list) -> list:\n    counts = Counter(items)\n    # Сортировка по убыванию частоты\n    return counts.most_common()", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"frequency_analysis\" in globals() and callable(frequency_analysis), \"Функция frequency_analysis() должна быть определена\"\n_fn_nodes_frequency_analysis = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"frequency_analysis\"]\nassert _fn_nodes_frequency_analysis and not (len(_fn_nodes_frequency_analysis[0].body) == 1 and isinstance(_fn_nodes_frequency_analysis[0].body[0], _ast.Pass)), \"Реализуйте тело функции frequency_analysis() (сейчас там только pass)\"\nassert frequency_analysis([\"a\", \"b\", \"a\"])[0] == (\"a\", 2)", "code": "# Реализуйте подсчёт частоты элементов через collections.Counter\nfrom collections import Counter\n\ndef frequency_analysis(items: list) -> list:\n    counts = Counter(items)\n    # Сортировка по убыванию частоты\n    return counts.most_common()"}, {"id": 19, "title": "Извлеките срез матрицы 3x3 по диагонали", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Извлеките срез матрицы 3x3 по диагонали.</p>", "initialCode": "matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]\nmain_diagonal = None", "solution": "# Извлеките срез матрицы 3x3 по диагонали\nmatrix = [\n    [1, 2, 3],\n    [4, 5, 6],\n    [7, 8, 9]\n]\nmain_diagonal = [matrix[i][i] for i in range(len(matrix))]\nprint(main_diagonal)  # [1, 5, 9]", "hint": "Синтаксис срезов в Python: seq[start:stop:step]. Для получения инвертированной копии списка используй отрицательный шаг [::-1].", "tests": "import ast as _ast\nassert \"matrix\" in globals() and matrix is not None, \"Переменная matrix должна быть определена и не равна None\"\nassert matrix != \"__TODO__\", \"Заполните значение переменной matrix\"\nassert \"main_diagonal\" in globals() and main_diagonal is not None, \"Переменная main_diagonal должна быть определена и не равна None\"\nassert main_diagonal != \"__TODO__\", \"Заполните значение переменной main_diagonal\"", "code": "# Извлеките срез матрицы 3x3 по диагонали\nmatrix = [\n    [1, 2, 3],\n    [4, 5, 6],\n    [7, 8, 9]\n]\nmain_diagonal = [matrix[i][i] for i in range(len(matrix))]\nprint(main_diagonal)  # [1, 5, 9]"}, {"id": 20, "title": "Разворот списка срезом [::-1]", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте исходный список чисел <code>original</code> и получите его инвертированную копию <code>reversed_list</code> с помощью шага среза <code>[::-1]</code>.</p>", "initialCode": "original = [1, 2, 3, 4, 5]\nreversed_list = None", "solution": "# Сделайте реверс списка срезом [::-1]\noriginal = [1, 2, 3, 4, 5]\nreversed_list = original[::-1]\nprint(reversed_list)  # [5, 4, 3, 2, 1]", "hint": "Синтаксис срезов в Python: seq[start:stop:step]. Для получения инвертированной копии списка используй отрицательный шаг [::-1].", "tests": "import ast as _ast\nassert \"original\" in globals() and original is not None, \"Переменная original должна быть определена и не равна None\"\nassert original != \"__TODO__\", \"Заполните значение переменной original\"\nassert \"reversed_list\" in globals() and reversed_list is not None, \"Переменная reversed_list должна быть определена и не равна None\"\nassert reversed_list != \"__TODO__\", \"Заполните значение переменной reversed_list\"", "code": "# Сделайте реверс списка срезом [::-1]\noriginal = [1, 2, 3, 4, 5]\nreversed_list = original[::-1]\nprint(reversed_list)  # [5, 4, 3, 2, 1]"}, {"id": 21, "title": "Сделайте динамическую замену стратегии в рантайме", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Сделайте динамическую замену стратегии в рантайме.</p>", "initialCode": "class Order:\n\n    def __init__(self, strategy: DeliveryStrategy):\n        pass\n\n    def set_strategy(self, strategy: DeliveryStrategy):\n        pass\n\n    def get_shipping_cost(self, weight: float) -> float:\n        pass", "solution": "# Сделайте динамическую замену стратегии в рантайме\nclass Order:\n    def __init__(self, strategy: DeliveryStrategy):\n        self.strategy = strategy\n\n    def set_strategy(self, strategy: DeliveryStrategy):\n        self.strategy = strategy\n\n    def get_shipping_cost(self, weight: float) -> float:\n        return self.strategy.calculate(weight)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Order\" in globals() and isinstance(Order, type), \"Класс Order должен быть определён\"\n_cl_def_Order = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Order\"]\nassert _cl_def_Order and not (len(_cl_def_Order[0].body) == 1 and isinstance(_cl_def_Order[0].body[0], _ast.Pass)), \"Реализуйте тело класса Order (сейчас там только pass)\"\nassert hasattr(Order, \"__init__\"), \"В классе Order должен быть метод/свойство __init__\"\n_cl_nodes_Order___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Order\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Order___init__ and not (len(_cl_nodes_Order___init__[0].body) == 1 and isinstance(_cl_nodes_Order___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Order.__init__()\"\nassert hasattr(Order, \"set_strategy\"), \"В классе Order должен быть метод/свойство set_strategy\"\n_cl_nodes_Order_set_strategy = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Order\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"set_strategy\"]\nassert _cl_nodes_Order_set_strategy and not (len(_cl_nodes_Order_set_strategy[0].body) == 1 and isinstance(_cl_nodes_Order_set_strategy[0].body[0], _ast.Pass)), \"Реализуйте метод Order.set_strategy()\"\nassert hasattr(Order, \"get_shipping_cost\"), \"В классе Order должен быть метод/свойство get_shipping_cost\"\n_cl_nodes_Order_get_shipping_cost = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Order\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"get_shipping_cost\"]\nassert _cl_nodes_Order_get_shipping_cost and not (len(_cl_nodes_Order_get_shipping_cost[0].body) == 1 and isinstance(_cl_nodes_Order_get_shipping_cost[0].body[0], _ast.Pass)), \"Реализуйте метод Order.get_shipping_cost()\"", "code": "# Сделайте динамическую замену стратегии в рантайме\nclass Order:\n    def __init__(self, strategy: DeliveryStrategy):\n        self.strategy = strategy\n\n    def set_strategy(self, strategy: DeliveryStrategy):\n        self.strategy = strategy\n\n    def get_shipping_cost(self, weight: float) -> float:\n        return self.strategy.calculate(weight)"}, {"id": 22, "title": "Упростите переусложнённую функцию по принципу KISS", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Упростите переусложнённую функцию по принципу KISS.</p>", "initialCode": "def is_valid_username(name: str) -> bool:\n    pass", "solution": "# Упростите переусложнённую функцию по принципу KISS\n# Вместо сложных регулярных выражений и циклов\ndef is_valid_username(name: str) -> bool:\n    return 3 <= len(name) <= 20 and name.isalnum()", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"is_valid_username\" in globals() and callable(is_valid_username), \"Функция is_valid_username() должна быть определена\"\n_fn_nodes_is_valid_username = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"is_valid_username\"]\nassert _fn_nodes_is_valid_username and not (len(_fn_nodes_is_valid_username[0].body) == 1 and isinstance(_fn_nodes_is_valid_username[0].body[0], _ast.Pass)), \"Реализуйте тело функции is_valid_username() (сейчас там только pass)\"\nassert is_valid_username(\"alex123\") is True and is_valid_username(\"ab\") is False", "code": "# Упростите переусложнённую функцию по принципу KISS\n# Вместо сложных регулярных выражений и циклов\ndef is_valid_username(name: str) -> bool:\n    return 3 <= len(name) <= 20 and name.isalnum()"}, {"id": 23, "title": "Опишите свойства класса через @property и сеттер", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте инкапсуляцию температуры с валидацией через <code>@property</code>.</p><p class='meta'>В классе <code>Temperature</code> создайте геттер <code>@property def celsius(self)</code> и сеттер <code>@celsius.setter</code>, выбрасывающий исключение <code>ValueError(\"Температура не может быть ниже -273.15°C\")</code> при попытке установить недопустимое значение.</p>", "initialCode": "class Temperature:\n\n    def __init__(self, celsius: float=0.0):\n        pass\n\n    @property\n    def celsius(self) -> float:\n        pass\n\n    @celsius.setter\n    def celsius(self, value: float):\n        pass", "solution": "# Опишите свойства класса через @property и сеттер\nclass Temperature:\n    def __init__(self, celsius: float = 0.0):\n        self._celsius = celsius\n\n    @property\n    def celsius(self) -> float:\n        return self._celsius\n\n    @celsius.setter\n    def celsius(self, value: float):\n        if value < -273.15:\n            raise ValueError(\"Температура ниже абсолютного нуля!\")\n        self._celsius = value", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Temperature\" in globals() and isinstance(Temperature, type), \"Класс Temperature должен быть определён\"\n_cl_def_Temperature = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Temperature\"]\nassert _cl_def_Temperature and not (len(_cl_def_Temperature[0].body) == 1 and isinstance(_cl_def_Temperature[0].body[0], _ast.Pass)), \"Реализуйте тело класса Temperature (сейчас там только pass)\"\nassert hasattr(Temperature, \"__init__\"), \"В классе Temperature должен быть метод/свойство __init__\"\n_cl_nodes_Temperature___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Temperature\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Temperature___init__ and not (len(_cl_nodes_Temperature___init__[0].body) == 1 and isinstance(_cl_nodes_Temperature___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Temperature.__init__()\"\nassert hasattr(Temperature, \"celsius\"), \"В классе Temperature должен быть метод/свойство celsius\"\n_cl_nodes_Temperature_celsius = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Temperature\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"celsius\"]\nassert _cl_nodes_Temperature_celsius and not (len(_cl_nodes_Temperature_celsius[0].body) == 1 and isinstance(_cl_nodes_Temperature_celsius[0].body[0], _ast.Pass)), \"Реализуйте метод Temperature.celsius()\"\nassert hasattr(Temperature, \"celsius\"), \"В классе Temperature должен быть метод/свойство celsius\"\n_cl_nodes_Temperature_celsius = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Temperature\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"celsius\"]\nassert _cl_nodes_Temperature_celsius and not (len(_cl_nodes_Temperature_celsius[0].body) == 1 and isinstance(_cl_nodes_Temperature_celsius[0].body[0], _ast.Pass)), \"Реализуйте метод Temperature.celsius()\"\n_t_obj = Temperature(25); assert _t_obj.celsius == 25", "code": "# Опишите свойства класса через @property и сеттер\nclass Temperature:\n    def __init__(self, celsius: float = 0.0):\n        self._celsius = celsius\n\n    @property\n    def celsius(self) -> float:\n        return self._celsius\n\n    @celsius.setter\n    def celsius(self, value: float):\n        if value < -273.15:\n            raise ValueError(\"Температура ниже абсолютного нуля!\")\n        self._celsius = value"}, {"id": 24, "title": "Напишите SELECT с условиями WHERE и сортировкой ORDER BY", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите SQL-запрос выборки пользователей в переменной <code>sql</code>.</p><p class='meta'>Выберите столбцы <code>id</code>, <code>username</code>, <code>email</code>, <code>created_at</code> из таблицы <code>users</code>, где <code>is_active = TRUE</code>, отсортируйте по <code>created_at DESC</code> и ограничьте вывод <code>LIMIT 10</code>.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Напишите SELECT с условиями WHERE и сортировкой ORDER BY\nsql = \"\"\"\nSELECT id, username, email, created_at \nFROM users \nWHERE is_active = true AND created_at >= '2026-01-01'\nORDER BY created_at DESC \nLIMIT 50;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"username\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'username'\"\nassert isinstance(sql, str) and \"email\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'email'\"", "code": "# Напишите SELECT с условиями WHERE и сортировкой ORDER BY\nsql = \"\"\"\nSELECT id, username, email, created_at \nFROM users \nWHERE is_active = true AND created_at >= '2026-01-01'\nORDER BY created_at DESC \nLIMIT 50;\n\"\"\""}, {"id": 25, "title": "Опишите интерфейс UserRepository с get_by_id и save", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Опишите абстрактный интерфейс репозитория пользователей с помощью модуля <code>abc</code>.</p><p class='meta'>Класс <code>UserRepository(ABC)</code> должен содержать абстрактные методы <code>@abstractmethod def get_by_id(self, user_id: int) -> dict</code> и <code>@abstractmethod def save(self, user: dict) -> None</code>.</p>", "initialCode": "from abc import ABC, abstractmethod\nfrom typing import Optional\nclass IUserRepository(ABC):\n    pass", "solution": "# Опишите интерфейс UserRepository с get_by_id и save\nfrom abc import ABC, abstractmethod\nfrom typing import Optional\n\nclass IUserRepository(ABC):\n    @abstractmethod\n    def get_by_id(self, user_id: int) -> Optional[dict]: pass\n\n    @abstractmethod\n    def save(self, user: dict) -> None: pass", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"IUserRepository\" in globals() and isinstance(IUserRepository, type), \"Класс IUserRepository должен быть определён\"\n_cl_def_IUserRepository = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"IUserRepository\"]\nassert _cl_def_IUserRepository and not (len(_cl_def_IUserRepository[0].body) == 1 and isinstance(_cl_def_IUserRepository[0].body[0], _ast.Pass)), \"Реализуйте тело класса IUserRepository (сейчас там только pass)\"\nassert hasattr(IUserRepository, \"get_by_id\"), \"В классе IUserRepository должен быть метод/свойство get_by_id\"\nassert hasattr(IUserRepository, \"save\"), \"В классе IUserRepository должен быть метод/свойство save\"\nassert len([n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.FunctionDef) and n.name in (\"get_by_id\", \"save\")]) >= 2, \"Опишите методы get_by_id и save в интерфейсе UserRepository\"", "code": "# Опишите интерфейс UserRepository с get_by_id и save\nfrom abc import ABC, abstractmethod\nfrom typing import Optional\n\nclass IUserRepository(ABC):\n    @abstractmethod\n    def get_by_id(self, user_id: int) -> Optional[dict]: pass\n\n    @abstractmethod\n    def save(self, user: dict) -> None: pass"}, {"id": 26, "title": "Разделите толстый интерфейс на мелкие через typing.Protocol", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Разделите толстый интерфейс на мелкие через typing.Protocol.</p>", "initialCode": "from typing import Protocol\nclass Printable(Protocol):\n\n    def print_content(self) -> None:\n        pass\nclass Serializable(Protocol):\n\n    def to_json(self) -> str:\n        pass\nclass UserDoc:\n\n    def print_content(self) -> None:\n        pass\n\n    def to_json(self) -> str:\n        pass", "solution": "# Разделите толстый интерфейс на мелкие через typing.Protocol\nfrom typing import Protocol\n\nclass Printable(Protocol):\n    def print_content(self) -> None: ...\n\nclass Serializable(Protocol):\n    def to_json(self) -> str: ...\n\nclass UserDoc:\n    def print_content(self) -> None:\n        print(\"Rendering document...\")\n    \n    def to_json(self) -> str:\n        return '{\"type\": \"doc\"}'", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Printable\" in globals() and isinstance(Printable, type), \"Класс Printable должен быть определён\"\n_cl_def_Printable = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Printable\"]\nassert _cl_def_Printable and not (len(_cl_def_Printable[0].body) == 1 and isinstance(_cl_def_Printable[0].body[0], _ast.Pass)), \"Реализуйте тело класса Printable (сейчас там только pass)\"\nassert hasattr(Printable, \"print_content\"), \"В классе Printable должен быть метод/свойство print_content\"\nassert \"Serializable\" in globals() and isinstance(Serializable, type), \"Класс Serializable должен быть определён\"\n_cl_def_Serializable = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Serializable\"]\nassert _cl_def_Serializable and not (len(_cl_def_Serializable[0].body) == 1 and isinstance(_cl_def_Serializable[0].body[0], _ast.Pass)), \"Реализуйте тело класса Serializable (сейчас там только pass)\"\nassert hasattr(Serializable, \"to_json\"), \"В классе Serializable должен быть метод/свойство to_json\"\nassert \"UserDoc\" in globals() and isinstance(UserDoc, type), \"Класс UserDoc должен быть определён\"\n_cl_def_UserDoc = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UserDoc\"]\nassert _cl_def_UserDoc and not (len(_cl_def_UserDoc[0].body) == 1 and isinstance(_cl_def_UserDoc[0].body[0], _ast.Pass)), \"Реализуйте тело класса UserDoc (сейчас там только pass)\"\nassert hasattr(UserDoc, \"print_content\"), \"В классе UserDoc должен быть метод/свойство print_content\"\n_cl_nodes_UserDoc_print_content = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UserDoc\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"print_content\"]\nassert _cl_nodes_UserDoc_print_content and not (len(_cl_nodes_UserDoc_print_content[0].body) == 1 and isinstance(_cl_nodes_UserDoc_print_content[0].body[0], _ast.Pass)), \"Реализуйте метод UserDoc.print_content()\"\nassert hasattr(UserDoc, \"to_json\"), \"В классе UserDoc должен быть метод/свойство to_json\"\n_cl_nodes_UserDoc_to_json = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UserDoc\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"to_json\"]\nassert _cl_nodes_UserDoc_to_json and not (len(_cl_nodes_UserDoc_to_json[0].body) == 1 and isinstance(_cl_nodes_UserDoc_to_json[0].body[0], _ast.Pass)), \"Реализуйте метод UserDoc.to_json()\"", "code": "# Разделите толстый интерфейс на мелкие через typing.Protocol\nfrom typing import Protocol\n\nclass Printable(Protocol):\n    def print_content(self) -> None: ...\n\nclass Serializable(Protocol):\n    def to_json(self) -> str: ...\n\nclass UserDoc:\n    def print_content(self) -> None:\n        print(\"Rendering document...\")\n    \n    def to_json(self) -> str:\n        return '{\"type\": \"doc\"}'"}, {"id": 27, "title": "Выполните базовые команды Redis: SET, GET, EXPIRE", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Выполните управление сессией пользователя через клиент Redis.</p><p class='meta'>С помощью клиента <code>r</code> установите ключ <code>\"session:123\"</code> со значением <code>\"user_auth_token\"</code>, задайте TTL <code>3600</code> секунд через <code>expire</code> и прочитайте значение ключа в переменную <code>val</code>.</p>", "initialCode": "import redis\n\nr = redis.Redis(host='localhost', port=6379, decode_responses=True)\nval = None\nttl = None", "solution": "# Выполните базовые команды Redis: SET, GET, EXPIRE\nimport redis\n\nr = redis.Redis(host='localhost', port=6379, decode_responses=True)\nr.set('session:123', 'user_data', ex=3600)\nval = r.get('session:123')\nttl = r.ttl('session:123')", "hint": "Используй стандартные команды Redis-клиента: r.set(key, value), r.get(key) и r.expire(key, seconds).", "tests": "import ast as _ast\nassert \"r\" in globals() and r is not None, \"Переменная r должна быть определена и не равна None\"\nassert r != \"__TODO__\", \"Заполните значение переменной r\"\nassert \"val\" in globals() and val is not None, \"Переменная val должна быть определена и не равна None\"\nassert val != \"__TODO__\", \"Заполните значение переменной val\"\nassert \"ttl\" in globals() and ttl is not None, \"Переменная ttl должна быть определена и не равна None\"\nassert ttl != \"__TODO__\", \"Заполните значение переменной ttl\"", "code": "# Выполните базовые команды Redis: SET, GET, EXPIRE\nimport redis\n\nr = redis.Redis(host='localhost', port=6379, decode_responses=True)\nr.set('session:123', 'user_data', ex=3600)\nval = r.get('session:123')\nttl = r.ttl('session:123')"}, {"id": 28, "title": "Напишите тест функции с фикстурой @pytest.fixture", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите юнит-тест с использованием фикстуры <code>pytest</code>.</p><p class='meta'>Создайте фикстуру <code>@pytest.fixture def sample_user()</code>, возвращающую тестовый словарь пользователя <code>{\"username\": \"alex\", \"age\": 25}</code>, и передайте её в тест <code>test_user_is_adult(sample_user)</code> для проверки совершеннолетия.</p>", "initialCode": "import pytest\n@pytest.fixture\ndef user_payload():\n    pass\ndef test_create_user(user_payload):\n    pass", "solution": "# Напишите тест функции с фикстурой @pytest.fixture\nimport pytest\n\n@pytest.fixture\ndef user_payload():\n    return {\"username\": \"test_user\", \"email\": \"test@example.com\"}\n\ndef test_create_user(user_payload):\n    assert user_payload[\"username\"] == \"test_user\"", "hint": "Шаг 1: Оберни вспомогательную функцию декоратором @pytest.fixture. Шаг 2: Укажи имя фикстуры в качестве аргумента тестовой функции def test_*(fixture_name).", "tests": "import ast as _ast\nassert \"user_payload\" in globals() and callable(user_payload), \"Функция user_payload() должна быть определена\"\n_fn_nodes_user_payload = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"user_payload\"]\nassert _fn_nodes_user_payload and not (len(_fn_nodes_user_payload[0].body) == 1 and isinstance(_fn_nodes_user_payload[0].body[0], _ast.Pass)), \"Реализуйте тело функции user_payload() (сейчас там только pass)\"\nassert \"test_create_user\" in globals() and callable(test_create_user), \"Функция test_create_user() должна быть определена\"\n_fn_nodes_test_create_user = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"test_create_user\"]\nassert _fn_nodes_test_create_user and not (len(_fn_nodes_test_create_user[0].body) == 1 and isinstance(_fn_nodes_test_create_user[0].body[0], _ast.Pass)), \"Реализуйте тело функции test_create_user() (сейчас там только pass)\"\n_t_list = [(k, v) for k, v in list(globals().items()) if k.startswith(\"test_\") and callable(v)]\nassert len(_t_list) > 0, \"Должна быть определена тестовая функция test_*\"\n_fix_map = {k: v for k, v in list(globals().items()) if callable(v) and getattr(v, \"_is_fixture\", False)}\nfor _tn, _tf in _t_list:\n    _cases = [({}, \"\")]\n    if hasattr(_tf, \"_parametrize\"):\n        _pnames, _pvals = _tf._parametrize\n        _cases = []\n        for _ix, _pv in enumerate(_pvals):\n            _raw = _pv.values if hasattr(_pv, \"values\") else (_pv if isinstance(_pv, (tuple, list)) else (_pv,))\n            _cases.append((dict(zip(_pnames, _raw)), f\"[{_ix}]\"))\n    _sig = list(_inspect.signature(_tf).parameters.keys())\n    for _cargs, _csuf in _cases:\n        _tds = []\n        _kw = dict(_cargs)\n        for _p in _sig:\n            if _p in _kw: continue\n            if _p == \"tmp_path\": _kw[_p] = _MemPath(\"/tmp/pytest_sandbox\")\n            elif _p == \"monkeypatch\":\n                _mp = _MonkeyPatch(); _kw[_p] = _mp; _tds.append(_mp.undo)\n            elif _p == \"caplog\": _kw[_p] = _CapLog()\n            elif _p in _fix_map:\n                _r = _fix_map[_p]()\n                if hasattr(_r, \"__next__\"):\n                    _kw[_p] = next(_r)\n                    _tds.append(lambda g=_r: next(g, None))\n                else: _kw[_p] = _r\n        try:\n            _tf(**_kw)\n        finally:\n            for _td in reversed(_tds): _td()", "code": "# Напишите тест функции с фикстурой @pytest.fixture\nimport pytest\n\n@pytest.fixture\ndef user_payload():\n    return {\"username\": \"test_user\", \"email\": \"test@example.com\"}\n\ndef test_create_user(user_payload):\n    assert user_payload[\"username\"] == \"test_user\""}, {"id": 29, "title": "Разбейте God Object класс по принципу SRP", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Разбейте God Object класс по принципу SRP.</p>", "initialCode": "class UserRepository:\n\n    def save(self, user):\n        pass\nclass EmailService:\n\n    def send_welcome(self, email: str):\n        pass\nclass AuthService:\n\n    def __init__(self, repo: UserRepository, mailer: EmailService):\n        pass\n\n    def register(self, user_data: dict):\n        pass", "solution": "# Разбейте God Object класс по принципу SRP\n# Разделение UserManager на аутентификацию, рассылку и хранилище\nclass UserRepository:\n    def save(self, user):\n        print(f\"Сохранение пользователя {user['id']} в БД\")\n\nclass EmailService:\n    def send_welcome(self, email: str):\n        print(f\"Отправка приветственного письма на {email}\")\n\nclass AuthService:\n    def __init__(self, repo: UserRepository, mailer: EmailService):\n        self.repo = repo\n        self.mailer = mailer\n\n    def register(self, user_data: dict):\n        self.repo.save(user_data)\n        self.mailer.send_welcome(user_data['email'])", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"UserRepository\" in globals() and isinstance(UserRepository, type), \"Класс UserRepository должен быть определён\"\n_cl_def_UserRepository = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UserRepository\"]\nassert _cl_def_UserRepository and not (len(_cl_def_UserRepository[0].body) == 1 and isinstance(_cl_def_UserRepository[0].body[0], _ast.Pass)), \"Реализуйте тело класса UserRepository (сейчас там только pass)\"\nassert hasattr(UserRepository, \"save\"), \"В классе UserRepository должен быть метод/свойство save\"\n_cl_nodes_UserRepository_save = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UserRepository\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"save\"]\nassert _cl_nodes_UserRepository_save and not (len(_cl_nodes_UserRepository_save[0].body) == 1 and isinstance(_cl_nodes_UserRepository_save[0].body[0], _ast.Pass)), \"Реализуйте метод UserRepository.save()\"\nassert \"EmailService\" in globals() and isinstance(EmailService, type), \"Класс EmailService должен быть определён\"\n_cl_def_EmailService = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"EmailService\"]\nassert _cl_def_EmailService and not (len(_cl_def_EmailService[0].body) == 1 and isinstance(_cl_def_EmailService[0].body[0], _ast.Pass)), \"Реализуйте тело класса EmailService (сейчас там только pass)\"\nassert hasattr(EmailService, \"send_welcome\"), \"В классе EmailService должен быть метод/свойство send_welcome\"\n_cl_nodes_EmailService_send_welcome = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"EmailService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"send_welcome\"]\nassert _cl_nodes_EmailService_send_welcome and not (len(_cl_nodes_EmailService_send_welcome[0].body) == 1 and isinstance(_cl_nodes_EmailService_send_welcome[0].body[0], _ast.Pass)), \"Реализуйте метод EmailService.send_welcome()\"\nassert \"AuthService\" in globals() and isinstance(AuthService, type), \"Класс AuthService должен быть определён\"\n_cl_def_AuthService = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"AuthService\"]\nassert _cl_def_AuthService and not (len(_cl_def_AuthService[0].body) == 1 and isinstance(_cl_def_AuthService[0].body[0], _ast.Pass)), \"Реализуйте тело класса AuthService (сейчас там только pass)\"\nassert hasattr(AuthService, \"__init__\"), \"В классе AuthService должен быть метод/свойство __init__\"\n_cl_nodes_AuthService___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"AuthService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_AuthService___init__ and not (len(_cl_nodes_AuthService___init__[0].body) == 1 and isinstance(_cl_nodes_AuthService___init__[0].body[0], _ast.Pass)), \"Реализуйте метод AuthService.__init__()\"\nassert hasattr(AuthService, \"register\"), \"В классе AuthService должен быть метод/свойство register\"\n_cl_nodes_AuthService_register = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"AuthService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"register\"]\nassert _cl_nodes_AuthService_register and not (len(_cl_nodes_AuthService_register[0].body) == 1 and isinstance(_cl_nodes_AuthService_register[0].body[0], _ast.Pass)), \"Реализуйте метод AuthService.register()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Разбейте God Object класс по принципу SRP\n# Разделение UserManager на аутентификацию, рассылку и хранилище\nclass UserRepository:\n    def save(self, user):\n        print(f\"Сохранение пользователя {user['id']} в БД\")\n\nclass EmailService:\n    def send_welcome(self, email: str):\n        print(f\"Отправка приветственного письма на {email}\")\n\nclass AuthService:\n    def __init__(self, repo: UserRepository, mailer: EmailService):\n        self.repo = repo\n        self.mailer = mailer\n\n    def register(self, user_data: dict):\n        self.repo.save(user_data)\n        self.mailer.send_welcome(user_data['email'])"}, {"id": 30, "title": "Напишите подзапрос в секции WHERE с оператором IN", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите SQL-запрос выборки курсов с подзапросом в условии WHERE в переменной <code>sql</code>.</p><p class='meta'>Выберите <code>title</code> и <code>price</code> из таблицы <code>courses</code>, где <code>author_id</code> входит (<code>IN</code>) в список идентификаторов верифицированных авторов из таблицы <code>authors</code> (<code>WHERE is_verified = TRUE</code>).</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Напишите подзапрос в секции WHERE с оператором IN\nsql = \"\"\"\nSELECT title, price \nFROM products \nWHERE category_id IN (\n    SELECT id FROM categories WHERE is_active = true AND priority > 5\n);\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"title\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'title'\"\nassert isinstance(sql, str) and \"price\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'price'\"", "code": "# Напишите подзапрос в секции WHERE с оператором IN\nsql = \"\"\"\nSELECT title, price \nFROM products \nWHERE category_id IN (\n    SELECT id FROM categories WHERE is_active = true AND priority > 5\n);\n\"\"\""}, {"id": 31, "title": "Постройте список смежности из перечня рёбер графа", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте список смежности из перечня рёбер графа.</p>", "initialCode": "from collections import defaultdict\ndef build_adjacency_list(num_nodes: int, edges: list) -> dict:\n    pass", "solution": "# Постройте список смежности из перечня рёбер графа\nfrom collections import defaultdict\n\ndef build_adjacency_list(num_nodes: int, edges: list) -> dict:\n    graph = defaultdict(list)\n    for u, v in edges:\n        graph[u].append(v)\n        graph[v].append(u)  # для неориентированного графа\n    return graph", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"build_adjacency_list\" in globals() and callable(build_adjacency_list), \"Функция build_adjacency_list() должна быть определена\"\n_fn_nodes_build_adjacency_list = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"build_adjacency_list\"]\nassert _fn_nodes_build_adjacency_list and not (len(_fn_nodes_build_adjacency_list[0].body) == 1 and isinstance(_fn_nodes_build_adjacency_list[0].body[0], _ast.Pass)), \"Реализуйте тело функции build_adjacency_list() (сейчас там только pass)\"\n_g = build_adjacency_list(3, [(0, 1), (1, 2)]); assert 1 in _g[0] and 0 in _g[1]", "code": "# Постройте список смежности из перечня рёбер графа\nfrom collections import defaultdict\n\ndef build_adjacency_list(num_nodes: int, edges: list) -> dict:\n    graph = defaultdict(list)\n    for u, v in edges:\n        graph[u].append(v)\n        graph[v].append(u)  # для неориентированного графа\n    return graph"}, {"id": 32, "title": "Реализуйте санитизацию пользовательского ввода от XSS", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте санитизацию пользовательского ввода от XSS.</p>", "initialCode": "import html\ndef sanitize_input(text: str) -> str:\n    pass", "solution": "# Реализуйте санитизацию пользовательского ввода от XSS\nimport html\n\ndef sanitize_input(text: str) -> str:\n    # Экранирование спецсимволов HTML (&, <, >, \", ')\n    return html.escape(text.strip(), quote=True)\n\nsafe = sanitize_input('  <script>alert(\"xss\")<\/script>  ')\nprint(safe)\nassert safe == \"&lt;script&gt;alert(&quot;xss&quot;)&lt;/script&gt;\"\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sanitize_input\" in globals() and callable(sanitize_input), \"Функция sanitize_input() должна быть определена\"\n_fn_nodes_sanitize_input = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"sanitize_input\"]\nassert _fn_nodes_sanitize_input and not (len(_fn_nodes_sanitize_input[0].body) == 1 and isinstance(_fn_nodes_sanitize_input[0].body[0], _ast.Pass)), \"Реализуйте тело функции sanitize_input() (сейчас там только pass)\"\nsafe = sanitize_input('  <script>alert(\"xss\")<\/script>  ')\nprint(safe)\nassert safe == \"&lt;script&gt;alert(&quot;xss&quot;)&lt;/script&gt;\"\nassert \"safe\" in globals(), \"Переменная safe должна быть вычислена\"", "code": "# Реализуйте санитизацию пользовательского ввода от XSS\nimport html\n\ndef sanitize_input(text: str) -> str:\n    # Экранирование спецсимволов HTML (&, <, >, \", ')\n    return html.escape(text.strip(), quote=True)\n\nsafe = sanitize_input('  <script>alert(\"xss\")<\/script>  ')\nprint(safe)\nassert safe == \"&lt;script&gt;alert(&quot;xss&quot;)&lt;/script&gt;\"\n"}, {"id": 33, "title": "Опишите Pydantic схему создания пользователя с валидацией", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Опишите Pydantic схему создания пользователя с валидацией.</p>", "initialCode": "from pydantic import BaseModel, EmailStr, field_validator\nclass UserCreate(BaseModel):\n    username: str\n    email: EmailStr\n    password: str\n\n    @field_validator('password')\n    @classmethod\n    def validate_password(cls, v: str) -> str:\n        pass", "solution": "# Опишите Pydantic схему создания пользователя с валидацией\nfrom pydantic import BaseModel, EmailStr, field_validator\n\nclass UserCreate(BaseModel):\n    username: str\n    email: EmailStr\n    password: str\n\n    @field_validator('password')\n    @classmethod\n    def validate_password(cls, v: str) -> str:\n        if len(v) < 8:\n            raise ValueError('Пароль должен содержать минимум 8 символов')\n        return v\n\nuser = UserCreate(username=\"alice\", email=\"alice@example.com\", password=\"secret_password\")\nprint(user.model_dump())\nassert user.username == \"alice\"\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"UserCreate\" in globals() and isinstance(UserCreate, type), \"Класс UserCreate должен быть определён\"\n_cl_def_UserCreate = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UserCreate\"]\nassert _cl_def_UserCreate and not (len(_cl_def_UserCreate[0].body) == 1 and isinstance(_cl_def_UserCreate[0].body[0], _ast.Pass)), \"Реализуйте тело класса UserCreate (сейчас там только pass)\"\nassert hasattr(UserCreate, \"validate_password\"), \"В классе UserCreate должен быть метод/свойство validate_password\"\n_cl_nodes_UserCreate_validate_password = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UserCreate\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"validate_password\"]\nassert _cl_nodes_UserCreate_validate_password and not (len(_cl_nodes_UserCreate_validate_password[0].body) == 1 and isinstance(_cl_nodes_UserCreate_validate_password[0].body[0], _ast.Pass)), \"Реализуйте метод UserCreate.validate_password()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nuser = UserCreate(username=\"alice\", email=\"alice@example.com\", password=\"secret_password\")\nprint(user.model_dump())\nassert user.username == \"alice\"\nassert \"user\" in globals(), \"Переменная user должна быть вычислена\"", "code": "# Опишите Pydantic схему создания пользователя с валидацией\nfrom pydantic import BaseModel, EmailStr, field_validator\n\nclass UserCreate(BaseModel):\n    username: str\n    email: EmailStr\n    password: str\n\n    @field_validator('password')\n    @classmethod\n    def validate_password(cls, v: str) -> str:\n        if len(v) < 8:\n            raise ValueError('Пароль должен содержать минимум 8 символов')\n        return v\n\nuser = UserCreate(username=\"alice\", email=\"alice@example.com\", password=\"secret_password\")\nprint(user.model_dump())\nassert user.username == \"alice\"\n"}, {"id": 34, "title": "Реализуйте паттерн Strategy для расчета доставки", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте паттерн Strategy для расчета доставки.</p>", "initialCode": "from abc import ABC, abstractmethod\nclass DeliveryStrategy(ABC):\n\n    @abstractmethod\n    def calculate(self, weight: float) -> float:\n        pass\nclass CourierStrategy(DeliveryStrategy):\n\n    def calculate(self, weight: float) -> float:\n        pass\nclass PostStrategy(DeliveryStrategy):\n\n    def calculate(self, weight: float) -> float:\n        pass", "solution": "# Реализуйте паттерн Strategy для расчета доставки\nfrom abc import ABC, abstractmethod\n\nclass DeliveryStrategy(ABC):\n    @abstractmethod\n    def calculate(self, weight: float) -> float: pass\n\nclass CourierStrategy(DeliveryStrategy):\n    def calculate(self, weight: float) -> float: return 300.0 + weight * 50\n\nclass PostStrategy(DeliveryStrategy):\n    def calculate(self, weight: float) -> float: return 150.0 + weight * 20", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"DeliveryStrategy\" in globals() and isinstance(DeliveryStrategy, type), \"Класс DeliveryStrategy должен быть определён\"\n_cl_def_DeliveryStrategy = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"DeliveryStrategy\"]\nassert _cl_def_DeliveryStrategy and not (len(_cl_def_DeliveryStrategy[0].body) == 1 and isinstance(_cl_def_DeliveryStrategy[0].body[0], _ast.Pass)), \"Реализуйте тело класса DeliveryStrategy (сейчас там только pass)\"\nassert hasattr(DeliveryStrategy, \"calculate\"), \"В классе DeliveryStrategy должен быть метод/свойство calculate\"\nassert \"CourierStrategy\" in globals() and isinstance(CourierStrategy, type), \"Класс CourierStrategy должен быть определён\"\n_cl_def_CourierStrategy = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CourierStrategy\"]\nassert _cl_def_CourierStrategy and not (len(_cl_def_CourierStrategy[0].body) == 1 and isinstance(_cl_def_CourierStrategy[0].body[0], _ast.Pass)), \"Реализуйте тело класса CourierStrategy (сейчас там только pass)\"\nassert hasattr(CourierStrategy, \"calculate\"), \"В классе CourierStrategy должен быть метод/свойство calculate\"\n_cl_nodes_CourierStrategy_calculate = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CourierStrategy\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"calculate\"]\nassert _cl_nodes_CourierStrategy_calculate and not (len(_cl_nodes_CourierStrategy_calculate[0].body) == 1 and isinstance(_cl_nodes_CourierStrategy_calculate[0].body[0], _ast.Pass)), \"Реализуйте метод CourierStrategy.calculate()\"\nassert \"PostStrategy\" in globals() and isinstance(PostStrategy, type), \"Класс PostStrategy должен быть определён\"\n_cl_def_PostStrategy = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PostStrategy\"]\nassert _cl_def_PostStrategy and not (len(_cl_def_PostStrategy[0].body) == 1 and isinstance(_cl_def_PostStrategy[0].body[0], _ast.Pass)), \"Реализуйте тело класса PostStrategy (сейчас там только pass)\"\nassert hasattr(PostStrategy, \"calculate\"), \"В классе PostStrategy должен быть метод/свойство calculate\"\n_cl_nodes_PostStrategy_calculate = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PostStrategy\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"calculate\"]\nassert _cl_nodes_PostStrategy_calculate and not (len(_cl_nodes_PostStrategy_calculate[0].body) == 1 and isinstance(_cl_nodes_PostStrategy_calculate[0].body[0], _ast.Pass)), \"Реализуйте метод PostStrategy.calculate()\"\nassert CourierStrategy().calculate(2) > PostStrategy().calculate(2)", "code": "# Реализуйте паттерн Strategy для расчета доставки\nfrom abc import ABC, abstractmethod\n\nclass DeliveryStrategy(ABC):\n    @abstractmethod\n    def calculate(self, weight: float) -> float: pass\n\nclass CourierStrategy(DeliveryStrategy):\n    def calculate(self, weight: float) -> float: return 300.0 + weight * 50\n\nclass PostStrategy(DeliveryStrategy):\n    def calculate(self, weight: float) -> float: return 150.0 + weight * 20"}, {"id": 35, "title": "Разделите генерацию отчета и его сохранение в файл", "level": 1, "tier": "🥚 Уровень 1", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Разделите генерацию отчета и его сохранение в файл.</p>", "initialCode": "class ReportGenerator:\n\n    def generate_csv(self, data: list) -> str:\n        pass\nclass ReportStorage:\n\n    def save_to_file(self, content: str, filename: str):\n        pass", "solution": "# Разделите генерацию отчета и его сохранение в файл\nclass ReportGenerator:\n    def generate_csv(self, data: list) -> str:\n        return \"\\n\".join([\",\".join(map(str, row)) for row in data])\n\nclass ReportStorage:\n    def save_to_file(self, content: str, filename: str):\n        with open(filename, 'w', encoding='utf-8') as f:\n            f.write(content)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"ReportGenerator\" in globals() and isinstance(ReportGenerator, type), \"Класс ReportGenerator должен быть определён\"\n_cl_def_Repor
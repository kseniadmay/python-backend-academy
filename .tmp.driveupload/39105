она [{self.min_value}, {self.max_value}]\"\n            )\n        setattr(obj, self.name, value)\n\n\nclass Sensor:\n    temperature = RangeValidator(-50, 50)\n\n\ns = Sensor()\ns.temperature = 22\ntry:\n    s.temperature = 100\nexcept ValueError as _e:\n    print(\"ValueError перехвачен:\", _e)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"RangeValidator\" in globals() and isinstance(RangeValidator, type), \"Класс RangeValidator должен быть определён\"\n_cl_def_RangeValidator = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"RangeValidator\"]\nassert _cl_def_RangeValidator and not (len(_cl_def_RangeValidator[0].body) == 1 and isinstance(_cl_def_RangeValidator[0].body[0], _ast.Pass)), \"Реализуйте тело класса RangeValidator (сейчас там только pass)\"\nassert hasattr(RangeValidator, \"__init__\"), \"В классе RangeValidator должен быть метод/свойство __init__\"\n_cl_nodes_RangeValidator___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"RangeValidator\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_RangeValidator___init__ and not (len(_cl_nodes_RangeValidator___init__[0].body) == 1 and isinstance(_cl_nodes_RangeValidator___init__[0].body[0], _ast.Pass)), \"Реализуйте метод RangeValidator.__init__()\"\nassert hasattr(RangeValidator, \"__set_name__\"), \"В классе RangeValidator должен быть метод/свойство __set_name__\"\n_cl_nodes_RangeValidator___set_name__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"RangeValidator\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__set_name__\"]\nassert _cl_nodes_RangeValid
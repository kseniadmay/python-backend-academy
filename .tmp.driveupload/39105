LightThemeFactory\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"create_button\"]\nassert _cl_nodes_LightThemeFactory_create_button and not (len(_cl_nodes_LightThemeFactory_create_button[0].body) == 1 and isinstance(_cl_nodes_LightThemeFactory_create_button[0].body[0], _ast.Pass)), \"Реализуйте метод LightThemeFactory.create_button()\"\nassert hasattr(LightThemeFactory, \"create_checkbox\"), \"В классе LightThemeFactory должен быть метод/свойство create_checkbox\"\n_cl_nodes_LightThemeFactory_create_checkbox = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LightThemeFactory\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"create_checkbox\"]\nassert _cl_nodes_LightThemeFactory_create_checkbox and not (len(_cl_nodes_LightThemeFactory_create_checkbox[0].body) == 1 and isinstance(_cl_nodes_LightThemeFactory_create_checkbox[0].body[0], _ast.Pass)), \"Реализуйте метод LightThemeFactory.create_checkbox()\"", "code": "# Постройте Abstract Factory для компонентов интерфейса\nfrom abc import ABC, abstractmethod\n\nclass GUIFactory(ABC):\n    @abstractmethod\n    def create_button(self): pass\n    @abstractmethod\n    def create_checkbox(self): pass\n\nclass DarkThemeFactory(GUIFactory):\n    def create_button(self): return \"DarkButton\"\n    def create_checkbox(self): return \"DarkCheckbox\"\n\nclass LightThemeFactory(GUIFactory):\n    def create_button(self): return \"LightButton\"\n    def create_checkbox(self): return \"LightCheckbox\""}, {"id": 155, "title": "Найдите кратчайший путь в невзвешенном графе через BFS", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Найдите кратчайший путь в невзвешенном графе через BFS.</p>", "initialCode": "from collections import deque\ndef shortest_path(graph: dict, start, target):\n    pass", "solution": "# Найдите кратчайший путь в невзвешенном графе через BFS\nfrom collections import deque\n\ndef shortest_path(graph: dict, start, target):\n    queue = deque([(start, [start])])\n    visited = {start}\n    while queue:\n        node, path = queue.popleft()\n        if node == target:\n            return path\n        for neighbor in graph.get(node, []):\n            if neighbor not in visited:\n                visited.add(neighbor)\n                queue.append((neighbor, path + [neighbor]))\n    return None", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"shortest_path\" in globals() and callable(shortest_path), \"Функция shortest_path() должна быть определена\"\n_fn_nodes_shortest_path = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"shortest_path\"]\nassert _fn_nodes_shortest_path and not (len(_fn_nodes_shortest_path[0].body) == 1 and isinstance(_fn_nodes_shortest_path[0].body[0], _ast.Pass)), \"Реализуйте тело функции shortest_path() (сейчас там только pass)\"", "code": "# Найдите кратчайший путь в невзвешенном графе через BFS\nfrom collections import deque\n\ndef shortest_path(graph: dict, start, target):\n    queue = deque([(start, [start])])\n    visited = {start}\n    while queue:\n        node, path = queue.popleft()\n        if node == target:\n            return path\n        for neighbor in graph.get(node, []):\n            if neighbor not in visited:\n                visited.add(neighbor)\n                queue.append((neighbor, path + [neighbor]))\n    return None"}, {"id": 156, "title": "Создайте паттерн Proxy для ленивой инициализации объекта", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте паттерн Proxy для ленивой инициализации объекта.</p>", "initialCode": "class Hea
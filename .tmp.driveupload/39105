)\"", "code": "# Исправьте нарушение LSP в иерархии Rectangle и Square\nfrom abc import ABC, abstractmethod\n\nclass Shape(ABC):\n    @abstractmethod\n    def area(self) -> float:\n        pass\n\nclass Rectangle(Shape):\n    def __init__(self, width: float, height: float):\n        self.width = width\n        self.height = height\n\n    def area(self) -> float:\n        return self.width * self.height\n\nclass Square(Shape):\n    def __init__(self, side: float):\n        self.side = side\n\n    def area(self) -> float:\n        return self.side ** 2"}, {"id": 102, "title": "Реализуйте паттерн Decorator для компрессии потока данных", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте паттерн Decorator для компрессии потока данных.</p>", "initialCode": "import gzip\nclass DataStream(ABC):\n\n    @abstractmethod\n    def write(self, data: bytes) -> bytes:\n        pass\nclass FileStream(DataStream):\n\n    def write(self, data: bytes) -> bytes:\n        pass\nclass GzipStreamDecorator(DataStream):\n\n    def __init__(self, stream: DataStream):\n        pass\n\n    def write(self, data: bytes) -> bytes:\n        pass", "solution": "# Реализуйте паттерн Decorator для компрессии потока данных\nimport gzip\n\nclass DataStream(ABC):\n    @abstractmethod\n    def write(self, data: bytes) -> bytes: pass\n\nclass FileStream(DataStream):\n    def write(self, data: bytes) -> bytes: return data\n\nclass GzipStreamDecorator(DataStream):\n    def __init__(self, stream: DataStream):\n        self.stream = stream\n\n    def write(self, data: bytes) -> bytes:\n        compressed = gzip.compress(data)\n        return self.stream.write(compressed)", "hint": "Шаг 1: Определи функцию-декоратор, принимающую func. Шаг 2: Внутри объяви wrapper(*args, **kwargs), вызови func и верни результат. Шаг 3: Верни wrapper.", "tests": "import ast as _ast\nassert \"DataStream\" in globals() and isinstance(DataStream, type), \"Класс DataStream должен быть определён\"\n_cl_def_DataStream = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"DataStream\"]\nassert _cl_def_DataStream and not (len(_cl_def_DataStream[0].body) == 1 and isinstance(_cl_def_DataStream[0].body[0], _ast.Pass)), \"Реализуйте тело класса DataStream (сейчас там только pass)\"\nassert hasattr(DataStream, \"write\"), \"В классе DataStream должен быть метод/свойство write\"\nassert \"FileStream\" in globals() and isinstance(FileStream, type), \"Класс FileStream должен быть определён\"\n_cl_def_FileStream = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"FileStream\"]\nassert _cl_def_FileStream and not (len(_cl_def_FileStream[0].body) == 1 and isinstance(_cl_def_FileStream[0].body[0], _ast.Pass)), \"Реализуйте тело класса FileStream (сейчас там только pass)\"\nassert hasattr(FileStream, \"write\"), \"В классе FileStream должен быть метод/свойство write\"\n_cl_nodes_FileStream_write = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"FileStream\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"write\"]\nassert _cl_nodes_FileStream_write and not (len(_cl_nodes_FileStream_write[0].body) == 1 and isinstance(_cl_nodes_FileStream_write[0].body[0], _ast.Pass)), \"Реализуйте метод FileStream.write()\"\nassert \"GzipStreamDecorator\" in globals() and isinstance(GzipStreamDecorator, type), \"Класс GzipStreamDecorator должен быть определён\"\n_cl_def_GzipStreamDecorator = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"GzipStreamDecorator\"]\nassert _cl_def_GzipStreamDecorator and not (len(_cl_def_GzipStreamDecorator[0].body) == 1 and isinstance(_cl_def_GzipStreamDecorator[0].body[0], _ast.Pass)), \"Реализуйте тело класса GzipStreamDecorator (сейчас там только pass)\"\nassert hasattr(GzipStreamDecorator, \"__init__\"), \
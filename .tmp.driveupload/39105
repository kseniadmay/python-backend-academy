\"Product 1\"}]\n\nclass ProductService:\n    def __init__(self, db: DatabaseConnection):\n        self._db = db  # инъекция через конструктор (DI)\n\n    def get_all(self):\n        return self._db.query(\"SELECT * FROM products\")"}, {"id": 54, "title": "Выделите логику валидации из контроллера в сервис", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Выделите логику валидации из контроллера в сервис.</p>", "initialCode": "class OrderValidator:\n\n    @staticmethod\n    def validate(order_data: dict):\n        pass\nclass OrderService:\n\n    def __init__(self, validator: OrderValidator):\n        pass\n\n    def create_order(self, data: dict):\n        pass", "solution": "# Выделите логику валидации из контроллера в сервис\nclass OrderValidator:\n    @staticmethod\n    def validate(order_data: dict):\n        if not order_data.get('items'):\n            raise ValueError(\"Заказ не может быть пустым\")\n        if order_data.get('total', 0) <= 0:\n            raise ValueError(\"Некорректная сумма заказа\")\n\nclass OrderService:\n    def __init__(self, validator: OrderValidator):\n        self.validator = validator\n\n    def create_order(self, data: dict):\n        self.validator.validate(data)\n        return {\"status\": \"created\", \"order\": data}", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"OrderValidator\" in globals() and isinstance(OrderValidator, type), \"Класс OrderValidator должен быть определён\"\n_cl_def_OrderValidator = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OrderValidator\"]\nassert _cl_def_OrderValidator and not (len(_cl_def_OrderValidator[0].body) == 1 and isinstance(_cl_def_OrderValidator[0].body[0], _ast.Pass)), \"Реализуйте тело класса OrderValidator (сейчас там только pass)\"\nassert hasattr(OrderValidator, \"validate\"), \"В классе OrderValidator должен быть метод/свойство validate\"\n_cl_nodes_OrderValidator_validate = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OrderValidator\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"validate\"]\nassert _cl_nodes_OrderValidator_validate and not (len(_cl_nodes_OrderValidator_validate[0].body) == 1 and isinstance(_cl_nodes_OrderValidator_validate[0].body[0], _ast.Pass)), \"Реализуйте метод OrderValidator.validate()\"\nassert \"OrderService\" in globals() and isinstance(OrderService, type), \"Класс OrderService должен быть определён\"\n_cl_def_OrderService = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OrderService\"]\nassert _cl_def_OrderService and not (len(_cl_def_OrderService[0].body) == 1 and isinstance(_cl_def_OrderService[0].body[0], _ast.Pass)), \"Реализуйте тело класса OrderService (сейчас там только pass)\"\nassert hasattr(OrderService, \"__init__\"), \"В классе OrderService должен быть метод/свойство __init__\"\n_cl_nodes_OrderService___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OrderService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_OrderService___init__ and not (len(_cl_nodes_OrderService___init__[0].body) == 1 and isinstance(_cl_nodes_OrderService___init__[0].body[0], _ast.Pass)), \"Реализуйте метод OrderService.__init__()\"\nassert hasattr(OrderService, \"create_order\"), \"В классе OrderService должен быть метод/свойство create_order\"\n_cl_nodes_OrderService_create_order = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OrderService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"create_order\"]\nassert _cl_nodes_OrderService_create_order and not (len(_cl_nodes_OrderService_create_order[0].body) == 1 and isinstance(_cl_nodes_OrderService_create_order[0].body[0], _ast.Pass)), \"Реализуйте метод OrderService.create_order()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Выделите логику валидации из контроллера в сервис\nclass OrderValidator:\n    @staticmethod\n    def validate(order_data: dict):\n        if not order_data.get('items'):\n            raise ValueError(\"Заказ не может быть пустым\")\n        if order_data.get('total', 0) <= 0:\n            raise ValueError(\"Некорректная сумма заказа\")\n\nclass OrderService:\n    def __init__(self, validator: OrderValidator):\n        self.validator = validator\n\n    def create_order(self, data: dict):\n        self.validator.validate(data)\n        return {\"status\": \"created\", \"order\": data}"}, {"id": 55, "title": "Реализуйте циклическую очередь фиксированного размера", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте циклическую очередь фиксированного размера.</p>", "initialCode": "class CircularQueue:\n\n    def __init__(self, k: int):\n        pass\n\n    def enqueue(self, val: int) -> bool:\n        pass\n\n    def dequeue(self) -> bool:\n        pass", "solution": "# Реализуйте циклическую очередь фиксированного размера\nclass CircularQueue:\n    def __init__(self, k: int):\n        self.data = [0] * k\n        self.head = 0\n        self.tail = 0\n        self.size = 0\n        self.capacity = k\n\n    def enqueue(self, val: int) -> bool:\n        if self.size == self.capacity:\n            return False\n        self.data[self.tail] = val\n        self.tail = (self.tail + 1) % self.capacity\n        self.size += 1\n        return True\n\n    def dequeue(self) -> bool:\n        if self.size == 0:\n            return False\n        self.head = (self.head + 1) % self.capacity\n        self.size -= 1\n        return True", "hint": "Шаг 1: Используй список или collections.deque. Шаг 2: Добавляй в конец (append), извлекай из начала (popleft / pop(0)) с валидацией непустого состояния.", "tests": "import ast as _ast\nassert \"CircularQueue\" in globals() and isinstance(CircularQueue, type), \"Класс CircularQueue должен быть определён\"\n_cl_def_CircularQueue = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CircularQueue\"]\nassert _cl_def_CircularQueue and not (len(_cl_def_CircularQueue[0].body) == 1 and isinstance(_cl_def_CircularQueue[0].body[0], _ast.Pass)), \"Реализуйте тело класса CircularQueue (сейчас там только pass)\"\nassert hasattr(CircularQueue, \"__init__\"), \"В классе CircularQueue должен быть метод/свойство __init__\"\n_cl_nodes_CircularQueue___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CircularQueue\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_CircularQueue___init__ and not (len(_cl_nodes_CircularQueue___init__[0].body) == 1 and isinstance(_cl_nodes_CircularQueue___init__[0].body[0], _ast.Pass)), \"Реализуйте метод CircularQueue.__init__()\"\nassert hasattr(CircularQueue, \"enqueue\"), \"В классе CircularQueue должен быть метод/свойство enqueue\"\n_cl_nodes_CircularQueue_enqueue = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CircularQueue\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"enqueue\"]\nassert _cl_nodes_CircularQueue_enqueue and not (len(_cl_nodes_CircularQueue_enqueue[0].body) == 1 and isinstance(_cl_nodes_CircularQueue_enqueue[0].body[0], _ast.Pass)), \"Реализуйте метод CircularQueue.enqueue()\"\nassert hasattr(CircularQueue, \"dequeue\"), \"В классе CircularQueue должен быть метод/свойство dequeue\"\n_cl_nodes_CircularQueue_dequeue = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CircularQueue\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"dequeue\"]\nassert _cl_nodes_CircularQueue_dequeue and not (len(_cl_nodes_CircularQueue_dequeue[0].body) == 1 and isinstance(_cl_nodes_CircularQueue_dequeue[0].body[0], _ast.Pass)), \"Реализуйте метод CircularQueue.dequeue()\"\n_cq = CircularQueue(2); assert _cq.enqueue(1) and _cq.enqueue(2) and not _cq.enqueue(3) and _cq.dequeue()", "code": "# Реализуйте циклическую очередь фиксированного размера\nclass CircularQueue:\n    def __init__(self, k: int):\n        self.data = [0] * k\n        self.head = 0\n        self.tail = 0\n        self.size = 0\n        self.capacity = k\n\n    def enqueue(self, val: int) -> bool:\n        if self.size == self.capacity:\n            return False\n        self.data[self.tail] = val\n        self.tail = (self.tail + 1) % self.capacity\n        self.size += 1\n        return True\n\n    def dequeue(self) -> bool:\n        if self.size == 0:\n            return False\n        self.head = (self.head + 1) % self.capacity\n        self.size -= 1\n        return True"}, {"id": 56, "title": "Создайте InMemoryUserRepository для быстрого тестирования", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте InMemoryUserRepository для быстрого тестирования.</p>", "initialCode": "class InMemoryUserRepository(IUserRepository):\n\n    def __init__(self):\n        pass\n\n    def get_by_id(self, user_id: int):\n        pass\n\n    def save(self, user: dict):\n        pass", "solution": "# Создайте InMemoryUserRepository для быстрого тестирования\nclass InMemoryUserRepository(IUserRepository):\n    def __init__(self):\n        self._store = {}\n\n    def get_by_id(self, user_id: int):\n        return self._store.get(user_id)\n\n    def save(self, user: dict):\n        self._store[user[\"id\"]] = user", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"InMemoryUserRepository\" in globals() and isinstance(InMemoryUserRepository, type), \"Класс InMemoryUserRepository должен быть определён\"\n_cl_def_InMemoryUserRepository = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"InMemoryUserRepository\"]\nassert _cl_def_InMemoryUserRepository and not (len(_cl_def_InMemoryUserRepository[0].body) == 1 and isinstance(_cl_def_InMemoryUserRepository[0].body[0], _ast.Pass)), \"Реализуйте тело класса InMemoryUserRepository (сейчас там только pass)\"\nassert hasattr(InMemoryUserRepository, \"__init__\"), \"В классе InMemoryUserRepository должен быть метод/свойство __init__\"\n_cl_nodes_InMemoryUserRepository___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"InMemoryUserRepository\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_InMemoryUserRepository___init__ and not (len(_cl_nodes_InMemoryUserRepository___init__[0].body) == 1 and isinstance(_cl_nodes_InMemoryUserRepository___init__[0].body[0], _ast.Pass)), \"Реализуйте метод InMemoryUserRepository.__init__()\"\nassert hasattr(InMemoryUserRepository, \"get_by_id\"), \"В классе InMemoryUserRepository должен быть метод/свойство get_by_id\"\n_cl_nodes_InMemoryUserRepository_get_by_id = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"InMemoryUserRepository\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"get_by_id\"]\nassert _cl_nodes_InMemoryUserRepository_get_by_id and not (len(_cl_nodes_InMemoryUserRepository_get_by_id[0].body) == 1 and isinstance(_cl_nodes_InMemoryUserRepository_get_by_id[0].body[0], _ast.Pass)), \"Реализуйте метод InMemoryUserRepository.get_by_id()\"\nassert hasattr(InMemoryUserRepository, \"save\"), \"В классе InMemoryUserRepository должен быть метод/свойство save\"\n_cl_nodes_InMemoryUserRepository_save = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"InMemoryUserRepository\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"save\"]\nassert _cl_nodes_InMemoryUserRepository_save and not (len(_cl_nodes_InMemoryUserRepository_save[0].body) == 1 and isinstance(_cl_nodes_InMemoryUserRepository_save[0].body[0], _ast.Pass)), \"Реализуйте метод InMemoryUserRepository.save()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\n_repo = InMemoryUserRepository(); _repo.save({\"id\": 1, \"name\": \"A\"}); assert _repo.get_by_id(1)[\"name\"] == \"A\"", "code": "# Создайте InMemoryUserRepository для быстрого тестирования\nclass InMemoryUserRepository(IUserRepository):\n    def __init__(self):\n        self._store = {}\n\n    def get_by_id(self, user_id: int):\n        return self._store.get(user_id)\n\n    def save(self, user: dict):\n        self._store[user[\"id\"]] = user"}, {"id": 57, "title": "Создайте подписчика на событие регистрации пользователя", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте подписчика на событие регистрации пользователя.</p>", "initialCode": "def on_user_registered(user: dict):\n    pass", "solution": "# Создайте подписчика на событие регистрации пользователя\ndef on_user_registered(user: dict):\n    print(f\"Отправка приветственного письма для: {user['email']}\")\n\nemitter = EventEmitter()\nemitter.on('user_registered', on_user_registered)\nemitter.emit('user_registered', {'email': 'user@example.com'})", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"on_user_registered\" in globals() and callable(on_user_registered), \"Функция on_user_registered() должна быть определена\"\n_fn_nodes_on_user_registered = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"on_user_registered\"]\nassert _fn_nodes_on_user_registered and not (len(_fn_nodes_on_user_registered[0].body) == 1 and isinstance(_fn_nodes_on_user_registered[0].body[0], _ast.Pass)), \"Реализуйте тело функции on_user_registered() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nemitter = EventEmitter()\nemitter.on('user_registered', on_user_registered)\nemitter.emit('user_registered', {'email': 'user@example.com'})\nassert \"emitter\" in globals(), \"Переменная emitter должна быть вычислена\"", "code": "# Создайте подписчика на событие регистрации пользователя\ndef on_user_registered(user: dict):\n    print(f\"Отправка приветственного письма для: {user['email']}\")\n\nemitter = EventEmitter()\nemitter.on('user_registered', on_user_registered)\nemitter.emit('user_registered', {'email': 'user@example.com'})"}, {"id": 58, "title": "Выполните ALTER TABLE с добавлением колонки и DEFAULT", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите DDL-команду добавления новой колонки в переменную <code>sql</code>.</p><p class='meta'>Используйте оператор <code>ALTER TABLE users ADD COLUMN</code> для добавления столбца <code>status VARCHAR(32) NOT NULL DEFAULT 'active';</code>.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Выполните ALTER TABLE с добавлением колонки и DEFAULT\nsql = \"\"\"\nALTER TABLE users \nADD COLUMN is_active BOOLEAN NOT NULL DEFAULT true,\nADD COLUMN last_login TIMESTAMP WITH TIME ZONE;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"ALTER\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'ALTER'\"\nassert isinstance(sql, str) and \"TABLE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'TABLE'\"\nassert isinstance(sql, str) and \"users\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'users'\"", "code": "# Выполните ALTER TABLE с добавлением колонки и DEFAULT\nsql = \"\"\"\nALTER TABLE users \nADD COLUMN is_active BOOLEAN NOT NULL DEFAULT true,\nADD COLUMN last_login TIMESTAMP WITH TIME ZONE;\n\"\"\""}, {"id": 59, "title": "Используйте оконную функцию ROW_NUMBER() с PARTITION BY", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите SQL-запрос с оконной функцией в переменной <code>sql</code>.</p><p class='meta'>Из таблицы <code>orders</code> выберите <code>id</code>, <code>user_id</code>, <code>total_amount</code> и вычислите порядковый номер заказа для каждого пользователя через <code>ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY created_at DESC) AS rn</code>.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Используйте оконную функцию ROW_NUMBER() с PARTITION BY\nsql = \"\"\"\nSELECT \n    id, user_id, total_amount, created_at,\n    ROW_NUMBER() OVER(PARTITION BY user_id ORDER BY created_at DESC) AS order_rank\nFROM orders;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"user_id\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'user_id'\"\nassert isinstance(sql, str) and \"total_amount\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'total_amount'\"", "code": "# Используйте оконную функцию ROW_NUMBER() с PARTITION BY\nsql = \"\"\"\nSELECT \n    id, user_id, total_amount, created_at,\n    ROW_NUMBER() OVER(PARTITION BY user_id ORDER BY created_at DESC) AS order_rank\nFROM orders;\n\"\"\""}, {"id": 60, "title": "Замените цепочку if/elif через полиморфизм или словарь стратегий", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Замените цепочку if/elif через полиморфизм или словарь стратегий.</p>", "initialCode": "from abc import ABC, abstractmethod\nclass PaymentProcessor(ABC):\n\n    @abstractmethod\n    def pay(self, amount: float):\n        pass\nclass CardPayment(PaymentProcessor):\n\n    def pay(self, amount: float):\n        pass\nclass CryptoPayment(PaymentProcessor):\n\n    def pay(self, amount: float):\n        pass\nPROCESSORS = {'card': CardPayment(), 'crypto': CryptoPayment()}\ndef process_payment(method: str, amount: float):\n    pass", "solution": "# Замените цепочку if/elif через полиморфизм\nfrom abc import ABC, abstractmethod\n\nclass PaymentProcessor(ABC):\n    @abstractmethod\n    def pay(self, amount: float):\n        pass\n\nclass CardPayment(PaymentProcessor):\n    def pay(self, amount: float):\n        print(f\"Оплата картой: {amount}\")\n\nclass CryptoPayment(PaymentProcessor):\n    def pay(self, amount: float):\n        print(f\"Оплата криптой: {amount}\")\n\n# Реестр вместо ветвлений\nPROCESSORS = {'card': CardPayment(), 'crypto': CryptoPayment()}\ndef process_payment(method: str, amount: float):\n    PROCESSORS[method].pay(amount)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"process_payment\" in globals() and callable(process_payment), \"Функция process_payment() должна быть определена\"\n_fn_nodes_process_payment = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"process_payment\"]\nassert _fn_nodes_process_payment and not (len(_fn_nodes_process_payment[0].body) == 1 and isinstance(_fn_nodes_process_payment[0].body[0], _ast.Pass)), \"Реализуйте тело функции process_payment() (сейчас там только pass)\"\nassert \"PaymentProcessor\" in globals() and isinstance(PaymentProcessor, type), \"Класс PaymentProcessor должен быть определён\"\n_cl_def_PaymentProcessor = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PaymentProcessor\"]\nassert _cl_def_PaymentProcessor and not (len(_cl_def_PaymentProcessor[0].body) == 1 and isinstance(_cl_def_PaymentProcessor[0].body[0], _ast.Pass)), \"Реализуйте тело класса PaymentProcessor (сейчас там только pass)\"\nassert hasattr(PaymentProcessor, \"pay\"), \"В классе PaymentProcessor должен быть метод/свойство pay\"\nassert \"CardPayment\" in globals() and isinstance(CardPayment, type), \"Класс CardPayment должен быть определён\"\n_cl_def_CardPayment = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CardPayment\"]\nassert _cl_def_CardPayment and not (len(_cl_def_CardPayment[0].body) == 1 and isinstance(_cl_def_CardPayment[0].body[0], _ast.Pass)), \"Реализуйте тело класса CardPayment (сейчас там только pass)\"\nassert hasattr(CardPayment, \"pay\"), \"В классе CardPayment должен быть метод/свойство pay\"\n_cl_nodes_CardPayment_pay = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CardPayment\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"pay\"]\nassert _cl_nodes_CardPayment_pay and not (len(_cl_nodes_CardPayment_pay[0].body) == 1 and isinstance(_cl_nodes_CardPayment_pay[0].body[0], _ast.Pass)), \"Реализуйте метод CardPayment.pay()\"\nassert \"CryptoPayment\" in globals() and isinstance(CryptoPayment, type), \"Класс CryptoPayment должен быть определён\"\n_cl_def_CryptoPayment = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CryptoPayment\"]\nassert _cl_def_CryptoPayment and not (len(_cl_def_CryptoPayment[0].body) == 1 and isinstance(_cl_def_CryptoPayment[0].body[0], _ast.Pass)), \"Реализуйте тело класса CryptoPayment (сейчас там только pass)\"\nassert hasattr(CryptoPayment, \"pay\"), \"В классе CryptoPayment должен быть метод/свойство pay\"\n_cl_nodes_CryptoPayment_pay = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CryptoPayment\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"pay\"]\nassert _cl_nodes_CryptoPayment_pay and not (len(_cl_nodes_CryptoPayment_pay[0].body) == 1 and isinstance(_cl_nodes_CryptoPayment_pay[0].body[0], _ast.Pass)), \"Реализуйте метод CryptoPayment.pay()\"", "code": "# Замените цепочку if/elif через полиморфизм\nfrom abc import ABC, abstractmethod\n\nclass PaymentProcessor(ABC):\n    @abstractmethod\n    def pay(self, amount: float):\n        pass\n\nclass CardPayment(PaymentProcessor):\n    def pay(self, amount: float):\n        print(f\"Оплата картой: {amount}\")\n\nclass CryptoPayment(PaymentProcessor):\n    def pay(self, amount: float):\n        print(f\"Оплата криптой: {amount}\")\n\n# Реестр вместо ветвлений\nPROCESSO
ef __init__(self):\n        self.rooms: dict[str, list] = defaultdict(list)\n\n    async def connect(self, room: str, ws) -> None:\n        await ws.accept()\n        self.rooms[room].append(ws)\n\n    def disconnect(self, room: str, ws) -> None:\n        if ws in self.rooms[room]:\n            self.rooms[room].remove(ws)\n\n    async def broadcast(self, room: str, message: str) -> None:\n        for ws in list(self.rooms[room]):\n            await ws.send_text(message)\n\nclass FakeWebSocket:\n    def __init__(self, name: str):\n        self.name = name\n        self.inbox: list[str] = []\n    async def accept(self):\n        pass\n    async def send_text(self, msg: str):\n        self.inbox.append(msg)\n\nasync def main():\n    mgr = ConnectionManager()\n    u1, u2 = FakeWebSocket(\"Alice\"), FakeWebSocket(\"Bob\")\n    await mgr.connect(\"general\", u1)\n    await mgr.connect(\"general\", u2)\n    await mgr.broadcast(\"general\", \"Привет всем в комнате!\")\n    mgr.disconnect(\"general\", u2)\n    await mgr.broadcast(\"general\", \"Второе сообщение\")\n    print(\"Alice inbox:\", u1.inbox, \"| Bob inbox:\", u2.inbox)\n    assert len(u1.inbox) == 2 and len(u2.inbox) == 1\n\nasyncio.run(main())\n"}, {"id": 400, "title": "Соберите модульное приложение через паттерн Application Factory и Blueprint-роутеры", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Соберите модульное приложение через паттерн Application Factory и Blueprint-роутеры.</p>", "initialCode": "class Blueprint:\n\n    def __init__(self, name: str, url_prefix: str=''):\n        pass\n\n    def route(self, path: str):\n        pass\nclass MiniApp:\n\n    def __init__(self, config: dict):\n        pass\n\n    def register_blueprint(self, bp: Blueprint) -> None:\n        pass\n\n    def handle(self, path: str):\n        pass\nauth_bp = Blueprint('auth', url_prefix='/api/v1/auth')\n@auth_bp.route('/login')\ndef login_view():\n    pass\ndef create_app(env
e, \"audit\": True, \"payload\": payload}\n        raise ValueError(f\"Неизвестный тип события: {event_type}\")", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"EventFactory\" in globals() and isinstance(EventFactory, type), \"Класс EventFactory должен быть определён\"\n_cl_def_EventFactory = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"EventFactory\"]\nassert _cl_def_EventFactory and not (len(_cl_def_EventFactory[0].body) == 1 and isinstance(_cl_def_EventFactory[0].body[0], _ast.Pass)), \"Реализуйте тело класса EventFactory (сейчас там только pass)\"\nassert hasattr(EventFactory, \"create_event\"), \"В классе EventFactory должен быть метод/свойство create_event\"\n_cl_nodes_EventFactory_create_event = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"EventFactory\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"create_event\"]\nassert _cl_nodes_EventFactory_create_event and not (len(_cl_nodes_EventFactory_create_event[0].body) == 1 and isinstance(_cl_nodes_EventFactory_create_event[0].body[0], _ast.Pass)), \"Реализуйте метод EventFactory.create_event()\"\nassert EventFactory.create_event(\"user_signup\", {})[\"notify\"] is True", "code": "# Создайте фабричный метод для обработки типов событий\nclass EventFactory:\n    @staticmethod\n    def create_event(event_type: str, payload: dict):\n        if event_type == \"user_signup\":\n            return {\"type\": event_type, \"notify\": True, \"payload\": payload}\n        elif event_type == \"payment_received\":\n            return {\"type\": event_type, \"audit\": True, \"payload\": payload}\n        raise ValueError(f\"Неизвестный тип события: {event_type}\")"}, {"id": 53, "title": "Сделайте и
otocol):\n    def __lt__(self, other) -> bool: ...\n\n\ndef find_min(items: list[Comparable]) -> Comparable:\n    result = items[0]\n    for item in items[1:]:\n        if item < result:\n            result = item\n    return result\n\n\nclass Money:\n    def __init__(self, amount: int):\n        self.amount = amount\n\n    def __lt__(self, other) -> bool:\n        return self.amount < other.amount\n\n\nprint(find_min([Money(30), Money(5), Money(20)]).amount)  # 5"}, {"id": 237, "title": "Создайте дескриптор с данными (get и set) для валидации типа", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте дескриптор с данными (get и set) для валидации типа.</p>", "initialCode": "class Typed:\n\n    def __init__(self, expected_type):\n        pass\n\n    def __set_name__(self, owner, name):\n        pass\n\n    def __get__(self, obj, owner):\n        pass\n\n    def __set__(self, obj, value):\n        pass\nclass User:\n    pass", "solution": "# Создайте дескриптор с данными (get и set) для валидации типа\nclass Typed:\n    def __init__(self, expected_type):\n        self.expected_type = expected_type\n\n    def __set_name__(self, owner, name):\n        self.name = \"_\" + name\n\n    def __get__(self, obj, owner):\n        if obj is None:\n            return self\n        return getattr(obj, self.name, None)\n\n    def __set__(self, obj, value):\n        if not isinstance(value, self.expected_type):\n            raise TypeError(f\"{value!r} должно быть типа {self.expected_type}\")\n        setattr(obj, self.name, value)\n\n\nclass User:\n    age = Typed(int)\n    name = Typed(str)\n\n\nu = User()\nu.age = 25\nu.name = \"Alex\"\ntry:\n    u.age = \"25\"\nexcept TypeError as _e:\n    print(\"TypeError перехвачен:\", _e)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "t
d isinstance(Service, type), \"Класс Service должен быть определён\"\n_cl_def_Service = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Service\"]\nassert _cl_def_Service and not (len(_cl_def_Service[0].body) == 1 and isinstance(_cl_def_Service[0].body[0], _ast.Pass)), \"Реализуйте тело класса Service (сейчас там только pass)\"\nassert hasattr(Service, \"ping\"), \"В классе Service должен быть метод/свойство ping\"\n_cl_nodes_Service_ping = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Service\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"ping\"]\nassert _cl_nodes_Service_ping and not (len(_cl_nodes_Service_ping[0].body) == 1 and isinstance(_cl_nodes_Service_ping[0].body[0], _ast.Pass)), \"Реализуйте метод Service.ping()\"", "code": "# Постройте множественное наследование и вызов super() по MRO\nclass Base:\n    def ping(self):\n        print(\"Base.ping\")\n\nclass MixinA(Base):\n    def ping(self):\n        print(\"MixinA.ping\")\n        super().ping()\n\nclass MixinB(Base):\n    def ping(self):\n        print(\"MixinB.ping\")\n        super().ping()\n\nclass Service(MixinA, MixinB):\n    def ping(self):\n        print(\"Service.ping\")\n        super().ping()\n\n# Service -> MixinA -> MixinB -> Base -> object"}, {"id": 152, "title": "Вычисление выражения в обратной польской нотации", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Вычисление выражения в обратной польской нотации.</p>", "initialCode": "def eval_rpn(tokens: list) -> int:\n    pass", "solution": "# Вычисление выражения в обратной польской нотации (RPN)\ndef eval_rpn(tokens: list) -> int:\n    stack = []\n    ops = {\n        '+': lambda a, b: a + b,\n        '-': lambda a, b: a - b,\n        '*': lambda a, b: a * b,\n        '/': lambda a, b: int(a / b)\n    }\n    for token in tokens:\n        if token in ops:\n            b, a = stack.pop(), stack.pop()\n            stack.append(ops[token](a, b))\n        else:\n            stack.append(int(token))\n    return stack[0]", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"eval_rpn\" in globals() and callable(eval_rpn), \"Функция eval_rpn() должна быть определена\"\n_fn_nodes_eval_rpn = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"eval_rpn\"]\nassert _fn_nodes_eval_rpn and not (len(_fn_nodes_eval_rpn[0].body) == 1 and isinstance(_fn_nodes_eval_rpn[0].body[0], _ast.Pass)), \"Реализуйте тело функции eval_rpn() (сейчас там только pass)\"", "code": "# Вычисление выражения в обратной польской нотации (RPN)\ndef eval_rpn(tokens: list) -> int:\n    stack = []\n    ops = {\n        '+': lambda a, b: a + b,\n        '-': lambda a, b: a - b,\n        '*': lambda a, b: a * b,\n        '/': lambda a, b: int(a / b)\n    }\n    for token in tokens:\n        if token in ops:\n            b, a = stack.pop(), stack.pop()\n            stack.append(ops[token](a, b))\n        else:\n            stack.append(int(token))\n    return stack[0]"}, {"id": 153, "title": "Напишите проверку: является ли дерево валидным BST", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите проверку: является ли дерево валидным BST.</p>", "initialCode": "def is_valid_bst(root: TreeNode) -> bool:\n    pass", "solution": "# Напишите проверку: является ли дерево валидным BST\ndef is_valid_bst(root: TreeNode) -> bool:\n    def validate(node, low=float('-inf'), high=float('inf')):\n        if not node:\n            return True\n        if not (low < node.val < high):\n            return False\n        return validate(node.left, low, node.val) and validate(node.right, node.val, high)\n    return validate(root)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"is_valid_bst\" in globals() and callable(is_valid_bst), \"Функция is_valid_bst() должна быть определена\"\n_fn_nodes_is_valid_bst = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"is_valid_bst\"]\nassert _fn_nodes_is_valid_bst and not (len(_fn_nodes_is_valid_bst[0].body) == 1 and isinstance(_fn_nodes_is_valid_bst[0].body[0], _ast.Pass)), \"Реализуйте тело функции is_valid_bst() (сейчас там только pass)\"\n_r = TreeNode(2, TreeNode(1), TreeNode(3)); assert is_valid_bst(_r) is True", "code": "# Напишите проверку: является ли дерево валидным BST\ndef is_valid_bst(root: TreeNode) -> bool:\n    def validate(node, low=float('-inf'), high=float('inf')):\n        if not node:\n            return True\n        if not (low < node.val < high):\n            return False\n        return validate(node.left, low, node.val) and validate(node.right, node.val, high)\n    return validate(root)"}, {"id": 154, "title": "Постройте Abstract Factory для компонентов интерфейса", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте Abstract Factory для компонентов интерфейса.</p>", "initialCode": "from abc import ABC, abstractmethod\nclass GUIFactory(ABC):\n\n    @abstractmethod\n    def create_button(self):\n        pass\n\n    @abstractmethod\n    def create_checkbox(self):\n        pass\nclass DarkThemeFactory(GUIFactory):\n\n    def create_button(self):\n        pass\n\n    def create_checkbox(self):\n        pass\nclass LightThemeFactory(GUIFactory):\n\n    def create_button(self):\n        pass\n\n    def create_checkbox(self):\n        pass", "solution": "# 
\n        parent_result = Base.greet(self)\n        return f\"{parent_result}, а это уже Child\"\n\n\nprint(Child().greet())  # \"Привет из Base, а это уже Child\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Base\" in globals() and isinstance(Base, type), \"Класс Base должен быть определён\"\n_cl_def_Base = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Base\"]\nassert _cl_def_Base and not (len(_cl_def_Base[0].body) == 1 and isinstance(_cl_def_Base[0].body[0], _ast.Pass)), \"Реализуйте тело класса Base (сейчас там только pass)\"\nassert hasattr(Base, \"greet\"), \"В классе Base должен быть метод/свойство greet\"\n_cl_nodes_Base_greet = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Base\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"greet\"]\nassert _cl_nodes_Base_greet and not (len(_cl_nodes_Base_greet[0].body) == 1 and isinstance(_cl_nodes_Base_greet[0].body[0], _ast.Pass)), \"Реализуйте метод Base.greet()\"\nassert \"Child\" in globals() and isinstance(Child, type), \"Класс Child должен быть определён\"\n_cl_def_Child = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Child\"]\nassert _cl_def_Child and not (len(_cl_def_Child[0].body) == 1 and isinstance(_cl_def_Child[0].body[0], _ast.Pass)), \"Реализуйте тело класса Child (сейчас там только pass)\"\nassert hasattr(Child, \"greet\"), \"В классе Child должен быть метод/свойство greet\"\n_cl_nodes_Child_greet = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Child\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"greet\"]\nassert _cl_nodes_Child_greet and not (len(_cl_nodes_Child_greet[0].body) == 1 and isinstance(_cl_nodes_Child_greet[0].body[0], _ast.Pass)), \"Реализуйте метод Child.greet()\"\nprint(Child().greet())", "code": "# Вызовите метод родителя явно через ClassName.method(self)\nclass Base:\n    def greet(self):\n        return \"Привет из Base\"\n\n\nclass Child(Base):\n    def greet(self):\n        # явный вызов конкретного класса, а не super() —\n        # полезно, когда нужно обратиться именно к этой реализации,\n        # в обход MRO (например, при диагностике/тестах)\n        parent_result = Base.greet(self)\n        return f\"{parent_result}, а это уже Child\"\n\n\nprint(Child().greet())  # \"Привет из Base, а это уже Child\""}, {"id": 248, "title": "Постройте ромбовидное наследование (diamond problem) и выведите mro", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Постройте ромбовидное наследование (diamond problem) и выведите mro.</p>", "initialCode": "class A:\n\n    def greet(self):\n        pass\nclass B(A):\n\n    def greet(self):\n        pass\nclass C(A):\n\n    def greet(self):\n        pass\nclass D(B, C):\n    pass", "solution": "# Постройте ромбовидное наследование (diamond problem) и выведите mro\nclass A:\n    def greet(self):\n        return \"A\"\n\n\nclass B(A):\n    def greet(self):\n        return \"B\"\n\n\nclass C(A):\n    def greet(self):\n        return \"C\"\n\n\nclass D(B, C):\n    pass\n\n\nprint(D().greet())                       # \"B\" — первый по MRO\nprint([cls.__name__ for cls in D.__mro__])\n# ['D', 'B', 'C', 'A', 'object']", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"A\" in globals() and isinstance(A, type), \"Класс A должен быть определён\"\n_cl_def_A = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, 
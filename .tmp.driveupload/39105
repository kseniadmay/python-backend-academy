lf, amount):\n        pass", "solution": "# Постройте класс-миксин LoggingMixin и подключите к сервису\nclass LoggingMixin:\n    def log(self, message):\n        print(f\"[{self.__class__.__name__}] {message}\")\n\n\nclass PaymentService(LoggingMixin):\n    def charge(self, amount):\n        self.log(f\"Списание {amount} руб.\")\n        return True\n\n\nservice = PaymentService()\nservice.charge(500)  # [PaymentService] Списание 500 руб.", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"LoggingMixin\" in globals() and isinstance(LoggingMixin, type), \"Класс LoggingMixin должен быть определён\"\n_cl_def_LoggingMixin = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LoggingMixin\"]\nassert _cl_def_LoggingMixin and not (len(_cl_def_LoggingMixin[0].body) == 1 and isinstance(_cl_def_LoggingMixin[0].body[0], _ast.Pass)), \"Реализуйте тело класса LoggingMixin (сейчас там только pass)\"\nassert hasattr(LoggingMixin, \"log\"), \"В классе LoggingMixin должен быть метод/свойство log\"\n_cl_nodes_LoggingMixin_log = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LoggingMixin\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"log\"]\nassert _cl_nodes_LoggingMixin_log and not (len(_cl_nodes_LoggingMixin_log[0].body) == 1 and isinstance(_cl_nodes_LoggingMixin_log[0].body[0], _ast.Pass)), \"Реализуйте метод LoggingMixin.log()\"\nassert \"PaymentService\" in globals() and isinstance(PaymentService, type), \"Класс PaymentService должен быть определён\"\n_cl_def_PaymentService = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PaymentService\"]\nassert _cl_def_PaymentService and not (len(_cl_def_PaymentService[0].bod
ером и сеттером для приватного поля.</p>", "initialCode": "class Account:\n\n    def __init__(self, balance: float):\n        pass\n\n    @property\n    def balance(self) -> float:\n        pass\n\n    @balance.setter\n    def balance(self, value: float) -> None:\n        pass", "solution": "# Реализуйте property с геттером и сеттером для приватного поля\nclass Account:\n    def __init__(self, balance: float):\n        self._balance = balance\n\n    @property\n    def balance(self) -> float:\n        return self._balance\n\n    @balance.setter\n    def balance(self, value: float) -> None:\n        if value < 0:\n            raise ValueError(\"Баланс не может быть отрицательным\")\n        self._balance = value\n\n\nacc = Account(100)\nacc.balance = 150\nprint(acc.balance)   # 150\ntry:\n    acc.balance = -10\nexcept ValueError as _e:\n    print(\"ValueError перехвачен:\", _e)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Account\" in globals() and isinstance(Account, type), \"Класс Account должен быть определён\"\n_cl_def_Account = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\"]\nassert _cl_def_Account and not (len(_cl_def_Account[0].body) == 1 and isinstance(_cl_def_Account[0].body[0], _ast.Pass)), \"Реализуйте тело класса Account (сейчас там только pass)\"\nassert hasattr(Account, \"__init__\"), \"В классе Account должен быть метод/свойство __init__\"\n_cl_nodes_Account___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Account___init__ and not (len(_cl_nodes_Account___init__[0].body) == 1 and isinstance(_cl_nodes_Account___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Account.__init__()\"\nassert hasattr(Account, \"balance\"), \"В классе Account должен быть метод/свойство balance\"\n_cl_nodes_Account_balance = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"balance\"]\nassert _cl_nodes_Account_balance and not (len(_cl_nodes_Account_balance[0].body) == 1 and isinstance(_cl_nodes_Account_balance[0].body[0], _ast.Pass)), \"Реализуйте метод Account.balance()\"\nassert hasattr(Account, \"balance\"), \"В классе Account должен быть метод/свойство balance\"\n_cl_nodes_Account_balance = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"balance\"]\nassert _cl_nodes_Account_balance and not (len(_cl_nodes_Account_balance[0].body) == 1 and isinstance(_cl_nodes_Account_balance[0].body[0], _ast.Pass)), \"Реализуйте метод Account.balance()\"\nacc = Account(100)\nacc.balance = 150\nprint(acc.balance)\ntry:\n    acc.balance = -10\nexcept ValueError as _e:\n    print(\"ValueError перехвачен:\", _e)\nassert \"acc\" in globals(), \"Переменная acc должна быть вычислена\"", "code": "# Реализуйте property с геттером и сеттером для приватного поля\nclass Account:\n    def __init__(self, balance: float):\n        self._balance = balance\n\n    @property\n    def balance(self) -> float:\n        return self._balance\n\n    @balance.setter\n    def balance(self, value: float) -> None:\n        if value < 0:\n            raise ValueError(\"Баланс не может быть отрицательным\")\n        self._balance = value\n\n\nacc = Account(100)\nacc.balance = 150\nprint(acc.balance)   # 150\ntry:\n    acc.balance = -10\nexcept ValueError as _e:\n    print(\"ValueError перехвачен:\", _e)"}, {"id": 234, "title": "Добавьте type hints к функции с Optional и Union параметрами", "level": 2, "tier": "🐣 Уровень 2", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Добавьте type hints к функции с Optional и Union параметрами.</p>", "initialCode": "from typing import Optional, Union\ndef format_price(amount: Union[int, float], currency: Optional[str]=None) -> str:\n    pass", "solution": "# Добавьте type hints к функции с Optional и Union параметрами\nfrom typing import Optional, Union\n\n\ndef format_price(amount: Union[int, float], currency: Optional[str] = None) -> str:\n    currency = currency or \"USD\"\n    return f\"{amount:.2f} {currency}\"\n\n\nprint(format_price(9.5))          # \"9.50 USD\"\nprint(format_price(100, \"EUR\"))    # \"100.00 EUR\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"format_price\" in globals() and callable(format_price), \"Функция format_price() должна быть определена\"\n_fn_nodes_format_price = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"format_price\"]\nassert _fn_nodes_format_price and not (len(_fn_nodes_format_price[0].body) == 1 and isinstance(_fn_nodes_format_price[0].body[0], _ast.Pass)), \"Реализуйте тело функции format_price() (сейчас там только pass)\"\nprint(format_price(9.5))\nprint(format_price(100, \"EUR\"))", "code": "# Добавьте type hints к функции с Optional и Union параметрами\nfrom typing import Optional, Union\n\n\ndef format_price(amount: Union[int, float], currency: Optional[str] = None) -> str:\n    currency = currency or \"USD\"\n    return f\"{amount:.2f} {currency}\"\n\n\nprint(format_price(9.5))          # \"9.50 USD\"\nprint(format_price(100, \"EUR\"))    # \"100.00 EUR\""}, {"id": 235, "title": "Напишите дескриптор без данных (non-data descriptor) для ленивого вычисления", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите дескриптор без данных (non-data descriptor) для ленивого вычисления.</p>", "initialCode": "class LazyProperty:\n\n    def __init__(self, func):\n        pass\n\n    def __get__(self, obj, owner):\n        pass\nclass Report:\n\n    def __init__(self, rows):\n        pass\n\n    @LazyProperty\n    def total(self):\n        pass", "solution": "# Напишите дескриптор без данных (non-data descriptor) для ленивого вычисления\nclass LazyProperty:\n    \"\"\"Non-data descriptor: только __get__.\n    Вычисляет значение один раз и кладёт его в __dict__ экземпляра —\n    при следующем обращении Python найдёт значение в __dict__ раньше,\n    чем дойдёт до дескриптора класса (т.к. это НЕ data-дескриптор).\"\"\"\n\n    def __init__(self, func):\n        self.func = func\n        self.name = func.__name__\n\n    def __get__(self, obj, owner):\n        if obj is None:\n            return self\n        value = self.func(obj)\n        obj.__dict__[self.name] = value\n        return value\n\n\nclass Report:\n    def __init__(self, rows):\n        self.rows = rows\n\n    @LazyProperty\n    def total(self):\n        print(\"Считаю сумму...\")\n        return sum(self.rows)\n\n\nr = Report([1, 2, 3])\nprint(r.total)  # \"Считаю сумму...\" -> 6\nprint(r.total)  # сразу 6, без пересчёта", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"LazyProperty\" in globals() and isinstance(LazyProperty, type), \"Класс LazyProperty должен быть определён\"\n_cl_def_LazyProperty = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LazyProperty\"]\nassert _cl_def_LazyProperty and not (len(_cl_def_LazyProperty[0].body) == 1 and isinstance(_cl_def_LazyProperty[0].
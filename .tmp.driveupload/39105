 с БД\" выведется автоматически при выходе из блока,\n# даже если бы внутри произошло исключение", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"DatabaseConnection\" in globals() and isinstance(DatabaseConnection, type), \"Класс DatabaseConnection должен быть определён\"\n_cl_def_DatabaseConnection = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"DatabaseConnection\"]\nassert _cl_def_DatabaseConnection and not (len(_cl_def_DatabaseConnection[0].body) == 1 and isinstance(_cl_def_DatabaseConnection[0].body[0], _ast.Pass)), \"Реализуйте тело класса DatabaseConnection (сейчас там только pass)\"\nassert hasattr(DatabaseConnection, \"__enter__\"), \"В классе DatabaseConnection должен быть метод/свойство __enter__\"\n_cl_nodes_DatabaseConnection___enter__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"DatabaseConnection\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__enter__\"]\nassert _cl_nodes_DatabaseConnection___enter__ and not (len(_cl_nodes_DatabaseConnection___enter__[0].body) == 1 and isinstance(_cl_nodes_DatabaseConnection___enter__[0].body[0], _ast.Pass)), \"Реализуйте метод DatabaseConnection.__enter__()\"\nassert hasattr(DatabaseConnection, \"__exit__\"), \"В классе DatabaseConnection должен быть метод/свойство __exit__\"\n_cl_nodes_DatabaseConnection___exit__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"DatabaseConnection\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__exit__\"]\nassert _cl_nodes_DatabaseConnection___exit__ and not (len(_cl_nodes_DatabaseConnection___exit__[0].body) == 1 and isinstance(_cl_nodes_DatabaseConnection___exit__[0].body[0], _ast.Pass)), \"Реализуйте метод DatabaseConnection.__exit__()\"\nwith DatabaseConnection() as db:\n    print(f\"Соединение активно: {db.connected}\")", "code": "# Напишите менеджер соединения с БД через контекстный менеджер (__enter__/__exit__)\nclass DatabaseConnection:\n    def __enter__(self):\n        print(\"Открываю соединение с БД\")\n        self.connected = True\n        return self\n\n    def __exit__(self, exc_type, exc_value, traceback):\n        print(\"Закрываю соединение с БД\")\n        self.connected = False\n        return False   # False — не подавлять исключение, если оно было\n\n\nwith DatabaseConnection() as db:\n    print(f\"Соединение активно: {db.connected}\")\n# \"Закрываю соединение с БД\" выведется автоматически при выходе из блока,\n# даже если бы внутри произошло исключение"}, {"id": 332, "title": "Реализуйте иерархию собственных исключений для валидации формы", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте иерархию собственных исключений для валидации формы.</p>", "initialCode": "class ValidationError(Exception):\n    pass\nclass EmailInvalidError(ValidationError):\n    pass\nclass PasswordTooShortError(ValidationError):\n    pass\ndef validate(email, password):\n    pass", "solution": "# Реализуйте иерархию собственных исключений для валидации формы\nclass ValidationError(Exception):\n    \"\"\"Базовое исключение валидации.\"\"\"\n    pass\n\nclass EmailInvalidError(ValidationError):\n    pass\n\nclass PasswordTooShortError(ValidationError):\n    pass\n\n\ndef validate(email, password):\n    if \"@\" not in email:\n        raise EmailInvalidError(f\"Некорректный email: {email}\")\n    if len(password) < 8:\n        raise PasswordTooShortError(\"Пароль короче 8 символов\")\n\n\ntry:\n    validate(\"bad-email\", \"12345\")\nexcept EmailInvalidError as e:\n    print(f\"Ошибка email: {e}\")\nexcept PasswordTooShortError as e:\n    print(f\"Ошибка пароля: {e}\")\nexcept ValidationError:\n    print(\"Общая ошибка валидации\")", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"validate\" in globals() and callable(validate), \"Функция validate() должна быть определена\"\n_fn_nodes_validate = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"validate\"]\nassert _fn_nodes_validate and not (len(_fn_nodes_validate[0].body) == 1 and isinstance(_fn_nodes_validate[0].body[0], _ast.Pass)), \"Реализуйте тело функции validate() (сейчас там только pass)\"\nassert \"ValidationError\" in globals() and isinstance(ValidationError, type), \"Класс ValidationError должен быть определён\"\n_cl_def_ValidationError = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ValidationError\"]\nassert _cl_def_ValidationError and not (len(_cl_def_ValidationError[0].body) == 1 and isinstance(_cl_def_ValidationError[0].body[0], _ast.Pass)), \"Реализуйте тело класса ValidationError (сейчас там только pass)\"\nassert \"EmailInvalidError\" in globals() and isinstance(EmailInvalidError, type), \"Класс EmailInvalidError должен быть определён\"\nassert \"PasswordTooShortError\" in globals() and isinstance(PasswordTooShortError, type), \"Класс PasswordTooShortError должен быть определён\"\ntry:\n    validate(\"bad-email\", \"12345\")\nexcept EmailInvalidError as e:\n    print(f\"Ошибка email: {e}\")\nexcept PasswordTooShortError as e:\n    print(f\"Ошибка пароля: {e}\")\nexcept ValidationError:\n    print(\"Общая ошибка валидации\")", "code": "# Реализуйте иерархию собственных исключений для валидации формы\nclass ValidationError(Exception):\n    \"\"\"Базовое исключение валидации.\"\"\"\n    pass\n\nclass EmailInvalidError(ValidationError):\n    pass\n\nclass PasswordTooShortError(ValidationError):\n    pass\n\n\ndef validate(email, password):\n    if \"@\" not in email:\n        raise EmailInvalidError(f\"Некорректный email: {email}\")\n    if len(password) < 8:\n        raise PasswordTooShortError(\"Пароль короче 8 символов\")\n\n\ntry:\n    validate(\"bad-email\", \"12345\")\nexcept EmailInvalidError as e:\n    print(f\"Ошибка email: {e}\")\nexcept PasswordTooShortError as e:\n    print(f\"Ошибка пароля: {e}\")\nexcept ValidationError:\n    print(\"Общая ошибка валидации\")"}, {"id": 333, "title": "Спроектируйте класс с несколькими миксинами, разрешив конфликт через MRO явно", "level": 4, "tier": "🦊 Уровень 4", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Спроектируйте класс с несколькими миксинами, разрешив конфликт через MRO явно.</p>", "initialCode": "class JSONMixin:\n\n    def render(self):\n        pass\nclass XMLMixin:\n\n    def render(self):\n        pass\nclass Report(JSONMixin, XMLMixin):\n\n    def __init__(self, data):\n        pass", "solution": "# Спроектируйте класс с несколькими миксинами, разрешив конфликт через MRO явно\nclass JSONMixin:\n    def render(self):\n        return f'{{\"data\": \"{self.data}\"}}'\n\nclass XMLMixin:\n    def render(self):\n        return f\"<data>{self.data}</data>\"\n\n\nclass Report(JSONMixin, XMLMixin):   # JSONMixin первый -> его render побеждает по MRO\n    def __init__(self, data):\n        self.data = data\n\n\nr = Report(\"продажи\")\nprint(r.render())            # JSON-вариант — победил JSONMixin (стоит левее)\nprint(Report.__mro__)          # видно точный порядок разрешения", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"JSONMixin\" in globals() and isinstance(JSONMixin, type), \"Класс JSONMixin должен быть определён\"\n_cl_def_JSONMixin = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"JSONMixin\"]\nassert _cl_def_JSONMixin and not (len(_cl_def_JSONMixin[0].body) == 1 and isinstance(_cl_def_JSONMixin[0].body[0], _ast.Pass)), \"Реализуйте тело класса JSONMixin (сейчас там только pass)\"\nassert hasattr(JSONMixin, \"render\"), \"В классе JSONMixin должен быть метод/свойство render\"\n_cl_nodes_JSONMixin_render = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"JSONMixin\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"render\"]\nassert _cl_nodes_JSONMixin_render and not (len(_cl_nodes_JSONMixin_render[0].body) == 1 and isinstance(_cl_nodes_JSONMixin_render[0].body[0], _ast.Pass)), \"Реализуйте метод JSONMixin.render()\"\nassert \"XMLMixin\" in globals() and isinstance(XMLMixin, type), \"Класс XMLMixin должен быть определён\"\n_cl_def_XMLMixin = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"XMLMixin\"]\nassert _cl_def_XMLMixin and not (len(_cl_def_XMLMixin[0].body) == 1 and isinstance(_cl_def_XMLMixin[0].body[0], _ast.Pass)), \"Реализуйте тело класса XMLMixin (сейчас там только pass)\"\nassert hasattr(XMLMixin, \"render\"), \"В классе XMLMixin должен быть метод/свойство render\"\n_cl_nodes_XMLMixin_render = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"XMLMixin\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"render\"]\nassert _cl_nodes_XMLMixin_render and not (len(_cl_nodes_XMLMixin_render[0].body) == 1 and isinstance(_cl_nodes_XMLMixin_render[0].body[0], _ast.Pass)), \"Реализуйте метод XMLMixin.render()\"\nassert \"Report\" in globals() and isinstance(Report, type), \"Класс Report должен быть определён\"\n_cl_def_Report = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Report\"]\nassert _cl_def_Report and not (len(_cl_def_Report[0].body) == 1 and isinstance(_cl_def_Report[0].body[0], _ast.Pass)), \"Реализуйте тело класса Report (сейчас там только pass)\"\nassert hasattr(Report, \"__init__\"), \"В классе Report должен быть метод/свойство __init__\"\n_cl_nodes_Report___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Report\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Report___init__ and not (len(_cl_nodes_Report___init__[0].body) == 1 and isinstance(_cl_nodes_Report___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Report.__init__()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nr = Report(\"продажи\")\nprint(r.render())\nprint(Report.__mro__)\nassert \"r\" in globals(), \"Переменная r должна быть вычислена\"", "code": "# Спроектируйте класс с несколькими миксинами, разрешив конфликт через MRO явно\nclass JSONMixin:\n    def render(self):\n        return f'{{\"data\": \"{self.data}\"}}'\n\nclass XMLMixin:\n    def render(self):\n        return f\"<data>{self.data}</data>\"\n\n\nclass Report(JSONMixin, XMLMixin):   # JSONMixin первый -> его render побеждает по MRO\n    def __init__(self, data):\n        self.data = data\n\n\nr = Report(\"продажи\")\nprint(r.render())            # JSON-вариант — победил JSONMixin (стоит левее)\nprint(Report.__mro__)          # видно точный порядок разрешения"}, {"id": 334, "title": "Сравните время выполнения синхронного и асинхронного ожидания нескольких задач", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Сравните время выполнения синхронного и асинхронного ожидания нескольких задач.</p>", "initialCode": "import asyncio\nimport time\nasync def wait_task(n):\n    pass\nasync def main():\n    pass", "solution": "# Сравните время выполнения синхронного и асинхронного ожидания нескольких задач\nimport asyncio\nimport time\n\nasync def wait_task(n):\n    await asyncio.sleep(1)\n    return n\n\nasync def main():\n    start = time.time()\n    results = [await wait_task(i) for i in range(3)]   # последовательно\n    print(f\"Последовательно: {time.time()-start:.1f}с\")   # ~3с\n\n    start = time.time()\n    results = await asyncio.gather(*[wait_task(i) for i in range(3)])  # конкурентно\n    print(f\"Конкурентно: {time.time()-start:.1f}с\")   # ~1с\n\nasyncio.run(main())", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"wait_task\" in globals() and callable(wait_task), \"Функция wait_task() должна быть определена\"\n_fn_nodes_wait_task = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"wait_task\"]\nassert _fn_nodes_wait_task and not (len(_fn_nodes_wait_task[0].body) == 1 and isinstance(_fn_nodes_wait_task[0].body[0], _ast.Pass)), \"Реализуйте тело функции wait_task() (сейчас там только pass)\"\nassert \"main\" in globals() and callable(main), \"Функция main() должна быть определена\"\n_fn_nodes_main = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"main\"]\nassert _fn_nodes_main and not (len(_fn_nodes_main[0].body) == 1 and isinstance(_fn_nodes_main[0].body[0], _ast.Pass)), \"Реализуйте тело функции main() (сейчас там только pass)\"\nasyncio.run(main())", "code": "# Сравните время выполнения синхронного и асинхронного ожидания нескольких задач\nimport asyncio\nimport time\n\nasync def wait_task(n):\n    await asyncio.sleep(1)\n    return n\n\nasync def main():\n    start = time.time()\n    results = [await wait_task(i) for i in range(3)]   # последовательно\n    print(f\"Последовательно: {time.time()-start:.1f}с\")   # ~3с\n\n    start = time.time()\n    results = await asyncio.gather(*[wait_task(i) for i in range(3)])  # конкурентно\n    print(f\"Конкурентно: {time.time()-start:.1f}с\")   # ~1с\n\nasyncio.run(main())"}, {"id": 335, "title": "Извлеките именованные группы из строки лога через re", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Извлеките именованные группы из строки лога через re.</p>", "initialCode": "import re\n\nlog = '2026-09-19 10:15:00 WARNING Диск заполнен на 90%'\npattern = '(?P<date>[\\\\d-]+) (?P<time>[\\\\d:]+) (?P<level>\\\\w+) (?P<message>.+)'\nmatch = None", "solution": "# Извлеките именованные группы из строки лога через re\nimport re\n\nlog = \"2026-09-19 10:15:00 WARNING Диск заполнен на 90%\"\npattern = r'(?P<date>[\\d-]+) (?P<time>[\\d:]+) (?P<level>\\w+) (?P<message>.+)'\n\nmatch = re.match(pattern, log)\nprint(match.group('level'))     # WARNING\nprint(match.group('message'))   # Диск заполнен на 90%", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"log\" in globals() and log is not None, \"Переменная log должна быть определена и не равна None\"\nassert isinstance(log, str) and \"WARNING\".lower() in log.lower(), \"Строка log должна содержать ключевой элемент 'WARNING'\"\nassert \"pattern\" in globals() and pattern is not None, \"Переменная pattern должна быть определена и не равна None\"\nassert isinstance(pattern, str) and \"date\".lower() in pattern.lower(), \"Строка pattern должна содержать ключевой элемент 'date'\"\nassert isinstance(pattern, str) and \"time\".lower() in pattern.lower(), \"Строка pattern должна содержать ключевой элемент 'time'\"\nassert isinstance(pattern, str) and \"level\".lower() in pattern.lower(), \"Строка pattern должна содержать ключевой элемент 'level'\"\nassert \"match\" in globals() and match is not None, \"Переменная match должна быть определена и не равна None\"\nassert match != \"__TODO__\", \"Заполните значение переменной match\"", "code": "# Извлеките именованные группы из строки лога через re\nimport re\n\nlog = \"2026-09-19 10:15:00 WARNING Диск заполнен на 90%\"\npattern = r'(?P<date>[\\d-]+) (?P<time>[\\d:]+) (?P<level>\\w+) (?P<message>.+)'\n\nmatch = re.match(pattern, log)\nprint(match.group('level'))     # WARNING\nprint(match.group('message'))   # Диск заполнен на 90%"}, {"id": 336, "title": "Настройте systemd-подобный воркер с graceful shutdown через сигналы потоков", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Настройте systemd-подобный воркер с graceful shutdown через сигналы потоков.</p>", "initialCode": "import threading\nimport time\nstop_event = threading.Event()\ndef worker():\n    pass", "solution": "# Настройте воркер с graceful shutdown через threading.Event\nimport threading\nimport time\n\nstop_event = threading.Event()\n\ndef worker():\n    for _ in range(2):\n        print(\"Работаю...\")\n        time.sleep(0.5)\n    print(\"Корректно остановлен\")\n\nt = threading.Thread(target=worker)\nt.start()\ntime.sleep(1.5)\nstop_event.set()   # сигнал остановки вместо резкого kill потока\nt.join()", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"worker\" in globals() and callable(worker), \"Функция worker() должна быть определена\"\n_fn_nodes_worker = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"worker\"]\nassert _fn_nodes_worker and not (len(_fn_nodes_worker[0].body) == 1 and isinstance(_fn_nodes_worker[0].body[0], _ast.Pass)), \"Реализуйте тело функции worker() (сейчас там только pass)\"\nt = threading.Thread(target=worker)\nt.start()\ntime.sleep(1.5)\nstop_event.set()\nt.join()\nassert \"t\" in globals(), \"Переменная t должна быть вычислена\"", "code": "# Настройте воркер с graceful shutdown через threading.Event\nimport threading\nimport time\n\nstop_event = threading.Event()\n\ndef worker():\n    for _ in range(2):\n        print(\"Работаю...\")\n        time.sleep(0.5)\n    print(\"Корректно остановлен\")\n\nt = threading.Thread(target=worker)\nt.start()\ntime.sleep(1.5)\nstop_event.set()   # сигнал остановки вместо резкого kill потока\nt.join()"}, {"id": 337, "title": "Сериализуйте datetime объект в JSON через кастомный encoder", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Сериализуйте datetime объект в JSON через кастомный encoder.</p>", "initialCode": "import json\nfrom datetime import datetime\ndef custom_encoder(obj):\n    pass", "solution": "# Сериализуйте datetime объект в JSON через кастомный encoder\nimport json\nfrom datetime import datetime\n\ndef custom_encoder(obj):\n    if isinstance(obj, datetime):\n        return obj.isoformat()\n    raise TypeError(f\"Object of type {type(obj)} is not JSON serializable\")\n\ndata = {\"event\": \"login\", \"timestamp\": datetime(2026, 9, 19, 10, 0)}\nprint(json.dumps(data, default=custom_encoder))\n# {\"event\": \"login\", \"timestamp\": \"2026-09-19T10:00:00\"}", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"custom_encoder\" in globals() and callable(custom_encoder), \"Функция custom_encoder() должна быть определена\"\n_fn_nodes_custom_encoder = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"custom_encoder\"]\nassert _fn_nodes_custom_encoder and not (len(_fn_nodes_custom_encoder[0].body) == 1 and isinstance(_fn_nodes_custom_encoder[0].body[0], _ast.Pass)), \"Реализуйте тело функции custom_encoder() (сейчас там только pass)\"\ndata = {\"event\": \"login\", \"timestamp\": datetime(2026, 9, 19, 10, 0)}\nprint(json.dumps(data, default=custom_encoder))\nassert \"data\" in globals(), \"Переменная data должна быть вычислена\"", "code": "# Сериализуйте datetime объект в JSON через кастомный encoder\nimport json\nfrom datetime import datetime\n\ndef custom_encoder(obj):\n    if isinstance(obj, datetime):\n        return obj.isoformat()\n    raise TypeError(f\"Object of type {type(obj)} is not JSON serializable\")\n\ndata = {\"event\": \"login\", \"timestamp\": datetime(2026, 9, 19, 10, 0)}\nprint(json.dumps(data, default=custom_encoder))\n# {\"event\": \"login\", \"timestamp\": \"2026-09-19T10:00:00\"}"}, {"id": 338, "title": "Реализуйте пул воркеров через ThreadPoolExecutor для I/O-bound задач", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте пул воркеров через ThreadPoolExecutor для I/O-bound задач.</p>", "initialCode": "from concurrent.futures import ThreadPoolExecutor\nimport time\ndef fetch(url):\n    pass", "solution": "# Реализуйте пул воркеров через ThreadPoolExecutor для I/O-bound задач\nfrom concurrent.futures import ThreadPoolExecutor\nimport time\n\ndef fetch(url):\n    time.sleep(1)   # имитация сетевого запроса\n    return f\"Данные с {url}\"\n\nurls = [\"a.com\", \"b.com\", \"c.com\"]\n\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    results = list(executor.map(fetch, urls))\n\nprint(results)   # все три \"запроса\" выполнились параллельно, ~1с вместо 3с —\n                   # ThreadPoolExecutor эффективен именно для I/O-bound задач", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"fetch\" in globals() and callable(fetch), \"Функция fetch() должна быть определена\"\n_fn_nodes_fetch = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"fetch\"]\nassert _fn_nodes_fetch and not (len(_fn_nodes_fetch[0].body) == 1 and isinstance(_fn_nodes_fetch[0].body[0], _ast.Pass)), \"Реализуйте тело функции fetch() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nurls = [\"a.com\", \"b.com\", \"c.com\"]\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    results = list(executor.map(fetch, urls))\nprint(results)\nassert \"urls\" in globals(), \"Переменная urls должна быть вычислена\"", "code": "# Реализуйте пул воркеров через ThreadPoolExecutor для I/O-bound задач\nfrom concurrent.futures import ThreadPoolExecutor\nimport time\n\ndef fetch(url):\n    time.sleep(1)   # имитация сетевого запроса\n    return f\"Данные с {url}\"\n\nurls = [\"a.com\", \"b.com\", \"c.com\"]\n\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    results = list(executor.map(fetch, urls))\n\nprint(results)   # все три \"запроса\" выполнились параллельно, ~1с вместо 3с —\n                   # ThreadPoolExecutor эффективен именно для I/O-bound задач"}, {"id": 339, "title": "Напишите тест производительности: dis.dis() для сравнения байткода двух реализаций", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Напишите тест производительности: dis.dis() для сравнения байткода двух реализаций.</p>", "initialCode": "import dis\ndef sum_loop(n):\n    pass\ndef sum_builtin(n):\n    pass", "solution": "# Используйте dis.dis() для сравнения байткода двух реализаций одной задачи\nimport dis\n\ndef sum_loop(n):\n    total = 0\n    for i in range(n):\n        total += i\n    return total\n\ndef sum_builtin(n):\n    return sum(range(n))\n\nprint(\"=== sum_loop ===\")\ndis.dis(sum_loop)\nprint(\"=== sum_builtin ===\")\ndis.dis(sum_builtin)\n# sum_builtin компилируется в заметно меньше инструкций байткода —\n# встроенные функции обычно эффективнее ручных циклов", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sum_loop\" in globals() and callable(sum_loop), \"Функция sum_loop() должна быть определена\"\n_fn_nodes_sum_loop = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"sum_loop\"]\nassert _fn_nodes_sum_loop and not (len(_fn_nodes_sum_loop[0].body) == 1 and isinstance(_fn_nodes_sum_loop[0].body[0], _ast.Pass)), \"Реализуйте тело функции sum_loop() (сейчас там только pass)\"\nassert \"sum_builtin\" in globals() and callable(sum_builtin), \"Функция sum_builtin() должна быть определена\"\n_fn_nodes_sum_builtin = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"sum_builtin\"]\nassert _fn_nodes_sum_builtin and not (len(_fn_nodes_sum_builtin[0].body) == 1 and isinstance(_fn_nodes_sum_builtin[0].body[0], _ast.Pass)), \"Реализуйте тело функции sum_builtin() (сейчас там только pass)\"\nprint(\"=== sum_loop ===\")\ndis.dis(sum_loop)\nprint(\"=== sum_builtin ===\")\ndis.dis(sum_builtin)", "code": "# Используйте dis.dis() для сравнения байткода двух реализаций одной задачи\nimport dis\n\ndef sum_loop(n):\n    total = 0\n    for i in range(n):\n        total += i\n    return total\n\ndef sum_builtin(n):\n    return sum(range(n))\n\nprint(\"=== sum_loop ===\")\ndis.dis(sum_loop)\nprint(\"=== sum_builtin ===\")\ndis.dis(sum_builtin)\n# sum_builtin компилируется в заметно меньше инструкций байткода —\n# встроенные функции обычно эффективнее ручных циклов"}, {"id": 340, "title": "Профилируйте функцию через cProfile и найдите узкое место", "level": 4, "tier": "🦊 Уровень 4", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Профилируйте функцию через cProfile и найдите узкое место.</p>", "initialCode": "import cProfile\ndef slow_function():\n    pass", "solution": "# Профилируйте функцию через cProfile и найдите узкое место\nimport cProfile\n\ndef slow_function():\n    total = 0\n    for i in range(1000):\n        total += i ** 2\n    return total\n\ncProfile.run('slow_function()')\n# выведет таблицу: сколько раз вызвана каждая функция, сколько времени заняла —\n# именно так на практике ищут реальное узкое место, а не гадают", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"slow_function\" in globals() and callable(slow_function), \"Функция slow_function() должна быть определена\"\n_fn_nodes_slow_function = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"slow_function\"]\nassert _fn_nodes_slow_function and not (len(_fn_nodes_slow_function[0].body) == 1 and isinstance(_fn_nodes_slow_function[0].body[0], _ast.Pass)), \"Реализуйте тело функции slow_function() (сейчас там только pass)\"\ncProfile.run('slow_function()')", "code": "# Профилируйте функцию через cProfile и найдите узкое место\nimport cProfile\n\ndef slow_function():\n    total = 0\n    for i in range(1000):\n        total += i ** 2\n    return total\n\ncProfile.run('slow_function()')\n# выведет таблицу: сколько раз вызвана каждая функция, сколько времени заняла —\n# именно так на практике ищут реальное узкое место, а не гадают"}, {"id": 341, "title": "Изоляция состояния независимых экземпляров класса через self", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте независимость состояния разных экземпляров одного класса.</p><p class='meta'>В классе <code>Counter</code> инициализируйте <code>self.count = 0</code> и напишите метод <code>increment()</code>. Создайте экземпляры <code>c1</code> и <code>c2</code>, вызвав метод дважды у <code>c1</code> и один раз у <code>c2</code>, подтвердив изолированность их счётчиков.</p>", "initialCode": "class Counter:\n\n    def __init__(self):\n        pass\n\n    def increment(self):\n        pass", "solution": "# Реализуйте класс с несколькими экземплярами и покажите независимость self\nclass Counter:\n    def __init__(self):\n        self.count = 0\n\n    def increment(self):\n        self.count += 1\n        return self.count\n\n\nc1 = Counter()\nc2 = Counter()\nc1.increment()\nc1.increment()\nc2.increment()\n\nprint(c1.count, c2.count)   # 2 1 — у каждого экземпляра свой self, своё состояние", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Counter\" in globals() and isinstance(Counter, type), \"Класс Counter должен быть определён\"\n_cl_def_Counter = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Counter\"]\nassert _cl_def_Counter and not (len(_cl_def_Counter[0].body) == 1 and isinstance(_cl_def_Counter[0].body[0], _ast.Pass)), \"Реализуйте тело класса Counter (сейчас там только pass)\"\nassert hasattr(Counter, \"__init__\"), \"В классе Counter должен быть метод/свойство __init__\"\n_cl_nodes_Counter___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Counter\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Counter___init__ and not (len(_cl_nodes_Counter___init__[0].body) == 1 and isinstance(_cl_nodes_Counter___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Counter.__init__()\"\nassert hasattr(Counter, \"increment\"), \"В классе Counter должен быть метод/свойство increment\"\n_cl_nodes_Counter_increment = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Counter\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"increment\"]\nassert _cl_nodes_Counter_increment and not (len(_cl_nodes_Counter_increment[0].body) == 1 and isinstance(_cl_nodes_Counter_increment[0].body[0], _ast.Pass)), \"Реализуйте метод Counter.increment()\"\nc1 = Counter()\nc2 = Counter()\nc1.increment()\nc1.increment()\nc2.increment()\nprint(c1.count, c2.count)\nassert \"c1\" in globals(), \"Переменная c1 должна быть вычислена\"\nassert \"c2\" in globals(), \"Переменная c2 должна быть вычислена\"\nassert c1.count == 2 and c2.count == 1, \"Счетчики независимых экземпляров c1 и c2 должны быть изолированы\"", "code": "# Реализуйте класс с несколькими экземплярами и покажите независимость self\nclass Counter:\n    def __init__(self):\n        self.count = 0\n\n    def increment(self):\n        self.count += 1\n        return self.count\n\n\nc1 = Counter()\nc2 = Counter()\nc1.increment()\nc1.increment()\nc2.increment()\n\nprint(c1.count, c2.count)   # 2 1 — у каждого экземпляра свой self, своё состояние"}, {"id": 342, "title": "Реализуйте жизненный цикл объекта: создание, использование, удаление через __del__", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте жизненный цикл объекта: создание, использование, удаление через __del__.</p>", "initialCode": "class Resource:\n\n    def __init__(self, name):\n        pass\n\n    def __del__(self):\n        pass", "solution": "# Реализуйте жизненный цикл объекта: создание, использование, удаление через __del__\nclass Resource:\n    def __init__(self, name):\n        self.name = name\n        print(f\"Создан ресурс: {name}\")\n\n    def __del__(self):\n        print(f\"Освобождён ресурс: {self.name}\")\n\n\nr = Resource(\"файл.txt\")\nprint(\"Работаем с ресурсом...\")\ndel r   # явно удаляем ссылку — при отсутствии других ссылок сработает __del__", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Resource\" in globals() and isinstance(Resource, type), \"Класс Resource должен быть определён\"\n_cl_def_Resource = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Resource\"]\nassert _cl_def_Resource and not (len(_cl_def_Resource[0].body) == 1 and isinstance(_cl_def_Resource[0].body[0], _ast.Pass)), \"Реализуйте тело класса Resource (сейчас там только pass)\"\nassert hasattr(Resource, \"__init__\"), \"В классе Resource должен быть метод/свойство __init__\"\n_cl_nodes_Resource___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Resource\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Resource___init__ and not (len(_cl_nodes_Resource___init__[0].body) == 1 and isinstance(_cl_nodes_Resource___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Resource.__init__()\"\nassert hasattr(Resource, \"__del__\"), \"В классе Resource должен быть метод/свойство __del__\"\n_cl_nodes_Resource___del__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Resource\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__del__\"]\nassert _cl_nodes_Resource___del__ and not (len(_cl_nodes_Resource___del__[0].body) == 1 and isinstance(_cl_nodes_Resource___del__[0].body[0], _ast.Pass)), \"Реализуйте метод Resource.__del__()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nr = Resource(\"файл.txt\")\nprint(\"Работаем с ресурсом...\")\ndel r", "code": "# Реализуйте жизненный цикл объекта: создание, использование, удаление через __del__\nclass Resource:\n    def __init__(self, name):\n        self.name = name\n        print(f\"Создан ресурс: {name}\")\n\n    def __del__(self):\n        print(f\"Освобождён ресурс: {self.name}\")\n\n\nr = Resource(\"файл.txt\")\nprint(\"Работаем с ресурсом...\")\ndel r   # явно удаляем ссылку — при отсутствии других ссылок сработает __del__"}, {"id": 343, "title": "Вызов связанного и несвязанного метода через Class.method(instance)", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте эквивалентность вызова метода экземпляра <code>obj.method()</code> и функции класса <code>Class.method(obj)</code>.</p><p class='meta'>Для класса <code>Dog</code> с методом <code>bark(self)</code> создайте объект <code>rex = Dog()</code> с <code>rex.name = \"Рекс\"</code>. Вызовите метод через <code>rex.bark()</code> и напрямую через класс <code>Dog.bark(rex)</code>, убедившись в одинаковом результате.</p>", "initialCode": "class Dog:\n\n    def bark(self):\n        pass", "solution": "# Продемонстрируйте вызов метода через явное указание self\nclass Dog:\n    def bark(self):\n        return f\"{self.name} гавкает!\"\n\n\nrex = Dog()\nrex.name = \"Рекс\"\nprint(rex.bark())              # обычный вызов — self подставляется автоматически\nprint(Dog.bark(rex))           # то же самое, но self передан явно —\n                                  # показывает, что метод это просто функция класса", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Dog\" in globals() and isinstance(Dog, type), \"Класс Dog должен быть определён\"\n_cl_def_Dog = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Dog\"]\nassert _cl_def_Dog and not (len(_cl_def_Dog[0].body) == 1 and isinstance(_cl_def_Dog[0].body[0], _ast.Pass)), \"Реализуйте тело класса Dog (сейчас там только pass)\"\nassert hasattr(Dog, \"bark\"), \"В классе Dog должен быть метод/свойство bark\"\n_cl_nodes_Dog_bark = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Dog\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"bark\"]\nassert _cl_nodes_Dog_bark and not (len(_cl_nodes_Dog_bark[0].body) == 1 and isinstance(_cl_nodes_Dog_bark[0].body[0], _ast.Pass)), \"Реализуйте метод Dog.bark()\"\nrex = Dog()\nrex.name = \"Рекс\"\nprint(rex.bark())\nprint(Dog.bark(rex))\nassert \"rex\" in globals(), \"Переменная rex должна быть вычислена\"\nassert rex.bark() == Dog.bark(rex) == \"Рекс гавкает!\", \"Вызов rex.bark() и Dog.bark(rex) должны возвращать одинаковый результат\"", "code": "# Продемонстрируйте вызов метода через явное указание self\nclass Dog:\n    def bark(self):\n        return f\"{self.name} гавкает!\"\n\n\nrex = Dog()\nrex.name = \"Рекс\"\nprint(rex.bark())              # обычный вызов — self подставляется автоматически\nprint(Dog.bark(rex))           # то же самое, но self передан явно —\n                                  # показывает, что метод это просто функция класса"}, {"id": 344, "title": "Реализуйте класс-обёртку с __repr__ для отладочного вывода коллекции", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте класс коллекции <code>UserGroup</code> с кастомным строковым представлением <code>__repr__</code>.</p><p class='meta'>Метод <code>__repr__(self)</code> должен возвращать информативную строку вида <code>f\"UserGroup(count={len(self.members)})\"</code> для однозначной идентификации состояния объекта в логах.</p>", "initialCode": "class ShoppingCart:\n\n    def __init__(self):\n        pass\n\n    def add(self, item):\n        pass\n\n    def __repr__(self):\n        pass", "solution": "# Реализуйте класс-обёртку с __repr__ для отладочного вывода коллекции\nclass ShoppingCart:\n    def __init__(self):\n        self.items = []\n\n    def add(self, item):\n        self.items.append(item)\n\n    def __repr__(self):\n        return f\"ShoppingCart({self.items!r})\"\n\n\ncart = ShoppingCart()\ncart.add(\"хлеб\")\ncart.add(\"молоко\")\nprint(cart)   # ShoppingCart(['хлеб', 'молоко']) — читаемо в консоли/логах", "hint": "Метод __repr__(self) должен возвращать точную, понятную разработчику строку вида ClassName(attr=val, ...), однозначно отражающую состояние объекта.", "tests": "import ast as _ast\nassert \"ShoppingCart\" in globals() and isinstance(ShoppingCart, type), \"Класс ShoppingCart должен быть определён\"\n_cl_def_ShoppingCart = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ShoppingCart\"]\nassert _cl_def_ShoppingCart and not (len(_cl_def_ShoppingCart[0].body) == 1 and isinstance(_cl_def_ShoppingCart[0].body[0], _ast.Pass)), \"Реализуйте тело класса ShoppingCart (сейчас там только pass)\"\nassert hasattr(ShoppingCart, \"__init__\"), \"В классе ShoppingCart должен быть метод/свойство __init__\"\n_cl_nodes_ShoppingCart___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ShoppingCart\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_ShoppingCart___init__ and not (len(_cl_nodes_ShoppingCart___init__[0].body) == 1 and isinstance(_cl_nodes_ShoppingCart___init__[0].body[0], _ast.Pass)), \"Реализуйте метод ShoppingCart.__init__()\"\nassert hasattr(ShoppingCart, \"add\"), \"В классе ShoppingCart должен быть метод/свойство add\"\n_cl_nodes_ShoppingCart_add = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ShoppingCart\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"add\"]\nassert _cl_nodes_ShoppingCart_add and not (len(_cl_nodes_ShoppingCart_add[0].body) == 1 and isinstance(_cl_nodes_ShoppingCart_add[0].body[0], _ast.Pass)), \"Реализуйте метод ShoppingCart.add()\"\nassert hasattr(ShoppingCart, \"__repr__\"), \"В классе ShoppingCart должен быть метод/свойство __repr__\"\n_cl_nodes_ShoppingCart___repr__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ShoppingCart\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__repr__\"]\nassert _cl_nodes_ShoppingCart___repr__ and not (len(_cl_nodes_ShoppingCart___repr__[0].body) == 1 and isinstance(_cl_nodes_ShoppingCart___repr__[0].body[0], _ast.Pass)), \"Реализуйте метод ShoppingCart.__repr__()\"\ncart = ShoppingCart()\ncart.add(\"хлеб\")\ncart.add(\"молоко\")\nprint(cart)\nassert \"cart\" in globals(), \"Переменная cart должна быть вычислена\"\n_ug = UserGroup([\"a\", \"b\"]); assert \"UserGroup\" in repr(_ug) and \"2\" in repr(_ug), \"__repr__ должен отображать имя класса и размер группы\"", "code": "# Реализуйте класс-обёртку с __repr__ для отладочного вывода коллекции\nclass ShoppingCart:\n    def __init__(self):\n        self.items = []\n\n    def add(self, item):\n        self.items.append(item)\n\n    def __repr__(self):\n        return f\"ShoppingCart({self.items!r})\"\n\n\ncart = ShoppingCart()\ncart.add(\"хлеб\")\ncart.add(\"молоко\")\nprint(cart)   # ShoppingCart(['хлеб', 'молоко']) — читаемо в консоли/логах"}, {"id": 345, "title": "Инкапсулируйте валидацию внутри __init__, запретив создание объекта в невалидном состоянии", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Инкапсулируйте валидацию внутри __init__, запретив создание объекта в невалидном состоянии.</p>", "initialCode": "class Age:\n\n    def __init__(self, value):\n        pass\n\n    def __repr__(self):\n        pass", "solution": "# Инкапсулируйте валидацию внутри __init__, запретив создание объекта в невалидном состоянии\nclass Age:\n    def __init__(self, value):\n        if value < 0 or value > 150:\n            raise ValueError(f\"Некорректный возраст: {value}\")\n        self._value = value\n\n    def __repr__(self):\n        return f\"Age({self._value})\"\n\n\na = Age(25)         # OK\ntry:\n    bad = Age(-5)    # ValueError сразу при создании — невозможно получить невалидный объект\nexcept ValueError as e:\n    print(f\"Ошибка: {e}\")", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Age\" in globals() and isinstance(Age, type), \"Класс Age должен быть определён\"\n_cl_def_Age = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Age\"]\nassert _cl_def_Age and not (len(_cl_def_Age[0].body) == 1 and isinstance(_cl_def_Age[0].body[0], _ast.Pass)), \"Реализуйте тело класса Age (сейчас там только pass)\"\nassert hasattr(Age, \"__init__\"), \"В классе Age должен быть метод/свойство __init__\"\n_cl_nodes_Age___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Age\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Age___init__ and not (len(_cl_nodes_Age___init__[0].body) == 1 and isinstance(_cl_nodes_Age___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Age.__init__()\"\nassert hasattr(Age, \"__repr__\"), \"В классе Age должен быть метод/свойство __repr__\"\n_cl_nodes_Age___repr__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Age\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__repr__\"]\nassert _cl_nodes_Age___repr__ and not (len(_cl_nodes_Age___repr__[0].body) == 1 and isinstance(_cl_nodes_Age___repr__[0].body[0], _ast.Pass)), \"Реализуйте метод Age.__repr__()\"\na = Age(25)\ntry:\n    bad = Age(-5)    # ValueError сразу при создании — невозможно получить невалидный объект\nexcept ValueError as e:\n    print(f\"Ошибка: {e}\")\nassert \"a\" in globals(), \"Переменная a должна быть вычислена\"", "code": "# Инкапсулируйте валидацию внутри __init__, запретив создание объекта в невалидном состоянии\nclass Age:\n    def __init__(self, value):\n        if value < 0 or value > 150:\n            raise ValueError(f\"Некорректный возраст: {value}\")\n        self._value = value\n\n    def __repr__(self):\n        return f\"Age({self._value})\"\n\n\na = Age(25)         # OK\ntry:\n    bad = Age(-5)    # ValueError сразу при создании — невозможно получить невалидный объект\nexcept ValueError as e:\n    print(f\"Ошибка: {e}\")"}, {"id": 346, "title": "Реализуйте класс исключения с дополнительными полями для контекста ошибки", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте класс исключения с дополнительными полями для контекста ошибки.</p>", "initialCode": "class InsufficientStockError(Exception):\n\n    def __init__(self, product, requested, available):\n        pass", "solution": "# Реализуйте класс исключения с дополнительными полями для контекста ошибки\nclass InsufficientStockError(Exception):\n    def __init__(self, product, requested, available):\n        self.product = product\n        self.requested = requested\n        self.available = available\n        super().__init__(\n            f\"Недостаточно '{product}': запрошено {requested}, доступно {available}\"\n        )\n\n\ntry:\n    raise InsufficientStockError(\"Книга\", 5, 2)\nexcept InsufficientStockError as e:\n    print(e)                  # человекочитаемое сообщение\n    print(e.product, e.requested, e.available)  # доступ к структурированным данным ошибки", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"InsufficientStockError\" in globals() and isinstance(InsufficientStockError, type), \"Класс InsufficientStockError должен быть определён\"\n_cl_def_InsufficientStockError = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"InsufficientStockError\"]\nassert _cl_def_InsufficientStockError and not (len(_cl_def_InsufficientStockError[0].body) == 1 and isinstance(_cl_def_InsufficientStockError[0].body[0], _ast.Pass)), \"Реализуйте тело класса InsufficientStockError (сейчас там только pass)\"\nassert hasattr(InsufficientStockError, \"__init__\"), \"В классе InsufficientStockError должен быть метод/свойство __init__\"\n_cl_nodes_InsufficientStockError___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"InsufficientStockError\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_InsufficientStockError___init__ and not (len(_cl_nodes_InsufficientStockError___init__[0].body) == 1 and isinstance(_cl_nodes_InsufficientStockError___init__[0].body[0], _ast.Pass)), \"Реализуйте метод InsufficientStockError.__init__()\"\ntry:\n    raise InsufficientStockError(\"Книга\", 5, 2)\nexcept InsufficientStockError as e:\n    print(e)                  # человекочитаемое сообщение\n    print(e.product, e.requested, e.available)", "code": "# Реализуйте класс исключения с дополнительными полями для контекста ошибки\nclass InsufficientStockError(Exception):\n    def __init__(self, product, requested, available):\n        self.product = product\n        self.requested = requested\n        self.available = available\n        super().__init__(\n            f\"Недостаточно '{product}': запрошено {requested}, доступно {available}\"\n        )\n\n\ntry:\n    raise InsufficientStockError(\"Книга\", 5, 2)\nexcept InsufficientStockError as e:\n    print(e)                  # человекочитаемое сообщение\n    print(e.product, e.requested, e.available)  # доступ к структурированным данным ошибки"}, {"id": 347, "title": "Реализуйте класс Stack как Generic[T] с методом peek и проверкой пустоты", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте класс Stack как Generic[T] с методом peek и проверкой пустоты.</p>", "initialCode": "from typing import TypeVar, Generic, Optional\nT = TypeVar('T')\nclass Stack(Generic[T]):\n\n    def __init__(self) -> None:\n        pass\n\n    def push(self, item: T) -> None:\n        pass\n\n    def pop(self) -> T:\n        pass\n\n    def peek(self) -> Optional[T]:\n        pass\n\n    def is_empty(self) -> bool:\n        pass", "solution": "# Реализуйте класс Stack как Generic[T] с методом peek и проверкой пустоты\nfrom typing import TypeVar, Generic, Optional\n\nT = TypeVar(\"T\")\n\nclass Stack(Generic[T]):\n    def __init__(self) -> None:\n        self._items: list[T] = []\n\n    def push(self, item: T) -> None:\n        self._items.append(item)\n\n    def pop(self) -> T:\n        return self._items.pop()\n\n    def peek(self) -> Optional[T]:\n        return self._items[-1] if self._items else None\n\n    def is_empty(self) -> bool:\n        return not self._items\n\n\ns: Stack[str] = Stack()\ns.push(\"a\")\ns.push(\"b\")\nprint(s.peek())      # 'b' — смотрим верхний элемент, не удаляя\nprint(s.is_empty())   # False", "hint": "Шаг 1: Храни элементы во внутреннем списке self._items. Шаг 2: push добавляет через append(), pop удаляет с конца через pop() с проверкой на пустоту, peek возвращает последний элемент.", "tests": "import ast as _ast\nassert \"Stack\" in globals() and isinstance(Stack, type), \"Класс Stack должен быть определён\"\n_cl_def_Stack = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\"]\nassert _cl_def_Stack and not (len(_cl_def_Stack[0].body) == 1 and isinstance(_cl_def_Stack[0].body[0], _ast.Pass)), \"Реализуйте тело класса Stack (сейчас там только pass)\"\nassert hasattr(Stack, \"__init__\"), \"В классе Stack должен быть метод/свойство __init__\"\n_cl_nodes_Stack___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Stack___init__ and not (len(_cl_nodes_Stack___init__[0].body) == 1 and isinstance(_cl_nodes_Stack___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.__init__()\"\nassert hasattr(Stack, \"push\"), \"В классе Stack должен быть метод/свойство push\"\n_cl_nodes_Stack_push = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"push\"]\nassert _cl_nodes_Stack_push and not (len(_cl_nodes_Stack_push[0].body) == 1 and isinstance(_cl_nodes_Stack_push[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.push()\"\nassert hasattr(Stack, \"pop\"), \"В классе Stack должен быть метод/свойство pop\"\n_cl_nodes_Stack_pop = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"pop\"]\nassert _cl_nodes_Stack_pop and not (len(_cl_nodes_Stack_pop[0].body) == 1 and isinstance(_cl_nodes_Stack_pop[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.pop()\"\nassert hasattr(Stack, \"peek\"), \"В классе Stack должен быть метод/свойство peek\"\n_cl_nodes_Stack_peek = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"peek\"]\nassert _cl_nodes_Stack_peek and not (len(_cl_nodes_Stack_peek[0].body) == 1 and isinstance(_cl_nodes_Stack_peek[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.peek()\"\nassert hasattr(Stack, \"is_empty\"), \"В классе Stack должен быть метод/свойство is_empty\"\n_cl_nodes_Stack_is_empty = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"is_empty\"]\nassert _cl_nodes_Stack_is_empty and not (len(_cl_nodes_Stack_is_empty[0].body) == 1 and isinstance(_cl_nodes_Stack_is_empty[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.is_empty()\"\ns: Stack[str] = Stack()\ns.push(\"a\")\ns.push(\"b\")\nprint(s.peek())\nprint(s.is_empty())", "code": "# Реализуйте класс Stack как Generic[T] с методом peek и проверкой пустоты\nfrom typing import TypeVar, Generic, Optional\n\nT = TypeVar(\"T\")\n\nclass Stack(Generic[T]):\n    def __init__(self) -> None:\n        self._items: list[T] = []\n\n    def push(self, item: T) -> None:\n        self._items.append(item)\n\n    def pop(self) -> T:\n        return self._items.pop()\n\n    def peek(self) -> Optional[T]:\n        return self._items[-1] if self._items else None\n\n    def is_empty(self) -> bool:\n        return not self._items\n\n\ns: Stack[str] = Stack()\ns.push(\"a\")\ns.push(\"b\")\nprint(s.peek())      # 'b' — смотрим верхний элемент, не удаляя\nprint(s.is_empty())   # False"}, {"id": 348, "title": "Реализуйте смешивание миксина логирования с сервисом через super()", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте смешивание миксина логирования с сервисом через super().</p>", "initialCode": "class LoggingMixin:\n\n    def process(self, *args, **kwargs):\n        pass\nclass PaymentService:\n\n    def process(self, amount):\n        pass\nclass LoggedPaymentService(LoggingMixin, PaymentService):\n    pass", "solution": "# Реализуйте смешивание миксина логирования с сервисом через super()\nclass LoggingMixin:\n    def process(self, *args, **kwargs):\n        print(f\"[LOG] Вызов process с {args}, {kwargs}\")\n        return super().process(*args, **kwargs)\n\n\nclass PaymentService:\n    def process(self, amount):\n        return f\"Платёж на {amount} обработан\"\n\n\nclass LoggedPaymentService(LoggingMixin, PaymentService):\n    pass\n\n\nservice = LoggedPaymentService()\nprint(service.process(100))\n# [LOG] Вызов process с (100,), {}\n# Платёж на 100 обработан", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"LoggingMixin\" in globals() and isinstance(LoggingMixin, type), \"Класс LoggingMixin должен быть определён\"\n_cl_def_LoggingMixin = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LoggingMixin\"]\nassert _cl_def_LoggingMixin and not (len(_cl_def_LoggingMixin[0].body) == 1 and isinstance(_cl_def_LoggingMixin[0].body[0], _ast.Pass)), \"Реализуйте тело класса LoggingMixin (сейчас там только pass)\"\nassert hasattr(LoggingMixin, \"process\"), \"В классе LoggingMixin должен быть метод/свойство process\"\n_cl_nodes_LoggingMixin_process = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LoggingMixin\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"process\"]\nassert _cl_nodes_LoggingMixin_process and not (len(_cl_nodes_LoggingMixin_process[0].body) == 1 and isinstance(_cl_nodes_LoggingMixin_process[0].body[0], _ast.Pass)), \"Реализуйте метод LoggingMixin.process()\"\nassert \"PaymentService\" in globals() and isinstanc
ogged_in\"}\n"}, {"id": 401, "title": "Верифицируйте HMAC-SHA256 подпись входящего Webhook-запроса с защитой от Replay-атак", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Верифицируйте HMAC-SHA256 подпись входящего Webhook-запроса с защитой от Replay-атак.</p>", "initialCode": "import hashlib\nimport hmac\nimport time\ndef sign_webhook(raw_body: bytes, timestamp: int, secret: str) -> str:\n    pass\ndef verify_webhook(raw_body: bytes, sig_header: str, secret: str, tolerance_sec: int=300) -> bool:\n    pass", "solution": "# Верифицируйте HMAC-SHA256 подпись входящего Webhook-запроса с защитой от Replay-атак\nimport hashlib\nimport hmac\nimport time\n\ndef sign_webhook(raw_body: bytes, timestamp: int, secret: str) -> str:\n    payload_to_sign = f\"{timestamp}.\".encode() + raw_body\n    digest = hmac.new(secret.encode(), payload_to_sign, hashlib.sha256).hexdigest()\n    return f\"t={timestamp},v1={digest}\"\n\ndef verify_webhook(raw_body: bytes, sig_header: str, secret: str, tolerance_sec: int = 300) -> bool:\n    parts = dict(item.split(\"=\", 1) for item in sig_header.split(\",\") if \"=\" in item)\n    ts = int(parts.get(\"t\", \"0\"))\n    v1 = parts.get(\"v1\", \"\")\n    # Защита от Replay-атак: отклоняем запросы старше 5 минут\n    if abs(int(time.time()) - ts) > tolerance_sec:\n        raise ValueError(\"Webhook timestamp expired (possible replay attack)\")\n    expected = sign_webhook(raw_body, ts, secret).split(\",v1=\")[1]\n    if not hmac.compare_digest(v1, expected):\n        raise ValueError(\"Invalid webhook signature\")\n    return True\n\nnow = int(time.time())\nbody = b'{\"event\":\"payment.succeeded\",\"order_id\":42}'\nheader = sign_webhook(body, now, secret=\"whsec_test_key\")\nok = verify_webhook(body, header, secret=\"whsec_test_key\")\nprint(\"Подпись вебхука проверена:\", ok)\nassert ok is True\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sign_webhook\" in globals() and callable(sign_webhook), \"Функция sign_webhook() должна быть определена\"\n_fn_nodes_sign_webhook = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"sign_webhook\"]\nassert _fn_nodes_sign_webhook and not (len(_fn_nodes_sign_webhook[0].body) == 1 and isinstance(_fn_nodes_sign_webhook[0].body[0], _ast.Pass)), \"Реализуйте тело функции sign_webhook() (сейчас там только pass)\"\nassert \"verify_webhook\" in globals() and callable(verify_webhook), \"Функция verify_webhook() должна быть определена\"\n_fn_nodes_verify_webhook = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"verify_webhook\"]\nassert _fn_nodes_verify_webhook and not (len(_fn_nodes_verify_webhook[0].body) == 1 and isinstance(_fn_nodes_verify_webhook[0].body[0], _ast.Pass)), \"Реализуйте тело функции verify_webhook() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nnow = int(time.time())\nbody = b'{\"event\":\"payment.succeeded\",\"order_id\":42}'\nheader = sign_webhook(body, now, secret=\"whsec_test_key\")\nok = verify_webhook(body, header, secret=\"whsec_test_key\")\nprint(\"Подпись вебхука проверена:\", ok)\nassert ok is True\nassert \"now\" in globals(), \"Переменная now должна быть вычислена\"\nassert \"body\" in globals(), \"Переменная body должна быть вычислена\"\nassert \"header\" in globals(), \"Переменная header должна быть вычислена\"\nassert \"ok\" in globals(), \"Переменная ok должна быть вычислена\"", "code": "# Верифицируйте HMAC-SHA256 подпись входящего Webhook-запроса с защитой от Replay-атак\nimport hashlib\nimport hmac\nimport time\n\ndef sign_webhook(raw_body: bytes, timestamp: int, secret: str) -> str:\n    payload_to_sign = f\"{timestamp}.\".encode() + raw_body\n    digest = hmac.new(secret.encode(), payload_to_sign, hashlib.sha256).hexdigest()\n    return f\"t={timestamp},v1={digest}\"\n\ndef verify_webhook(raw_body: bytes, sig_header: str, secret: str, tolerance_sec: int = 300) -> bool:\n    parts = dict(item.split(\"=\", 1) for item in sig_header.split(\",\") if \"=\" in item)\n    ts = int(parts.get(\"t\", \"0\"))\n    v1 = parts.get(\"v1\", \"\")\n    # Защита от Replay-атак: отклоняем запросы старше 5 минут\n    if abs(int(time.time()) - ts) > tolerance_sec:\n        raise ValueError(\"Webhook timestamp expired (possible replay attack)\")\n    expected = sign_webhook(raw_body, ts, secret).split(\",v1=\")[1]\n    if not hmac.compare_digest(v1, expected):\n        raise ValueError(\"Invalid webhook signature\")\n    return True\n\nnow = int(time.time())\nbody = b'{\"event\":\"payment.succeeded\",\"order_id\":42}'\nheader = sign_webhook(body, now, secret=\"whsec_test_key\")\nok = verify_webhook(body, header, secret=\"whsec_test_key\")\nprint(\"Подпись вебхука проверена:\", ok)\nassert ok is True\n"}];

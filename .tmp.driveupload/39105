 r.publish(channel, data)"}, {"id": 224, "title": "Асинхронная шина событий с приоритетами обработчиков", "level": 7, "tier": "👑 Уровень 7", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Асинхронная шина событий с приоритетами обработчиков.</p>", "initialCode": "import asyncio\nimport heapq\nclass AsyncPriorityEventBus:\n\n    def __init__(self):\n        pass\n\n    def subscribe(self, event_name: str, priority: int, handler):\n        pass\n\n    async def publish(self, event_name: str, data):\n        pass", "solution": "# Асинхронная шина событий с приоритетами обработчиков\nimport asyncio\nimport heapq\n\nclass AsyncPriorityEventBus:\n    def __init__(self):\n        self._handlers = {}\n        self._seq = 0\n\n    def subscribe(self, event_name: str, priority: int, handler):\n        # Меньший номер приоритета выполняется раньше\n        self._handlers.setdefault(event_name, [])\n        heapq.heappush(self._handlers[event_name], (priority, self._seq, handler))\n        self._seq += 1\n\n    async def publish(self, event_name: str, data):\n        for _, _, handler in sorted(self._handlers.get(event_name, [])):\n            await handler(data)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"AsyncPriorityEventBus\" in globals() and isinstance(AsyncPriorityEventBus, type), \"Класс AsyncPriorityEventBus должен быть определён\"\n_cl_def_AsyncPriorityEventBus = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"AsyncPriorityEventBus\"]\nassert _cl_def_AsyncPriorityEventBus and not (len(_cl_def_AsyncPriorityEventBus[0].body) == 1 and isinstance(_cl_def_AsyncPriorityEventBus[0].body[0], _ast.Pass)), \"Реализуйте тело класса AsyncPriorityEventBus (сейчас там только pass)\"\nassert hasattr(AsyncPriorityEventBus, \"__ini
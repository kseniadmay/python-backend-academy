member\", is_active: bool = True) -> dict:\n        nonlocal counter\n        counter += 1\n        user = {\"id\": counter, \"username\": f\"{username}_{counter}\", \"role\": role, \"is_active\": is_active}\n        created_ids.append(counter)\n        return user\n\n    yield _factory\n    # Teardown: очистка всех созданных за время теста записей\n    created_ids.clear()\n\ndef test_admin_permissions(make_user):\n    admin = make_user(username=\"root\", role=\"admin\")\n    guest = make_user(role=\"guest\", is_active=False)\n    assert admin[\"role\"] == \"admin\" and guest[\"id\"] == 2"}, {"id": 362, "title": "Протестируйте асинхронный сервис с помощью unittest.mock.AsyncMock", "level": 5, "tier": "🦅 Уровень 5", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Протестируйте асинхронный сервис с помощью unittest.mock.AsyncMock.</p>", "initialCode": "import asyncio\nfrom unittest.mock import AsyncMock\nclass PaymentGateway:\n\n    async def charge(self, user_id: int, amount: int) -> dict:\n        pass\nasync def checkout_order(gateway: PaymentGateway, user_id: int, amount: int) -> str:\n    pass\nasync def main():\n    pass", "solution": "# Протестируйте асинхронный сервис с помощью unittest.mock.AsyncMock\nimport asyncio\nfrom unittest.mock import AsyncMock\n\nclass PaymentGateway:\n    async def charge(self, user_id: int, amount: int) -> dict:\n        raise NotImplementedError\n\nasync def checkout_order(gateway: PaymentGateway, user_id: int, amount: int) -> str:\n    resp = await gateway.charge(user_id=user_id, amount=amount)\n    return resp[\"transaction_id\"]\n\nasync def main():\n    mock_gateway = AsyncMock(spec=PaymentGateway)\n    mock_gateway.charge.return_value = {\"transaction_id\": \"tx_async_777\"}\n\n    tx_id = await checkout_order(mock_gateway, user_id=10, amount=1500)\n    assert tx_id == \"tx_async_777\"\n    mock_gateway.charge.assert_awaited_once_with(user_id=10, amount=1500)\n    print(\"AsyncMock успешно проверен:\", tx_id)\n\nasyncio.run(main())", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"checkout_order\" in globals() and callable(checkout_order), \"Функция checkout_order() должна быть определена\"\n_fn_nodes_checkout_order = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"checkout_order\"]\nassert _fn_nodes_checkout_order and not (len(_fn_nodes_checkout_order[0].body) == 1 and isinstance(_fn_nodes_checkout_order[0].body[0], _ast.Pass)), \"Реализуйте тело функции checkout_order() (сейчас там только pass)\"\nassert \"main\" in globals() and callable(main), \"Функция main() должна быть определена\"\n_fn_nodes_main = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"main\"]\nassert _fn_nodes_main and not (len(_fn_nodes_main[0].body) == 1 and isinstance(_fn_nodes_main[0].body[0], _ast.Pass)), \"Реализуйте тело функции main() (сейчас там только pass)\"\nassert \"PaymentGateway\" in globals() and isinstance(PaymentGateway, type), \"Класс PaymentGateway должен быть определён\"\n_cl_def_PaymentGateway = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PaymentGateway\"]\nassert _cl_def_PaymentGateway and not (len(_cl_def_PaymentGateway[0].body) == 1 and isinstance(_cl_def_PaymentGateway[0].body[0], _ast.Pass)), \"Реализуйте тело класса PaymentGateway (сейчас там только pass)\"\nassert hasattr(PaymentGateway, \"charge\"), \"В классе PaymentGateway должен быть метод/свойство charge\"\n_cl_nodes_PaymentGateway_charge = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PaymentGateway\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"charge\"]\nassert _cl_nodes_PaymentGateway_charge and not (len(_cl_nodes_PaymentGateway_charge[0].body) == 1 and isinstance(_cl_nodes_PaymentGateway_charge[0].body[0], _ast.Pass)), \"Реализуйте метод PaymentGateway.charge()\"\nasyncio.run(main())", "code": "# Протестируйте асинхронный сервис с помощью unittest.mock.AsyncMock\nimport asyncio\nfrom unittest.mock import AsyncMock\n\nclass PaymentGateway:\n    async def charge(self, user_id: int, amount: int) -> dict:\n        raise NotImplementedError\n\nasync def checkout_order(gateway: PaymentGateway, user_id: int, amount: int) -> str:\n    resp = await gateway.charge(user_id=user_id, amount=amount)\n    return resp[\"transaction_id\"]\n\nasync def main():\n    mock_gateway = AsyncMock(spec=PaymentGateway)\n    mock_gateway.charge.return_value = {\"transaction_id\": \"tx_async_777\"}\n\n    tx_id = await checkout_order(mock_gateway, user_id=10, amount=1500)\n    assert tx_id == \"tx_async_777\"\n    mock_gateway.charge.assert_awaited_once_with(user_id=10, amount=1500)\n    print(\"AsyncMock успешно проверен:\", tx_id)\n\nasyncio.run(main())"}, {"id": 363, "title": "Защитите мок от опечаток в именах методов и аргументах через create_autospec", "level": 5, "tier": "🦅 Уровень 5", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Защитите мок от опечаток в именах методов и аргументах через create_autospec.</p>", "initialCode": "from unittest.mock import create_autospec\nclass UserService:\n\n    def activate_user(self, user_id: int, send_email: bool=True) -> bool:\n        pass", "solution": "# Защитите мок от опечаток в именах методов и аргументах через create_autospec\nfrom unittest.mock import create_autospec\n\nclass UserService:\n    def activate_user(self, user_id: int, send_email: bool = True) -> bool:\n        return True\n\nstrict_mock = create_autospec(UserService, instance=True)\nstrict_mock.activate_user.return_value = True\n\n# Корректный вызов по сигнатуре проходит:\nassert strict_moc
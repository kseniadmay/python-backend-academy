ent_addr должна быть вычислена\"\nassert \"server_addr\" in globals(), \"Переменная server_addr должна быть вычислена\"", "code": "# Напишите UDP-сервер и клиент с обработкой датаграмм\nclass UDPChannel:\n    def __init__(self):\n        self.queue: list[tuple[bytes, tuple[str, int]]] = []\n    def sendto(self, data: bytes, addr: tuple[str, int]):\n        self.queue.append((data, addr))\n    def recvfrom(self, bufsize: int = 1024) -> tuple[bytes, tuple[str, int]]:\n        data, addr = self.queue.pop(0)\n        return data[:bufsize], addr\n\nchannel = UDPChannel()\nclient_addr = (\"127.0.0.1\", 54321)\nserver_addr = (\"127.0.0.1\", 9090)\n\n# Клиент отправляет датаграмму без предварительного рукопожатия\nchannel.sendto(b\"Hello UDP\", server_addr)\ndata, _ = channel.recvfrom(1024)\n# Сервер отвечает ACK\nchannel.sendto(b\"ACK:\" + data, client_addr)\nreply, addr = channel.recvfrom(1024)\nprint(f\"Ответ {reply.decode()} доставлен на {addr}\")\nassert reply == b\"ACK:Hello UDP\" and addr == client_addr\n"}, {"id": 280, "title": "Напишите конвейер обработки лога с regex, генератором и JSON-выводом", "level": 6, "tier": "🦁 Уровень 6", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Напишите конвейер обработки лога с regex, генератором и JSON-выводом.</p>", "initialCode": "import re\nimport json\nlog_lines = ['2026-09-17 14:23:01 ERROR Database connection failed', '2026-09-17 14:23:05 INFO Request processed', '2026-09-17 14:23:07 ERROR Timeout on external API']\npattern = re.compile('(?P<date>[\\\\d-]+) (?P<time>[\\\\d:]+) (?P<level>\\\\w+) (?P<message>.+)')\ndef parse_errors(lines):\n    pass", "solution": "# Напишите конвейер обработки лога с regex, генератором и JSON-выводом\nimport re\nimport json\n\nlog_lines = [\n    '2026-09-17 14:23:01 ERROR Database connection failed',\n    '2026-09-17 14:23:05 INFO Request processed',\n    '2026-09-17 14:23:07 ERROR Timeout on external API',\n]\npattern = re.compile(r'(?P<date>[\\d-]+) (?P<time>[\\d:]+) (?P<level>\\w+) (?P<message>.+)')\n\ndef parse_errors(lines):\n    for line in lines:\n        match = pattern.match(line)\n        if match and match.group('level') == 'ERROR':\n            yield match.groupdict()\n\n\nerrors = list(parse_errors(log_lines))\nprint(json.dumps(errors, indent=2))", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"parse_errors\" in globals() and callable(parse_errors), \"Функция parse_errors() должна быть определена\"\n_fn_nodes_parse_errors = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"parse_errors\"]\nassert _fn_nodes_parse_errors and not (len(_fn_nodes_parse_errors[0].body) == 1 and isinstance(_fn_nodes_parse_errors[0].body[0], _ast.Pass)), \"Реализуйте тело функции parse_errors() (сейчас там только pass)\"\nerrors = list(parse_errors(log_lines))\nprint(json.dumps(errors, indent=2))\nassert \"errors\" in globals(), \"Переменная errors должна быть вычислена\"", "code": "# Напишите конвейер обработки лога с regex, генератором и JSON-выводом\nimport re\nimport json\n\nlog_lines = [\n    '2026-09-17 14:23:01 ERROR Database connection failed',\n    '2026-09-17 14:23:05 INFO Request processed',\n    '2026-09-17 14:23:07 ERROR Timeout on external API',\n]\npattern = re.compile(r'(?P<date>[\\d-]+) (?P<time>[\\d:]+) (?P<level>\\w+) (?P<message>.+)')\n\ndef parse_errors(lines):\n    for line in lines:\n        match = pattern.match(line)\n        if match and match.group('level') == 'ERROR':\n            yield match.groupdict()\n\n\nerrors = list(parse_errors(log_lines))\nprint(json.dumps(errors, indent=2))"}, {"id": 281, "title": "Спроектируйте Aggregate с Value Object Money и доменными исключениями вместе", "level": 7, "tier": "👑 Уровень 7", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Спроектируйте Aggregate с Value Object Money и доменными исключениями вместе.</p>", "initialCode": "class InsufficientFundsError(Exception):\n    pass\nclass Money:\n\n    def __init__(self, amount: int, currency: str='USD'):\n        pass\n\n    def __add__(self, other):\n        pass\n\n    def __sub__(self, other):\n        pass\n\n    def __eq__(self, other):\n        pass\n\n    def __repr__(self):\n        pass\nclass Account:\n\n    def __init__(self, account_id: int, balance: Money):\n        pass\n\n    def withdraw(self, amount: Money):\n        pass\n\n    def deposit(self, amount: Money):\n        pass\n\n    @property\n    def balance(self):\n        pass", "solution": "# Спроектируйте Aggregate с Value Object Money и доменными исключениями вместе\nclass InsufficientFundsError(Exception):\n    pass\n\n\nclass Money:  # Value Object\n    def __init__(self, amount: int, currency: str = \"USD\"):\n        if amount < 0:\n            raise ValueError(\"Сумма не может быть отрицательной\")\n        self.amount = amount\n        self.currency = currency\n\n    def __add__(self, other):\n        if self.currency != other.currency:\n            raise ValueError(\"Разные валюты\")\n        return Money(self.amount + other.amount, self.currency)\n\n    def __sub__(self, other):\n        if other.amount > self.amount:\n            raise InsufficientFundsError(f\"Недостаточно средств: {self.amount} < {other.amount}\")\n        return Money(self.amount - other.amount, self.currency)\n\n    def __eq__(self, other):\n        return isinstance(other, Money) and self.amount == other.amount and self.currency == other.currency\n\n    def __repr__(self):\n        return f\"Money({self.amount}, '{self.currency}')\"\n\n\nclass Account:  # Aggregate Root, Entity\n    def __init__(self, account_id: int, balance: Money):\n        self.id = account_id\n        self._balance = balance\n        self._history = []\n\n    def withdraw(self, amount: Money):\n        self._balance = self._balance - amount   # __sub__ бросит InsufficientFundsError сам\n        self._history.append((\"withdraw\", amount))\n\n    def deposit(self, amount: Money):\n        self._balance = self._balance + amount\n        self._history.append((\"deposit\", amount))\n\n    @property\n    def balance(self):\n        return self._balance\n\n\nacc = Account(1, Money(100))\nacc.deposit(Money(50))\nprint(acc.balance)          # Money(150, 'USD')\ntry:\n    acc.withdraw(Money(200))\nexcept InsufficientFundsError as _e:\n    print(\"InsufficientFundsError перехвачен:\", _e)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"InsufficientFundsError\" in globals() and isinstance(InsufficientFundsError, type), \"Класс InsufficientFundsError должен быть определён\"\nassert \"Money\" in globals() and isinstance(Money, type), \"Класс Money должен быть определён\"\n_cl_def_Money = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Money\"]\nassert _cl_def_Money and not (len(_cl_def_Money[0].body) == 1 and isinstance(_cl_def_Money[0].body[0], _ast.Pass)), \"Реализуйте тело класса Money (сейчас там только pass)\"\nassert hasattr(Money, \"__init__\"), \"В классе Money должен быть метод/свойство __init__\"\n_cl_nodes_Money___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Money\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Money___init__ and not (len(_cl_nodes_Money___init__[0].body) == 1 and isinstance(_cl_nodes_Money___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Money.__init__()\"\nassert hasattr(Money, \"__add__\"), \"В классе Money должен быть метод/свойство __add__\"\n_cl_nodes_Money___add__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Money\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__add__\"]\nassert _cl_nodes_Money___add__ and not (len(_cl_nodes_Money___add__[0].body) == 1 and isinstance(_cl_nodes_Money___add__[0].body[0], _ast.Pass)), \"Реализуйте метод Money.__add__()\"\nassert hasattr(Money, \"__sub__\"), \"В классе Money должен быть метод/свойство __sub__\"\n_cl_nodes_Money___sub__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Money\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__sub__\"]\nassert _cl_nodes_Money___sub__ and not (len(_cl_nodes_Money___sub__[0].body) == 1 and isinstance(_cl_nodes_Money___sub__[0].body[0], _ast.Pass)), \"Реализуйте метод Money.__sub__()\"\nassert hasattr(Money, \"__eq__\"), \"В классе Money должен быть метод/свойство __eq__\"\n_cl_nodes_Money___eq__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Money\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__eq__\"]\nassert _cl_nodes_Money___eq__ and not (len(_cl_nodes_Money___eq__[0].body) == 1 and isinstance(_cl_nodes_Money___eq__[0].body[0], _ast.Pass)), \"Реализуйте метод Money.__eq__()\"\nassert hasattr(Money, \"__repr__\"), \"В классе Money должен быть метод/свойство __repr__\"\n_cl_nodes_Money___repr__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Money\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__repr__\"]\nassert _cl_nodes_Money___repr__ and not (len(_cl_nodes_Money___repr__[0].body) == 1 and isinstance(_cl_nodes_Money___repr__[0].body[0], _ast.Pass)), \"Реализуйте метод Money.__repr__()\"\nassert \"Account\" in globals() and isinstance(Account, type), \"Класс Account должен быть определён\"\n_cl_def_Account = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\"]\nassert _cl_def_Account and not (len(_cl_def_Account[0].body) == 1 and isinstance(_cl_def_Account[0].body[0], _ast.Pass)), \"Реализуйте тело класса Account (сейчас там только pass)\"\nassert hasattr(Account, \"__init__\"), \"В классе Account должен быть метод/свойство __init__\"\n_cl_nodes_Account___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Account___init__ and not (len(_cl_nodes_Account___init__[0].body) == 1 and isinstance(_cl_nodes_Account___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Account.__init__()\"\nassert hasattr(Account, \"withdraw\"), \"В классе Account должен быть метод/свойство withdraw\"\n_cl_nodes_Account_withdraw = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"withdraw\"]\nassert _cl_nodes_Account_withdraw and not (len(_cl_nodes_Account_withdraw[0].body) == 1 and isinstance(_cl_nodes_Account_withdraw[0].body[0], _ast.Pass)), \"Реализуйте метод Account.withdraw()\"\nassert hasattr(Account, \"deposit\"), \"В классе Account должен быть метод/свойство deposit\"\n_cl_nodes_Account_deposit = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"deposit\"]\nassert _cl_nodes_Account_deposit and not (len(_cl_nodes_Account_deposit[0].body) == 1 and isinstance(_cl_nodes_Account_deposit[0].body[0], _ast.Pass)), \"Реализуйте метод Account.deposit()\"\nassert hasattr(Account, \"balance\"), \"В классе Account должен быть метод/свойство balance\"\n_cl_nodes_Account_balance = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"balance\"]\nassert _cl_nodes_Account_balance and not (len(_cl_nodes_Account_balance[0].body) == 1 and isinstance(_cl_nodes_Account_balance[0].body[0], _ast.Pass)), \"Реализуйте метод Account.balance()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nacc = Account(1, Money(100))\nacc.deposit(Money(50))\nprint(acc.balance)\ntry:\n    acc.withdraw(Money(200))\nexcept InsufficientFundsError as _e:\n    print(\"InsufficientFundsError перехвачен:\", _e)\nassert \"acc\" in globals(), \"Переменная acc должна быть вычислена\"", "code": "# Спроектируйте Aggregate с Value Object Money и доменными исключениями вместе\nclass InsufficientFundsError(Exception):\n    pass\n\n\nclass Money:  # Value Object\n    def __init__(self, amount: int, currency: str = \"USD\"):\n        if amount < 0:\n            raise ValueError(\"Сумма не может быть отрицательной\")\n        self.amount = amount\n        self.currency = currency\n\n    def __add__(self, other):\n        if self.currency != other.currency:\n            raise ValueError(\"Разные валюты\")\n        return Money(self.amount + other.amount, self.currency)\n\n    def __sub__(self, other):\n        if other.amount > self.amount:\n            raise InsufficientFundsError(f\"Недостаточно средств: {self.amount} < {other.amount}\")\n        return Money(self.amount - other.amount, self.currency)\n\n    def __eq__(self, other):\n        return isinstance(other, Money) and self.amount == other.amount and self.currency == other.currency\n\n    def __repr__(self):\n        return f\"Money({self.amount}, '{self.currency}')\"\n\n\nclass Account:  # Aggregate Root, Entity\n    def __init__(self, account_id: int, balance: Money):\n        self.id = account_id\n        self._balance = balance\n        self._history = []\n\n    def withdraw(self, amount: Money):\n        self._balance = self._balance - amount   # __sub__ бросит InsufficientFundsError сам\n        self._history.append((\"withdraw\", amount))\n\n    def deposit(self, amount: Money):\n        self._balance = self._balance + amount\n        self._history.append((\"deposit\", amount))\n\n    @property\n    def balance(self):\n        return self._balance\n\n\nacc = Account(1, Money(100))\nacc.deposit(Money(50))\nprint(acc.balance)          # Money(150, 'USD')\ntry:\n    acc.withdraw(Money(200))\nexcept InsufficientFundsError as _e:\n    print(\"InsufficientFundsError перехвачен:\", _e)"}, {"id": 282, "title": "Создайте и запустите два потока через threading.Thread", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Создайте и параллельно выполните два потока с помощью модуля <code>threading</code>.</p><p class='meta'>Создайте потоки <code>t1</code> и <code>t2</code> с целевой функцией <code>worker</code>, запустите их методом <code>.start()</code> и синхронизируйте их завершение через <code>.join()</code>.</p>", "initialCode": "import threading\ndef worker(name):\n    pass", "solution": "# Создайте и запустите два потока через threading.Thread\nimport threading\n\ndef worker(name):\n    print(f\"Поток {name} работает\")\n\nt1 = threading.Thread(target=worker, args=(\"A\",))\nt2 = threading.Thread(target=worker, args=(\"B\",))\n\nt1.start()\nt2.start()\nt1.join()   # дождаться завершения потока\nt2.join()\nprint(\"Оба потока завершены\")", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"worker\" in globals() and callable(worker), \"Функция worker() должна быть определена\"\n_fn_nodes_worker = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"worker\"]\nassert _fn_nodes_worker and not (len(_fn_nodes_worker[0].body) == 1 and isinstance(_fn_nodes_worker[0].body[0], _ast.Pass)), \"Реализуйте тело функции worker() (сейчас там только pass)\"\nt1 = threading.Thread(target=worker, args=(\"A\",))\nt2 = threading.Thread(target=worker, args=(\"B\",))\nt1.start()\nt2.start()\nt1.join()\nt2.join()\nprint(\"Оба потока завершены\")\nassert \"t1\" in globals(), \"Переменная t1 должна быть вычислена\"\nassert \"t2\" in globals(), \"Переменная t2 должна быть вычислена\"\nassert t1 is not None and t2 is not None and not t1.is_alive() and not t2.is_alive(), \"Потоки t1 и t2 должны быть запущены и завершены\"", "code": "# Создайте и запустите два потока через threading.Thread\nimport threading\n\ndef worker(name):\n    print(f\"Поток {name} работает\")\n\nt1 = threading.Thread(target=worker, args=(\"A\",))\nt2 = threading.Thread(target=worker, args=(\"B\",))\n\nt1.start()\nt2.start()\nt1.join()   # дождаться завершения потока\nt2.join()\nprint(\"Оба потока завершены\")"}, {"id": 283, "title": "Проверьте строку на соответствие шаблону через re.match", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Проверьте соответствие формата строки регулярному выражению через <code>re.match</code>.</p><p class='meta'>Для строки <code>text = \"INV-2026-001\"</code> выполните поиск по шаблону номера инвойса <code>r\"^INV-\\d{4}-\\d+\"</code> и сохраните объект совпадения в переменную <code>match</code>.</p>", "initialCode": "import re\ndef is_valid_username(name):\n    pass", "solution": "# Проверьте строку на соответствие шаблону через re.match\nimport re\n\ndef is_valid_username(name):\n    return re.match(r'^[a-zA-Z_][a-zA-Z0-9_]{2,15}$', name) is not None\n\nprint(is_valid_username(\"alex_99\"))   # True\nprint(is_valid_username(\"9alex\"))      # False — начинается с цифры", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"is_valid_username\" in globals() and callable(is_valid_username), \"Функция is_valid_username() должна быть определена\"\n_fn_nodes_is_valid_username = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"is_valid_username\"]\nassert _fn_nodes_is_valid_username and not (len(_fn_nodes_is_valid_username[0].body) == 1 and isinstance(_fn_nodes_is_valid_username[0].body[0], _ast.Pass)), \"Реализуйте тело функции is_valid_username() (сейчас там только pass)\"\nprint(is_valid_username(\"alex_99\"))\nprint(is_valid_username(\"9alex\"))\nassert match is not None and match.group() == \"INV-2026-001\", \"Строка text должна соответствовать шаблону регулярного выражения\"", "code": "# Проверьте строку на соответствие шаблону через re.match\nimport re\n\ndef is_valid_username(name):\n    return re.match(r'^[a-zA-Z_][a-zA-Z0-9_]{2,15}$', name) is not None\n\nprint(is_valid_username(\"alex_99\"))   # True\nprint(is_valid_username(\"9alex\"))      # False — начинается с цифры"}, {"id": 284, "title": "Используйте multiprocessing.Pool для параллельной обработки списка", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Используйте multiprocessing.Pool для параллельной обработки списка.</p>", "initialCode": "from multiprocessing import Pool\ndef square(x):\n    pass", "solution": "# Используйте multiprocessing.Pool для параллельной обработки списка\nfrom multiprocessing import Pool\n\ndef square(x):\n    return x ** 2\n\nif __name__ == '__main__':\n    with Pool(processes=4) as pool:\n        results = pool.map(square, [1, 2, 3, 4, 5])\n    print(results)  # [1, 4, 9, 16, 25]", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"square\" in globals() and callable(square), \"Функция square() должна быть определена\"\n_fn_nodes_square = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"square\"]\nassert _fn_nodes_square and not (len(_fn_nodes_square[0].body) == 1 and isinstance(_fn_nodes_square[0].body[0], _ast.Pass)), \"Реализуйте тело функции square() (сейчас там только pass)\"\nif __name__ == '__main__':\n    with Pool(processes=4) as pool:\n        results = pool.map(square, [1, 2, 3, 4, 5])\n    print(results)", "code": "# Используйте multiprocessing.Pool для параллельной обработки списка\nfrom multiprocessing import Pool\n\ndef square(x):\n    return x ** 2\n\nif __name__ == '__main__':\n    with Pool(processes=4) as pool:\n        results = pool.map(square, [1, 2, 3, 4, 5])\n    print(results)  # [1, 4, 9, 16, 25]"}, {"id": 285, "title": "Продемонстрируйте, что GIL мешает потокам ускорить CPU-bound задачу", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте, что GIL мешает потокам ускорить CPU-bound задачу.</p>", "initialCode": "import threading\nimport time\ndef cpu_bound(n):\n    pass", "solution": "# Продемонстрируйте, что GIL мешает потокам ускорить CPU-bound задачу\nimport threading\nimport time\n\ndef cpu_bound(n):\n    count = 0\n    for _ in range(n):\n        count += 1\n    return count\n\nN = 200\n\nstart = time.time()\ncpu_bound(N)\ncpu_bound(N)\nprint(f\"Последовательно: {time.time() - start:.2f}с\")\n\nstart = time.time()\nt1 = threading.Thread(target=cpu_bound, args=(N,))\nt2 = threading.Thread(target=cpu_bound, args=(N,))\nt1.start(); t2.start()\nt1.join(); t2.join()\nprint(f\"Два потока: {time.time() - start:.2f}с\")\n# время почти не уменьшилось — GIL не даёт потокам выполнять\n# байткод Python параллельно на CPU-bound задаче", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"cpu_bound\" in globals() and callable(cpu_bound), \"Функция cpu_bound() должна быть определена\"\n_fn_nodes_cpu_bound = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"cpu_bound\"]\nassert _fn_nodes_cpu_bound and not (len(_fn_nodes_cpu_bound[0].body) == 1 and isinstance(_fn_nodes_cpu_bound[0].body[0], _ast.Pass)), \"Реализуйте тело функции cpu_bound() (сейчас там только pass)\"\nN = 200\nstart = time.time()\ncpu_bound(N)\ncpu_bound(N)\nprint(f\"Последовательно: {time.time() - start:.2f}с\")\nstart = time.time()\nt1 = threading.Thread(target=cpu_bound, args=(N,))\nt2 = threading.Thread(target=cpu_bound, args=(N,))\nt1.start()\nt2.start()\nt1.join()\nt2.join()\nprint(f\"Два потока: {time.time() - start:.2f}с\")\nassert \"N\" in globals(), \"Переменная N должна быть вычислена\"\nassert \"start\" in globals(), \"Переменная start должна быть вычислена\"\nassert \"start\" in globals(), \"Переменная start должна быть вычислена\"\nassert \"t1\" in globals(), \"Переменная t1 должна быть вычислена\"\nassert \"t2\" in globals(), \"Переменная t2 должна быть вычислена\"", "code": "# Продемонстрируйте, что GIL мешает потокам ускорить CPU-bound задачу\nimport threading\nimport time\n\ndef cpu_bound(n):\n    count = 0\n    for _ in range(n):\n        count += 1\n    return count\n\nN = 200\n\nstart = time.time()\ncpu_bound(N)\ncpu_bound(N)\nprint(f\"Последовательно: {time.time() - start:.2f}с\")\n\nstart = time.time()\nt1 = threading.Thread(target=cpu_bound, args=(N,))\nt2 = threading.Thread(target=cpu_bound, args=(N,))\nt1.start(); t2.start()\nt1.join(); t2.join()\nprint(f\"Два потока: {time.time() - start:.2f}с\")\n# время почти не уменьшилось — GIL не даёт потокам выполнять\n# байткод Python параллельно на CPU-bound задаче"}, {"id": 286, "title": "Сгруппируйте элементы списка по ключу через collections.defaultdict", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Сгруппируйте элементы списка по ключу через collections.defaultdict.</p>", "initialCode": "from collections import defaultdict\n\nwords = ['apple', 'banana', 'avocado', 'blueberry', 'cherry']\ngrouped = None", "solution": "# Сгруппируйте элементы списка по ключу через collections.defaultdict\nfrom collections import defaultdict\n\nwords = [\"apple\", \"banana\", \"avocado\", \"blueberry\", \"cherry\"]\ngrouped = defaultdict(list)\n\nfor word in words:\n    grouped[word[0]].append(word)\n\nprint(dict(grouped))\n# {'a': ['apple', 'avocado'], 'b': ['banana', 'blueberry'], 'c': ['cherry']}", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"words\" in globals() and words is not None, \"Переменная words должна быть определена и не равна None\"\nassert words != \"__TODO__\", \"Заполните значение переменной words\"\nassert \"grouped\" in globals() and grouped is not None, \"Переменная grouped должна быть определена и не равна None\"\nassert grouped != \"__TODO__\", \"Заполните значение переменной grouped\"", "code": "# Сгруппируйте элементы списка по ключу через collections.defaultdict\nfrom collections import defaultdict\n\nwords = [\"apple\", \"banana\", \"avocado\", \"blueberry\", \"cherry\"]\ngrouped = defaultdict(list)\n\nfor word in words:\n    grouped[word[0]].append(word)\n\nprint(dict(grouped))\n# {'a': ['apple', 'avocado'], 'b': ['banana', 'blueberry'], 'c': ['cherry']}"}, {"id": 287, "title": "Сохраните и загрузите объект класса через pickle", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Сохраните и загрузите объект класса через pickle.</p>", "initialCode": "import pickle\nclass User:\n\n    def __init__(self, name, age):\n        pass", "solution": "# Сохраните и загрузите объект класса через pickle\nimport pickle\n\nclass User:\n    def __init__(self, name, age):\n        self.name = name\n        self.age = age\n\nuser = User(\"Alex\", 30)\nbinary_data = pickle.dumps(user)\n\nrestored = pickle.loads(binary_data)\nprint(restored.name, restored.age)   # Alex 30", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"User\" in globals() and isinstance(User, type), \"Класс User должен быть определён\"\n_cl_def_User = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"User\"]\nassert _cl_def_User and not (len(_cl_def_User[0].body) == 1 and isinstance(_cl_def_User[0].body[0], _ast.Pass)), \"Реализуйте тело класса User (сейчас там только pass)\"\nassert hasattr(User, \"__init__\"), \"В классе User должен быть метод/свойство __init__\"\n_cl_nodes_User___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"User\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_User___init__ and not (len(_cl_nodes_User___init__[0].body) == 1 and isinstance(_cl_nodes_User___init__[0].body[0], _ast.Pass)), \"Реализуйте метод User.__init__()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nuser = User(\"Alex\", 30)\nbinary_data = pickle.dumps(user)\nrestored = pickle.loads(binary_data)\nprint(restored.name, restored.age)\nassert \"user\" in globals(), \"Переменная user должна быть вычислена\"\nassert \"binary_data\" in globals(), \"Переменная binary_data должна быть вычислена\"\nassert \"restored\" in globals(), \"Переменная restored должна быть вычислена\"", "code": "# Сохраните и загрузите объект класса через pickle\nimport pickle\n\nclass User:\n    def __init__(self, name, age):\n        self.name = name\n        self.age = age\n\nuser = User(\"Alex\", 30)\nbinary_data = pickle.dumps(user)\n\nrestored = pickle.loads(binary_data)\nprint(restored.name, restored.age)   # Alex 30"}, {"id": 288, "title": "Реализуйте безопасный счётчик с threading.Lock", "level": 4, "tier": "🦊 Уровень 4", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте безопасный счётчик с threading.Lock.</p>", "initialCode": "import threading\nclass SafeCounter:\n\n    def __init__(self):\n        pass\n\n    def increment(self):\n        pass\ncounter = SafeCounter()\ndef worker():\n    pass", "solution": "# Реализуйте безопасный счётчик с threading.Lock\nimport threading\n\nclass SafeCounter:\n    def __init__(self):\n        self.value = 0\n        self._lock = threading.Lock()\n\n    def increment(self):\n        with self._lock:      # без лока два потока могут одновременно\n            self.value += 1     # прочитать одно и то же значение и потерять инкремент\n\ncounter = SafeCounter()\n\ndef worker():\n    for _ in range(100):\n        counter.increment()\n\nthreads = [threading.Thread(target=worker) for _ in range(4)]\nfor t in threads: t.start()\nfor t in threads: t.join()\n\nprint(counter.value)   # ровно 400000 — без Lock результат был бы меньше", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"worker\" in globals() and callable(worker), \"Функция worker() должна быть определена\"\n_fn_nodes_worker = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"worker\"]\nassert _fn_nodes_worker and not (len(_fn_nodes_worker[0].body) == 1 and isinstance(_fn_nodes_worker[0].body[0], _ast.Pass)), \"Реализуйте тело функции worker() (сейчас там только pass)\"\nassert \"SafeCounter\" in globals() and isinstance(SafeCounter, type), \"Класс SafeCounter должен быть определён\"\n_cl_def_SafeCounter = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SafeCounter\"]\nassert _cl_def_SafeCounter and not (len(_cl_def_SafeCounter[0].body) == 1 and isinstance(_cl_def_SafeCounter[0].body[0], _ast.Pass)), \"Реализуйте тело класса SafeCounter (сейчас там только pass)\"\nassert hasattr(SafeCounter, \"__init__\"), \"В классе SafeCounter должен быть метод/свойство __init__\"\n_cl_nodes_SafeCounter___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SafeCounter\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_SafeCounter___init__ and not (len(_cl_nodes_SafeCounter___init__[0].body) == 1 and isinstance(_cl_nodes_SafeCounter___init__[0].body[0], _ast.Pass)), \"Реализуйте метод SafeCounter.__init__()\"\nassert hasattr(SafeCounter, \"increment\"), \"В классе SafeCounter должен быть метод/свойство increment\"\n_cl_nodes_SafeCounter_increment = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SafeCounter\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"increment\"]\nassert _cl_nodes_SafeCounter_increment and not (len(_cl_nodes_SafeCounter_increment[0].body) == 1 and isinstance(_cl_nodes_SafeCounter_increment[0].body[0], _ast.Pass)), \"Реализуйте метод SafeCounter.increment()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nthreads = [threading.Thread(target=worker) for _ in range(4)]\nfor t in threads: t.start()\nfor t in threads: t.join()\nprint(counter.value)\nassert \"threads\" in globals(), \"Переменная threads должна быть вычислена\"", "code": "# Реализуйте безопасный счётчик с threading.Lock\nimport threading\n\nclass SafeCounter:\n    def __init__(self):\n        self.value = 0\n        self._lock = threading.Lock()\n\n    def increment(self):\n        with self._lock:      # без лока два потока могут одновременно\n            self.value += 1     # прочитать одно и то же значение и потерять инкремент\n\ncounter = SafeCounter()\n\ndef worker():\n    for _ in range(100):\n        counter.increment()\n\nthreads = [threading.Thread(target=worker) for _ in range(4)]\nfor t in threads: t.start()\nfor t in threads: t.join()\n\nprint(counter.value)   # ровно 400000 — без Lock результат был бы меньше"}, {"id": 289, "title": "Сравните время CPU-bound задачи через threading vs multiprocessing", "level": 5, "tier": "🦅 Уровень 5", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Сравните время CPU-bound задачи через threading vs multiprocessing.</p>", "initialCode": "import time\nfrom threading import Thread\nfrom multiprocessing import Process\ndef cpu_bound(n):\n    pass", "solution": "# Сравните время CPU-bound задачи через threading vs multiprocessing\nimport time\nfrom threading import Thread\nfrom multiprocessing import Process\n\ndef cpu_bound(n):\n    count = 0\n    for _ in range(n):\n        count += 1\n\nN = 200\n\nstart = time.time()\nthreads = [Thread(target=cpu_bound, args=(N,)) for _ in range(2)]\nfor t in threads: t.start()\nfor t in threads: t.join()\nprint(f\"threading: {time.time() - start:.2f}с\")   # почти не ускорилось — мешает GIL\n\nif __name__ == '__main__':\n    start = time.time()\n    procs = [Process(target=cpu_bound, args=(N,)) for _ in range(2)]\n    for p in procs: p.start()\n    for p in procs: p.join()\n    print(f\"multiprocessing: {time.time() - start:.2f}с\")   # заметно быстрее —\n                                                                # у каждого процесса свой GIL", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"cpu_bound\" in globals() and callable(cpu_bound), \"Функция cpu_bound() должна быть определена\"\n_fn_nodes_cpu_bound = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"cpu_bound\"]\nassert _fn_nodes_cpu_bound and not (len(_fn_nodes_cpu_bound[0].body) == 1 and isinstance(_fn_nodes_cpu_bound[0].body[0], _ast.Pass)), \"Реализуйте тело функции cpu_bound() (сейчас там только pass)\"\nN = 200\nstart = time.time()\nthreads = [Thread(target=cpu_bound, args=(N,)) for _ in range(2)]\nfor t in threads: t.start()\nfor t in threads: t.join()\nprint(f\"threading: {time.time() - start:.2f}с\")\nif __name__ == '__main__':\n    start = time.time()\n    procs = [Process(target=cpu_bound, args=(N,)) for _ in range(2)]\n    for p in procs: p.start()\n    for p in procs: p.join()\n    print(f\"multiprocessing: {time.time() - start:.2f}с\")\nassert \"N\" in globals(), \"Переменная N должна быть вычислена\"\nassert \"start\" in globals(), \"Переменная start должна быть вычислена\"\nassert \"threads\" in globals(), \"Переменная threads должна быть вычислена\"", "code": "# Сравните время CPU-bound задачи через threading vs multiprocessing\nimport time\nfrom threading import Thread\nfrom multiprocessing import Process\n\ndef cpu_bound(n):\n    count = 0\n    for _ in range(n):\n        count += 1\n\nN = 200\n\nstart = time.time()\nthreads = [Thread(target=cpu_bound, args=(N,)) for _ in range(2)]\nfor t in threads: t.start()\nfor t in threads: t.join()\nprint(f\"threading: {time.time() - start:.2f}с\")   # почти не ускорилось — мешает GIL\n\nif __name__ == '__main__':\n    start = time.time()\n    procs = [Process(target=cpu_bound, args=(N,)) for _ in range(2)]\n    for p in procs: p.start()\n    for p in procs: p.join()\n    print(f\"multiprocessing: {time.time() - start:.2f}с\")   # заметно быстрее —\n                                                                # у каждого процесса свой GIL"}, {"id": 290, "title": "Реализуйте собственный класс, поддерживающий срезы через __getitem__", "level": 5, "tier": "🦅 Уровень 5", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте собственный класс, поддерживающий срезы через __getitem__.</p>", "initialCode": "class Sequence:\n\n    def __init__(self, data):\n        pass\n\n    def __getitem__(self, key):\n        pass\n\n    def __len__(self):\n        pass", "solution": "# Реализуйте собственный класс, поддерживающий срезы через __getitem__\nclass Sequence:\n    def __init__(self, data):\n        self._data = list(data)\n\n    def __getitem__(self, key):\n        # key может быть как обычным индексом, так и объектом slice —\n        # list сам умеет обрабатывать оба случая\n        return self._data[key]\n\n    def __len__(self):\n        return len(self._data)\n\n\nseq = Sequence([10, 20, 30, 40, 50])\nprint(seq[1])       # 20 — обычный индекс\nprint(seq[1:4])      # [20, 30, 40] — обычный срез, key пришёл объектом slice\nprint(seq[::-1])     # [50, 40, 30, 20, 10] — реверс через срез", "hint": "Синтаксис срезов в Python: seq[start:stop:step]. Для получения инвертированной копии списка используй отрицательный шаг [::-1].", "tests": "import ast as _ast\nassert \"Sequence\" in globals() and isinstance(Sequence, type), \"Класс Sequence должен быть определён\"\n_cl_def_Sequence = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Sequence\"]\nassert _cl_def_Sequence and not (len(_cl_def_Sequence[0].body) == 1 and isinstance(_cl_def_Sequence[0].body[0], _ast.Pass)), \"Реализуйте тело класса Sequence (сейчас там только pass)\"\nassert hasattr(Sequence, \"__init__\"), \"В классе Sequence должен быть метод/свойство __init__\"\n_cl_nodes_Sequence___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Sequence\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Sequence___init__ and not (len(_cl_nodes_Sequence___init__[0].body) == 1 and isinstance(_cl_nodes_Sequence___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Sequence.__init__()\"\nassert hasattr(Sequence, \"__getitem__\"), \"В классе Sequence должен быть метод/свойство __getitem__\"\n_cl_nodes_Sequence___getitem__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Sequence\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__getitem__\"]\nassert _cl_nodes_Sequence___getitem__ and not (len(_cl_nodes_Sequence___getitem__[0].body) == 1 and isinstance(_cl_nodes_Sequence___getitem__[0].body[0], _ast.Pass)), \"Реализуйте метод Sequence.__getitem__()\"\nassert hasattr(Sequence, \"__len__\"), \"В классе Sequence должен быть метод/свойство __len__\"\n_cl_nodes_Sequence___len__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Sequence\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__len__\"]\nassert _cl_nodes_Sequence___len__ and not (len(_cl_nodes_Sequence___len__[0].body) == 1 and isinstance(_cl_nodes_Sequence___len__[0].body[0], _ast.Pass)), \"Реализуйте метод Sequence.__len__()\"\nseq = Sequence([10, 20, 30, 40, 50])\nprint(seq[1])\nprint(seq[1:4])\nprint(seq[::-1])\nassert \"seq\" in globals(), \"Переменная seq должна быть вычислена\"", "code": "# Реализуйте собственный класс, поддерживающий срезы через __getitem__\nclass Sequence:\n    def __init__(self, data):\n        self._data = list(data)\n\n    def __getitem__(self, key):\n        # key может быть как обычным индексом, так и объектом slice —\n        # list сам умеет обрабатывать оба случая\n        return self._data[key]\n\n    def __len__(self):\n        return len(self._data)\n\n\nseq = Sequence([10, 20, 30, 40, 50])\nprint(seq[1])       # 20 — обычный индекс\nprint(seq[1:4])      # [20, 30, 40] — обычный срез, key пришёл объектом slice\nprint(seq[::-1])     # [50, 40, 30, 20, 10] — реверс через срез"}, {"id": 291, "title": "Дизассемблируйте функцию через модуль dis и объясните байткод", "level": 5, "tier": "🦅 Уровень 5", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Дизассемблируйте функцию через модуль dis и объясните байткод.</p>", "initialCode": "import dis\ndef add(a, b):\n    pass", "solution": "# Дизассемблируйте функцию через модуль dis и объясните байткод\nimport dis\n\ndef add(a, b):\n    return a + b\n\ndis.dis(add)\n# LOAD_FAST a, LOAD_FAST b, BINARY_ADD, RETURN_VALUE —\n# видно, что даже такая простая операция превращается\n# в 4 отдельные инструкции виртуальной машины Python", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"add\" in globals() and callable(add), \"Функция add() должна быть определена\"\n_fn_nodes_add = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"add\"]\nassert _fn_nodes_add and not (len(_fn_nodes_add[0].body) == 1 and isinstance(_fn_nodes_add[0].body[0], _ast.Pass)), \"Реализуйте тело функции add() (сейчас там только pass)\"\ndis.dis(add)", "code": "# Дизассемблируйте функцию через модуль dis и объясните байткод\nimport dis\n\ndef add(a, b):\n    return a + b\n\ndis.dis(add)\n# LOAD_FAST a, LOAD_FAST b, BINARY_ADD, RETURN_VALUE —\n# видно, что даже такая простая операция превращается\n# в 4 отдельные инструкции виртуальной машины Python"}, {"id": 292, "title": "Реализуйте producer-consumer через queue.Queue и потоки", "level": 6, "tier": "🦁 Уровень 6", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте producer-consumer через queue.Queue и потоки.</p>", "initialCode": "import threading\nimport queue\nimport time\nq = queue.Queue()\ndef producer():\n    pass\ndef consumer():\n    pass", "solution": "# Реализуйте producer-consumer через queue.Queue и потоки\nimport threading\nimport queue\nimport time\n\nq = queue.Queue()\n\ndef producer():\n    for i in range(5):\n        q.put(i)\n        print(f\"Произведено: {i}\")\n        time.sleep(0.1)\n    q.put(None)   # сигнал остановки для consumer\n\ndef consumer():\n    while True:\n        item = q.get()\n        if item is None:\n            break\n        print(f\"Обработано: {item}\")\n\nt1 = threading.Thread(target=producer)\nt2 = threading.Thread(target=consumer)\nt1.start(); t2.start()\nt1.join(); t2.join()\n# Queue потокобезопасна сама по себе — не нужен ручной Lock\n# для координации между producer и consumer", "hint": "Шаг 1: Используй список или collections.deque. Шаг 2: Добавляй в конец (append), извлекай из начала (popleft / pop(0)) с валидацией непустого состояния.", "tests": "import ast as _ast\nassert \"producer\" in globals() and callable(producer), \"Функция producer() должна быть определена\"\n_fn_nodes_producer = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"producer\"]\nassert _fn_nodes_producer and not (len(_fn_nodes_producer[0].body) == 1 and isinstance(_fn_nodes_producer[0].body[0], _ast.Pass)), \"Реализуйте тело функции producer() (сейчас там только pass)\"\nassert \"consumer\" in globals() and callable(consumer), \"Функция consumer() должна быть определена\"\n_fn_nodes_consumer = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"consumer\"]\nassert _fn_nodes_consumer and not (len(_fn_nodes_consumer[0].body) == 1 and isinstance(_fn_nodes_consumer[0].body[0], _ast.Pass)), \"Реализуйте тело функции consumer() (сейчас там только pass)\"\nt1 = threading.Thread(target=producer)\nt2 = threading.Thread(target=consumer)\nt1.start()\nt2.start()\nt1.join()\nt2.join()\nassert \"t1\" in globals(), \"Переменная t1 должна быть вычислена\"\nassert \"t2\" in globals(), \"Переменная t2 должна быть вычислена\"", "code": "# Реализуйте producer-consumer через queue.Queue и потоки\nimport threading\nimport queue\nimport time\n\nq = queue.Queue()\n\ndef producer():\n    for i in range(5):\n        q.put(i)\n        print(f\"Произведено: {i}\")\n        time.sleep(0.1)\n    q.put(None)   # сигнал остановки для consumer\n\ndef consumer():\n    while True:\n        item = q.get()\n        if item is None:\n            break\n        print(f\"Обработано: {item}\")\n\nt1 = threading.Thread(target=producer)\nt2 = threading.Thread(target=consumer)\nt1.start(); t2.start()\nt1.join(); t2.join()\n# Queue потокобезопасна сама по себе — не нужен ручной Lock\n# для координации между producer и consumer"}, {"id": 293, "title": "Реализуйте кольцевой буфер фиксированного размера на списке", "level": 6, "tier": "🦁 Уровень 6", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте кольцевой буфер фиксированного размера на списке.</p>", "initialCode": "class RingBuffer:\n\n    def __init__(self, size):\n        pass\n\n    def append(self, item):\n        pass\n\n    def __repr__(self):\n        pass", "solution": "# Реализуйте кольцевой буфер фиксированного размера на списке\nclass RingBuffer:\n    def __init__(self, size):\n        self.size = size\n        self._data = []\n\n    def append(self, item):\n        self._data.append(item)\n        if len(self._data) > self.size:\n            self._data.pop(0)   # выталкиваем самый старый элемент\n\n    def __repr__(self):\n        return repr(self._data)\n\n\nbuf = RingBuffer(3)\nfor i in range(5):\n    buf.append(i)\n    print(buf)\n# [0] [0, 1] [0, 1, 2] [1, 2, 3] [2, 3, 4] — размер никогда не превышает 3", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"RingBuffer\" in globals() and isinstance(RingBuffer, type), \"Класс RingBuffer должен быть определён\"\n_cl_def_RingBuffer = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"RingBuffer\"]\nassert _cl_def_RingBuffer and not (len(_cl_def_RingBuffer[0].body) == 1 and isinstance(_cl_def_RingBuffer[0].body[0], _ast.Pass)), \"Реализуйте тело класса RingBuffer (сейчас там только pass)\"\nassert hasattr(RingBuffer, \"__init__\"), \"В классе RingBuffer должен быть метод/свойство __init__\"\n_cl_nodes_RingBuffer___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"RingBuffer\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_RingBuffer___init__ and not (len(_cl_nodes_RingBuffer___init__[0].body) == 1 and isinstance(_cl_nodes_RingBuffer___init__[0].body[0], _ast.Pass)), \"Реализуйте метод RingBuffer.__init__()\"\nassert hasattr(RingBuffer, \"append\"), \"В классе RingBuffer должен быть метод/свойство append\"\n_cl_nodes_RingBuffer_append = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"RingBuffer\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"append\"]\nassert _cl_nodes_RingBuffer_append and not (len(_cl_nodes_RingBuffer_append[0].body) == 1 and isinstance(_cl_nodes_RingBuffer_append[0].body[0], _ast.Pass)), \"Реализуйте метод RingBuffer.append()\"\nassert hasattr(RingBuffer, \"__repr__\"), \"В классе RingBuffer должен быть метод/свойство __repr__\"\n_cl_nodes_RingBuffer___repr__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"RingBuffer\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__repr__\"]\nassert _cl_nodes_RingBuffer___repr__ and not (len(_cl_nodes_RingBuffer___repr__[0].body) == 1 and isinstance(_cl_nodes_RingBuffer___repr__[0].body[0], _ast.Pass)), \"Реализуйте метод RingBuffer.__repr__()\"\nbuf = RingBuffer(3)\nfor i in range(5):\n    buf.append(i)\n    print(buf)\nassert \"buf\" in globals(), \"Переменная buf должна быть вычислена\"", "code": "# Реализуйте кольцевой буфер фиксированного размера на списке\nclass RingBuffer:\n    def __init__(self, size):\n        self.size = size\n        self._data = []\n\n    def append(self, item):\n        self._data.append(item)\n        if len(self._data) > self.size:\n            self._data.pop(0)   # выталкиваем самый старый элемент\n\n    def __repr__(self):\n        return repr(self._data)\n\n\nbuf = RingBuffer(3)\nfor i in range(5):\n    buf.append(i)\n    print(buf)\n# [0] [0, 1] [0, 1, 2] [1, 2, 3] [2, 3, 4] — размер никогда не превышает 3"}, {"id": 294, "title": "Постройте пул воркеров через ProcessPoolExecutor с обработкой ошибок", "level": 7, "tier": "👑 Уровень 7", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Постройте пул воркеров через ProcessPoolExecutor с обработкой ошибок.</p>", "initialCode": "from concurrent.futures import ProcessPoolExecutor, as_completed\ndef risky_task(n):\n    pass", "solution": "# Постройте пул воркеров через ProcessPoolExecutor с обработкой ошибок\nfrom concurrent.futures import ProcessPoolExecutor, as_completed\n\ndef risky_task(n):\n    if n == 3:\n        raise ValueError(f\"Задача {n} упала намеренно\")\n    return n ** 2\n\nif __name__ == '__main__':\n    results = {}\n    with ProcessPoolExecutor(max_workers=4) as executor:\n        futures = {executor.submit(risky_task, i): i for i in range(5)}\n        for future in as_completed(futures):\n            n = futures[future]\n            try:\n                results[n] = future.result()\n            except ValueError as e:\n                results[n] = f\"ошибка: {e}\"\n\n    print(results)\n    # {0: 0, 1: 1, 2: 4, 3: 'ошибка: Задача 3 упала намеренно', 4: 16}\n    # одна упавшая задача не роняет весь пул — остальные результаты доступны", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"risky_task\" in globals() and callable(risky_task), \"Функция risky_task() должна быть определена\"\n_fn_nodes_risky_task = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"risky_task\"]\nassert _fn_nodes_risky_task and not (len(_fn_nodes_risky_task[0].body) == 1 and isinstance(_fn_nodes_risky_task[0].body[0], _ast.Pass)), \"Реализуйте тело функции risky_task() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nif __name__ == '__main__':\n    results = {}\n    with ProcessPoolExecutor(max_workers=4) as executor:\n        futures = {executor.submit(risky_task, i): i for i in range(5)}\n        for future in as_completed(futures):\n            n = futures[future]\n            try:\n                results[n] = future.result()\n            except ValueError as e:\n                results[n] = f\"ошибка: {e}\"\n\n    print(results)", "code": "# Постройте пул воркеров через ProcessPoolExecutor с обработкой ошибок\nfrom concurrent.futures import ProcessPoolExecutor, as_completed\n\ndef risky_task(n):\n    if n == 3:\n        raise ValueError(f\"Задача {n} упала намеренно\")\n    return n ** 2\n\nif __name__ == '__main__':\n    results = {}\n    with ProcessPoolExecutor(max_workers=4) as executor:\n        futures = {executor.submit(risky_task, i): i for i in range(5)}\n        for future in as_completed(futures):\n            n = futures[future]\n            try:\n                results[n] = future.result()\n            except ValueError as e:\n                results[n] = f\"ошибка: {e}\"\n\n    print(results)\n    # {0: 0, 1: 1, 2: 4, 3: 'ошибка: Задача 3 упала намеренно', 4: 16}\n    # одна упавшая задача не роняет весь пул — остальные результаты доступны"}, {"id": 295, "title": "Напишите валидатор конфигурации на regex с именованными группами и сериализацией в JSON", "level": 7, "tier": "👑 Уровень 7", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Напишите валидатор конфигурации на regex с именованными группами и сериализацией в JSON.</p>", "initialCode": "import re\nimport json\nCONFIG_LINE = re.compile('^(?P<key>[A-Z_]+)=(?P<value>.+)$')\ndef parse_config(lines):\n    pass", "solution": "# Напишите валидатор конфигурации на regex с именованными группами и сериализацией в JSON\nimport re\nimport json\n\nCONFIG_LINE = re.compile(\n    r'^(?P<key>[A-Z_]+)=(?P<value>.+)$'\n)\n\ndef parse_config(lines):\n    result = {}\n    errors = []\n    for i, line in enumerate(lines, 1):\n        line = line.strip()\n        if not line or line.startswith('#'):\n            continue\n        match = CONFIG_LINE.match(line)\n        if not match:\n            errors.append(f\"Строка {i}: неверный формат — {line!r}\")\n            continue\n        result[match.group('key')] = match.group('value')\n    return result, errors\n\n\nlines = [\n    \"DEBUG=true\",\n    \"# комментарий\",\n    \"PORT=8080\",\n    \"invalid line without equals\",\n    \"DATABASE_URL=postgres://localhost/db\",\n]\nconfig, errors = parse_config(lines)\nprint(json.dumps(config, indent=2))\nprint(errors)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (👑 Уровень 7). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"parse_config\" in globals() and callable(parse_config), \"Функция parse_config() должна быть определена\"\n_fn_nodes_parse_config = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"parse_config\"]\nassert _fn_nodes_parse_config and not (len(_fn_nodes_parse_config[0].body) == 1 and isinstance(_fn_nodes_parse_config[0].body[0], _ast.Pass)), \"Реализуйте тело функции parse_config() (сейчас там только pass)\"\nlines = [\n    \"DEBUG=true\",\n    \"# комментарий\",\n    \"PORT=8080\",\n    \"invalid line without equals\",\n    \"DATABASE_URL=postgres://localhost/db\",\n]\nconfig, errors = parse_config(lines)\nprint(json.dumps(config, indent=2))\nprint(errors)\nassert \"lines\" in globals(), \"Переменная lines должна быть вычислена\"", "code": "# Напишите валидатор конфигурации на regex с именованными группами и сериализацией в JSON\nimport re\nimport json\n\nCONFIG_LINE = re.compile(\n    r'^(?P<key>[A-Z_]+)=(?P<value>.+)$'\n)\n\ndef parse_config(lines):\n    result = {}\n    errors = []\n    for i, line in enumerate(lines, 1):\n        line = line.strip()\n        if not line or line.startswith('#'):\n            continue\n        match = CONFIG_LINE.match(line)\n        if not match:\n            errors.append(f\"Строка {i}: неверный формат — {line!r}\")\n            continue\n        result[match.group('key')] = match.group('value')\n    return result, errors\n\n\nlines = [\n    \"DEBUG=true\",\n    \"# комментарий\",\n    \"PORT=8080\",\n    \"invalid line without equals\",\n    \"DATABASE_URL=postgres://localhost/db\",\n]\nconfig, errors = parse_config(lines)\nprint(json.dumps(config, indent=2))\nprint(errors)"}, {"id": 296, "title": "Запишите и прочитайте текстовый файл через with open()", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Запишите строку в файл и прочитайте её обратно через контекстный менеджер <code>with open()</code>.</p><p class='meta'>Запишите текст <code>\"Первая строка заметок\\n\"</code> в файл <code>notes.txt</code> в режиме <code>\"w\"</code>, а затем откройте его в режиме <code>\"r\"</code> и прочитайте содержимое в переменную <code>content</code>.</p>", "initialCode": "# Запишите и прочитайте текстовый файл через with open()\ncontent = ''\n", "solution": "# Запишите и прочитайте текстовый файл через with open()\nwith open(\"notes.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"Первая строка\\n\")\n    f.write(\"Вторая строка\\n\")\n\nwith open(\"notes.txt\", \"r\", encoding=\"utf-8\") as f:\n    content = f.read()\n\nprint(content)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"content\" in globals() and \"Первая строка\" in str(content), \"Файл notes.txt должен быть записан и прочитан в переменную content\"", "code": "# Запишите и прочитайте текстовый файл через with open()\nwith open(\"notes.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"Первая строка\\n\")\n    f.write(\"Вторая строка\\n\")\n\nwith open(\"notes.txt\", \"r\", encoding=\"utf-8\") as f:\n    content = f.read()\n\nprint(content)"}, {"id": 297, "title": "Дополните список через append и расширьте другим списком через extend", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте различие между добавлением элемента <code>append()</code> и расширением списка <code>extend()</code>.</p><p class='meta'>Для списка <code>items = [1, 2]</code> добавьте одиночное число <code>3</code> методом <code>append(3)</code>, а затем объедините со списком <code>[4, 5]</code> методом <code>extend([4, 5])</code>.</p>", "initialCode": "cart = None", "solution": "# Дополните список через append и расширьте другим списком через extend\ncart = [\"apple\"]\ncart.append(\"banana\")          # добавляет один элемент\nprint(cart)                      # ['apple', 'banana']\n\ncart.extend([\"cherry\", \"date\"])  # добавляет элементы по отдельности\nprint(cart)                      # ['apple', 'banana', 'cherry', 'date']\n\ncart.append([\"extra\", \"items\"])  # список добавится КАК ОДИН элемент\nprint(cart)                      # [..., ['extra', 'items']]", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"cart\" in globals() and cart is not None, \"Переменная cart должна быть определена и не равна None\"\nassert cart != \"__TODO__\", \"Заполните значение переменной cart\"\nassert items == [1, 2, 3, 4, 5], \"Список items должен быть дополнен через append(3) и extend([4, 5])\"", "code": "# Дополните список через append и расширьте другим списком через extend\ncart = [\"apple\"]\ncart.append(\"banana\")          # добавляет один элемент\nprint(cart)                      # ['apple', 'banana']\n\ncart.extend([\"cherry\", \"date\"])  # добавляет элементы по отдельности\nprint(cart)                      # ['apple', 'banana', 'cherry', 'date']\n\ncart.append([\"extra\", \"items\"])  # список добавится КАК ОДИН элемент\nprint(cart)                      # [..., ['extra', 'items']]"}, {"id": 298, "title": "Используйте моржовый оператор для проверки длины и вывода в одном выражении", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Используйте моржовый оператор для проверки длины и вывода в одном выражении.</p>", "initialCode": "data = None", "solution": "# Используйте моржовый оператор для проверки длины и вывода в одном выражении\ndata = [1, 2, 3, 4, 5, 6]\n\nif (n := len(data)) > 3:\n    print(f\"Слишком много элементов: {n}\")\nelse:\n    print(f\"Нормально: {n}\")", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"data\" in globals() and data is not None, \"Переменная data должна быть определена и не равна None\"\nassert data != \"__TODO__\", \"Заполните значение переменной data\"", "code": "# Используйте моржовый оператор для проверки длины и вывода в одном выражении\ndata = [1, 2, 3, 4, 5, 6]\n\nif (n := len(data)) > 3:\n    print(f\"Слишком много элементов: {n}\")\nelse:\n    print(f\"Нормально: {n}\")"}, {"id": 299, "title": "Объедините списки имён и оценок через zip() и найдите лучшего студента", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Объедините списки имён и оценок через zip() и найдите лучшего студента.</p>", "initialCode": "names = ['Alice', 'Bob', 'Charlie']\nscores = [85, 92, 78]\nbest_name = None\nbest_score = None", "solution": "# Объедините списки имён и оценок через zip() и найдите лучшего студента\nnames = [\"Alice\", \"Bob\", \"Charlie\"]\nscores = [85, 92, 78]\n\nbest_name, best_score = max(zip(names, scores), key=lambda pair: pair[1])\nprint(f\"{best_name}: {best_score}\")   # Bob: 92", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"names\" in globals() and names is not None, \"Переменная names должна быть определена и не равна None\"\nassert names != \"__TODO__\", \"Заполните значение переменной names\"\nassert \"scores\" in globals() and scores is not None, \"Переменная scores должна быть определена и не равна None\"\nassert scores != \"__TODO__\", \"Заполните значение переменной scores\"\nassert \"best_name\" in globals() and best_name is not None, \"Переменная best_name должна быть определена и не равна None\"\nassert best_name != \"__TODO__\", \"Заполните значение переменной best_name\"\nassert \"best_score\" in globals() and best_score is not None, \"Переменная best_score должна быть определена и не равна None\"\nassert best_score != \"__TODO__\", \"Заполните значение переменной best_score\"", "code": "# Объедините списки имён и оценок через zip() и найдите лучшего студента\nnames = [\"Alice\", \"Bob\", \"Charlie\"]\nscores = [85, 92, 78]\n\nbest_name, best_score = max(zip(names, scores), key=lambda pair: pair[1])\nprint(f\"{best_name}: {best_score}\")   # Bob: 92"}, {"id": 300, "title": "Сравните id() объекта до и после присваивания и после копирования", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Сравните id() объекта до и после присваивания и после копирования.</p>", "initialCode": "a = [1, 2, 3]\nb = None\nc = None", "solution": "# Сравните id() объекта до и после присваивания и после копирования\na = [1, 2, 3]\nb = a               # присваивание — та же ссылка\nc = a.copy()          # копия — новый объект\n\nprint(id(a) == id(b))   # True — b это тот же объект\nprint(id(a) == id(c))   # False — c это независимая копия\nprint(a is b, a is c)     # True False", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"a\" in globals() and a is not None, \"Переменная a должна быть определена и не равна None\"\nassert a != \"__TODO__\", \"Заполните значение переменной a\"\nassert \"b\" in globals() and b is not None, \"Переменная b должна быть определена и не равна None\"\nassert b != \"__TODO__\", \"Заполните значение переменной b\"\nassert \"c\" in globals() and c is not None, \"Переменная c должна быть определена и не равна None\"\nassert c != \"__TODO__\", \"Заполните значение переменной c\"", "code": "# Сравните id() объекта до и после присваивания и после копирования\na = [1, 2, 3]\nb = a               # присваивание — та же ссылка\nc = a.copy()          # копия — новый объект\n\nprint(id(a) == id(b))   # True — b это тот же объект\nprint(id(a) == id(c))   # False — c это независимая копия\nprint(a is b, a is c)     # True False"}, {"id": 301, "title": "Прочитайте файл построчно и посчитайте количество непустых строк", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Прочитайте файл построчно и посчитайте количество непустых строк.</p>", "initialCode": "count = None", "solution": "# Прочитайте файл построчно и посчитайте количество непустых строк\nwith open(\"log.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"строка 1\\n\\nстрока 2\\n\\n\\nстрока 3\\n\")\n\ncount = 0\nwith open(\"log.txt\", \"r\", encoding=\"utf-8\") as f:\n    for line in f:                 # построчное чтение — не грузит весь файл в память\n        if line.strip():\n            count += 1\n\nprint(count)   # 3", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"count\" in globals() and count is not None, \"Переменная count должна быть определена и не равна None\"\nassert count != \"__TODO__\", \"Заполните значение переменной count\"", "code": "# Прочитайте файл построчно и посчитайте количество непустых строк\nwith open(\"log.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"строка 1\\n\\nстрока 2\\n\\n\\nстрока 3\\n\")\n\ncount = 0\nwith open(\"log.txt\", \"r\", encoding=\"utf-8\") as f:\n    for line in f:                 # построчное чтение — не грузит весь файл в память\n        if line.strip():\n            count += 1\n\nprint(count)   # 3"}, {"id": 302, "title": "Используйте моржовый оператор внутри спискового включения с regex", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Используйте моржовый оператор внутри спискового включения с regex.</p>", "initialCode": "import re\n\nlines = ['user: alex@example.com', 'нет почты тут', 'user: nina@test.org']\npattern = '[\\\\w.]+@[\\\\w.]+\\\\.\\\\w+'\nemails = None", "solution": "# Используйте моржовый оператор внутри спискового включения с regex\nimport re\n\nlines = [\"user: alex@example.com\", \"нет почты тут\", \"user: nina@test.org\"]\npattern = r'[\\w.]+@[\\w.]+\\.\\w+'\n\nemails = [m.group() for line in lines if (m := re.search(pattern, line))]\nprint(emails)   # ['alex@example.com', 'nina@test.org']", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"lines\" in globals() and lines is not None, \"Переменная lines должна быть определена и не равна None\"\nassert lines != \"__TODO__\", \"Заполните значение переменной lines\"\nassert \"pattern\" in globals() and pattern is not None, \"Переменная pattern должна быть определена и не равна None\"\nassert \"emails\" in globals() and emails is not None, \"Переменная emails должна быть определена и не равна None\"\nassert emails != \"__TODO__\", \"Заполните значение переменной emails\"", "code": "# Используйте моржовый оператор внутри спискового включения с regex\nimport re\n\nlines = [\"user: alex@example.com\", \"нет почты тут\", \"user: nina@test.org\"]\npattern = r'[\\w.]+@[\\w.]+\\.\\w+'\n\nemails = [m.group() for line in lines if (m := re.search(pattern, line))]\nprint(emails)   # ['alex@example.com', 'nina@test.org']"}, {"id": 303, "title": "Реализуйте класс с __len__ и __contains__ для кастомной коллекции", "level": 4, "tier": "🦊 Уровень 4", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте класс с __len__ и __contains__ для кастомной коллекции.</p>", "initialCode": "class Playlist:\n\n    def __init__(self, songs):\n        pass\n\n    def __len__(self):\n        pass\n\n    def __contains__(self, song):\n        pass\n\n    def __getitem__(self, index):\n        pass", "solution": "# Реализуйте класс с __len__ и __contains__ для кастомной коллекции\nclass Playlist:\n    def __init__(self, songs):\n        self._songs = list(songs)\n\n    def __len__(self):\n        return len(self._songs)\n\n    def __contains__(self, song):\n        return song in self._songs\n\n    def __getitem__(self, index):\n        return self._songs[index]\n\n\nplaylist = Playlist([\"Song A\", \"Song B\", \"Song C\"])\nprint(len(playlist))                # 3 — вызывает __len__\nprint(\"Song B\" in playlist)         # True — вызывает __contains__\nprint(playlist[0])                   # \"Song A\" — вызывает __getitem__", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Playlist\" in globals() and isinstance(Playlist, type), \"Класс Playlist должен быть определён\"\n_cl_def_Playlist = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Playlist\"]\nassert _cl_def_Playlist and not (len(_cl_def_Playlist[0].body) == 1 and isinstance(_cl_def_Playlist[0].body[0], _ast.Pass)), \"Реализуйте тело класса Playlist (сейчас там только pass)\"\nassert hasattr(Playlist, \"__init__\"), \"В классе Playlist должен быть метод/свойство __init__\"\n_cl_nodes_Playlist___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Playlist\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Playlist___init__ and not (len(_cl_nodes_Playlist___init__[0].body) == 1 and isinstance(_cl_nodes_Playlist___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Playlist.__init__()\"\nassert hasattr(Playlist, \"__len__\"), \"В классе Playlist должен быть метод/свойство __len__\"\n_cl_nodes_Playlist___len__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Playlist\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__len__\"]\nassert _cl_nodes_Playlist___len__ and not (len(_cl_nodes_Playlist___len__[0].body) == 1 and isinstance(_cl_nodes_Playlist___len__[0].body[0], _ast.Pass)), \"Реализуйте метод Playlist.__len__()\"\nassert hasattr(Playlist, \"__contains__\"), \"В классе Playlist должен быть метод/свойство __contains__\"\n_cl_nodes_Playlist___contains__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Playlist\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__contains__\"]\nassert _cl_nodes_Playlist___contains__ and not (len(_cl_nodes_Playlist___contains__[0].body) == 1 and isinstance(_cl_nodes_Playlist___contains__[0].body[0], _ast.Pass)), \"Реализуйте метод Playlist.__contains__()\"\nassert hasattr(Playlist, \"__getitem__\"), \"В классе Playlist должен быть метод/свойство __getitem__\"\n_cl_nodes_Playlist___getitem__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Playlist\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__getitem__\"]\nassert _cl_nodes_Playlist___getitem__ and not (len(_cl_nodes_Playlist___getitem__[0].body) == 1 and isinstance(_cl_nodes_Playlist___getitem__[0].body[0], _ast.Pass)), \"Реализуйте метод Playlist.__getitem__()\"\nplaylist = Playlist([\"Song A\", \"Song B\", \"Song C\"])\nprint(len(playlist))\nprint(\"Song B\" in playlist)\nprint(playlist[0])\nassert \"playlist\" in globals(), \"Переменная playlist должна быть вычислена\"", "code": "# Реализуйте класс с __len__ и __contains__ для кастомной коллекции\nclass Playlist:\n    def __init__(self, songs):\n        self._songs = list(songs)\n\n    def __len__(self):\n        return len(self._songs)\n\n    def __contains__(self, song):\n        return song in self._songs\n\n    def __getitem__(self, index):\n        return self._songs[index]\n\n\nplaylist = Playlist([\"Song A\", \"Song B\", \"Song C\"])\nprint(len(playlist))                # 3 — вызывает __len__\nprint(\"Song B\" in playlist)         # True — вызывает __contains__\nprint(playlist[0])                   # \"Song A\" — вызывает __getitem__"}, {"id": 304, "title": "Используйте zip(*matrix) для транспонирования матрицы", "level": 4, "tier": "🦊 Уровень 4", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Используйте zip(*matrix) для транспонирования матрицы.</p>", "initialCode": "matrix = [[1, 2, 3], [4, 5, 6]]\ntransposed = None", "solution": "# Используйте zip(*matrix) для транспонирования матрицы\nmatrix = [\n    [1, 2, 3],\n    [4, 5, 6],\n]\n\ntransposed = list(zip(*matrix))\nprint(transposed)   # [(1, 4), (2, 5), (3, 6)]", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"matrix\" in globals() and matrix is not None, \"Переменная matrix должна быть определена и не равна None\"\nassert matrix != \"__TODO__\", \"Заполните значение переменной matrix\"\nassert \"transposed\" in globals() and transposed is not None, \"Переменная transposed должна быть определена и не равна None\"\nassert transposed != \"__TODO__\", \"Заполните значение переменной transposed\"", "code": "# Используйте zip(*matrix) для транспонирования матрицы\nmatrix = [\n    [1, 2, 3],\n    [4, 5, 6],\n]\n\ntransposed = list(zip(*matrix))\nprint(transposed)   # [(1, 4), (2, 5), (3, 6)]"}, {"id": 305, "title": "Напишите функцию слияния логов из нескольких файлов с дедупликацией по id() содержимого", "level": 5, "tier": "🦅 Уровень 5", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Напишите функцию слияния логов из нескольких файлов с дедупликацией по id() содержимого.</p>", "initialCode": "def merge_unique_lines(*file_paths):\n    pass", "solution": "# Напишите функцию слияния логов из нескольких файлов с дедупликацией строк\ndef merge_unique_lines(*file_paths):\n    seen = set()\n    result = []\n    for path in file_paths:\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            for line in f:\n                cleaned = line.strip()\n                if cleaned and cleaned not in seen:\n                    seen.add(cleaned)\n                    result.append(cleaned)\n    return result\n\n\nwith open(\"a.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"error: timeout\\nerror: 404\\n\")\nwith open(\"b.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"error: timeout\\nerror: 500\\n\")\n\nprint(merge_unique_lines(\"a.txt\", \"b.txt\"))\n# ['error: timeout', 'error: 404', 'error: 500']", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"merge_unique_lines\" in globals() and callable(merge_unique_lines), \"Функция merge_unique_lines() должна быть определена\"\n_fn_nodes_merge_unique_lines = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"merge_unique_lines\"]\nassert _fn_nodes_merge_unique_lines and not (len(_fn_nodes_merge_unique_lines[0].body) == 1 and isinstance(_fn_nodes_merge_unique_lines[0].body[0], _ast.Pass)), \"Реализуйте тело функции merge_unique_lines() (сейчас там только pass)\"\nwith open(\"a.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"error: timeout\\nerror: 404\\n\")\nwith open(\"b.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"error: timeout\\nerror: 500\\n\")\nprint(merge_unique_lines(\"a.txt\", \"b.txt\"))", "code": "# Напишите функцию слияния логов из нескольких файлов с дедупликацией строк\ndef merge_unique_lines(*file_paths):\n    seen = set()\n    result = []\n    for path in file_paths:\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            for line in f:\n                cleaned = line.strip()\n                if cleaned and cleaned not in seen:\n                    seen.add(cleaned)\n                    result.append(cleaned)\n    return result\n\n\nwith open(\"a.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"error: timeout\\nerror: 404\\n\")\nwith open(\"b.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"error: timeout\\nerror: 500\\n\")\n\nprint(merge_unique_lines(\"a.txt\", \"b.txt\"))\n# ['error: timeout', 'error: 404', 'error: 500']"}, {"id": 306, "title": "Реализуйте инкапсуляцию с приватным атрибутом через name mangling", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Защитите приватное состояние банковского аккаунта механизмом Name Mangling.</p><p class='meta'>В классе <code>BankAccount</code> сохраните переданный начальный баланс в атрибут <code>self.__balance</code>. В рантайме Python такой атрибут автоматически преобразуется в <code>_BankAccount__balance</code>.</p>", "initialCode": "class BankAccount:\n\n    def __init__(self, balance):\n        pass\n\n    def get_balance(self):\n        pass\n\n    def deposit(self, amount):\n        pass", "solution": "# Реализуйте инкапсуляцию с приватным атрибутом через name mangling\nclass BankAccount:\n    def __init__(self, balance):\n        self.__balance = balance   # двойное подчёркивание -> name mangling\n\n    def get_balance(self):\n        return self.__balance\n\n    def deposit(self, amount):\n        if amount > 0:\n            self.__balance += amount\n\n\naccount = BankAccount(100)\naccount.deposit(50)\nprint(account.get_balance())     # 150\n# print(account.__balance)       # AttributeError — напрямую снаружи не достучаться\nprint(account._BankAccount__balance)  # 150 — но так можно, mangling не абсолютная защита", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"BankAccount\" in globals() and isinstance(BankAccount, type), \"Класс BankAccount должен быть определён\"\n_cl_def_BankAccount = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"BankAccount\"]\nassert _cl_def_BankAccount and not (len(_cl_def_BankAccount[0].body) == 1 and isinstance(_cl_def_BankAccount[0].body[0], _ast.Pass)), \"Реализуйте тело класса BankAccount (сейчас там только pass)\"\nassert hasattr(BankAccount, \"__init__\"), \"В классе BankAccount должен быть метод/свойство __init__\"\n_cl_nodes_BankAccount___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"BankAccount\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_BankAccount___init__ and not (len(_cl_nodes_BankAccount___init__[0].body) == 1 and isinstance(_cl_nodes_BankAccount___init__[0].body[0], _ast.Pass)), \"Реализуйте метод BankAccount.__init__()\"\nassert hasattr(BankAccount, \"get_balance\"), \"В классе BankAccount должен быть метод/свойство get_balance\"\n_cl_nodes_BankAccount_get_balance = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"BankAccount\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"get_balance\"]\nassert _cl_nodes_BankAccount_get_balance and not (len(_cl_nodes_BankAccount_get_balance[0].body) == 1 and isinstance(_cl_nodes_BankAccount_get_balance[0].body[0], _ast.Pass)), \"Реализуйте метод BankAccount.get_balance()\"\nassert hasattr(BankAccount, \"deposit\"), \"В классе BankAccount должен быть метод/свойство deposit\"\n_cl_nodes_BankAccount_deposit = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"BankAccount\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"deposit\"]\nassert _cl_nodes_BankAccount_deposit and not (len(_cl_nodes_BankAccount_deposit[0].body) == 1 and isinstance(_cl_nodes_BankAccount_deposit[0].body[0], _ast.Pass)), \"Реализуйте метод BankAccount.deposit()\"\naccount = BankAccount(100)\naccount.deposit(50)\nprint(account.get_balance())\nprint(account._BankAccount__balance)\nassert \"account\" in globals(), \"Переменная account должна быть вычислена\"\nassert hasattr(BankAccount, \"_BankAccount__balance\") or \"_BankAccount__balance\" in BankAccount(100).__dict__, \"Атрибут баланса должен использовать name mangling __balance\"", "code": "# Реализуйте инкапсуляцию с приватным атрибутом через name mangling\nclass BankAccount:\n    def __init__(self, balance):\n        self.__balance = balance   # двойное подчёркивание -> name mangling\n\n    def get_balance(self):\n        return self.__balance\n\n    def deposit(self, amount):\n        if amount > 0:\n            self.__balance += amount\n\n\naccount = BankAccount(100)\naccount.deposit(50)\nprint(account.get_balance())     # 150\n# print(account.__balance)       # AttributeError — напрямую снаружи не достучаться\nprint(account._BankAccount__balance)  # 150 — но так можно, mangling не абсолютная защита"}, {"id": 307, "title": "Продемонстрируйте разницу между __new__ и __init__", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте разницу между __new__ и __init__.</p>", "initialCode": "class Tracked:\n\n    def __new__(cls, *args, **kwargs):\n        pass\n\n    def __init__(self, name):\n        pass", "solution": "# Продемонстрируйте разницу между __new__ и __init__\nclass Tracked:\n    def __new__(cls, *args, **kwargs):\n        print(f\"__new__: создаю объект класса {cls.__name__}\")\n        instance = super().__new__(cls)   # __new__ реально СОЗДАЁТ объект\n        return instance\n\n    def __init__(self, name):\n        print(f\"__init__: настраиваю уже созданный объект, name={name}\")\n        self.name = name   # __init__ только НАСТРАИВАЕТ уже существующий объект\n\n\nobj = Tracked(\"test\")\n# __new__: создаю объект класса Tracked\n# __init__: настраиваю уже созданный объект, name=test", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Tracked\" in globals() and isinstance(Tracked, type), \"Класс Tracked должен быть определён\"\n_cl_def_Tracked = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Tracked\"]\nassert _cl_def_Tracked and not (len(_cl_def_Tracked[0].body) == 1 and isinstance(_cl_def_Tracked[0].body[0], _ast.Pass)), \"Реализуйте тело класса Tracked (сейчас там только pass)\"\nassert hasattr(Tracked, \"__new__\"), \"В классе Tracked должен быть метод/свойство __new__\"\n_cl_nodes_Tracked___new__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Tracked\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__new__\"]\nassert _cl_nodes_Tracked___new__ and not (len(_cl_nodes_Tracked___new__[0].body) == 1 and isinstance(_cl_nodes_Tracked___new__[0].body[0], _ast.Pass)), \"Реализуйте метод Tracked.__new__()\"\nassert hasattr(Tracked, \"__init__\"), \"В классе Tracked должен быть метод/свойство __init__\"\n_cl_nodes_Tracked___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Tracked\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Tracked___init__ and not (len(_cl_nodes_Tracked___init__[0].body) == 1 and isinstance(_cl_nodes_Tracked___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Tracked.__init__()\"\nobj = Tracked(\"test\")\nassert \"obj\" in globals(), \"Переменная obj должна быть вычислена\"", "code": "# Продемонстрируйте разницу между __new__ и __init__\nclass Tracked:\n    def __new__(cls, *args, **kwargs):\n        print(f\"__new__: создаю объект класса {cls.__name__}\")\n        instance = super().__new__(cls)   # __new__ реально СОЗДАЁТ объект\n        return instance\n\n    def __init__(self, name):\n        print(f\"__init__: настраиваю уже созданный объект, name={name}\")\n        self.name = name   # __init__ только НАСТРАИВАЕТ уже существующий объект\n\n\nobj = Tracked(\"test\")\n# __new__: создаю объект класса Tracked\n# __init__: настраиваю уже созданный объект, name=test"}, {"id": 308, "title": "Реализуйте паттерн \"приватное состояние + публичное свойство\" через self", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте паттерн &quot;приватное состояние + публичное свойство&quot; через self.</p>", "initialCode": "class Temperature:\n\n    def __init__(self, celsius):\n        pass\n\n    def to_fahrenheit(self):\n        pass", "solution": "# Реализуйте паттерн \"приватное состояние + публичное свойство\" через self\nclass Temperature:\n    def __init__(self, celsius):\n        self._celsius = celsius   # self связывает состояние именно с ЭТИМ экземпляром\n\n    def to_fahrenheit(self):\n        # self всегда явно передаётся первым аргументом при вызове метода\n        return self._celsius * 9 / 5 + 32\n\n\nt1 = Temperature(0)\nt2 = Temperature(100)\nprint(t1.to_fahrenheit())   # 32.0 — свой self, своё состояние\nprint(t2.to_fahrenheit())   # 212.0 — независимо от t1", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Temperature\" in globals() and isinstance(Temperature, type), \"Класс Temperature должен быть определён\"\n_cl_def_Temperature = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Temperature\"]\nassert _cl_def_Temperature and not (len(_cl_def_Temperature[0].body) == 1 and isinstance(_cl_def_Temperature[0].body[0], _ast.Pass)), \"Реализуйте тело класса Temperature (сейчас там только pass)\"\nassert hasattr(Temperature, \"__init__\"), \"В классе Temperature должен быть метод/свойство __init__\"\n_cl_nodes_Temperature___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Temperature\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Temperature___init__ and not (len(_cl_nodes_Temperature___init__[0].body) == 1 and isinstance(_cl_nodes_Temperature___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Temperature.__init__()\"\nassert hasattr(Temperature, \"to_fahrenheit\"), \"В классе Temperature должен быть метод/свойство to_fahrenheit\"\n_cl_nodes_Temperature_to_fahrenheit = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Temperature\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"to_fahrenheit\"]\nassert _cl_nodes_Temperature_to_fahrenheit and not (len(_cl_nodes_Temperature_to_fahrenheit[0].body) == 1 and isinstance(_cl_nodes_Temperature_to_fahrenheit[0].body[0], _ast.Pass)), \"Реализуйте метод Temperature.to_fahrenheit()\"\nt1 = Temperature(0)\nt2 = Temperature(100)\nprint(t1.to_fahrenheit())\nprint(t2.to_fahrenheit())\nassert \"t1\" in globals(), \"Переменная t1 должна быть вычислена\"\nassert \"t2\" in globals(), \"Переменная t2 должна быть вычислена\"", "code": "# Реализуйте паттерн \"приватное состояние + публичное свойство\" через self\nclass Temperature:\n    def __init__(self, celsius):\n        self._celsius = celsius   # self связывает состояние именно с ЭТИМ экземпляром\n\n    def to_fahrenheit(self):\n        # self всегда явно передаётся первым аргументом при вызове метода\n        return self._celsius * 9 / 5 + 32\n\n\nt1 = Temperature(0)\nt2 = Temperature(100)\nprint(t1.to_fahrenheit())   # 32.0 — свой self, своё состояние\nprint(t2.to_fahrenheit())   # 212.0 — независимо от t1"}, {"id": 309, "title": "Изоляция точки входа исполняемого модуля через if __name__ == \"__main__\"", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Изолируйте точку входа модуля защитной конструкцией <code>if __name__ == \"__main__\":</code>.</p><p class='meta'>Определите функцию <code>greet(name)</code>, возвращающую <code>f\"Привет, {name}!\"</code>, и вызовите её внутри блока <code>if __name__ == \"__main__\":</code>, предотвращая побочные эффекты исполнения при импорте модуля.</p>", "initialCode": "def greet(name):\n    pass", "solution": "# Продемонстрируйте, зачем нужен if __name__ == '__main__'\n# файл mymodule.py:\ndef greet(name):\n    return f\"Привет, {name}!\"\n\nprint(f\"Имя модуля при загрузке: {__name__}\")\n\nif __name__ == '__main__':\n    # выполнится, только если файл запущен напрямую (python mymodule.py),\n    # а не при импорте: import mymodule\n    print(greet(\"тестовый запуск\"))", "hint": "Условие if __name__ == \"__main__\": проверяет, запущен ли скрипт напрямую в консоли или импортирован как модуль.", "tests": "import ast as _ast\nassert \"greet\" in globals() and callable(greet), \"Функция greet() должна быть определена\"\n_fn_nodes_greet = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"greet\"]\nassert _fn_nodes_greet and not (len(_fn_nodes_greet[0].body) == 1 and isinstance(_fn_nodes_greet[0].body[0], _ast.Pass)), \"Реализуйте тело функции greet() (сейчас там только pass)\"\nprint(f\"Имя модуля при загрузке: {__name__}\")\nif __name__ == '__main__':\n    # выполнится, только если файл запущен напрямую (python mymodule.py),\n    # а не при импорте: import mymodule\n    print(greet(\"тестовый запуск\"))\nassert callable(greet) and greet(\"мир\") == \"Привет, мир!\", \"Функция greet(name) должна возвращать приветственную строку\"", "code": "# Продемонстрируйте, зачем нужен if __name__ == '__main__'\n# файл mymodule.py:\ndef greet(name):\n    return f\"Привет, {name}!\"\n\nprint(f\"Имя модуля при загрузке: {__name__}\")\n\nif __name__ == '__main__':\n    # выполнится, только если файл запущен напрямую (python mymodule.py),\n    # а не при импорте: import mymodule\n    print(greet(\"тестовый запуск\"))"}, {"id": 310, "title": "Используйте functools.lru_cache для мемоизации медленной функции", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Используйте functools.lru_cache для мемоизации медленной функции.</p>", "initialCode": "from functools import lru_cache\nimport time\n@lru_cache(maxsize=128)\ndef slow_square(n):\n    pass", "solution": "# Используйте functools.lru_cache для мемоизации медленной функции\nfrom functools import lru_cache\nimport time\n\n@lru_cache(maxsize=128)\ndef slow_square(n):\n    time.sleep(0.5)   # имитация медленного вычисления\n    return n ** 2\n\n\nprint(slow_square(4))   # ждёт 0.5с, считает\nprint(slow_square(4))   # мгновенно — результат взят из кэша\nprint(slow_square.cache_info())   # статистика: hits, misses, maxsize, currsize", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"slow_square\" in globals() and callable(slow_square), \"Функция slow_square() должна быть определена\"\n_fn_nodes_slow_square = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"slow_square\"]\nassert _fn_nodes_slow_square and not (len(_fn_nodes_slow_square[0].body) == 1 and isinstance(_fn_nodes_slow_square[0].body[0], _ast.Pass)), \"Реализуйте тело функции slow_square() (сейчас там только pass)\"\nprint(slow_square(4))\nprint(slow_square(4))\nprint(slow_square.cache_info())", "code": "# Используйте functools.lru_cache для мемоизации медленной функции\nfrom functools import lru_cache\nimport time\n\n@lru_cache(maxsize=128)\ndef slow_square(n):\n    time.sleep(0.5)   # имитация медленного вычисления\n    return n ** 2\n\n\nprint(slow_square(4))   # ждёт 0.5с, считает\nprint(slow_square(4))   # мгновенно — результат взят из кэша\nprint(slow_square.cache_info())   # статистика: hits, misses, maxsize, currsize"}, {"id": 311, "title": "Проверьте счётчик ссылок объекта через sys.getrefcount()", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Проверьте счётчик ссылок объекта через sys.getrefcount().</p>", "initialCode": "import sys\n\ndata = [1, 2, 3]\nother_ref = None", "solution": "# Проверьте счётчик ссылок объекта через sys.getrefcount()\nimport sys\n\ndata = [1, 2, 3]\nprint(sys.getrefcount(data))   # обычно 2: сама переменная data + временная\n                                  # ссылка внутри аргумента getrefcount()\n\nother_ref = data\nprint(sys.getrefcount(data))   # выросло на 1 — появилась вторая переменная-ссылка\n\ndel other_ref\nprint(sys.getrefcount(data))   # вернулось к исходному значению", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"data\" in globals() and data is not None, \"Переменная data должна быть определена и не равна None\"\nassert data != \"__TODO__\", \"Заполните значение переменной data\"", "code": "# Проверьте счётчик ссылок объекта через sys.getrefcount()\nimport sys\n\ndata = [1, 2, 3]\nprint(sys.getrefcount(data))   # обычно 2: сама переменная data + временная\n                                  # ссылка внутри аргумента getrefcount()\n\nother_ref = data\nprint(sys.getrefcount(data))   # выросло на 1 — появилась вторая переменная-ссылка\n\ndel other_ref\nprint(sys.getrefcount(data))   # вернулось к исходному значению"}, {"id": 312, "title": "Продемонстрируйте циклическую ссылку и её обнаружение через модуль gc", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте циклическую ссылку и её обнаружение через модуль gc.</p>", "initialCode": "import gc\nclass Node:\n\n    def __init__(self, name):\n        pass", "solution": "# Продемонстрируйте циклическую ссылку и её обнаружение через модуль gc\nimport gc\n\nclass Node:\n    def __init__(self, name):\n        self.name = name\n        self.ref = None\n\n\na = Node(\"A\")\nb = Node(\"B\")\na.ref = b   # a ссылается на b\nb.ref = a     # b ссылается на a — циклическая ссылка,\n                # обычный подсчёт ссылок (reference counting) не может освободить\n                # эту пару сам по себе, даже если извне на них больше нет ссылок\n\ndel a, b\ncollected = gc.collect()   # циклический сборщик мусора находит и разрывает такие циклы\nprint(f\"Собрано объектов: {collected}\")", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Node\" in globals() and isinstance(Node, type), \"Класс Node должен быть определён\"\n_cl_def_Node = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Node\"]\nassert _cl_def_Node and not (len(_cl_def_Node[0].body) == 1 and isinstance(_cl_def_Node[0].body[0], _ast.Pass)), \"Реализуйте тело класса Node (сейчас там только pass)\"\nassert hasattr(Node, \"__init__\"), \"В классе Node должен быть метод/свойство __init__\"\n_cl_nodes_Node___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Node\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Node___init__ and not (len(_cl_nodes_Node___init__[0].body) == 1 and isinstance(_cl_nodes_Node___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Node.__init__()\"\na = Node(\"A\")\nb = Node(\"B\")\na.ref = b\nb.ref = a\ndel a, b\ncollected = gc.collect()\nprint(f\"Собрано объектов: {collected}\")\nassert \"collected\" in globals(), \"Переменная collected должна быть вычислена\"", "code": "# Продемонстрируйте циклическую ссылку и её обнаружение через модуль gc\nimport gc\n\nclass Node:\n    def __init__(self, name):\n        self.name = name\n        self.ref = None\n\n\na = Node(\"A\")\nb = Node(\"B\")\na.ref = b   # a ссылается на b\nb.ref = a     # b ссылается на a — циклическая ссылка,\n                # обычный подсчёт ссылок (reference counting) не может освободить\n                # эту пару сам по себе, даже если извне на них больше нет ссылок\n\ndel a, b\ncollected = gc.collect()   # циклический сборщик мусора находит и разрывает такие циклы\nprint(f\"Собрано объектов: {collected}\")"}, {"id": 313, "title": "Продемонстрируйте ловушку замыкания в цикле и исправьте её", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте ловушку замыкания в цикле и исправьте её.</p>", "initialCode": "funcs_broken = []\nfuncs_fixed = None", "solution": "# Продемонстрируйте ловушку замыкания в цикле и исправьте её\n\n# Ловушка: все функции захватывают одну и ту же переменную i,\n# а не её значение на момент создания\nfuncs_broken = []\nfor i in range(3):\n    funcs_broken.append(lambda: i)\n\nprint([f() for f in funcs_broken])   # [2, 2, 2] — а не [0, 1, 2]!\n\n# Исправление: фиксируем текущее значение через аргумент по умолчанию\nfuncs_fixed = []\nfor i in range(3):\n    funcs_fixed.append(lambda i=i: i)   # i=i \"замораживает\" значение на момент создания\n\nprint([f() for f in funcs_fixed])   # [0, 1, 2] — как и ожидалось", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"funcs_broken\" in globals() and funcs_broken is not None, \"Переменная funcs_broken должна быть определена и не равна None\"\nassert funcs_broken != \"__TODO__\", \"Заполните значение переменной funcs_broken\"\nassert \"funcs_fixed\" in globals() and funcs_fixed is not None, \"Переменная funcs_fixed должна быть определена и не равна None\"\nassert funcs_fixed != \"__TODO__\", \"Заполните значение переменной funcs_fixed\"", "code": "# Продемонстрируйте ловушку замыкания в цикле и исправьте её\n\n# Ловушка: все функции захватывают одну и ту же переменную i,\n# а не её значение на момент создания\nfuncs_broken = []\nfor i in range(3):\n    funcs_broken.append(lambda: i)\n\nprint([f() for f in funcs_broken])   # [2, 2, 2] — а не [0, 1, 2]!\n\n# Исправление: фиксируем текущее значение через аргумент по умолчанию\nfuncs_fixed = []\nfor i in range(3):\n    funcs_fixed.append(lambda i=i: i)   # i=i \"замораживает\" значение на момент создания\n\nprint([f() for f in funcs_fixed])   # [0, 1, 2] — как и ожидалось"}, {"id": 314, "title": "Используйте functools.partial для фиксации части аргументов функции", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Используйте functools.partial для фиксации части аргументов функции.</p>", "initialCode": "from functools import partial\ndef power(base, exponent):\n    pass", "solution": "# Используйте functools.partial для фиксации части аргументов функции\nfrom functools import partial\n\ndef power(base, exponent):\n    return base ** exponent\n\nsquare = partial(power, exponent=2)     # фиксируем exponent=2\ncube = partial(power, exponent=3)         # фиксируем exponent=3\n\nprint(square(5))   # 25 — power(5, exponent=2)\nprint(cube(2))       # 8  — power(2, exponent=3)\nprint(square(10))   # 100", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"power\" in globals() and callable(power), \"Функция power() должна быть определена\"\n_fn_nodes_power = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"power\"]\nassert _fn_nodes_power and not (len(_fn_nodes_power[0].body) == 1 and isinstance(_fn_nodes_power[0].body[0], _ast.Pass)), \"Реализуйте тело функции power() (сейчас там только pass)\"\nsquare = partial(power, exponent=2)\ncube = partial(power, exponent=3)\nprint(square(5))\nprint(cube(2))\nprint(square(10))\nassert \"square\" in globals(), \"Переменная square должна быть вычислена\"\nassert \"cube\" in globals(), \"Переменная cube должна быть вычислена\"", "code": "# Используйте functools.partial для фиксации части аргументов функции\nfrom functools import partial\n\ndef power(base, exponent):\n    return base ** exponent\n\nsquare = partial(power, exponent=2)     # фиксируем exponent=2\ncube = partial(power, exponent=3)         # фиксируем exponent=3\n\nprint(square(5))   # 25 — power(5, exponent=2)\nprint(cube(2))       # 8  — power(2, exponent=3)\nprint(square(10))   # 100"}, {"id": 315, "title": "Сравните global и nonlocal на примере счётчика на двух уровнях вложенности", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Сравните global и nonlocal на примере счётчика на двух уровнях вложенности.</p>", "initialCode": "counter = 0\ndef increment_global():\n    pass\ndef make_counter():\n    pass", "solution": "# Сравните global и nonlocal на примере счётчика на двух уровнях вложенности\ncounter = 0   # переменная уровня модуля\n\ndef increment_global():\n    global counter          # без этого — UnboundLocalError при попытке изменить\n    counter += 1\n\ndef make_counter():\n    local_counter = 0        # переменная во внешней функции\n\n    def increment_local():\n        nonlocal local_counter   # без этого — тоже UnboundLocalError\n        local_counter += 1\n        return local_counter\n\n    return increment_local\n\n\nincrement_global()\nincrement_global()\nprint(counter)             # 2 — изменили переменную МОДУЛЯ\n\ninc = make_counter()\nprint(inc())                # 1\nprint(inc())                # 2 — изменили переменную ВНЕШНЕЙ ФУНКЦИИ, не модуля", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"increment_global\" in globals() and callable(increment_global), \"Функция increment_global() должна быть определена\"\n_fn_nodes_increment_global = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"increment_global\"]\nassert _fn_nodes_increment_global and not (len(_fn_nodes_increment_global[0].body) == 1 and isinstance(_fn_nodes_increment_global[0].body[0], _ast.Pass)), \"Реализуйте тело функции increment_global() (сейчас там только pass)\"\nassert \"make_counter\" in globals() and callable(make_counter), \"Функция make_counter() должна быть определена\"\n_fn_nodes_make_counter = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"make_counter\"]\nassert _fn_nodes_make_counter and not (len(_fn_nodes_make_counter[0].body) == 1 and isinstance(_fn_nodes_make_counter[0].body[0], _ast.Pass)), \"Реализуйте тело функции make_counter() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nincrement_global()\nincrement_global()\nprint(counter)\ninc = make_counter()\nprint(inc())\nprint(inc())\nassert \"inc\" in globals(), \"Переменная inc должна быть вычислена\"", "code": "# Сравните global и nonlocal на примере счётчика на двух уровнях вложенности\ncounter = 0   # переменная уровня модуля\n\ndef increment_global():\n    global counter          # без этого — UnboundLocalError при попытке изменить\n    counter += 1\n\ndef make_counter():\n    local_counter = 0        # переменная во внешней функции\n\n    def increment_local():\n        nonlocal local_counter   # без этого — тоже UnboundLocalError\n        local_counter += 1\n        return local_counter\n\n    return increment_local\n\n\nincrement_global()\nincrement_global()\nprint(counter)             # 2 — изменили переменную МОДУЛЯ\n\ninc = make_counter()\nprint(inc())                # 1\nprint(inc())                # 2 — изменили переменную ВНЕШНЕЙ ФУНКЦИИ, не модуля"}, {"id": 316, "title": "Продемонстрируйте три уровня доступа: public, _protected, __private", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте три уровня доступа: public, _protected, __private.</p>", "initialCode": "class Account:\n\n    def __init__(self, owner, balance):\n        pass", "solution": "# Продемонстрируйте три уровня доступа: public, _protected, __private\nclass Account:\n    def __init__(self, owner, balance):\n        self.owner = owner            # public — открытый доступ отовсюду\n        self._balance = balance         # _protected — соглашение \"не трогать снаружи\",\n                                           # но технически доступ не заблокирован\n        self.__pin = \"1234\"              # __private — запускает name mangling\n\n\nacc = Account(\"Alex\", 100)\nprint(acc.owner)          # OK, задумано для внешнего доступа\nprint(acc._balance)       # тоже сработает — Python не запрещает, только \"не рекомендует\"\n# print(acc.__pin)         # AttributeError — напрямую недоступно\nprint(acc._Account__pin)  # '1234' — но так всё равно можно добраться, mangling не защита", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Account\" in globals() and isinstance(Account, type), \"Класс Account должен быть определён\"\n_cl_def_Account = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\"]\nassert _cl_def_Account and not (len(_cl_def_Account[0].body) == 1 and isinstance(_cl_def_Account[0].body[0], _ast.Pass)), \"Реализуйте тело класса Account (сейчас там только pass)\"\nassert hasattr(Account, \"__init__\"), \"В классе Account должен быть метод/свойство __init__\"\n_cl_nodes_Account___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Account\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Account___init__ and not (len(_cl_nodes_Account___init__[0].body) == 1 and isinstance(_cl_nodes_Account___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Account.__init__()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nacc = Account(\"Alex\", 100)\nprint(acc.owner)\nprint(acc._balance)\nprint(acc._Account__pin)\nassert \"acc\" in globals(), \"Переменная acc должна быть вычислена\"", "code": "# Продемонстрируйте три уровня доступа: public, _protected, __private\nclass Account:\n    def __init__(self, owner, balance):\n        self.owner = owner            # public — открытый доступ отовсюду\n        self._balance = balance         # _protected — соглашение \"не трогать снаружи\",\n                                           # но технически доступ не заблокирован\n        self.__pin = \"1234\"              # __private — запускает name mangling\n\n\nacc = Account(\"Alex\", 100)\nprint(acc.owner)          # OK, задумано для внешнего доступа\nprint(acc._balance)       # тоже сработает — Python не запрещает, только \"не рекомендует\"\n# print(acc.__pin)         # AttributeError — напрямую недоступно\nprint(acc._Account__pin)  # '1234' — но так всё равно можно добраться, mangling не защита"}, {"id": 317, "title": "Продемонстрируйте, что __str__ падает обратно на __repr__, если не определён", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте, что __str__ падает обратно на __repr__, если не определён.</p>", "initialCode": "class Point:\n\n    def __init__(self, x, y):\n        pass\n\n    def __repr__(self):\n        pass", "solution": "# Продемонстрируйте, что __str__ падает обратно на __repr__, если не определён\nclass Point:\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n\n    def __repr__(self):\n        return f\"Point(x={self.x}, y={self.y})\"\n    # __str__ намеренно не определён\n\n\np = Point(1, 2)\nprint(str(p))     # Point(x=1, y=2) — использовал __repr__ как запасной вариант\nprint(repr(p))    # Point(x=1, y=2) — тот же результат\nprint(p)            # print() тоже вызывает __str__, значит тоже упадёт на __repr__", "hint": "Метод __repr__(self) должен возвращать точную, понятную разработчику строку вида ClassName(attr=val, ...), однозначно отражающую состояние объекта.", "tests": "import ast as _ast\nassert \"Point\" in globals() and isinstance(Point, type), \"Класс Point должен быть определён\"\n_cl_def_Point = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Point\"]\nassert _cl_def_Point and not (len(_cl_def_Point[0].body) == 1 and isinstance(_cl_def_Point[0].body[0], _ast.Pass)), \"Реализуйте тело класса Point (сейчас там только pass)\"\nassert hasattr(Point, \"__init__\"), \"В классе Point должен быть метод/свойство __init__\"\n_cl_nodes_Point___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Point\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Point___init__ and not (len(_cl_nodes_Point___init__[0].body) == 1 and isinstance(_cl_nodes_Point___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Point.__init__()\"\nassert hasattr(Point, \"__repr__\"), \"В классе Point должен быть метод/свойство __repr__\"\n_cl_nodes_Point___repr__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Point\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__repr__\"]\nassert _cl_nodes_Point___repr__ and not (len(_cl_nodes_Point___repr__[0].body) == 1 and isinstance(_cl_nodes_Point___repr__[0].body[0], _ast.Pass)), \"Реализуйте метод Point.__repr__()\"\np = Point(1, 2)\nprint(str(p))\nprint(repr(p))\nprint(p)\nassert \"p\" in globals(), \"Переменная p должна быть вычислена\"", "code": "# Продемонстрируйте, что __str__ падает обратно на __repr__, если не определён\nclass Point:\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n\n    def __repr__(self):\n        return f\"Point(x={self.x}, y={self.y})\"\n    # __str__ намеренно не определён\n\n\np = Point(1, 2)\nprint(str(p))     # Point(x=1, y=2) — использовал __repr__ как запасной вариант\nprint(repr(p))    # Point(x=1, y=2) — тот же результат\nprint(p)            # print() тоже вызывает __str__, значит тоже упадёт на __repr__"}, {"id": 318, "title": "Продемонстрируйте, что переопределение __eq__ без __hash__ делает объект нехэшируемым", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте, что переопределение __eq__ без __hash__ делает объект нехэшируемым.</p>", "initialCode": "class Money:\n\n    def __init__(self, amount):\n        pass\n\n    def __eq__(self, other):\n        pass\nm1 = Money(100)\nclass MoneyFixed:\n\n    def __init__(self, amount):\n        pass\n\n    def __eq__(self, other):\n        pass\n\n    def __hash__(self):\n        pass", "solution": "# Продемонстрируйте, что переопределение __eq__ без __hash__ делает объект нехэшируемым\nclass Money:\n    def __init__(self, amount):\n        self.amount = amount\n\n    def __eq__(self, other):\n        return self.amount == other.amount\n    # __hash__ НЕ определён явно\n\n\nm1 = Money(100)\ntry:\n    hash(m1)   # TypeError — Python автоматически обнулил __hash__,\nexcept TypeError as e:  # так как равные по __eq__ объекты обязаны иметь одинаковый хэш,\n    print(f\"Ошибка: {e}\")   # а старое поведение (хэш по id) больше не гарантирует это\n\n# Исправление — определить __hash__ согласованно с __eq__:\nclass MoneyFixed:\n    def __init__(self, amount):\n        self.amount = amount\n\n    def __eq__(self, other):\n        return self.amount == other.amount\n\n    def __hash__(self):\n        return hash(self.amount)\n\n\nm2 = MoneyFixed(100)\nprint(hash(m2))   # работает — теперь можно класть в set/dict", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Money\" in globals() and isinstance(Money, type), \"Класс Money должен быть определён\"\n_cl_def_Money = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Money\"]\nassert _cl_def_Money and not (len(_cl_def_Money[0].body) == 1 and isinstance(_cl_def_Money[0].body[0], _ast.Pass)), \"Реализуйте тело класса Money (сейчас там только pass)\"\nassert hasattr(Money, \"__init__\"), \"В классе Money должен быть метод/свойство __init__\"\n_cl_nodes_Money___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Money\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Money___init__ and not (len(_cl_nodes_Money___init__[0].body) == 1 and isinstance(_cl_nodes_Money___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Money.__init__()\"\nassert hasattr(Money, \"__eq__\"), \"В классе Money должен быть метод/свойство __eq__\"\n_cl_nodes_Money___eq__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Money\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__eq__\"]\nassert _cl_nodes_Money___eq__ and not (len(_cl_nodes_Money___eq__[0].body) == 1 and isinstance(_cl_nodes_Money___eq__[0].body[0], _ast.Pass)), \"Реализуйте метод Money.__eq__()\"\nassert \"MoneyFixed\" in globals() and isinstance(MoneyFixed, type), \"Класс MoneyFixed должен быть определён\"\n_cl_def_MoneyFixed = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MoneyFixed\"]\nassert _cl_def_MoneyFixed and not (len(_cl_def_MoneyFixed[0].body) == 1 and isinstance(_cl_def_MoneyFixed[0].body[0], _ast.Pass)), \"Реализуйте тело класса MoneyFixed (сейчас там только pass)\"\nassert hasattr(MoneyFixed, \"__init__\"), \"В классе MoneyFixed должен быть метод/свойство __init__\"\n_cl_nodes_MoneyFixed___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MoneyFixed\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_MoneyFixed___init__ and not (len(_cl_nodes_MoneyFixed___init__[0].body) == 1 and isinstance(_cl_nodes_MoneyFixed___init__[0].body[0], _ast.Pass)), \"Реализуйте метод MoneyFixed.__init__()\"\nassert hasattr(MoneyFixed, \"__eq__\"), \"В классе MoneyFixed должен быть метод/свойство __eq__\"\n_cl_nodes_MoneyFixed___eq__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MoneyFixed\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__eq__\"]\nassert _cl_nodes_MoneyFixed___eq__ and not (len(_cl_nodes_MoneyFixed___eq__[0].body) == 1 and isinstance(_cl_nodes_MoneyFixed___eq__[0].body[0], _ast.Pass)), \"Реализуйте метод MoneyFixed.__eq__()\"\nassert hasattr(MoneyFixed, \"__hash__\"), \"В классе MoneyFixed должен быть метод/свойство __hash__\"\n_cl_nodes_MoneyFixed___hash__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MoneyFixed\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__hash__\"]\nassert _cl_nodes_MoneyFixed___hash__ and not (len(_cl_nodes_MoneyFixed___hash__[0].body) == 1 and isinstance(_cl_nodes_MoneyFixed___hash__[0].body[0], _ast.Pass)), \"Реализуйте метод MoneyFixed.__hash__()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nm2 = MoneyFixed(100)\nprint(hash(m2))\nassert \"m2\" in globals(), \"Переменная m2 должна быть вычислена\"", "code": "# Продемонстрируйте, что переопределение __eq__ без __hash__ делает объект нехэшируемым\nclass Money:\n    def __init__(self, amount):\n        self.amount = amount\n\n    def __eq__(self, other):\n        return self.amount == other.amount\n    # __hash__ НЕ определён явно\n\n\nm1 = Money(100)\ntry:\n    hash(m1)   # TypeError — Python автоматически обнулил __hash__,\nexcept TypeError as e:  # так как равные по __eq__ объекты обязаны иметь одинаковый хэш,\n    print(f\"Ошибка: {e}\")   # а старое поведение (хэш по id) больше не гарантирует это\n\n# Исправление — определить __hash__ согласованно с __eq__:\nclass MoneyFixed:\n    def __init__(self, amount):\n        self.amount = amount\n\n    def __eq__(self, other):\n        return self.amount == other.amount\n\n    def __hash__(self):\n        return hash(self.amount)\n\n\nm2 = MoneyFixed(100)\nprint(hash(m2))   # работает — теперь можно класть в set/dict"}, {"id": 319, "title": "Замените класс-контейнер с бойлерплейтом на @dataclass", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Создайте декларативную модель данных пользователя с помощью <code>@dataclass</code>.</p><p class='meta'>Объявите класс <code>User</code> с декоратором <code>@dataclass</code> и полями <code>id: int</code>, <code>username: str</code>, <code>email: str</code>. Декоратор автоматически создаст <code>__init__</code>, <code>__repr__</code> и <code>__eq__</code>.</p>", "initialCode": "from dataclasses import dataclass\n@dataclass\nclass Point:\n    pass", "solution": "# Замените класс-контейнер с бойлерплейтом на @dataclass\nfrom dataclasses import dataclass\n\n# Было бы так без dataclass — __init__, __repr__, __eq__ пришлось бы писать руками:\n# class Point:\n#     def __init__(self, x, y):\n#         self.x = x\n#         self.y = y\n#     def __repr__(self):\n#         return f\"Point(x={self.x}, y={self.y})\"\n#     def __eq__(self, other):\n#         return self.x == other.x and self.y == other.y\n\n@dataclass\nclass Point:\n    x: int\n    y: int\n\n\np1 = Point(1, 2)\np2 = Point(1, 2)\nprint(p1)          # Point(x=1, y=2) — __repr__ сгенерирован автоматически\nprint(p1 == p2)     # True — __eq__ тоже сгенерирован автоматически", "hint": "Импортируй dataclass из модуля dataclasses. Примени декоратор @dataclass к классу и объяви поля с явными аннотациями типов.", "tests": "import ast as _ast\nassert \"Point\" in globals() and isinstance(Point, type), \"Класс Point должен быть определён\"\n_cl_def_Point = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Point\"]\nassert _cl_def_Point and not (len(_cl_def_Point[0].body) == 1 and isinstance(_cl_def_Point[0].body[0], _ast.Pass)), \"Реализуйте тело класса Point (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\np1 = Point(1, 2)\np2 = Point(1, 2)\nprint(p1)\nprint(p1 == p2)\nassert \"p1\" in globals(), \"Переменная p1 должна быть вычислена\"\nassert \"p2\" in globals(), \"Переменная p2 должна быть вычислена\"\nassert hasattr(User, \"__dataclass_fields__\"), \"Класс User должен быть декорирован @dataclass\"", "code": "# Замените класс-контейнер с бойлерплейтом на @dataclass\nfrom dataclasses import dataclass\n\n# Было бы так без dataclass — __init__, __repr__, __eq__ пришлось бы писать руками:\n# class Point:\n#     def __init__(self, x, y):\n#         self.x = x\n#         self.y = y\n#     def __repr__(self):\n#         return f\"Point(x={self.x}, y={self.y})\"\n#     def __eq__(self, other):\n#         return self.x == other.x and self.y == other.y\n\n@dataclass\nclass Point:\n    x: int\n    y: int\n\n\np1 = Point(1, 2)\np2 = Point(1, 2)\nprint(p1)          # Point(x=1, y=2) — __repr__ сгенерирован автоматически\nprint(p1 == p2)     # True — __eq__ тоже сгенерирован автоматически"}, {"id": 320, "title": "Создайте неизменяемый dataclass через frozen=True", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Создайте неизменяемый dataclass через frozen=True.</p>", "initialCode": "from dataclasses import dataclass\n@dataclass(frozen=True)\nclass Money:\n    pass", "solution": "# Создайте неизменяемый dataclass через frozen=True\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Money:\n    amount: int\n    currency: str = \"USD\"   # значение по умолчанию\n\n\nm = Money(100)\nprint(m)              # Money(amount=100, currency='USD')\n\ntry:\n    m.amount = 200      # FrozenInstanceError — frozen запрещает изменение после создания\nexcept Exception as e:\n    print(f\"Ошибка: {type(e).__name__}\")\n\n# frozen=True также делает объект хэшируемым — можно класть в set\nmoney_set = {Money(100), Money(100), Money(200)}\nprint(len(money_set))   # 2 — дубликат Money(100) схлопнулся", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Money\" in globals() and isinstance(Money, type), \"Класс Money должен быть определён\"\n_cl_def_Money = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Money\"]\nassert _cl_def_Money and not (len(_cl_def_Money[0].body) == 1 and isinstance(_cl_def_Money[0].body[0], _ast.Pass)), \"Реализуйте тело класса Money (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nm = Money(100)\nprint(m)\ntry:\n    m.amount = 200      # FrozenInstanceError — frozen запрещает изменение после создания\nexcept Exception as e:\n    print(f\"Ошибка: {type(e).__name__}\")\nmoney_set = {Money(100), Money(100), Money(200)}\nprint(len(money_set))\nassert \"m\" in globals(), \"Переменная m должна быть вычислена\"\nassert \"money_set\" in globals(), \"Переменная money_set должна быть вычислена\"", "code": "# Создайте неизменяемый dataclass через frozen=True\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Money:\n    amount: int\n    currency: str = \"USD\"   # значение по умолчанию\n\n\nm = Money(100)\nprint(m)              # Money(amount=100, currency='USD')\n\ntry:\n    m.amount = 200      # FrozenInstanceError — frozen запрещает изменение после создания\nexcept Exception as e:\n    print(f\"Ошибка: {type(e).__name__}\")\n\n# frozen=True также делает объект хэшируемым — можно класть в set\nmoney_set = {Money(100), Money(100), Money(200)}\nprint(len(money_set))   # 2 — дубликат Money(100) схлопнулся"}, {"id": 321, "title": "Используйте guard-условие в match-case для классификации чисел", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Используйте guard-условие в match-case для классификации чисел.</p>", "initialCode": "def classify(n):\n    pass", "solution": "# Используйте guard-условие в match-case для классификации чисел\ndef classify(n):\n    match n:\n        case int(x) if x < 0:\n            return \"отрицательное\"\n        case int(x) if x == 0:\n            return \"ноль\"\n        case int(x) if x % 2 == 0:\n            return \"положительное чётное\"\n        case int(x):\n            return \"положительное нечётное\"\n        case _:\n            return \"не число\"\n\n\nprint(classify(-5))   # отрицательное\nprint(classify(4))     # положительное чётное\nprint(classify(7))     # положительное нечётное", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"classify\" in globals() and callable(classify), \"Функция classify() должна быть определена\"\n_fn_nodes_classify = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"classify\"]\nassert _fn_nodes_classify and not (len(_fn_nodes_classify[0].body) == 1 and isinstance(_fn_nodes_classify[0].body[0], _ast.Pass)), \"Реализуйте тело функции classify() (сейчас там только pass)\"\nprint(classify(-5))\nprint(classify(4))\nprint(classify(7))", "code": "# Используйте guard-условие в match-case для классификации чисел\ndef classify(n):\n    match n:\n        case int(x) if x < 0:\n            return \"отрицательное\"\n        case int(x) if x == 0:\n            return \"ноль\"\n        case int(x) if x % 2 == 0:\n            return \"положительное чётное\"\n        case int(x):\n            return \"положительное нечётное\"\n        case _:\n            return \"не число\"\n\n\nprint(classify(-5))   # отрицательное\nprint(classify(4))     # положительное чётное\nprint(classify(7))     # положительное нечётное"}, {"id": 322, "title": "Напишите декоратор без аргументов и примените к нескольким функциям", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте базовый декоратор функции <code>log_execution</code>.</p><p class='meta'>Декоратор должен оборачивать функцию <code>func</code> во внутреннюю функцию <code>wrapper(*args, **kwargs)</code>, печатать лог вызова и возвращать результат выполнения целевой функции.</p>", "initialCode": "def announce(func):\n    pass\n@announce\ndef add(a, b):\n    pass\n@announce\ndef greet(name):\n    pass", "solution": "# Напишите декоратор без аргументов и примените к нескольким функциям\ndef announce(func):\n    def wrapper(*args, **kwargs):\n        print(f\"Запускаю {func.__name__}...\")\n        return func(*args, **kwargs)\n    return wrapper\n\n\n@announce\ndef add(a, b):\n    return a + b\n\n@announce\ndef greet(name):\n    return f\"Привет, {name}!\"\n\n\nprint(add(2, 3))          # \"Запускаю add...\" -> 5\nprint(greet(\"Мир\"))       # \"Запускаю greet...\" -> \"Привет, Мир!\"", "hint": "Шаг 1: Определи функцию-декоратор, принимающую func. Шаг 2: Внутри объяви wrapper(*args, **kwargs), вызови func и верни результат. Шаг 3: Верни wrapper.", "tests": "import ast as _ast\nassert \"announce\" in globals() and callable(announce), \"Функция announce() должна быть определена\"\n_fn_nodes_announce = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"announce\"]\nassert _fn_nodes_announce and not (len(_fn_nodes_announce[0].body) == 1 and isinstance(_fn_nodes_announce[0].body[0], _ast.Pass)), \"Реализуйте тело функции announce() (сейчас там только pass)\"\nassert \"add\" in globals() and callable(add), \"Функция add() должна быть определена\"\n_fn_nodes_add = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"add\"]\nassert _fn_nodes_add and not (len(_fn_nodes_add[0].body) == 1 and isinstance(_fn_nodes_add[0].body[0], _ast.Pass)), \"Реализуйте тело функции add() (сейчас там только pass)\"\nassert \"greet\" in globals() and callable(greet), \"Функция greet() должна быть определена\"\n_fn_nodes_greet = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"greet\"]\nassert _fn_nodes_greet and not (len(_fn_nodes_greet[0].body) == 1 and isinstance(_fn_nodes_greet[0].body[0], _ast.Pass)), \"Реализуйте тело функции greet() (сейчас там только pass)\"\nprint(add(2, 3))\nprint(greet(\"Мир\"))\nassert callable(log_execution), \"Декоратор log_execution должен быть определен\"", "code": "# Напишите декоратор без аргументов и примените к нескольким функциям\ndef announce(func):\n    def wrapper(*args, **kwargs):\n        print(f\"Запускаю {func.__name__}...\")\n        return func(*args, **kwargs)\n    return wrapper\n\n\n@announce\ndef add(a, b):\n    return a + b\n\n@announce\ndef greet(name):\n    return f\"Привет, {name}!\"\n\n\nprint(add(2, 3))          # \"Запускаю add...\" -> 5\nprint(greet(\"Мир\"))       # \"Запускаю greet...\" -> \"Привет, Мир!\""}, {"id": 323, "title": "Функции как объекты первого класса: сохранение и передача в коллекции", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Продемонстрируйте концепцию функций как объектов первого класса (First-Class Citizens).</p><p class='meta'>Создайте функции <code>double(x)</code> и <code>square(x)</code>, сохраните их в список <code>pipeline = [double, square]</code> и последовательно примените обе функции к аргументу <code>x = 3</code>, сохранив финальный результат <code>36</code> в <code>result</code>.</p>", "initialCode": "def add(a, b):\n    pass\ndef sub(a, b):\n    pass\ndef mul(a, b):\n    pass", "solution": "# Проверьте, что функция — объект первого класса (можно положить в список)\ndef add(a, b): return a + b\ndef sub(a, b): return a - b\ndef mul(a, b): return a * b\n\noperations = {\"+\": add, \"-\": sub, \"*\": mul}   # функции как значения словаря\n\nfor symbol, func in operations.items():\n    print(f\"5 {symbol} 3 = {func(5, 3)}\")", "hint": "В Python функции являются объектами первого класса: их можно присваивать переменным, сохранять в списки/словари и передавать аргументами.", "tests": "import ast as _ast\nassert \"add\" in globals() and callable(add), \"Функция add() должна быть определена\"\n_fn_nodes_add = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"add\"]\nassert _fn_nodes_add and not (len(_fn_nodes_add[0].body) == 1 and isinstance(_fn_nodes_add[0].body[0], _ast.Pass)), \"Реализуйте тело функции add() (сейчас там только pass)\"\nassert \"sub\" in globals() and callable(sub), \"Функция sub() должна быть определена\"\n_fn_nodes_sub = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"sub\"]\nassert _fn_nodes_sub and not (len(_fn_nodes_sub[0].body) == 1 and isinstance(_fn_nodes_sub[0].body[0], _ast.Pass)), \"Реализуйте тело функции sub() (сейчас там только pass)\"\nassert \"mul\" in globals() and callable(mul), \"Функция mul() должна быть определена\"\n_fn_nodes_mul = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"mul\"]\nassert _fn_nodes_mul and not (len(_fn_nodes_mul[0].body) == 1 and isinstance(_fn_nodes_mul[0].body[0], _ast.Pass)), \"Реализуйте тело функции mul() (сейчас там только pass)\"\noperations = {\"+\": add, \"-\": sub, \"*\": mul}\nfor symbol, func in operations.items():\n    print(f\"5 {symbol} 3 = {func(5, 3)}\")\nassert \"operations\" in globals(), \"Переменная operations должна быть вычислена\"\nassert pipeline == [double, square] and result == 36, \"Пайплайн должен применить double (3*2=6) и затем square (6**2=36)\"", "code": "# Проверьте, что функция — объект первого класса (можно положить в список)\ndef add(a, b): return a + b\ndef sub(a, b): return a - b\ndef mul(a, b): return a * b\n\noperations = {\"+\": add, \"-\": sub, \"*\": mul}   # функции как значения словаря\n\nfor symbol, func in operations.items():\n    print(f\"5 {symbol} 3 = {func(5, 3)}\")"}, {"id": 324, "title": "Реализуйте параметризованный декоратор @repeat(num_times) с тремя уровнями вложенности", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте параметризованный декоратор @repeat(num_times) с тремя уровнями вложенности.</p>", "initialCode": "def repeat(num_times):\n    pass\n@repeat(num_times=3)\ndef say_hi():\n    pass", "solution": "# Реализуйте параметризованный декоратор @repeat(num_times) с тремя уровнями вложенности\ndef repeat(num_times):          # уровень 1: принимает аргумент декоратора\n    def decorator(func):          # уровень 2: принимает саму функцию\n        def wrapper(*args, **kwargs):   # уровень 3: обёртка вызова\n            result = None\n            for _ in range(num_times):\n                result = func(*args, **kwargs)\n            return result\n        return wrapper\n    return decorator\n\n\n@repeat(num_times=3)\ndef say_hi():\n    print(\"Привет!\")\n\nsay_hi()   # напечатает \"Привет!\" три раза", "hint": "Шаг 1: Определи функцию-декоратор, принимающую func. Шаг 2: Внутри объяви wrapper(*args, **kwargs), вызови func и верни результат. Шаг 3: Верни wrapper.", "tests": "import ast as _ast\nassert \"repeat\" in globals() and callable(repeat), \"Функция repeat() должна быть определена\"\n_fn_nodes_repeat = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"repeat\"]\nassert _fn_nodes_repeat and not (len(_fn_nodes_repeat[0].body) == 1 and isinstance(_fn_nodes_repeat[0].body[0], _ast.Pass)), \"Реализуйте тело функции repeat() (сейчас там только pass)\"\nassert \"say_hi\" in globals() and callable(say_hi), \"Функция say_hi() должна быть определена\"\n_fn_nodes_say_hi = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"say_hi\"]\nassert _fn_nodes_say_hi and not (len(_fn_nodes_say_hi[0].body) == 1 and isinstance(_fn_nodes_say_hi[0].body[0], _ast.Pass)), \"Реализуйте тело функции say_hi() (сейчас там только pass)\"\nsay_hi()", "code": "# Реализуйте параметризованный декоратор @repeat(num_times) с тремя уровнями вложенности\ndef repeat(num_times):          # уровень 1: принимает аргумент декоратора\n    def decorator(func):          # уровень 2: принимает саму функцию\n        def wrapper(*args, **kwargs):   # уровень 3: обёртка вызова\n            result = None\n            for _ in range(num_times):\n                result = func(*args, **kwargs)\n            return result\n        return wrapper\n    return decorator\n\n\n@repeat(num_times=3)\ndef say_hi():\n    print(\"Привет!\")\n\nsay_hi()   # напечатает \"Привет!\" три раза"}, {"id": 325, "title": "Напишите функцию, генерирующую другие функции (замыкание-фабрика)", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Напишите функцию, генерирующую другие функции (замыкание-фабрика).</p>", "initialCode": "def make_multiplier(factor):\n    pass", "solution": "# Напишите функцию, генерирующую другие функции (замыкание-фабрика)\ndef make_multiplier(factor):\n    def multiplier(x):\n        return x * factor    # factor захвачен из внешней области — замыкание\n    return multiplier\n\n\ndouble = make_multiplier(2)\ntriple = make_multiplier(3)\n\nprint(double(5))   # 10\nprint(triple(5))   # 15 — каждая функция помнит своё собственное factor", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"make_multiplier\" in globals() and callable(make_multiplier), \"Функция make_multiplier() должна быть определена\"\n_fn_nodes_make_multiplier = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"make_multiplier\"]\nassert _fn_nodes_make_multiplier and not (len(_fn_nodes_make_multiplier[0].body) == 1 and isinstance(_fn_nodes_make_multiplier[0].body[0], _ast.Pass)), \"Реализуйте тело функции make_multiplier() (сейчас там только pass)\"\ndouble = make_multiplier(2)\ntriple = make_multiplier(3)\nprint(double(5))\nprint(triple(5))\nassert \"double\" in globals(), \"Переменная double должна быть вычислена\"\nassert \"triple\" in globals(), \"Переменная triple должна быть вычислена\"", "code": "# Напишите функцию, генерирующую другие функции (замыкание-фабрика)\ndef make_multiplier(factor):\n    def multiplier(x):\n        return x * factor    # factor захвачен из внешней области — замыкание\n    return multiplier\n\n\ndouble = make_multiplier(2)\ntriple = make_multiplier(3)\n\nprint(double(5))   # 10\nprint(triple(5))   # 15 — каждая функция помнит своё собственное factor"}, {"id": 326, "title": "Стек декораторов: примените два декоратора к одной функции и определите порядок", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Стек декораторов: примените два декоратора к одной функции и определите порядок.</p>", "initialCode": "def bold(func):\n    pass\ndef italic(func):\n    pass\n@bold\n@italic\ndef text():\n    pass", "solution": "# Стек декораторов: примените два декоратора к одной функции и определите порядок\ndef bold(func):\n    def wrapper(*args, **kwargs):\n        return f\"<b>{func(*args, **kwargs)}</b>\"\n    return wrapper\n\ndef italic(func):\n    def wrapper(*args, **kwargs):\n        return f\"<i>{func(*args, **kwargs)}</i>\"\n    return wrapper\n\n\n@bold\n@italic\ndef text():\n    return \"Привет\"\n\n\nprint(text())   # <b><i>Привет</i></b> —\n                   # применяются снизу вверх: сначала italic, потом bold снаружи", "hint": "Шаг 1: Храни элементы во внутреннем списке self._items. Шаг 2: push добавляет через append(), pop удаляет с конца через pop() с проверкой на пустоту, peek возвращает последний элемент.", "tests": "import ast as _ast\nassert \"bold\" in globals() and callable(bold), \"Функция bold() должна быть определена\"\n_fn_nodes_bold = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"bold\"]\nassert _fn_nodes_bold and not (len(_fn_nodes_bold[0].body) == 1 and isinstance(_fn_nodes_bold[0].body[0], _ast.Pass)), \"Реализуйте тело функции bold() (сейчас там только pass)\"\nassert \"italic\" in globals() and callable(italic), \"Функция italic() должна быть определена\"\n_fn_nodes_italic = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"italic\"]\nassert _fn_nodes_italic and not (len(_fn_nodes_italic[0].body) == 1 and isinstance(_fn_nodes_italic[0].body[0], _ast.Pass)), \"Реализуйте тело функции italic() (сейчас там только pass)\"\nassert \"text\" in globals() and callable(text), \"Функция text() должна быть определена\"\n_fn_nodes_text = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"text\"]\nassert _fn_nodes_text and not (len(_fn_nodes_text[0].body) == 1 and isinstance(_fn_nodes_text[0].body[0], _ast.Pass)), \"Реализуйте тело функции text() (сейчас там только pass)\"\nprint(text())", "code": "# Стек декораторов: примените два декоратора к одной функции и определите порядок\ndef bold(func):\n    def wrapper(*args, **kwargs):\n        return f\"<b>{func(*args, **kwargs)}</b>\"\n    return wrapper\n\ndef italic(func):\n    def wrapper(*args, **kwargs):\n        return f\"<i>{func(*args, **kwargs)}</i>\"\n    return wrapper\n\n\n@bold\n@italic\ndef text():\n    return \"Привет\"\n\n\nprint(text())   # <b><i>Привет</i></b> —\n                   # применяются снизу вверх: сначала italic, потом bold снаружи"}, {"id": 327, "title": "Реализуйте конвейер генераторов данных с трансформацией через yield", "level": 3, "tier": "🐢 Уровень 3", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте конвейер генераторов данных с трансформацией через yield.</p>", "initialCode": "def numbers(n):\n    pass\ndef double_values(nums):\n    pass\ndef only_positive(nums):\n    pass", "solution": "# Реализуйте конвейер генераторов данных с трансформацией через yield\ndef numbers(n):\n    for i in range(n):\n        yield i\n\ndef double_values(nums):\n    for n in nums:\n        yield n * 2\n\ndef only_positive(nums):\n    for n in nums:\n        if n > 0:\n            yield n\n\n\npipeline = only_positive(double_values(numbers(5)))\nprint(list(pipeline))   # [0, 2, 4, 6, 8] -> без нуля: [2, 4, 6, 8] после фильтра >0", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"numbers\" in globals() and callable(numbers), \"Функция numbers() должна быть определена\"\n_fn_nodes_numbers = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"numbers\"]\nassert _fn_nodes_numbers and not (len(_fn_nodes_numbers[0].body) == 1 and isinstance(_fn_nodes_numbers[0].body[0], _ast.Pass)), \"Реализуйте тело функции numbers() (сейчас там только pass)\"\nassert \"double_values\" in globals() and callable(double_values), \"Функция double_values() должна быть определена\"\n_fn_nodes_double_values = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"double_values\"]\nassert _fn_nodes_double_values and not (len(_fn_nodes_double_values[0].body) == 1 and isinstance(_fn_nodes_double_values[0].body[0], _ast.Pass)), \"Реализуйте тело функции double_values() (сейчас там только pass)\"\nassert \"only_positive\" in globals() and callable(only_positive), \"Функция only_positive() должна быть определена\"\n_fn_nodes_only_positive = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"only_positive\"]\nassert _fn_nodes_only_positive and not (len(_fn_nodes_only_positive[0].body) == 1 and isinstance(_fn_nodes_only_positive[0].body[0], _ast.Pass)), \"Реализуйте тело функции only_positive() (сейчас там только pass)\"\npipeline = only_positive(double_values(numbers(5)))\nprint(list(pipeline))\nassert \"pipeline\" in globals(), \"Переменная pipeline должна быть вычислена\"", "code": "# Реализуйте конвейер генераторов данных с трансформацией через yield\ndef numbers(n):\n    for i in range(n):\n        yield i\n\ndef double_values(nums):\n    for n in nums:\n        yield n * 2\n\ndef only_positive(nums):\n    for n in nums:\n        if n > 0:\n            yield n\n\n\npipeline = only_positive(double_values(numbers(5)))\nprint(list(pipeline))   # [0, 2, 4, 6, 8] -> без нуля: [2, 4, 6, 8] после фильтра >0"}, {"id": 328, "title": "Реализуйте бесконечный генератор простых чисел через yield", "level": 4, "tier": "🦊 Уровень 4", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте бесконечный генератор простых чисел через yield.</p>", "initialCode": "def primes():\n    pass", "solution": "# Реализуйте бесконечный генератор простых чисел через yield\ndef primes():\n    yield 2\n    found = [2]\n    candidate = 3\n    while True:\n        if all(candidate % p != 0 for p in found if p * p <= candidate):\n            found.append(candidate)\n            yield candidate\n        candidate += 2\n\n\ngen = primes()\nfirst_five = [next(gen) for _ in range(5)]\nprint(first_five)   # [2, 3, 5, 7, 11]", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"primes\" in globals() and callable(primes), \"Функция primes() должна быть определена\"\n_fn_nodes_primes = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"primes\"]\nassert _fn_nodes_primes and not (len(_fn_nodes_primes[0].body) == 1 and isinstance(_fn_nodes_primes[0].body[0], _ast.Pass)), \"Реализуйте тело функции primes() (сейчас там только pass)\"\ngen = primes()\nfirst_five = [next(gen) for _ in range(5)]\nprint(first_five)\nassert \"gen\" in globals(), \"Переменная gen должна быть вычислена\"\nassert \"first_five\" in globals(), \"Переменная first_five должна быть вычислена\"", "code": "# Реализуйте бесконечный генератор простых чисел через yield\ndef primes():\n    yield 2\n    found = [2]\n    candidate = 3\n    while True:\n        if all(candidate % p != 0 for p in found if p * p <= candidate):\n            found.append(candidate)\n            yield candidate\n        candidate += 2\n\n\ngen = primes()\nfirst_five = [next(gen) for _ in range(5)]\nprint(first_five)   # [2, 3, 5, 7, 11]"}, {"id": 329, "title": "Реализуйте класс с @classmethod как альтернативным конструктором", "level": 1, "tier": "🥚 Уровень 1", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте фабричный метод альтернативного создания объекта через <code>@classmethod</code>.</p><p class='meta'>В классе <code>User</code> объявите метод <code>@classmethod def from_string(cls, data_str: str)</code>, который принимает строку <code>\"Alex,30\"</code>, разделяет её и возвращает новый экземпляр <code>cls(name, int(age))</code>.</p>", "initialCode": "class Pizza:\n\n    def __init__(self, ingredients):\n        pass\n\n    @classmethod\n    def margherita(cls):\n        pass\n\n    @staticmethod\n    def is_vegetarian(ingredients):\n        pass", "solution": "# Реализуйте класс с @classmethod как альтернативным конструктором\nclass Pizza:\n    def __init__(self, ingredients):\n        self.ingredients = ingredients\n\n    @classmethod\n    def margherita(cls):\n        return cls([\"сыр\", \"томаты\", \"базилик\"])   # альтернативный способ создания\n\n    @staticmethod\n    def is_vegetarian(ingredients):\n        meat = {\"пепперони\", \"бекон\", \"курица\"}\n        return not any(i in meat for i in ingredients)\n\n\np = Pizza.margherita()          # classmethod создаёт готовый объект без ручного списка\nprint(p.ingredients)\nprint(Pizza.is_vegetarian(p.ingredients))   # staticmethod — не зависит от экземпляра", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🥚 Уровень 1). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Pizza\" in globals() and isinstance(Pizza, type), \"Класс Pizza должен быть определён\"\n_cl_def_Pizza = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Pizza\"]\nassert _cl_def_Pizza and not (len(_cl_def_Pizza[0].body) == 1 and isinstance(_cl_def_Pizza[0].body[0], _ast.Pass)), \"Реализуйте тело класса Pizza (сейчас там только pass)\"\nassert hasattr(Pizza, \"__init__\"), \"В классе Pizza должен быть метод/свойство __init__\"\n_cl_nodes_Pizza___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Pizza\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Pizza___init__ and not (len(_cl_nodes_Pizza___init__[0].body) == 1 and isinstance(_cl_nodes_Pizza___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Pizza.__init__()\"\nassert hasattr(Pizza, \"margherita\"), \"В классе Pizza должен быть метод/свойство margherita\"\n_cl_nodes_Pizza_margherita = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Pizza\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"margherita\"]\nassert _cl_nodes_Pizza_margherita and not (len(_cl_nodes_Pizza_margherita[0].body) == 1 and isinstance(_cl_nodes_Pizza_margherita[0].body[0], _ast.Pass)), \"Реализуйте метод Pizza.margherita()\"\nassert hasattr(Pizza, \"is_vegetarian\"), \"В классе Pizza должен быть метод/свойство is_vegetarian\"\n_cl_nodes_Pizza_is_vegetarian = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Pizza\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"is_vegetarian\"]\nassert _cl_nodes_Pizza_is_vegetarian and not (len(_cl_nodes_Pizza_is_vegetarian[0].body) == 1 and isinstance(_cl_nodes_Pizza_is_vegetarian[0].body[0], _ast.Pass)), \"Реализуйте метод Pizza.is_vegetarian()\"\np = Pizza.margherita()\nprint(p.ingredients)\nprint(Pizza.is_vegetarian(p.ingredients))\nassert \"p\" in globals(), \"Переменная p должна быть вычислена\"\nassert User.from_string(\"Alex,30\").name == \"Alex\" and User.from_string(\"Alex,30\").age == 30, \"Фабричный метод from_string должен создавать экземпляр User(name, age)\"", "code": "# Реализуйте класс с @classmethod как альтернативным конструктором\nclass Pizza:\n    def __init__(self, ingredients):\n        self.ingredients = ingredients\n\n    @classmethod\n    def margherita(cls):\n        return cls([\"сыр\", \"томаты\", \"базилик\"])   # альтернативный способ создания\n\n    @staticmethod\n    def is_vegetarian(ingredients):\n        meat = {\"пепперони\", \"бекон\", \"курица\"}\n        return not any(i in meat for i in ingredients)\n\n\np = Pizza.margherita()          # classmethod создаёт готовый объект без ручного списка\nprint(p.ingredients)\nprint(Pizza.is_vegetarian(p.ingredients))   # staticmethod — не зависит от экземпляра"}, {"id": 330, "title": "Настройте строгую проверку типов через mypy для функции с Optional", "level": 2, "tier": "🐣 Уровень 2", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Настройте строгую проверку типов через mypy для функции с Optional.</p>", "initialCode": "from typing import Optional\ndef find_user_email(user_id: int, users: dict) -> Optional[str]:\n    pass", "solution": "# Настройте строгую проверку типов через mypy для функции с Optional\nfrom typing import Optional\n\ndef find_user_email(user_id: int, users: dict) -> Optional[str]:\n    user = users.get(user_id)\n    if user is None:\n        return None\n    return user[\"email\"]\n\n# mypy --strict заставит явно проверить None перед использованием результата:\nresult = find_user_email(1, {1: {\"email\": \"a@b.com\"}})\nif result is not None:\n    print(result.upper())   # безопасно — mypy знает, что тут уже не None", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐣 Уровень 2). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"find_user_email\" in globals() and callable(find_user_email), \"Функция find_user_email() должна быть определена\"\n_fn_nodes_find_user_email = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"find_user_email\"]\nassert _fn_nodes_find_user_email and not (len(_fn_nodes_find_user_email[0].body) == 1 and 
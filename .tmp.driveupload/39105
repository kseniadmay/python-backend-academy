_name__(self, owner, name):\n        self.attr_name = name\n\n    def __get__(self, obj, owner):\n        if obj is None:\n            return self\n        value = self.func(obj)\n        obj.__dict__[self.attr_name] = value\n        return value\n\n\nclass DataSet:\n    def __init__(self, values):\n        self.values = values\n\n    @CachedProperty\n    def average(self):\n        print(\"Пересчитываю среднее...\")\n        return sum(self.values) / len(self.values)\n\n\nd = DataSet([1, 2, 3, 4])\nprint(d.average)  # печатает \"Пересчитываю...\" -> 2.5\nprint(d.average)  # берёт из __dict__, без пересчёта", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"CachedProperty\" in globals() and isinstance(CachedProperty, type), \"Класс CachedProperty должен быть определён\"\n_cl_def_CachedProperty = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CachedProperty\"]\nassert _cl_def_CachedProperty and not (len(_cl_def_CachedProperty[0].body) == 1 and isinstance(_cl_def_CachedProperty[0].body[0], _ast.Pass)), \"Реализуйте тело класса CachedProperty (сейчас там только pass)\"\nassert hasattr(CachedProperty, \"__init__\"), \"В классе CachedProperty должен быть метод/свойство __init__\"\n_cl_nodes_CachedProperty___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CachedProperty\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_CachedProperty___init__ and not (len(_cl_nodes_CachedProperty___init__[0].body) == 1 and isinstance(_cl_nodes_CachedProperty___init__[0].body[0], _ast.Pass)), \"Реализуйте метод CachedProperty.__init__()\"\nassert hasattr(CachedProperty, \"__set_name__\"), \"В классе CachedProperty должен быть мето
sponse\n\nres = echo_roundtrip(b\"Hello, TCP server!\")\nprint(\"Ответ эхо-сервера:\", res.decode(\"utf-8\"))\nassert res == b\"Hello, TCP server!\"\n"}, {"id": 273, "title": "Реализуйте асинхронную загрузку данных с помощью asyncio.gather", "level": 4, "tier": "🦊 Уровень 4", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте асинхронную загрузку данных с помощью asyncio.gather.</p>", "initialCode": "import asyncio\nasync def fetch(name, delay):\n    pass\nasync def main():\n    pass", "solution": "# Реализуйте асинхронную загрузку данных с помощью asyncio.gather\nimport asyncio\n\nasync def fetch(name, delay):\n    print(f\"{name}: начал запрос\")\n    await asyncio.sleep(delay)\n    print(f\"{name}: получил данные\")\n    return f\"{name}-результат\"\n\nasync def main():\n    results = await asyncio.gather(\n        fetch(\"A\", 2),\n        fetch(\"B\", 1),\n        fetch(\"C\", 3),\n    )\n    print(results)   # общее время ~3с, а не 2+1+3=6с\n\nasyncio.run(main())", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"fetch\" in globals() and callable(fetch), \"Функция fetch() должна быть определена\"\n_fn_nodes_fetch = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"fetch\"]\nassert _fn_nodes_fetch and not (len(_fn_nodes_fetch[0].body) == 1 and isinstance(_fn_nodes_fetch[0].body[0], _ast.Pass)), \"Реализуйте тело функции fetch() (сейчас там только pass)\"\nassert \"main\" in globals() and callable(main), \"Функция main() должна быть определена\"\n_fn_nodes_main = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"main\"]\nassert _fn_nodes_main and not (len(_fn_nodes_main[0].body) == 1 and isinstance(_fn_nodes_main[0].body[0], _ast.Pass)), \"Реализуйте тело функции main() (сейчас там только pass)\"\nasyncio.run(main())", "code": "# Реализуйте асинхронную загрузку данных с помощью asyncio.gather\nimport asyncio\n\nasync def fetch(name, delay):\n    print(f\"{name}: начал запрос\")\n    await asyncio.sleep(delay)\n    print(f\"{name}: получил данные\")\n    return f\"{name}-результат\"\n\nasync def main():\n    results = await asyncio.gather(\n        fetch(\"A\", 2),\n        fetch(\"B\", 1),\n        fetch(\"C\", 3),\n    )\n    print(results)   # общее время ~3с, а не 2+1+3=6с\n\nasyncio.run(main())"}, {"id": 274, "title": "Извлеките структурированные данные из строки лога через regex-группы", "level": 4, "tier": "🦊 Уровень 4", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Извлеките структурированные данные из строки лога через regex-группы.</p>", "initialCode": "import re\n\nlog_line = '2026-09-17 14:23:01 ERROR Database connection failed'\npattern = '(?P<date>[\\\\d-]+) (?P<time>[\\\\d:]+) (?P<level>\\\\w+) (?P<message>.+)'\nmatch = None", "solution": "# Извлеките структурированные данные из строки лога через regex-группы\nimport re\n\nlog_line = '2026-09-17 14:23:01 ERROR Database connection failed'\npattern = r'(?P<date>[\\d-]+) (?P<time>[\\d:]+) (?P<level>\\w+) (?P<message>.+)'\n\nmatch = re.match(pattern, log_line)\nprint(match.group('level'))     # ERROR\nprint(match.group('message'))   # Database connection failed\nprint(match.groupdict())        # {'date': ..., 'time': ..., 'level': ..., 'message': ...}", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"log_line\" in globals() and log_line is not None, \"Переменная log_line должна быть определена и не равна None\"\nassert isinstance(log_line, str) and \"ERROR\".lower() in log_line.lower(), \"Строка log_line должна содержать ключевой элемент 'ERROR'\"\nassert isinstance(log_line, str) and \"Database\".lower() in log_line.lower(), \"Строка log_line должна содержать ключевой элемент 'Database'\"\nassert isinstance(log_line, str) and \"connection\".lower() in log_line.lower(), \"Строка log_line должна содержать ключевой элемент 'connection'\"\nassert \"pattern\" in globals() and pattern is not None, \"Переменная pattern должна быть определена и не равна None\"\nassert isinstance(pattern, str) and \"date\".lower() in pattern.lower(), \"Строка pattern должна содержать ключевой элемент 'date'\"\nassert isinstance(pattern, str) and \"time\".lower() in pattern.lower(), \"Строка pattern должна содержать ключевой элемент 'time'\"\nassert isinstance(pattern, str) and \"level\".lower() in pattern.lower(), \"Строка pattern должна содержать ключевой элемент 'level'\"\nassert \"match\" in globals() and match is not None, \"Переменная match должна быть определена и не равна None\"\nassert match != \"__TODO__\", \"Заполните значение переменной match\"", "code": "# Извлеките структурированные данные из строки лога через regex-группы\nimport re\n\nlog_line = '2026-09-17 14:23:01 ERROR Database connection failed'\npattern = r'(?P<date>[\\d-]+) (?P<time>[\\d:]+) (?P<level>\\w+) (?P<message>.+)'\n\nmatch = re.match(pattern, log_line)\nprint(match.group('level'))     # ERROR\nprint(match.group('message'))   # Database connection failed\nprint(match.groupdict())        # {'date': ..., 'time': ..., 'level': ..., 'message': ...}"}, {"id": 275, "title": "Реализуйте класс Stack как Generic[T] и продемонстрируйте использование", "level": 5, "tier": "🦅 Уровень 5", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте класс Stack как Generic[T] и продемонстрируйте использование.</p>", "initialCode": "from typing import TypeVar, Generic\nT = TypeVar('T')\nclass Stack(Generic[T]):\n\n    def __init__(self) -> None:\n        pass\n\n    def push(self, item: T) -> None:\n        pass\n\n    def pop(self) -> T:\n        pass\n\n    def is_empty(self) -> bool:\n        pass", "solution": "# Реализуйте класс Stack как Generic[T] и продемонстрируйте использование\nfrom typing import TypeVar, Generic\n\nT = TypeVar(\"T\")\n\nclass Stack(Generic[T]):\n    def __init__(self) -> None:\n        self._items: list[T] = []\n\n    def push(self, item: T) -> None:\n        self._items.append(item)\n\n    def pop(self) -> T:\n        return self._items.pop()\n\n    def is_empty(self) -> bool:\n        return not self._items\n\n\nint_stack: Stack[int] = Stack()\nint_stack.push(1)\nint_stack.push(2)\nprint(int_stack.pop())  # 2", "hint": "Шаг 1: Храни элементы во внутреннем списке self._items. Шаг 2: push добавляет через append(), pop удаляет с конца через pop() с проверкой на пустоту, peek возвращает последний элемент.", "tests": "import ast as _ast\nassert \"Stack\" in globals() and isinstance(Stack, type), \"Класс Stack должен быть определён\"\n_cl_def_Stack = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\"]\nassert _cl_def_Stack and not (len(_cl_def_Stack[0].body) == 1 and isinstance(_cl_def_Stack[0].body[0], _ast.Pass)), \"Реализуйте тело класса Stack (сейчас там только pass)\"\nassert hasattr(Stack, \"__init__\"), \"В классе Stack должен быть метод/свойство __init__\"\n_cl_nodes_Stack___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Stack___init__ and not (len(_cl_nodes_Stack___init__[0].body) == 1 and isinstance(_cl_nodes_Stack___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.__init__()\"\nassert hasattr(Stack, \"push\"), \"В классе Stack должен быть метод/свойство push\"\n_cl_nodes_Stack_push = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"push\"]\nassert _cl_nodes_Stack_push and not (len(_cl_nodes_Stack_push[0].body) == 1 and isinstance(_cl_nodes_Stack_push[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.push()\"\nassert hasattr(Stack, \"pop\"), \"В классе Stack должен быть метод/свойство pop\"\n_cl_nodes_Stack_pop = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"pop\"]\nassert _cl_nodes_Stack_pop and not (len(_cl_nodes_Stack_pop[0].body) == 1 and isinstance(_cl_nodes_Stack_pop[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.pop()\"\nassert hasattr(Stack, \"is_empty\"), \"В классе Stack должен быть метод/свойство is_empty\"\n_cl_nodes_Stack_is_empty = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Stack\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"is_empty\"]\nassert _cl_nodes_Stack_is_empty and not (len(_cl_nodes_Stack_is_empty[0].body) == 1 and isinstance(_cl_nodes_Stack_is_empty[0].body[0], _ast.Pass)), \"Реализуйте метод Stack.is_empty()\"\nint_stack: Stack[int] = Stack()\nint_stack.push(1)\nint_stack.push(2)\nprint(int_stack.pop())", "code": "# Реализуйте класс Stack как Generic[T] и продемонстрируйте использование\nfrom typing import TypeVar, Generic\n\nT = TypeVar(\"T\")\n\nclass Stack(Generic[T]):\n    def __init__(self) -> None:\n        self._items: list[T] = []\n\n    def push(self, item: T) -> None:\n        self._items.append(item)\n\n    def pop(self) -> T:\n        return self._items.pop()\n\n    def is_empty(self) -> bool:\n        return not self._items\n\n\nint_stack: Stack[int] = Stack()\nint_stack.push(1)\nint_stack.push(2)\nprint(int_stack.pop())  # 2"}, {"id": 276, "title": "Постройте Aggregate Order с товарами и бизнес-инвариантами", "level": 5, "tier": "🦅 Уровень 5", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Постройте Aggregate Order с товарами и бизнес-инвариантами.</p>", "initialCode": "class OrderItem:\n\n    def __init__(self, product_id, quantity, price):\n        pass\nclass Order:\n\n    def __init__(self, order_id):\n        pass\n\n    def add_item(self, product_id, quantity, price):\n        pass\n\n    def total(self):\n        pass\n\n    def submit(self):\n        pass", "solution": "# Постройте Aggregate Order с товарами и бизнес-инвариантами\nclass OrderItem:\n    def __init__(self, product_id, quantity, price):\n        self.product_id = product_id\n        self.quantity = quantity\n        self.price = price\n\n\nclass Order:  # Aggregate Root\n    def __init__(self, order_id):\n        self.id = order_id\n        self._items = []\n        self.status = \"draft\"\n\n    def add_item(self, product_id, quantity, price):\n        if self.status != \"draft\":\n            raise ValueError(\"Нельзя добавить товар в оформленный заказ\")\n        self._items.append(OrderItem(product_id, quantity, price))\n\n    def total(self):\n        return sum(item.price * item.quantity for item in self._items)\n\n    def submit(self):\n        if not self._items:\n            raise ValueError(\"Нельзя оформить пустой заказ\")\n        self.status = \"submitted\"\n\n\norder = Order(1)\norder.add_item(\"book\", 2, 15)\norder.submit()\nprint(order.total(), order.status)   # 30 submitted", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"OrderItem\" in globals() and isinstance(OrderItem, type), \"Класс OrderItem должен быть определён\"\n_cl_def_OrderItem = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"OrderItem\"]\nassert _cl_def_OrderItem and not (len(_cl_def_Orde
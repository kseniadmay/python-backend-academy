elf.limit_val = count\n        return self\n\n    def build(self) -> str:\n        q = f\"SELECT {', '.join(self.fields)} FROM {self.table}\"\n        if self.conditions:\n            q += f\" WHERE {' AND '.join(self.conditions)}\"\n        if self.limit_val:\n            q += f\" LIMIT {self.limit_val}\"\n        return q", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"QueryBuilder\" in globals() and isinstance(QueryBuilder, type), \"Класс QueryBuilder должен быть определён\"\n_cl_def_QueryBuilder = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"QueryBuilder\"]\nassert _cl_def_QueryBuilder and not (len(_cl_def_QueryBuilder[0].body) == 1 and isinstance(_cl_def_QueryBuilder[0].body[0], _ast.Pass)), \"Реализуйте тело класса QueryBuilder (сейчас там только pass)\"\nassert hasattr(QueryBuilder, \"__init__\"), \"В классе QueryBuilder должен быть метод/свойство __init__\"\n_cl_nodes_QueryBuilder___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"QueryBuilder\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_QueryBuilder___init__ and not (len(_cl_nodes_QueryBuilder___init__[0].body) == 1 and isinstance(_cl_nodes_QueryBuilder___init__[0].body[0], _ast.Pass)), \"Реализуйте метод QueryBuilder.__init__()\"\nassert hasattr(QueryBuilder, \"select\"), \"В классе QueryBuilder должен быть метод/свойство select\"\n_cl_nodes_QueryBuilder_select = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"QueryBuilder\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"select\"]\nassert _cl_nodes_QueryBuilder_select and not (len(_cl_nodes_QueryBuilder_select[0].body) == 1 and isinstance(_cl_nodes_QueryBuilder_select[0].body[0], _ast.Pass)), \"Реализуйте метод QueryBuilder.select()\"\nassert hasattr(QueryBuilder, \"where\"), \"В классе QueryBuilder должен быть метод/свойство where\"\n_cl_nodes_QueryBuilder_where = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"QueryBuilder\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"where\"]\nassert _cl_nodes_QueryBuilder_where and not (len(_cl_nodes_QueryBuilder_where[0].body) == 1 and isinstance(_cl_nodes_QueryBuilder_where[0].body[0], _ast.Pass)), \"Реализуйте метод QueryBuilder.where()\"\nassert hasattr(QueryBuilder, \"limit\"), \"В классе QueryBuilder должен быть метод/свойство limit\"\n_cl_nodes_QueryBuilder_limit = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"QueryBuilder\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"limit\"]\nassert _cl_nodes_QueryBuilder_limit and not (len(_cl_nodes_QueryBuilder_limit[0].body) == 1 and isinstance(_cl_nodes_QueryBuilder_limit[0].body[0], _ast.Pass)), \"Реализуйте метод QueryBuilder.limit()\"\nassert hasattr(QueryBuilder, \"build\"), \"В классе QueryBuilder должен быть метод/свойство build\"\n_cl_nodes_QueryBuilder_build = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"QueryBuilder\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"build\"]\nassert _cl_nodes_QueryBuilder_build and not (len(_cl_nodes_QueryBuilder_build[0].body) == 1 and isinstance(_cl_nodes_QueryBuilder_build[0].body[0], _ast.Pass)), \"Реализуйте метод QueryBuilder.build()\"", "code": "# Напишите паттерн Builder для сборки сложного SQL-запроса\nclass QueryBuilder:\n    def __init__(self, table: str):\n        self.table = table\n        self.fields = [\"*\"]\n        self.conditions = []\n        self.limit_val = None\n\n    def select(self, *fields):\n        self.fields = list(fields)\n        return self\n\n    def where(self, condition):\n        self.conditions.append(condition)\n        return self\n\n    def limit(self, count):\n        self.limit_val = count\n        return self\n\n    def build(self) -> str:\n        q = f\"SELECT {', '.join(self.fields)} FROM {self.table}\"\n        if self.conditions:\n            q += f\" WHERE {' AND '.join(self.conditions)}\"\n        if self.limit_val:\n            q += f\" LIMIT {self.limit_val}\"\n        return q"}, {"id": 194, "title": "Настройте генерацию UUID v4 в качестве первичного ключа", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Настройте генерацию UUID v4 в качестве первичного ключа.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Настройте генерацию UUID v4 в качестве первичного ключа\nsql = \"\"\"\nCREATE EXTENSION IF NOT EXISTS \"uuid-ossp\";\n\nCREATE TABLE api_keys (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    user_id INT REFERENCES users(id),\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n);\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"CREATE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'CREATE'\"\nassert isinstance(sql, str) and \"EXTENSION\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'EXTENSION'\"\nassert isinstance(sql, str) and \"NOT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'NOT'\"", "code": "# Настройте генерацию UUID v4 в качестве первичного ключа\nsql = \"\"\"\nCREATE EXTENSION IF NOT EXISTS \"uuid-ossp\";\n\nCREATE TABLE api_keys (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    user_id INT REFERENCES users(id),\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n);\n\"\"\""}, {"id": 195, "title": "Напишите безопасный перевод денег между счетами", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите безопасный перевод денег между счетами.</p>", "initialCode": "def safe_transfer(conn, acc1: int, acc2: int, amount: float):\n    pass", "solution": "# Напишите безопасный перевод денег между счетами\ndef safe_transfer(conn, acc1: int, acc2: int, amount: float):\n    first, second = sorted([acc1, acc2])  # Предотвращает Deadlock\n    with conn:\n        with conn.cursor() as cur:\n            cur.execute(\"SELECT balance FROM accounts WHERE id = %s FOR UPDATE\", (first,))\n            cur.execute(\"SELECT balance FROM accounts WHERE id = %s FOR UPDATE\", (second,))\n            cur.execute(\"UPDATE accounts SET balance = balance - %s WHERE id = %s\", (amount, acc1))\n            cur.execute(\"UPDATE accounts SET balance = balance + %s WHERE id = %s\", (amount, acc2))", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"safe_transfer\" in globals() and callable(safe_transfer), \"Функция safe_transfer() должна быть определена\"\n_fn_nodes_safe_transfer = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"safe_transfer\"]\nassert _fn_nodes_safe_transfer and not (len(_fn_nodes_safe_transfer[0].body) == 1 and isinstance(_fn_nodes_safe_transfer[0].body[0], _ast.Pass)), \"Реализуйте тело функции safe_transfer() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Напишите безопасный перевод денег между счетами\ndef safe_transfer(conn, acc1: int, acc2: int, amount: float):\n    first, second = sorted([acc1, acc2])  # Предотвращает Deadlock\n    with conn:\n        with conn.cursor() as cur:\n            cur.execute(\"SELECT balance FROM accounts WHERE id = %s FOR UPDATE\", (first,))\n            cur.execute(\"SELECT balance FROM accounts WHERE id = %s FOR UPDATE\", (second,))\n            cur.execute(\"UPDATE accounts SET balance = balance - %s WHERE id = %s\", (amount, acc1))\n            cur.execute(\"UPDATE accounts SET balance = balance + %s WHERE id = %s\", (amount, acc2))"}, {"id": 196, "title": "Проанализируйте план запроса в EXPLAIN ANALYZE (Seq Scan)", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Проанализируйте план запроса в EXPLAIN ANALYZE (Seq Scan).</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Проанализируйте план запроса в EXPLAIN ANALYZE (Seq Scan)\nsql = \"\"\"\nEXPLAIN (ANALYZE, BUFFERS, VERBOSE)\nSELECT * FROM users WHERE email = 'test@example.com';\n-- Если в плане Seq Scan, необходимо добавить B-Tree индекс на email\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"EXPLAIN\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'EXPLAIN'\"\nassert isinstance(sql, str) and \"ANALYZE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'ANALYZE'\"\nassert isinstance(sql, str) and \"BUFFERS\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'BUFFERS'\"", "code": "# Проанализируйте план запроса в EXPLAIN ANALYZE (Seq Scan)\nsql = \"\"\"\nEXPLAIN (ANALYZE, BUFFERS, VERBOSE)\nSELECT * FROM users WHERE email = 'test@example.com';\n-- Если в плане Seq Scan, необходимо добавить B-Tree индекс на email\n\"\"\""}, {"id": 197, "title": "Реализуйте стек декораторов с сохранением метаданных functools.wraps", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте стек декораторов с сохранением метаданных functools.wraps.</p>", "initialCode": "from functools import wraps\ndef bold(func):\n    pass\ndef italic(func):\n    pass\n@bold\n@italic\ndef greet(name):\n    pass", "solution": "# Реализуйте стек декораторов с сохранением метаданных functools.wraps\nfrom functools import wraps\n\ndef bold(func):\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        return f\"<b>{func(*args, **kwargs)}</b>\"\n    return wrapper\n\ndef italic(func):\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        return f\"<i>{func(*args, **kwargs)}</i>\"\n    return wrapper\n\n@bold\n@italic\ndef greet(name):\n    \"\"\"Docstring greet\"\"\"\n    return f\"Hello, {name}\"\n\nprint(greet(\"User\"))  # <b><i>Hello, User</i></b>\nprint(greet.__name__)  # greet", "hint": "Шаг 1: Храни элементы во внутреннем списке self._items. Шаг 2: push добавляет через append(), pop удаляет с конца через pop() с проверкой на пустоту, peek возвращает последний элемент.", "tests": "import ast as _ast\nassert \"bold\" in globals() and callable(bold), \"Функция bold() должна быть определена\"\n_fn_nodes_bold = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"bold\"]\nassert _fn_nodes_bold and not (len(_fn_nodes_bold[0].body) == 1 and isinstance(_fn_nodes_bold[0].body[0], _ast.Pass)), \"Реализуйте тело функции bold() (сейчас там только pass)\"\nassert \"italic\" in globals() and callable(italic), \"Функция italic() должна быть определена\"\n_fn_nodes_italic = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"italic\"]\nassert _fn_nodes_italic and not (len(_fn_nodes_italic[0].body) == 1 and isinstance(_fn_nodes_italic[0].body[0], _ast.Pass)), \"Реализуйте тело функции italic() (сейчас там только pass)\"\nassert \"greet\" in globals() and callable(greet), \"Функция greet() должна быть определена\"\n_fn_nodes_greet = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"greet\"]\nassert _fn_nodes_greet and not (len(_fn_nodes_greet[0].body) == 1 and isinstance(_fn_nodes_greet[0].body[0], _ast.Pass)), \"Реализуйте тело функции greet() (сейчас там только pass)\"\nprint(greet(\"User\"))\nprint(greet.__name__)", "code": "# Реализуйте стек декораторов с сохранением метаданных functools.wraps\nfrom functools import wraps\n\ndef bold(func):\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        return f\"<b>{func(*args, **kwargs)}</b>\"\n    return wrapper\n\ndef italic(func):\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        return f\"<i>{func(*args, **kwargs)}</i>\"\n    return wrapper\n\n@bold\n@italic\ndef greet(name):\n    \"\"\"Docstring greet\"\"\"\n    return f\"Hello, {name}\"\n\nprint(greet(\"User\"))  # <b><i>Hello, User</i></b>\nprint(greet.__name__)  # greet"}, {"id": 198, "title": "Проверьте дерево на зеркальную симметрию (Symmetric Tree)", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Проверьте дерево на зеркальную симметрию (Symmetric Tree).</p>", "initialCode": "def is_symmetric(root: TreeNode) -> bool:\n    pass", "solution": "# Проверьте дерево на зеркальную симметрию (Symmetric Tree)\ndef is_symmetric(root: TreeNode) -> bool:\n    def is_mirror(t1, t2):\n        if not t1 and not t2: return True\n        if not t1 or not t2: return False\n        return (t1.val == t2.val and \n                is_mirror(t1.left, t2.right) and \n                is_mirror(t1.right, t2.left))\n    return is_mirror(root, root)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"is_symmetric\" in globals() and callable(is_symmetric), \"Функция is_symmetric() должна быть определена\"\n_fn_nodes_is_symmetric = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"is_symmetric\"]\nassert _fn_nodes_is_symmetric and not (len(_fn_nodes_is_symmetric[0].body) == 1 and isinstance(_fn_nodes_is_symmetric[0].body[0], _ast.Pass)), \"Реализуйте тело функции is_symmetric() (сейчас там только pass)\"\n_r = TreeNode(1, TreeNode(2), TreeNode(2)); assert is_symmetric(_r) is True", "code": "# Проверьте дерево на зеркальную симметрию (Symmetric Tree)\ndef is_symmetric(root: TreeNode) -> bool:\n    def is_mirror(t1, t2):\n        if not t1 and not t2: return True\n        if not t1 or not t2: return False\n        return (t1.val == t2.val and \n                is_mirror(t1.left, t2.right) and \n                is_mirror(t1.right, t2.left))\n    return is_mirror(root, root)"}, {"id": 199, "title": "Постройте тройной JOIN: пользователи, заказы, товары", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте тройной JOIN: пользователи, заказы, товары.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Постройте тройной JOIN: пользователи, заказы, товары\nsql = \"\"\"\nSELECT u.username, o.id AS order_id, p.name AS product_name, oi.quantity, oi.price\nFROM users u\nJOIN orders o ON u.id = o.user_id\nJOIN order_items oi ON o.id = oi.order_id\nJOIN products p ON oi.product_id = p.id\nWHERE u.id = 42;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"username\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'username'\"\nassert isinstance(sql, str) and \"order_id\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'order_id'\"", "code": "# Постройте тройной JOIN: пользователи, заказы, товары\nsql = \"\"\"\nSELECT u.username, o.id AS order_id, p.name AS product_name, oi.quantity, oi.price\nFROM users u\nJOIN orders o ON u.id = o.user_id\nJOIN order_items oi ON o.id = oi.order_id\nJOIN products p ON oi.product_id = p.id\nWHERE u.id = 42;\n\"\"\""}, {"id": 200, "title": "Постройте сложный агрегационный запрос с Coalesce", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте сложный агрегационный запрос с Coalesce.</p>", "initialCode": "from django.db.models import Sum, Value\nfrom django.db.models.functions import Coalesce\n\nstats = None", "solution": "# Постройте сложный агрегационный запрос с Coalesce\nfrom django.db.models import Sum, Value\nfrom django.db.models.functions import Coalesce\n\n# Замена NULL на 0 при вычислении суммы бонусов\nstats = User.objects.aggregate(\n    total_bonus=Coalesce(Sum('bonuses__amount'), Value(0))\n)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"stats\" in globals() and stats is not None, \"Переменная stats должна быть определена и не равна None\"\nassert stats != \"__TODO__\", \"Заполните значение переменной stats\"", "code": "# Постройте сложный агрегационный запрос с Coalesce\nfrom django.db.models import Sum, Value\nfrom django.db.models.functions import Coalesce\n\n# Замена NULL на 0 при вычислении суммы бонусов\nstats = User.objects.aggregate(\n    total_bonus=Coalesce(Sum('bonuses__amount'), Value(0))\n)"}, {"id": 201, "title": "Реализуйте распределённую блокировку через Redis", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте распределённую блокировку через Redis.</p>", "initialCode": "import uuid\ndef acquire_lock(lock_key: str, ttl_sec: int=10):\n    pass\ndef release_lock(lock_key: str, token: str):\n    pass", "solution": "# Реализуйте распределённую блокировку через Redis (Redlock/SET NX EX)\nimport uuid\n\ndef acquire_lock(lock_key: str, ttl_sec: int = 10):\n    token = str(uuid.uuid4())\n    acquired = r.set(lock_key, token, nx=True, ex=ttl_sec)\n    return token if acquired else None\n\ndef release_lock(lock_key: str, token: str):\n    lua_release = \"\"\"\n    if redis.call('get', KEYS[1]) == ARGV[1] then\n        return redis.call('del', KEYS[1])\n    else\n        return 0\n    end\n    \"\"\"\n    r.eval(lua_release, 1, lock_key, token)", "hint": "Используй стандартные команды Redis-клиента: r.set(key, value), r.get(key) и r.expire(key, seconds).", "tests": "import ast as _ast\nassert \"acquire_lock\" in globals() and callable(acquire_lock), \"Функция acquire_lock() должна быть определена\"\n_fn_nodes_acquire_lock = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"acquire_lock\"]\nassert _fn_nodes_acquire_lock and not (len(_fn_nodes_acquire_lock[0].body) == 1 and isinstance(_fn_nodes_acquire_lock[0].body[0], _ast.Pass)), \"Реализуйте тело функции acquire_lock() (сейчас там только pass)\"\nassert \"release_lock\" in globals() and callable(release_lock), \"Функция release_lock() должна быть определена\"\n_fn_nodes_release_lock = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"release_lock\"]\nassert _fn_nodes_release_lock and not (len(_fn_nodes_release_lock[0].body) == 1 and isinstance(_fn_nodes_release_lock[0].body[0], _ast.Pass)), \"Реализуйте тело функции release_lock() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Реализуйте распределённую блокировку через Redis (Redlock/SET NX EX)\nimport uuid\n\ndef acquire_lock(lock_key: str, ttl_sec: int = 10):\n    token = str(uuid.uuid4())\n    acquired = r.set(lock_key, token, nx=True, ex=ttl_sec)\n    return token if acquired else None\n\ndef release_lock(lock_key: str, token: str):\n    lua_release = \"\"\"\n    if redis.call('get', KEYS[1]) == ARGV[1] then\n        return redis.call('del', KEYS[1])\n    else\n        return 0\n    end\n    \"\"\"\n    r.eval(lua_release, 1, lock_key, token)"}, {"id": 202, "title": "Напишите паттерн State для жизненного цикла заказа", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите паттерн State для жизненного цикла заказа.</p>", "initialCode": "class OrderState(ABC):\n\n    @abstractmethod\n    def pay(self, order):\n        pass\n\n    @abstractmethod\n    def ship(self, order):\n        pass\nclass PendingState(OrderState):\n\n    def pay(self, order):\n        pass\n\n    def ship(self, order):\n        pass\nclass PaidState(OrderState):\n\n    def pay(self, order):\n        pass\n\n    def ship(self, order):\n        pass\nclass ShippedState(OrderState):\n\n    def pay(self, order):\n        pass\n\n    def ship(self, order):\n        pass", "solution": "# Напишите паттерн State для жизненного цикла заказа\nclass OrderState(ABC):\n    @abstractmethod\n    def pay(self, order): pass\n    @abstractmethod\n    def ship(self, 
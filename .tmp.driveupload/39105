ationService\" in globals() and isinstance(NotificationService, type), \"Класс NotificationService должен быть определён\"\n_cl_def_NotificationService = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"NotificationService\"]\nassert _cl_def_NotificationService and not (len(_cl_def_NotificationService[0].body) == 1 and isinstance(_cl_def_NotificationService[0].body[0], _ast.Pass)), \"Реализуйте тело класса NotificationService (сейчас там только pass)\"\nassert hasattr(NotificationService, \"__init__\"), \"В классе NotificationService должен быть метод/свойство __init__\"\n_cl_nodes_NotificationService___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"NotificationService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_NotificationService___init__ and not (len(_cl_nodes_NotificationService___init__[0].body) == 1 and isinstance(_cl_nodes_NotificationService___init__[0].body[0], _ast.Pass)), \"Реализуйте метод NotificationService.__init__()\"\nassert hasattr(NotificationService, \"notify_all\"), \"В классе NotificationService должен быть метод/свойство notify_all\"\n_cl_nodes_NotificationService_notify_all = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"NotificationService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"notify_all\"]\nassert _cl_nodes_NotificationService_notify_all and not (len(_cl_nodes_NotificationService_notify_all[0].body) == 1 and isinstance(_cl_nodes_NotificationService_notify_all[0].body[0], _ast.Pass)), \"Реализуйте метод NotificationService.notify_all()\"", "code": "# Постройте сервис отправки уведомлений по принципу OCP\nfrom abc import ABC, abstractmethod\n\nclass NotificationSender(ABC):\n    @abstractmethod\n    def send(self, recipient: str, message: str):\n        pass\n\nclass EmailSender(NotificationSender):\n    def send(self, recipient: str, message: str):\n        print(f\"Email to {recipient}: {message}\")\n\nclass TelegramSender(NotificationSender):\n    def send(self, recipient: str, message: str):\n        print(f\"Telegram to {recipient}: {message}\")\n\nclass NotificationService:\n    def __init__(self, senders: list[NotificationSender]):\n        self.senders = senders\n\n    def notify_all(self, recipient: str, msg: str):\n        for s in self.senders:\n            s.send(recipient, msg)"}, {"id": 148, "title": "Напишите хэширование паролей через bcrypt с солью", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите хэширование паролей через bcrypt с солью.</p>", "initialCode": "import bcrypt\ndef hash_password(password: str) -> str:\n    pass\ndef verify_password(password: str, hashed: str) -> bool:\n    pass", "solution": "# Напишите хэширование паролей через bcrypt с солью\nimport bcrypt\n\ndef hash_password(password: str) -> str:\n    salt = bcrypt.gensalt(rounds=12)\n    hashed = bcrypt.hashpw(password.encode('utf-8'), salt)\n    return hashed.decode('utf-8')\n\ndef verify_password(password: str, hashed: str) -> bool:\n    return bcrypt.checkpw(password.encode('utf-8'), hashed.encode('utf-8'))\n\nh = hash_password(\"MyStr0ngPass!\")\nprint(\"Bcrypt hash:\", h[:29] + \"...\")\nassert verify_password(\"MyStr0ngPass!\", h) is True\nassert verify_password(\"WrongPass\", h) is False\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"hash_password\" in globals() and callable(hash_password), \"Функция hash_password() должна быть определена\"\n_fn_nodes_hash_password = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"hash_password\"]\nassert _fn_nodes_hash_password and not (len(_fn_nodes_hash_password[0].body) == 1 and isinstance(_fn_nodes_hash_password[0].body[0], _ast.Pass)), \"Реализуйте тело функции hash_password() (сейчас там только pass)\"\nassert \"verify_password\" in globals() and callable(verify_password), \"Функция verify_password() должна быть определена\"\n_fn_nodes_verify_password = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"verify_password\"]\nassert _fn_nodes_verify_password and not (len(_fn_nodes_verify_password[0].body) == 1 and isinstance(_fn_nodes_verify_password[0].body[0], _ast.Pass)), \"Реализуйте тело функции verify_password() (сейчас там только pass)\"\nh = hash_password(\"MyStr0ngPass!\")\nprint(\"Bcrypt hash:\", h[:29] + \"...\")\nassert verify_password(\"MyStr0ngPass!\", h) is True\nassert verify_password(\"WrongPass\", h) is False\nassert \"h\" in globals(), \"Переменная h должна быть вычислена\"", "code": "# Напишите хэширование паролей через bcrypt с солью\nimport bcrypt\n\ndef hash_password(password: str) -> str:\n    salt = bcrypt.gensalt(rounds=12)\n    hashed = bcrypt.hashpw(password.encode('utf-8'), salt)\n    return hashed.decode('utf-8')\n\ndef verify_password(password: str, hashed: str) -> bool:\n    return bcrypt.checkpw(password.encode('utf-8'), hashed.encode('utf-8'))\n\nh = hash_password(\"MyStr0ngPass!\")\nprint(\"Bcrypt hash:\", h[:29] + \"...\")\nassert verify_password(\"MyStr0ngPass!\", h) is True\nassert verify_password(\"WrongPass\", h) is False\n"}, {"id": 149, "title": "Реализуйте оптимистическую блокировку по номеру версии", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте оптимистическую блокировку по номеру версии.</p>", "initialCode": "def update_product_stock(conn, product_id: int, qty: int):\n    pass", "solution": "# Реализуйте оптимистическую блокировку по номеру версии\ndef update_product_stock(conn, product_id: int, qty: int):\n    with conn.cursor() as cur:\n        cur.execute(\"SELECT stock, version FROM products WHERE id = %s\", (product_id,))\n        stock, version = cur.fetchone()\n        if stock < qty:\n            raise ValueError(\"Недостаточно товара\")\n        cur.execute(\n            \"UPDATE products SET stock = stock - %s, version = version + 1 WHERE id = %s AND version = %s\",\n            (qty, product_id, version)\n        )\n        if cur.rowcount == 0:\n            raise Exception(\"Конфликт параллельного изменения! Повторите попытку.\")", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"update_product_stock\" in globals() and callable(update_product_stock), \"Функция update_product_stock() должна быть определена\"\n_fn_nodes_update_product_stock = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"update_product_stock\"]\nassert _fn_nodes_update_product_stock and not (len(_fn_nodes_update_product_stock[0].body) == 1 and isinstance(_fn_nodes_update_product_stock[0].body[0], _ast.Pass)), \"Реализуйте тело функции update_product_stock() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Реализуйте оптимистическую блокировку по номеру версии\ndef update_product_stock(conn, product_id: int, qty: int):\n    with conn.cursor() as cur:\n        cur.execute(\"SELECT stock, version FROM products WHERE id = %s\", (product_id,))\n        stock, version = cur.fetchone()\n        if stock < qty:\n            raise ValueError(\"Недостаточно товара\")\n        cur.execute(\n            \"UPDATE products SET stock = stock - %s, version = version + 1 WHERE id = %s AND version = %s\",\n            (qty, product_id, version)\n        )\n        if cur.rowcount == 0:\n            raise Exception(\"Конфликт параллельного изменения! Повторите попытку.\")"}, {"id": 150, "title": "Найдите максимальную сумму подмассива размера K (окно)", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Найдите максимальную сумму подмассива размера K (окно).</p>", "initialCode": "def max_sub_array_of_size_k(k: int, arr: list) -> int:\n    pass", "solution": "# Найдите максимальную сумму подмассива размера K (окно)\ndef max_sub_array_of_size_k(k: int, arr: list) -> int:\n    if len(arr) < k: return 0\n    window_sum = sum(arr[:k])\n    max_sum = window_sum\n    for i in range(k, len(arr)):\n        window_sum += arr[i] - arr[i - k]\n        max_sum = max(max_sum, window_sum)\n    return max_sum", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"max_sub_array_of_size_k\" in globals() and callable(max_sub_array_of_size_k), \"Функция max_sub_array_of_size_k() должна быть определена\"\n_fn_nodes_max_sub_array_of_size_k = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"max_sub_array_of_size_k\"]\nassert _fn_nodes_max_sub_array_of_size_k and not (len(_fn_nodes_max_sub_array_of_size_k[0].body) == 1 and isinstance(_fn_nodes_max_sub_array_of_size_k[0].body[0], _ast.Pass)), \"Реализуйте тело функции max_sub_array_of_size_k() (сейчас там только pass)\"", "code": "# Найдите максимальную сумму подмассива размера K (окно)\ndef max_sub_array_of_size_k(k: int, arr: list) -> int:\n    if len(arr) < k: return 0\n    window_sum = sum(arr[:k])\n    max_sum = window_sum\n    for i in range(k, len(arr)):\n        window_sum += arr[i] - arr[i - k]\n        max_sum = max(max_sum, window_sum)\n    return max_sum"}, {"id": 151, "title": "Постройте множественное наследование и вызов super() по MRO", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте множественное наследование и вызов super() по MRO.</p>", "initialCode": "class Base:\n\n    def ping(self):\n        pass\nclass MixinA(Base):\n\n    def ping(self):\n        pass\nclass MixinB(Base):\n\n    def ping(self):\n        pass\nclass Service(MixinA, MixinB):\n\n    def ping(self):\n        pass", "solution": "# Постройте множественное наследование и вызов super() по MRO\nclass Base:\n    def ping(self):\n        print(\"Base.ping\")\n\nclass MixinA(Base):\n    def ping(self):\n        print(\"MixinA.ping\")\n        super().ping()\n\nclass MixinB(Base):\n    def ping(self):\n        print(\"MixinB.ping\")\n        super().ping()\n\nclass Service(MixinA, MixinB):\n    def ping(self):\n        print(\"Service.ping\")\n        super().ping()\n\n# Service -> MixinA -> MixinB -> Base -> object", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Base\" in globals() and isinstance(Base, type), \"Класс Base должен быть определён\"\n_cl_def_Base = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Base\"]\nassert _cl_def_Base and not (len(_cl_def_Base[0].body) == 1 and isinstance(_cl_def_Base[0].body[0], _ast.Pass)), \"Реализуйте тело класса Base (сейчас там только pass)\"\nassert hasattr(Base, \"ping\"), \"В классе Base должен быть метод/свойство ping\"\n_cl_nodes_Base_ping = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Base\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"ping\"]\n
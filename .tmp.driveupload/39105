and not (len(_cl_nodes_Report___init__[0].body) == 1 and isinstance(_cl_nodes_Report___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Report.__init__()\"\nassert hasattr(Report, \"total\"), \"В классе Report должен быть метод/свойство total\"\n_cl_nodes_Report_total = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Report\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"total\"]\nassert _cl_nodes_Report_total and not (len(_cl_nodes_Report_total[0].body) == 1 and isinstance(_cl_nodes_Report_total[0].body[0], _ast.Pass)), \"Реализуйте метод Report.total()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nr = Report([1, 2, 3])\nprint(r.total)\nprint(r.total)\nassert \"r\" in globals(), \"Переменная r должна быть вычислена\"", "code": "# Напишите дескриптор без данных (non-data descriptor) для ленивого вычисления\nclass LazyProperty:\n    \"\"\"Non-data descriptor: только __get__.\n    Вычисляет значение один раз и кладёт его в __dict__ экземпляра —\n    при следующем обращении Python найдёт значение в __dict__ раньше,\n    чем дойдёт до дескриптора класса (т.к. это НЕ data-дескриптор).\"\"\"\n\n    def __init__(self, func):\n        self.func = func\n        self.name = func.__name__\n\n    def __get__(self, obj, owner):\n        if obj is None:\n            return self\n        value = self.func(obj)\n        obj.__dict__[self.name] = value\n        return value\n\n\nclass Report:\n    def __init__(self, rows):\n        self.rows = rows\n\n    @LazyProperty\n    def total(self):\n        print(\"Считаю сумму...\")\n        return sum(self.rows)\n\n\nr = Report([1, 2, 3])\nprint(r.total)  # \"Считаю сумму...\" -> 6\nprint(r.total)  # сразу 6, без пересчёта"}, {"id": 236, "title": "Опишите структурный протокол Comparable через typing.Protocol", "level": 3, "tier": "🐢 Уровень 3", "topic": 
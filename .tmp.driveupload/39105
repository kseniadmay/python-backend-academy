ame == \"charge\"]\nassert _cl_nodes_PayPalGateway_charge and not (len(_cl_nodes_PayPalGateway_charge[0].body) == 1 and isinstance(_cl_nodes_PayPalGateway_charge[0].body[0], _ast.Pass)), \"Реализуйте метод PayPalGateway.charge()\"", "code": "# Спроектируйте платёжный шлюз по принципам SRP и LSP\nfrom abc import ABC, abstractmethod\n\nclass IPaymentGateway(ABC):\n    @abstractmethod\n    def charge(self, amount: float, currency: str) -> str:\n        pass\n\nclass StripeGateway(IPaymentGateway):\n    def charge(self, amount: float, currency: str) -> str:\n        return f\"stripe_tx_{int(amount)}\"\n\nclass PayPalGateway(IPaymentGateway):\n    def charge(self, amount: float, currency: str) -> str:\n        return f\"paypal_tx_{int(amount)}\""}, {"id": 181, "title": "Напишите кастомный дескриптор типа для валидации полей", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите кастомный дескриптор типа для валидации полей.</p>", "initialCode": "class TypedField:\n\n    def __init__(self, expected_type):\n        pass\n\n    def __set_name__(self, owner, name):\n        pass\n\n    def __get__(self, instance, owner):\n        pass\n\n    def __set__(self, instance, value):\n        pass", "solution": "# Напишите кастомный дескриптор типа для валидации полей\nclass TypedField:\n    def __init__(self, expected_type):\n        self.expected_type = expected_type\n        self.name = None\n\n    def __set_name__(self, owner, name):\n        self.name = f\"_{name}\"\n\n    def __get__(self, instance, owner):\n        if instance is None:\n            return self\n        return getattr(instance, self.name, None)\n\n    def __set__(self, instance, value):\n        if not isinstance(value, self.expected_type):\n            raise TypeError(f\"{self.name} должно быть типа {self.expected_type}\")\n        setattr(instance, self.name, value)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"TypedField\" in globals() and isinstance(TypedField, type), \"Класс TypedField должен быть определён\"\n_cl_def_TypedField = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TypedField\"]\nassert _cl_def_TypedField and not (len(_cl_def_TypedField[0].body) == 1 and isinstance(_cl_def_TypedField[0].body[0], _ast.Pass)), \"Реализуйте тело класса TypedField (сейчас там только pass)\"\nassert hasattr(TypedField, \"__init__\"), \"В классе TypedField должен быть метод/свойство __init__\"\n_cl_nodes_TypedField___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TypedField\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_TypedField___init__ and not (len(_cl_nodes_TypedField___init__[0].body) == 1 and isinstance(_cl_nodes_TypedField___init__[0].body[0], _ast.Pass)), \"Реализуйте метод TypedField.__init__()\"\nassert hasattr(TypedField, \"__set_name__\"), \"В классе TypedField должен быть метод/свойство __set_name__\"\n_cl_nodes_TypedField___set_name__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TypedField\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__set_name__\"]\nassert _cl_nodes_TypedField___set_name__ and not (len(_cl_nodes_TypedField___set_name__[0].body) == 1 and isinstance(_cl_nodes_TypedField___set_name__[0].body[0], _ast.Pass)), \"Реализуйте метод TypedField.__set_name__()\"\nassert hasattr(TypedField, \"__get__\"), \"В классе TypedField должен быть метод/свойство __get__\"\n_cl_nodes_TypedField___get__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TypedField\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__get__\"]\nassert _cl_nodes_TypedField___get__ and not (len(_cl_nodes_TypedField___get__[0].body) == 1 and isinstance(_cl_nodes_TypedField___get__[0].body[0], _ast.Pass)), \"Реализуйте метод TypedField.__get__()\"\nassert hasattr(TypedField, \"__set__\"), \"В классе TypedField должен быть метод/свойство __set__\"\n_cl_nodes_TypedField___set__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"TypedField\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__set__\"]\nassert _cl_nodes_TypedField___set__ and not (len(_cl_nodes_TypedField___set__[0].body) == 1 and isinstance(_cl_nodes_TypedField___set__[0].body[0], _ast.Pass)), \"Реализуйте метод TypedField.__set__()\"", "code": "# Напишите кастомный дескриптор типа для валидации полей\nclass TypedField:\n    def __init__(self, expected_type):\n        self.expected_type = expected_type\n        self.name = None\n\n    def __set_name__(self, owner, name):\n        self.name = f\"_{name}\"\n\n    def __get__(self, instance, owner):\n        if instance is None:\n            return self\n        return getattr(instance, self.name, None)\n\n    def __set__(self, instance, value):\n        if not isinstance(value, self.expected_type):\n            raise TypeError(f\"{self.name} должно быть типа {self.expected_type}\")\n        setattr(instance, self.name, value)"}, {"id": 182, "title": "Реализуйте монотонный стек для поиска следующего большего элемента", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте монотонный стек для поиска следующего большего элемента.</p>", "initialCode": "def next_greater_elements(nums: list) -> list:\n    pass", "solution": "# Реализуйте монотонный стек для поиска следующего большего элемента\ndef next_greater_elements(nums: list) -> list:\n    res = [-1] * len(nums)\n    stack = []  # индексы элементов\n    for i, num in enumerate(nums):\n        while stack and nums[stack[-1]] < num:\n            idx = stack.pop()\n            res[idx] = num\n        stack.append(i)\n    return res", "hint": "Шаг 1: Храни элементы во внутреннем списке self._items. Шаг 2: push добавляет через append(), pop удаляет с конца через pop() с проверкой на пустоту, peek возвращает последний элемент.", "tests": "import ast as _ast\nassert \"next_greater_elements\" in globals() and callable(next_greater_elements), \"Функция next_greater_elements() должна быть определена\"\n_fn_nodes_next_greater_elements = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"next_greater_elements\"]\nassert _fn_nodes_next_greater_elements and not (len(_fn_nodes_next_greater_elements[0].body) == 1 and isinstance(_fn_nodes_next_greater_elements[0].body[0], _ast.Pass)), \"Реализуйте тело функции next_greater_elements() (сейчас там только pass)\"", "code": "# Реализуйте монотонный стек для поиска следующего большего элемента\ndef next_greater_elements(nums: list) -> list:\n    res = [-1] * len(nums)\n    stack = []  # индексы элементов\n    for i, num in enumerate(nums):\n        while stack and nums[stack[-1]] < num:\n            idx = stack.pop()\n            res[idx] = num\n        stack.append(i)\n    return res"}, {"id": 183, "title": "Реализуйте очередь транзакционных команд с историей", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте очередь транзакционных команд с историей.</p>", "initialCode": "class CommandHistory:\n\n    def __init__(self):\n        pass\n\n    def execute_command(self, cmd: Command):\n        pass\n\n    def rollback_all(self):\n        pass", "solution": "# Реализуйте очередь транзакционных команд с историей\nclass CommandHistory:\n    def __init__(self):\n        self.history = []\n\n    def execute_command(self, cmd: Command):\n        cmd.execute()\n        self.history.append(cmd)\n\n    def rollback_all(self):\n        while self.history:\n            cmd = self.history.pop()\n            cmd.undo()", "hint": "Шаг 1: Используй список или collections.deque. Шаг 2: Добавляй в конец (append), извлекай из начала (popleft / pop(0)) с валидацией непустого состояния.", "tests": "import ast as _ast\nassert \"CommandHistory\" in globals() and isinstance(CommandHistory, type), \"Класс CommandHistory должен быть определён\"\n_cl_def_CommandHistory = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CommandHistory\"]\nassert _cl_def_CommandHistory and not (len(_cl_def_CommandHistory[0].body) == 1 and isinstance(_cl_def_CommandHistory[0].body[0], _ast.Pass)), \"Реализуйте тело класса CommandHistory (сейчас там только pass)\"\nassert hasattr(CommandHistory, \"__init__\"), \"В классе CommandHistory должен быть метод/свойство __init__\"\n_cl_nodes_CommandHistory___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CommandHistory\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_CommandHistory___init__ and not (len(_cl_nodes_CommandHistory___init__[0].body) == 1 and isinstance(_cl_nodes_CommandHistory___init__[0].body[0], _ast.Pass)), \"Реализуйте метод CommandHistory.__init__()\"\nassert hasattr(CommandHistory, \"execute_command\"), \"В классе CommandHistory должен быть метод/свойство execute_command\"\n_cl_nodes_CommandHistory_execute_command = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CommandHistory\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"execute_command\"]\nassert _cl_nodes_CommandHistory_execute_command and not (len(_cl_nodes_CommandHistory_execute_command[0].body) == 1 and isinstance(_cl_nodes_CommandHistory_execute_command[0].body[0], _ast.Pass)), \"Реализуйте метод CommandHistory.execute_command()\"\nassert hasattr(CommandHistory, \"rollback_all\"), \"В классе CommandHistory должен быть метод/свойство rollback_all\"\n_cl_nodes_CommandHistory_rollback_all = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CommandHistory\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"rollback_all\"]\nassert _cl_nodes_CommandHistory_rollback_all and not (len(_cl_nodes_CommandHistory_rollback_all[0].body) == 1 and isinstance(_cl_nodes_CommandHistory_rollback_all[0].body[0], _ast.Pass)), \"Реализуйте метод CommandHistory.rollback_all()\"", "code": "# Реализуйте очередь транзакционных команд с историей\nclass CommandHistory:\n    def __init__(self):\n        self.history = []\n\n    def execute_command(self, cmd: Command):\n        cmd.execute()\n        self.history.append(cmd)\n\n    def rollback_all(self):\n        while self.history:\n            cmd = self.history.pop()\n            cmd.undo()"}, {"id": 184, "title": "Постройте эмуляцию OAuth2 Password Bearer flow", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте эмуляцию OAuth2 Password Bearer flow.</p>", "initialCode": "from fastapi import FastAPI, Depends, HTTPException, status\nfrom fastapi.security import OAuth2PasswordBearer, OAuth2PasswordRequestForm\nfrom fastapi.testclient import TestClient\napp = FastAPI()\noauth2_scheme = OAuth2PasswordBearer(tokenUrl='token')\n@app.post('/token')\ndef login(form_data: OAuth2PasswordRequestForm=Depends()):\n    pass", "solution": "# Постройте эмуляцию OAuth2 Password Bearer flow\nfrom fastapi import FastAPI, Depends, HTTPException, status\nfrom fastapi.security import OAuth2PasswordBearer, OAuth2PasswordRequestForm\nfrom fastapi.testclient import TestClient\n\napp = FastAPI()\noauth2_scheme = OAuth2PasswordBearer(tokenUrl=\"token\")\n\n@app.post(\"/token\")\ndef login(form_data: OAuth2PasswordRequestForm = Depends()):\n    if form_data.username == \"admin\" and form_data.password == \"secret\":\n        return {\"access_token\": \"mock-jwt-token\", \"token_type\": \"bearer\"}\n    raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Invalid credentials\")\n\nclient = TestClient(app)\nr_ok = client.post(\"/token\", data={\"username\": \"admin\", \"password\": \"secret\"})\nr_err = client.post(\"/token\", data={\"username\": \"admin\", \"password\": \"wrong\"})\nprint(\"Успешный вход:\", r_ok.json(), \"| Ошибка:\", r_err.status_code)\nassert r_ok.status_code == 200 and r_ok.json()[\"access_token\"] == \"mock-jwt-token\"\nassert r_err.status_code == 401\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"login\" in globals() and callable(login), \"Функция login() должна быть определена\"\n_fn_nodes_login = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"login\"]\nassert _fn_nodes_login and not (len(_fn_nodes_login[0].body) == 1 and isinstance(_fn_nodes_login[0].body[0], _ast.Pass)), \"Реализуйте тело функции login() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\nclient = TestClient(app)\nr_ok = client.post(\"/token\", data={\"username\": \"admin\", \"password\": \"secret\"})\nr_err = client.post(\"/token\", data={\"username\": \"admin\", \"password\": \"wrong\"})\nprint(\"Успешный вход:\", r_ok.json(), \"| Ошибка:\", r_err.status_code)\nassert r_ok.status_code == 200 and r_ok.json()[\"access_token\"] == \"mock-jwt-token\"\nassert r_err.status_code == 401\nassert \"client\" in globals(), \"Переменная client должна быть вычислена\"\nassert \"r_ok\" in globals(), \"Переменная r_ok должна быть вычислена\"\nassert \"r_err\" in globals(), \"Переменная r_err должна быть вычислена\"", "code": "# Постройте эмуляцию OAuth2 Password Bearer flow\nfrom fastapi import FastAPI, Depends, HTTPException, status\nfrom fastapi.security import OAuth2PasswordBearer, OAuth2PasswordRequestForm\nfrom fastapi.testclient import TestClient\n\napp = FastAPI()\noauth2_scheme = OAuth2PasswordBearer(tokenUrl=\"token\")\n\n@app.post(\"/token\")\ndef login(form_data: OAuth2PasswordRequestForm = Depends()):\n    if form_data.username == \"admin\" and form_data.password == \"secret\":\n        return {\"access_token\": \"mock-jwt-token\", \"token_type\": \"bearer\"}\n    raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Invalid credentials\")\n\nclient = TestClient(app)\nr_ok = client.post(\"/token\", data={\"username\": \"admin\", \"password\": \"secret\"})\nr_err = client.post(\"/token\", data={\"username\": \"admin\", \"password\": \"wrong\"})\nprint(\"Успешный вход:\", r_ok.json(), \"| Ошибка:\", r_err.status_code)\nassert r_ok.status_code == 200 and r_ok.json()[\"access_token\"] == \"mock-jwt-token\"\nassert r_err.status_code == 401\n"}, {"id": 185, "title": "Постройте структуру для поиска медианы в потоке чисел", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте структуру для поиска медианы в потоке чисел.</p>", "initialCode": "import heapq\nclass MedianFinder:\n\n    def __init__(self):\n        pass\n\n    def add_num(self, num: int):\n        pass\n\n    def find_median(self) -> float:\n        pass", "solution": "# Постройте структуру для поиска медианы в потоке чисел\nimport heapq\n\nclass MedianFinder:\n    def __init__(self):\n        self.small = []  # max-heap (инвертированные значения)\n        self.large = []  # min-heap\n\n    def add_num(self, num: int):\n        heapq.heappush(self.small, -num)\n        heapq.heappush(self.large, -heapq.heappop(self.small))\n        if len(self.large) > len(self.small):\n            heapq.heappush(self.small, -heapq.heappop(self.large))\n\n    def find_median(self) -> float:\n        if len(self.small) > len(self.large):\n            return float(-self.small[0])\n        return (-self.small[0] + self.large[0]) / 2.0", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"MedianFinder\" in globals() and isinstance(MedianFinder, type), \"Класс MedianFinder должен быть определён\"\n_cl_def_MedianFinder = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MedianFinder\"]\nassert _cl_def_MedianFinder and not (len(_cl_def_MedianFinder[0].body) == 1 and isinstance(_cl_def_MedianFinder[0].body[0], _ast.Pass)), \"Реализуйте тело класса MedianFinder (сейчас там только pass)\"\nassert hasattr(MedianFinder, \"__init__\"), \"В классе MedianFinder должен быть метод/свойство __init__\"\n_cl_nodes_MedianFinder___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MedianFinder\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_MedianFinder___init__ and not (len(_cl_nodes_MedianFinder___init__[0].body) == 1 and isinstance(_cl_nodes_MedianFinder___init__[0].body[0], _ast.Pass)), \"Реализуйте метод MedianFinder.__init__()\"\nassert hasattr(MedianFinder, \"add_num\"), \"В классе MedianFinder должен быть метод/свойство add_num\"\n_cl_nodes_MedianFinder_add_num = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MedianFinder\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"add_num\"]\nassert _cl_nodes_MedianFinder_add_num and not (len(_cl_nodes_MedianFinder_add_num[0].body) == 1 and isinstance(_cl_nodes_MedianFinder_add_num[0].body[0], _ast.Pass)), \"Реализуйте метод MedianFinder.add_num()\"\nassert hasattr(MedianFinder, \"find_median\"), \"В классе MedianFinder должен быть метод/свойство find_median\"\n_cl_nodes_MedianFinder_find_median = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"MedianFinder\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"find_median\"]\nassert _cl_nodes_MedianFinder_find_median and not (len(_cl_nodes_MedianFinder_find_median[0].body) == 1 and isinstance(_cl_nodes_MedianFinder_find_median[0].body[0], _ast.Pass)), \"Реализуйте метод MedianFinder.find_median()\"", "code": "# Постройте структуру для поиска медианы в потоке чисел\nimport heapq\n\nclass MedianFinder:\n    def __init__(self):\n        self.small = []  # max-heap (инвертированные значения)\n        self.large = []  # min-heap\n\n    def add_num(self, num: int):\n        heapq.heappush(self.small, -num)\n        heapq.heappush(self.large, -heapq.heappop(self.small))\n        if len(self.large) > len(self.small):\n            heapq.heappush(self.small, -heapq.heappop(self.large))\n\n    def find_median(self) -> float:\n        if len(self.small) > len(self.large):\n            return float(-self.small[0])\n        return (-self.small[0] + self.large[0]) / 2.0"}, {"id": 186, "title": "Напишите парсер raw HTTP-запроса из байтового потока", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите парсер raw HTTP-запроса из байтового потока.</p>", "initialCode": "def parse_raw_http(raw_bytes: bytes) -> dict:\n    pass", "solution": "# Напишите парсер raw HTTP-запроса из байтового потока\ndef parse_raw_http(raw_bytes: bytes) -> dict:\n    headers_part, _, body = raw_bytes.partition(b\"\\r\\n\\r\\n\")\n    lines = headers_part.decode(\"latin1\").split(\"\\r\\n\")\n    method, path, version = lines[0].split(\" \", 2)\n    headers = {}\n    for line in lines[1:]:\n        if \":\" in line:\n            k, v = line.split(\":\", 1)\n            headers[k.strip().lower()] = v.strip()\n    return {\"method\": method, \"path\": path, \"version\": version, \"headers\": headers, \"body\": body}\n\nraw = b'POST /api/v1/orders HTTP/1.1\\r\\nHost: api.example.com\\r\\nContent-Type: application/json\\r\\n\\r\\n{\"item\": 1}'\nparsed = parse_raw_http(raw)\nprint(parsed[\"method\"], parsed[\"path\"], parsed[\"headers\"][\"content-type\"])\nassert parsed[\"method\"] == \"POST\" and parsed[\"path\"] == \"/api/v1/orders\" and parsed[\"body\"] == b'{\"item\": 1}'\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"parse_raw_http\" in globals() and callable(parse_raw_http), \"Функция parse_raw_http() должна быть определена\"\n_fn_nodes_parse_raw_http = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"parse_raw_http\"]\nassert _fn_nodes_parse_raw_http and not (len(_fn_nodes_parse_raw_http[0].body) == 1 and isinstance(_fn_nodes_parse_raw_http[0].body[0], _ast.Pass)), \"Реализуйте тело функции parse_raw_http() (сейчас там только pass)\"\nraw = b'POST /api/v1/orders HTTP/1.1\\r\\nHost: api.example.com\\r\\nContent-Type: application/json\\r\\n\\r\\n{\"item\": 1}'\nparsed = parse_raw_http(raw)\nprint(parsed[\"method\"], parsed[\"path\"], parsed[\"headers\"][\"content-type\"])\nassert parsed[\"method\"] == \"POST\" and parsed[\"path\"] == \"/api/v1/orders\" and parsed[\"body\"] == b'{\"item\": 1}'\nassert \"raw\" in globals(), \"Переменная raw должна быть вычислена\"\nassert \"parsed\" in globals(), \"Переменная parsed должна быть вычислена\"", "code": "# Напишите парсер raw HTTP-запроса из байтового потока\ndef parse_raw_http(raw_bytes: bytes) -> dict:\n    headers_part, _, body = raw_bytes.partition(b\"\\r\\n\\r\\n\")\n    lines = headers_part.decode(\"latin1\").split(\"\\r\\n\")\n    method, path, version = lines[0].split(\" \", 2)\n    headers = {}\n    for line in lines[1:]:\n        if \":\" in line:\n            k, v = line.split(\":\", 1)\n            headers[k.strip().lower()] = v.strip()\n    return {\"method\": method, \"path\": path, \"version\": version, \"headers\": headers, \"body\": body}\n\nraw = b'POST /api/v1/orders HTTP/1.1\\r\\nHost: api.example.com\\r\\nContent-Type: application/json\\r\\n\\r\\n{\"item\": 1}'\nparsed = parse_raw_http(raw)\nprint(parsed[\"method\"], parsed[\"path\"], parsed[\"headers\"][\"content-type\"])\nassert parsed[\"method\"] == \"POST\" and parsed[\"path\"] == \"/api/v1/orders\" and parsed[\"body\"] == b'{\"item\": 1}'\n"}, {"id": 187, "title": "Оптимизируйте медленный запрос переводом в Index Scan", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Оптимизируйте медленный запрос переводом в Index Scan.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Оптимизируйте медленный запрос переводом в Index Scan\nsql = \"\"\"\n-- Запрос с функцией в WHERE приводит к Seq Scan: WHERE LOWER(email) = 'x'\n-- Решение: Индекс по выражению (Functional Index)\nCREATE INDEX idx_users_lower_email ON users (LOWER(email));\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"WHERE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'WHERE'\"\nassert isinstance(sql, str) and \"Seq\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'Seq'\"\nassert isinstance(sql, str) and \"Scan\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'Scan'\"", "code": "# Оптимизируйте медленный запрос переводом в Index Scan\nsql = \"\"\"\n-- Запрос с функцией в WHERE приводит к Seq Scan: WHERE LOWER(email) = 'x'\n-- Решение: Индекс по выражению (Functional Index)\nCREATE INDEX idx_users_lower_email ON users (LOWER(email));\n\"\"\""}, {"id": 188, "title": "Реализуйте слияние двух отсортированных связных списков", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте слияние двух отсортированных связных списков.</p>", "initialCode": "def merge_two_lists(l1: ListNode, l2: ListNode) -> ListNode:\n    pass", "solution": "# Реализуйте слияние двух отсортированных связных списков\ndef merge_two_lists(l1: ListNode, l2: ListNode) -> ListNode:\n    dummy = curr = ListNode(0)\n    while l1 and l2:\n        if l1.val <= l2.val:\n            curr.next = l1\n            l1 = l1.next\n        else:\n            curr.next = l2\n            l2 = l2.next\n        curr = curr.next\n    curr.next = l1 or l2\n    return dummy.next", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"merge_two_lists\" in globals() and callable(merge_two_lists), \"Функция merge_two_lists() должна быть определена\"\n_fn_nodes_merge_two_lists = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"merge_two_lists\"]\nassert _fn_nodes_merge_two_lists and not (len(_fn_nodes_merge_two_lists[0].body) == 1 and isinstance(_fn_nodes_merge_two_lists[0].body[0], _ast.Pass)), \"Реализуйте тело функции merge_two_lists() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()\n_l1 = ListNode(1, ListNode(3)); _l2 = ListNode(2, ListNode(4)); _m = merge_two_lists(_l1, _l2); assert _m.val == 1 and _m.next.val == 2", "code": "# Реализуйте слияние двух отсортированных связных списков\ndef merge_two_lists(l1: ListNode, l2: ListNode) -> ListNode:\n    dummy = curr = ListNode(0)\n    while l1 and l2:\n        if l1.val <= l2.val:\n            curr.next = l1\n            l1 = l1.next\n        else:\n            curr.next = l2\n            l2 = l2.next\n        curr = curr.next\n    curr.next = l1 or l2\n    return dummy.next"}, {"id": 189, "title": "Реализуйте конвейер генераторов данных", "level": 3, "tier": "🐢 Уровень 3", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте конвейер генераторов данных.</p>", "initialCode": "def read_numbers(n):\n    pass\ndef square_numbers(nums):\n    pass\ndef filter_evens(nums):\n    pass", "solution": "# Реализуйте конвейер генераторов данных\ndef read_numbers(n):\n    for i in range(1, n + 1):\n        yield i\n\ndef square_numbers(nums):\n    for x in nums:\n        yield x ** 2\n\ndef filter_evens(nums):\n    for x in nums:\n        if x % 2 == 0:\n            yield x\n\npipeline = filter_evens(square_numbers(read_numbers(10)))\nprint(list(pipeline))  # [4, 16, 36, 64, 100]", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🐢 Уровень 3). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"read_numbers\" in globals() and callable(read_numbers), \"Функция read_numbers() должна быть определена\"\n_fn_nodes_read_numbers = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"read_numbers\"]\nassert _fn_nodes_read_numbers and not (len(_fn_nodes_read_numbers[0].body) == 1 and isinstance(_fn_nodes_read_numbers[0].body[0], _ast.Pass)), \"Реализуйте тело функции read_numbers() (сейчас там только pass)\"\nassert \"square_numbers\" in globals() and callable(square_numbers), \"Функция square_numbers() должна быть определена\"\n_fn_nodes_square_numbers = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"square_numbers\"]\nassert _fn_nodes_square_numbers and not (len(_fn_nodes_square_numbers[0].body) == 1 and isinstance(_fn_nodes_square_numbers[0].body[0], _ast.Pass)), \"Реализуйте тело функции square_numbers() (сейчас там только pass)\"\nassert \"filter_evens\" in globals() and callable(filter_evens), \"Функция filter_evens() должна быть определена\"\n_fn_nodes_filter_evens = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"filter_evens\"]\nassert _fn_nodes_filter_evens and not (len(_fn_nodes_filter_evens[0].body) == 1 and isinstance(_fn_nodes_filter_evens[0].body[0], _ast.Pass)), \"Реализуйте тело функции filter_evens() (сейчас там только pass)\"\npipeline = filter_evens(square_numbers(read_numbers(10)))\nprint(list(pipeline))\nassert \"pipeline\" in globals(), \"Переменная pipeline должна быть вычислена\"", "code": "# Реализуйте конвейер генераторов данных\ndef read_numbers(n):\n    for i in range(1, n + 1):\n        yield i\n\ndef square_numbers(nums):\n    for x in nums:\n        yield x ** 2\n\ndef filter_evens(nums):\n    for x in nums:\n        if x % 2 == 0:\n            yield x\n\npipeline = filter_evens(square_numbers(read_numbers(10)))\nprint(list(pipeline))  # [4, 16, 36, 64, 100]"}, {"id": 190, "title": "Спроектируйте плагинную систему с динамической загрузкой", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Спроектируйте плагинную систему с динамической загрузкой.</p>", "initialCode": "import importlib\nclass PluginLoader:\n\n    @staticmethod\n    def load_plugin(module_path: str, class_name: str):\n        pass", "solution": "# Спроектируйте плагинную систему с динамической загрузкой\nimport importlib\n\nclass PluginLoader:\n    @staticmethod\n    def load_plugin(module_path: str, class_name: str):\n        module = importlib.import_module(module_path)\n        cls = getattr(module, class_name)\n        return cls()", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"PluginLoader\" in globals() and isinstance(PluginLoader, type), \"Класс PluginLoader должен быть определён\"\n_cl_def_PluginLoader = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PluginLoader\"]\nassert _cl_def_PluginLoader and not (len(_cl_def_PluginLoader[0].body) == 1 and isinstance(_cl_def_PluginLoader[0].body[0], _ast.Pass)), \"Реализуйте тело класса PluginLoader (сейчас там только pass)\"\nassert hasattr(PluginLoader, \"load_plugin\"), \"В классе PluginLoader должен быть метод/свойство load_plugin\"\n_cl_nodes_PluginLoader_load_plugin = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"PluginLoader\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"load_plugin\"]\nassert _cl_nodes_PluginLoader_load_plugin and not (len(_cl_nodes_PluginLoader_load_plugin[0].body) == 1 and isinstance(_cl_nodes_PluginLoader_load_plugin[0].body[0], _ast.Pass)), \"Реализуйте метод PluginLoader.load_plugin()\"", "code": "# Спроектируйте плагинную систему с динамической загрузкой\nimport importlib\n\nclass PluginLoader:\n    @staticmethod\n    def load_plugin(module_path: str, class_name: str):\n        module = importlib.import_module(module_path)\n        cls = getattr(module, class_name)\n        return cls()"}, {"id": 191, "title": "Оптимизация связного списка под L1-кэш", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Оптимизация связного списка под L1-кэш.</p>", "initialCode": "class UnrolledListNode:\n\n    def __init__(self, capacity=16):\n        pass\n\n    def is_full(self):\n        pass", "solution": "# Оптимизация связного списка под L1-кэш (Unrolled Linked List)\nclass UnrolledListNode:\n    def __init__(self, capacity=16):\n        self.capacity = capacity\n        self.elements = []\n        self.next = None\n\n    def is_full(self):\n        return len(self.elements) >= self.capacity\n\n# Хранение элементов блоками в непрерывных массивах минимизирует Cache Misses", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"UnrolledListNode\" in globals() and isinstance(UnrolledListNode, type), \"Класс UnrolledListNode должен быть определён\"\n_cl_def_UnrolledListNode = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UnrolledListNode\"]\nassert _cl_def_UnrolledListNode and not (len(_cl_def_UnrolledListNode[0].body) == 1 and isinstance(_cl_def_UnrolledListNode[0].body[0], _ast.Pass)), \"Реализуйте тело класса UnrolledListNode (сейчас там только pass)\"\nassert hasattr(UnrolledListNode, \"__init__\"), \"В классе UnrolledListNode должен быть метод/свойство __init__\"\n_cl_nodes_UnrolledListNode___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UnrolledListNode\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_UnrolledListNode___init__ and not (len(_cl_nodes_UnrolledListNode___init__[0].body) == 1 and isinstance(_cl_nodes_UnrolledListNode___init__[0].body[0], _ast.Pass)), \"Реализуйте метод UnrolledListNode.__init__()\"\nassert hasattr(UnrolledListNode, \"is_full\"), \"В классе UnrolledListNode должен быть метод/свойство is_full\"\n_cl_nodes_UnrolledListNode_is_full = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UnrolledListNode\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"is_full\"]\nassert _cl_nodes_UnrolledListNode_is_full and not (len(_cl_nodes_UnrolledListNode_is_full[0].body) == 1 and isinstance(_cl_nodes_UnrolledListNode_is_full[0].body[0], _ast.Pass)), \"Реализуйте метод UnrolledListNode.is_full()\"", "code": "# Оптимизация связного списка под L1-кэш (Unrolled Linked List)\nclass UnrolledListNode:\n    def __init__(self, capacity=16):\n        self.capacity = capacity\n        self.elements = []\n        self.next = None\n\n    def is_full(self):\n        return len(self.elements) >= self.capacity\n\n# Хранение элементов блоками в непрерывных массивах минимизирует Cache Misses"}, {"id": 192, "title": "Напишите workflow GitHub Actions: линтеры + тесты pytest", "level": 6, "tier": "🦁 Уровень 6", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите workflow GitHub Actions: линтеры + тесты pytest.</p>", "initialCode": "github_actions_yaml = \"\"\"\n\n\"\"\"", "solution": "# Напишите workflow GitHub Actions: линтеры + тесты pytest\ngithub_actions_yaml = \"\"\"\nname: CI Pipeline\non: [push, pull_request]\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-python@v5\n        with: { python-version: '3.12' }\n      - run: pip install ruff pytest\n      - run: ruff check .\n      - run: pytest -v\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"github_actions_yaml\" in globals() and github_actions_yaml is not None, \"Переменная g
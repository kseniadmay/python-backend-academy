print(r.serialize())\nprint(r.serialize_as_xml())\nassert \"r\" in globals(), \"Переменная r должна быть вычислена\"", "code": "# Спроектируйте класс с несколькими миксинами и разрешите конфликт методов\nclass JSONSerializerMixin:\n    def serialize(self):\n        return f'{{\"type\": \"json\", \"data\": {self.to_dict()}}}'\n\n\nclass XMLSerializerMixin:\n    def serialize(self):\n        return f\"<data>{self.to_dict()}</data>\"\n\n\nclass Report(JSONSerializerMixin, XMLSerializerMixin):\n    def __init__(self, payload):\n        self.payload = payload\n\n    def to_dict(self):\n        return self.payload\n\n    def serialize(self):\n        # явно разрешаем конфликт: базовая реализация — JSON,\n        # но оставляем доступ ко второй через явный вызов класса\n        return JSONSerializerMixin.serialize(self)\n\n    def serialize_as_xml(self):\n        return XMLSerializerMixin.serialize(self)\n\n\nr = Report({\"id\": 1})\nprint(r.serialize())          # JSON-вариант\nprint(r.serialize_as_xml())   # явно запрошенный XML-вариант"}, {"id": 251, "title": "Реализуйте паттерн Mixin для сериализации, комбинируемый с любым классом", "level": 5, "tier": "🦅 Уровень 5", "topic": "🐍 Python Core", "desc": "<p><strong>Задание:</strong> Реализуйте паттерн Mixin для сериализации, комбинируемый с любым классом.</p>", "initialCode": "import json\nclass SerializableMixin:\n\n    def to_json(self):\n        pass\n\n    @classmethod\n    def from_json(cls, data):\n        pass\nclass User(SerializableMixin):\n\n    def __init__(self, name, age):\n        pass", "solution": "# Реализуйте паттерн Mixin для сериализации, комбинируемый с любым классом\nimport json\n\n\nclass SerializableMixin:\n    \"\"\"Не хранит собственное состояние и не создаётся отдельно —\n    подмешивается к любому классу, у которого есть __dict__.\"\"\"\n\n    def to_json(self):\n        return json.dumps(self.__dict__)\n\n    @classmethod\n    def from_json(cls, data):\n        obj = cls.__new__(cls)  # создаём экземпляр в обход __init__\n        obj.__dict__.update(json.loads(data))\n        return obj\n\n\nclass User(SerializableMixin):\n    def __init__(self, name, age):\n        self.name = name\n        self.age = age\n\n\nu = User(\"Alex\", 30)\nraw = u.to_json()\nprint(raw)                    # {\"name\": \"Alex\", \"age\": 30}\n\nrestored = User.from_json(raw)\nprint(restored.name, restored.age)  # Alex 30", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"SerializableMixin\" in globals() and isinstance(SerializableMixin, type), \"Класс SerializableMixin должен быть определён\"\n_cl_def_SerializableMixin = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SerializableMixin\"]\nassert _cl_def_SerializableMixin and not (len(_cl_def_SerializableMixin[0].body) == 1 and isinstance(_cl_def_SerializableMixin[0].body[0], _ast.Pass)), \"Реализуйте тело класса SerializableMixin (сейчас там только pass)\"\nassert hasattr(SerializableMixin, \"to_json\"), \"В классе SerializableMixin должен быть метод/свойство to_json\"\n_cl_nodes_SerializableMixin_to_json = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SerializableMixin\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"to_json\"]\nassert _cl_nodes_SerializableMixin_to_json and not (len(_cl_nodes_SerializableMixin_to_json[0].body) == 1 and isinstance(_cl_nodes_SerializableMixin_to_json[0].body[0], _ast.Pass)), \"Реализуйте метод SerializableMixin.to_json()\"\nassert hasattr(SerializableMixin, \"from_json\"), \"В классе SerializableMixin должен быть метод/свойство from_json\"\n_cl_nodes_SerializableMixin_from_json = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name 
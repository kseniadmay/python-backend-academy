 tuple[str, int]):\n        pass\n\n    def recvfrom(self, bufsize: int=1024) -> tuple[bytes, tuple[str, int]]:\n        pass", "solution": "# Напишите UDP-сервер и клиент с обработкой датаграмм\nclass UDPChannel:\n    def __init__(self):\n        self.queue: list[tuple[bytes, tuple[str, int]]] = []\n    def sendto(self, data: bytes, addr: tuple[str, int]):\n        self.queue.append((data, addr))\n    def recvfrom(self, bufsize: int = 1024) -> tuple[bytes, tuple[str, int]]:\n        data, addr = self.queue.pop(0)\n        return data[:bufsize], addr\n\nchannel = UDPChannel()\nclient_addr = (\"127.0.0.1\", 54321)\nserver_addr = (\"127.0.0.1\", 9090)\n\n# Клиент отправляет датаграмму без предварительного рукопожатия\nchannel.sendto(b\"Hello UDP\", server_addr)\ndata, _ = channel.recvfrom(1024)\n# Сервер отвечает ACK\nchannel.sendto(b\"ACK:\" + data, client_addr)\nreply, addr = channel.recvfrom(1024)\nprint(f\"Ответ {reply.decode()} доставлен на {addr}\")\nassert reply == b\"ACK:Hello UDP\" and addr == client_addr\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦁 Уровень 6). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"UDPChannel\" in globals() and isinstance(UDPChannel, type), \"Класс UDPChannel должен быть определён\"\n_cl_def_UDPChannel = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UDPChannel\"]\nassert _cl_def_UDPChannel and not (len(_cl_def_UDPChannel[0].body) == 1 and isinstance(_cl_def_UDPChannel[0].body[0], _ast.Pass)), \"Реализуйте тело класса UDPChannel (сейчас там только pass)\"\nassert hasattr(UDPChannel, \"__init__\"), \"В классе UDPChannel должен быть метод/свойство __init__\"\n_cl_nodes_UDPChannel___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"UDPChannel\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.A
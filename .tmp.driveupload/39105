 = []\n    async def mock_send(event):\n        sent_events.append(event)\n\n    # 1. Запускаем lifespan.startup\n    async def recv_startup():\n        return {\"type\": \"lifespan.startup\"}\n    await asgi_app({\"type\": \"lifespan\"}, recv_startup, mock_send)\n\n    # 2. Отправляем HTTP-запрос\n    async def recv_http():\n        return {\"type\": \"http.request\"}\n    await asgi_app({\"type\": \"http\", \"path\": \"/status\"}, recv_http, mock_send)\n    body = json.loads(sent_events[-1][\"body\"].decode())\n    print(\"ASGI Ответ:\", body)\n    assert body == {\"path\": \"/status\", \"db\": True}\n\nasyncio.run(main())\n"}, {"id": 398, "title": "Агрегируйте данные для эндпоинта /dashboard параллельно через asyncio.gather", "level": 4, "tier": "🦊 Уровень 4", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Агрегируйте данные для эндпоинта /dashboard параллельно через asyncio.gather.</p>", "initialCode": "import asyncio\nasync def fetch_profile(user_id: int) -> dict:\n    pass\nasync def fetch_orders(user_id: int) -> list[dict]:\n    pass\nasync def fetch_notifications(user_id: int) -> int:\n    pass\nasync def get_dashboard(user_id: int) -> dict:\n    pass\nasync def main():\n    pass", "solution": "# Агрегируйте данные для эндпоинта /dashboard параллельно через asyncio.gather\nimport asyncio\n\nasync def fetch_profile(user_id: int) -> dict:\n    await asyncio.sleep(0.01)\n    return {\"id\": user_id, \"name\": \"Alice\"}\n\nasync def fetch_orders(user_id: int) -> list[dict]:\n    await asyncio.sleep(0.01)\n    return [{\"order_id\": 501, \"total\": 1200}]\n\nasync def fetch_notifications(user_id: int) -> int:\n    await asyncio.sleep(0.01)\n    return 3\n\nasync def get_dashboard(user_id: int) -> dict:\n    # Параллельный запуск трёх независимых I/O-задач в одном Event Loop\n    profile, orders, unread = await asyncio.gather(\n        fetch_profile(user_id),\n        fetch_orders(user_id),\n        fetch_notifications(user_id),\n    )\n    return {\"profile\": profile, \"orders\": orders, \"unread_count\": unread}\n\nasync def main():\n    data = await get_dashboard(42)\n    print(\"Dashboard:\", data)\n    assert data[\"profile\"][\"name\"] == \"Alice\" and data[\"unread_count\"] == 3\n\nasyncio.run(main())\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦊 Уровень 4). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"fetch_profile\" in globals() and callable(fetch_profile), \"Функция fetch_profile() должна быть определена\"\n_fn_nodes_fetch_profile = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"fetch_profile\"]\nassert _fn_nodes_fetch_profile and not (len(_fn_nodes_fetch_profile[0].body) == 1 and isinstance(_fn_nodes_fetch_profile[0].body[0], _ast.Pass)), \"Реализуйте тело функции fetch_profile() (сейчас там только pass)\"\nassert \"fetch_orders\" in globals() and callable(fetch_orders), \"Функция fetch_orders() должна быть определена\"\n_fn_nodes_fetch_orders = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"fetch_orders\"]\nassert _fn_nodes_fetch_orders and not (len(_fn_nodes_fetch_orders[0].body) == 1 and isinstance(_fn_nodes_fetch_orders[0].body[0], _ast.Pass)), \"Реализуйте тело функции fetch_orders() (сейчас там только pass)\"\nassert \"fetch_notifications\" in globals() and callable(fetch_notifications), \"Функция fetch_notifications() должна быть определена\"\n_fn_nodes_fetch_notifications = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"fetch_notifications\"]\nassert _fn_nodes_fetch_notifications and not (len(_fn_nodes_fetch_notifications[0].body) == 1 and isinstance(_fn_nodes_fetch_notifications[0].body[0], _ast.Pass)), \"Реализуйте тело фу
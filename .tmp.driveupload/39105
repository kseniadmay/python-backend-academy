nd isinstance(_cl_def_RegistrationService[0].body[0], _ast.Pass)), \"Реализуйте тело класса RegistrationService (сейчас там только pass)\"\nassert hasattr(RegistrationService, \"__init__\"), \"В классе RegistrationService должен быть метод/свойство __init__\"\n_cl_nodes_RegistrationService___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"RegistrationService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_RegistrationService___init__ and not (len(_cl_nodes_RegistrationService___init__[0].body) == 1 and isinstance(_cl_nodes_RegistrationService___init__[0].body[0], _ast.Pass)), \"Реализуйте метод RegistrationService.__init__()\"\nassert hasattr(RegistrationService, \"register\"), \"В классе RegistrationService должен быть метод/свойство register\"\n_cl_nodes_RegistrationService_register = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"RegistrationService\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"register\"]\nassert _cl_nodes_RegistrationService_register and not (len(_cl_nodes_RegistrationService_register[0].body) == 1 and isinstance(_cl_nodes_RegistrationService_register[0].body[0], _ast.Pass)), \"Реализуйте метод RegistrationService.register()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Напишите сервис регистрации пользователя через UoW\nclass RegistrationService:\n    def __init__(self, uow: UnitOfWork):\n        self.uow = uow\n\n    def register(self, user_data: dict):\n        with self.uow:\n            user = UserModel(**user_data)\n            self.uow.users.save(user)\n        return user"}, {"id": 158, "title": "Реализуйте Chain of Responsibility для цепочки middleware", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте Chain of Responsibility для цепочки middleware.</p>", "initialCode": "class Handler(ABC):\n\n    def __init__(self, next_handler=None):\n        pass\n\n    def handle(self, request):\n        pass\nclass AuthMiddleware(Handler):\n\n    def handle(self, request):\n        pass", "solution": "# Реализуйте Chain of Responsibility для цепочки middleware\nclass Handler(ABC):\n    def __init__(self, next_handler=None):\n        self.next = next_handler\n\n    def handle(self, request):\n        if self.next:\n            return self.next.handle(request)\n        return True\n\nclass AuthMiddleware(Handler):\n    def handle(self, request):\n        if not request.get('authenticated'):\n            raise PermissionError('Unauthorized')\n        return super().handle(request)", "hint": "Шаг 1: Используй CREATE TABLE name (колонка ТИП ОГРАНИЧЕНИЕ). Шаг 2: Задай PRIMARY KEY и связи с родительскими таблицами через REFERENCES.", "tests": "import ast as _ast\nassert \"Handler\" in globals() and isinstance(Handler, type), \"Класс Handler должен быть определён\"\n_cl_def_Handler = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Handler\"]\nassert _cl_def_Handler and not (len(_cl_def_Handler[0].body) == 1 and isinstance(_cl_def_Handler[0].body[0], _ast.Pass)), \"Реализуйте тело класса Handler (сейчас там только pass)\"\nassert hasattr(Handler, \"__init__\"), \"В классе Handler должен быть метод/свойство __init__\"\n_cl_nodes_Handler___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Handler\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Handler___init__ and not (len(_cl_nodes_Handler___init__[0].body) == 1 and isinstance(_cl_nodes_Handler___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Handler.__init__()\"\nassert hasattr(Handler, \"handle\"), \"В классе Handler должен быть метод/свойство handle\"\n_cl_nodes_Handler_handle = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Handler\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"handle\"]\nassert _cl_nodes_Handler_handle and not (len(_cl_nodes_Handler_handle[0].body) == 1 and isinstance(_cl_nodes_Handler_handle[0].body[0], _ast.Pass)), \"Реализуйте метод Handler.handle()\"\nassert \"AuthMiddleware\" in globals() and isinstance(AuthMiddleware, type), \"Класс AuthMiddleware должен быть определён\"\n_cl_def_AuthMiddleware = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"AuthMiddleware\"]\nassert _cl_def_AuthMiddleware and not (len(_cl_def_AuthMiddleware[0].body) == 1 and isinstance(_cl_def_AuthMiddleware[0].body[0], _ast.Pass)), \"Реализуйте тело класса AuthMiddleware (сейчас там только pass)\"\nassert hasattr(AuthMiddleware, \"handle\"), \"В классе AuthMiddleware должен быть метод/свойство handle\"\n_cl_nodes_AuthMiddleware_handle = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"AuthMiddleware\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"handle\"]\nassert _cl_nodes_AuthMiddleware_handle and not (len(_cl_nodes_AuthMiddleware_handle[0].body) == 1 and isinstance(_cl_nodes_AuthMiddleware_handle[0].body[0], _ast.Pass)), \"Реализуйте метод AuthMiddleware.handle()\"", "code": "# Реализуйте Chain of Responsibility для цепочки middleware\nclass Handler(ABC):\n    def __init__(self, next_handler=None):\n        self.next = next_handler\n\n    def handle(self, request):\n        if self.next:\n            return self.next.handle(request)\n        return True\n\nclass AuthMiddleware(Handler):\n    def handle(self, request):\n        if not request.get('authenticated'):\n            raise PermissionError('Unauthorized')\n        return super().handle(request)"}, {"id": 159, "title": "Нормализуйте денормализованную таблицу заказов до 3НФ", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Нормализуйте денормализованную таблицу заказов до 3НФ.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Нормализуйте денормализованную таблицу заказов до 3НФ\n# 1НФ: атомарность полей, 2НФ: устранение частичных зависимостей от составного ключа\n# 3НФ: устранение транзитивных зависимостей (клиент -> город -> индекс выносятся в отдельную таблицу)\nsql = \"\"\"\nCREATE TABLE clients (id SERIAL PRIMARY KEY, name VARCHAR(100), city_id INT);\nCREATE TABLE orders (id SERIAL PRIMARY KEY, client_id INT REFERENCES clients(id), date DATE);\nCREATE TABLE order_lines (order_id INT, product_id INT, qty INT, PRIMARY KEY (order_id, product_id));\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"CREATE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'CREATE'\"\nassert isinstance(sql, str) and \"TABLE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'TABLE'\"\nassert isinstance(sql, str) and \"clients\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'clients'\"", "code": "# Нормализуйте денормализованную таблицу заказов до 3НФ\n# 1НФ: атомарность полей, 2НФ: устранение частичных зависимостей от составного ключа\n# 3НФ: устранение транзитивных зависимостей (клиент -> город -> индекс выносятся в отдельную таблицу)\nsql = \"\"\"\nCREATE TABLE clients (id SERIAL PRIMARY KEY, name VARCHAR(100), city_id INT);\nCREATE TABLE orders (id SERIAL PRIMARY KEY, client_id INT REFERENCES clients(id), date DATE);\nCREATE TABLE order_lines (order_id INT, product_id INT, qty INT, PRIMARY KEY (order_id, product_id));\n\"\"\""}, {"id": 160, "title": "Напишите декоратор кеширования с ограничением по времени (TTL)", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите декоратор кеширования с ограничением по времени (TTL).</p>", "initialCode": "import time\nfrom functools import wraps\ndef ttl_cache(seconds=60):\n    pass", "solution": "# Напишите декоратор кеширования с ограничением по времени (TTL)\nimport time\nfrom functools import wraps\n\ndef ttl_cache(seconds=60):\n    def decorator(func):\n        cache = {}\n        @wraps(func)\n        def wrapper(*args, **kwargs):\n            key = (args, tuple(sorted(kwargs.items())))\n            now = time.time()\n            if key in cache:\n                val, exp = cache[key]\n                if now < exp:\n                    return val\n            val = func(*args, **kwargs)\n            cache[key] = (val, now + seconds)\n            return val\n        return wrapper\n    return decorator", "hint": "Шаг 1: Определи функцию-декоратор, принимающую func. Шаг 2: Внутри объяви wrapper(*args, **kwargs), вызови func и верни результат. Шаг 3: Верни wrapper.", "tests": "import ast as _ast\nassert \"ttl_cache\" in globals() and callable(ttl_cache), \"Функция ttl_cache() должна быть определена\"\n_fn_nodes_ttl_cache = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"ttl_cache\"]\nassert _fn_nodes_ttl_cache and not (len(_fn_nodes_ttl_cache[0].body) == 1 and isinstance(_fn_nodes_ttl_cache[0].body[0], _ast.Pass)), \"Реализуйте тело функции ttl_cache() (сейчас там только pass)\"", "code": "# Напишите декоратор кеширования с ограничением по времени (TTL)\nimport time\nfrom functools import wraps\n\ndef ttl_cache(seconds=60):\n    def decorator(func):\n        cache = {}\n        @wraps(func)\n        def wrapper(*args, **kwargs):\n            key = (args, tuple(sorted(kwargs.items())))\n            now = time.time()\n            if key in cache:\n                val, exp = cache[key]\n                if now < exp:\n                    return val\n            val = func(*args, **kwargs)\n            cache[key] = (val, now + seconds)\n            return val\n        return wrapper\n    return decorator"}, {"id": 161, "title": "Реализуйте вставку узла в BST с сохранением свойств", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте вставку узла в BST с сохранением свойств.</p>", "initialCode": "def insert_into_bst(root: TreeNode, val: int) -> TreeNode:\n    pass", "solution": "# Реализуйте вставку узла в BST с сохранением свойств\ndef insert_into_bst(root: TreeNode, val: int) -> TreeNode:\n    if not root:\n        return TreeNode(val)\n    if val < root.val:\n        root.left = insert_into_bst(root.left, val)\n    else:\n        root.right = insert_into_bst(root.right, val)\n    return root", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"insert_into_bst\" in globals() and callable(insert_into_bst), \"Функция insert_into_bst() должна быть определена\"\n_fn_nodes_insert_into_bst = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"insert_into_bst\"]\nassert _fn_nodes_insert_into_bst and not (len(_fn_nodes_insert_into_bst[0].body) == 1 and isinstance(_fn_nodes_insert_into_bst[0].body[0], _ast.Pass)), \"Реализуйте тело функции insert_into_bst() (сейчас там только pass)\"\n_r = insert_into_bst(None, 5); _r = insert_into_bst(_r, 3); assert _r.val == 5 and _r.left.val == 3", "code": "# Реализуйте вставку узла в BST с сохранением свойств\ndef insert_into_bst(root: TreeNode, val: int) -> TreeNode:\n    if not root:\n        return TreeNode(val)\n    if val < root.val:\n        root.left = insert_into_bst(root.left, val)\n    else:\n        root.right = insert_into_bst(root.right, val)\n    return root"}, {"id": 162, "title": "Создайте контекстный менеджер для временного изменения sys.stdout", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте контекстный менеджер для временного изменения sys.stdout.</p>", "initialCode": "import sys\nfrom io import StringIO\nfrom contextlib import contextmanager\n@contextmanager\ndef redirect_stdout():\n    pass", "solution": "# Создайте контекстный менеджер для временного изменения sys.stdout\nimport sys\nfrom io import StringIO\nfrom contextlib import contextmanager\n\n@contextmanager\ndef redirect_stdout():\n    old_stdout = sys.stdout\n    buffer = StringIO()\n    try:\n        sys.stdout = buffer\n        yield buffer\n    finally:\n        sys.stdout = old_stdout", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"redirect_stdout\" in globals() and callable(redirect_stdout), \"Функция redirect_stdout() должна быть определена\"\n_fn_nodes_redirect_stdout = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"redirect_stdout\"]\nassert _fn_nodes_redirect_stdout and not (len(_fn_nodes_redirect_stdout[0].body) == 1 and isinstance(_fn_nodes_redirect_stdout[0].body[0], _ast.Pass)), \"Реализуйте тело функции redirect_stdout() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Создайте контекстный менеджер для временного изменения sys.stdout\nimport sys\nfrom io import StringIO\nfrom contextlib import contextmanager\n\n@contextmanager\ndef redirect_stdout():\n    old_stdout = sys.stdout\n    buffer = StringIO()\n    try:\n        sys.stdout = buffer\n        yield buffer\n    finally:\n        sys.stdout = old_stdout"}, {"id": 163, "title": "Создайте абстрактный Storage с реализациями S3 и Local", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте абстрактный Storage с реализациями S3 и Local.</p>", "initialCode": "from abc import ABC, abstractmethod\nclass FileStorage(ABC):\n\n    @abstractmethod\n    def upload(self, filename: str, content: bytes) -> str:\n        pass\nclass LocalStorage(FileStorage):\n\n    def upload(self, filename: str, content: bytes) -> str:\n        pass\nclass S3Storage(FileStorage):\n\n    def upload(self, filename: str, content: bytes) -> str:\n        pass", "solution": "# Создайте абстрактный Storage с реализациями S3 и Local\nfrom abc import ABC, abstractmethod\n\nclass FileStorage(ABC):\n    @abstractmethod\n    def upload(self, filename: str, content: bytes) -> str:\n        pass\n\nclass LocalStorage(FileStorage):\n    def upload(self, filename: str, content: bytes) -> str:\n        return f\"/local/path/{filename}\"\n\nclass S3Storage(FileStorage):\n    def upload(self, filename: str, content: bytes) -> str:\n        return f\"https://bucket.s3.amazonaws.com/{filename}\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"FileStorage\" in globals() and isinstance(FileStorage, type), \"Класс FileStorage должен быть определён\"\n_cl_def_FileStorage = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"FileStorage\"]\nassert _cl_def_FileStorage and not (len(_cl_def_FileStorage[0].body) == 1 and isinstance(_cl_def_FileStorage[0].body[0], _ast.Pass)), \"Реализуйте тело класса FileStorage (сейчас там только pass)\"\nassert hasattr(FileStorage, \"upload\"), \"В классе FileStorage должен быть метод/свойство upload\"\nassert \"LocalStorage\" in globals() and isinstance(LocalStorage, type), \"Класс LocalStorage должен быть определён\"\n_cl_def_LocalStorage = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LocalStorage\"]\nassert _cl_def_LocalStorage and not (len(_cl_def_LocalStorage[0].body) == 1 and isinstance(_cl_def_LocalStorage[0].body[0], _ast.Pass)), \"Реализуйте тело класса LocalStorage (сейчас там только pass)\"\nassert hasattr(LocalStorage, \"upload\"), \"В классе LocalStorage должен быть метод/свойство upload\"\n_cl_nodes_LocalStorage_upload = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LocalStorage\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"upload\"]\nassert _cl_nodes_LocalStorage_upload and not (len(_cl_nodes_LocalStorage_upload[0].body) == 1 and isinstance(_cl_nodes_LocalStorage_upload[0].body[0], _ast.Pass)), \"Реализуйте метод LocalStorage.upload()\"\nassert \"S3Storage\" in globals() and isinstance(S3Storage, type), \"Класс S3Storage должен быть определён\"\n_cl_def_S3Storage = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"S3Storage\"]\nassert _cl_def_S3Storage and not (len(_cl_def_S3Storage[0].body) == 1 and isinstance(_cl_def_S3Storage[0].body[0], _ast.Pass)), \"Реализуйте тело класса S3Storage (сейчас там только pass)\"\nassert hasattr(S3Storage, \"upload\"), \"В классе S3Storage должен быть метод/свойство upload\"\n_cl_nodes_S3Storage_upload = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"S3Storage\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"upload\"]\nassert _cl_nodes_S3Storage_upload and not (len(_cl_nodes_S3Storage_upload[0].body) == 1 and isinstance(_cl_nodes_S3Storage_upload[0].body[0], _ast.Pass)), \"Реализуйте метод S3Storage.upload()\"", "code": "# Создайте абстрактный Storage с реализациями S3 и Local\nfrom abc import ABC, abstractmethod\n\nclass FileStorage(ABC):\n    @abstractmethod\n    def upload(self, filename: str, content: bytes) -> str:\n        pass\n\nclass LocalStorage(FileStorage):\n    def upload(self, filename: str, content: bytes) -> str:\n        return f\"/local/path/{filename}\"\n\nclass S3Storage(FileStorage):\n    def upload(self, filename: str, content: bytes) -> str:\n        return f\"https://bucket.s3.amazonaws.com/{filename}\""}, {"id": 164, "title": "Напишите хэш-таблицу с коллизиями методом цепочек", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите хэш-таблицу с коллизиями методом цепочек.</p>", "initialCode": "class SimpleHashTable:\n\n    def __init__(self, size=100):\n        pass\n\n    def _hash(self, key):\n        pass\n\n    def put(self, key, value):\n        pass\n\n    def get(self, key):\n        pass", "solution": "# Напишите хэш-таблицу с коллизиями методом цепочек\nclass SimpleHashTable:\n    def __init__(self, size=100):\n        self.size = size\n        self.table = [[] for _ in range(size)]\n\n    def _hash(self, key):\n        return hash(key) % self.size\n\n    def put(self, key, value):\n        bucket = self.table[self._hash(key)]\n        for i, (k, v) in enumerate(bucket):\n            if k == key:\n                bucket[i] = (key, value)\n                return\n        bucket.append((key, value))\n\n    def get(self, key):\n        bucket = self.table[self._hash(key)]\n        for k, v in bucket:\n            if k == key:\n                return v\n        raise KeyError(key)", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"SimpleHashTable\" in globals() and isinstance(SimpleHashTable, type), \"Класс SimpleHashTable должен быть определён\"\n_cl_def_SimpleHashTable = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SimpleHashTable\"]\nassert _cl_def_SimpleHashTable and not (len(_cl_def_SimpleHashTable[0].body) == 1 and isinstance(_cl_def_SimpleHashTable[0].body[0], _ast.Pass)), \"Реализуйте тело класса SimpleHashTable (сейчас там только pass)\"\nassert hasattr(SimpleHashTable, \"__init__\"), \"В классе SimpleHashTable должен быть метод/свойство __init__\"\n_cl_nodes_SimpleHashTable___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SimpleHashTable\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_SimpleHashTable___init__ and not (len(_cl_nodes_SimpleHashTable___init__[0].body) == 1 and isinstance(_cl_nodes_SimpleHashTable___init__[0].body[0], _ast.Pass)), \"Реализуйте метод SimpleHashTable.__init__()\"\nassert hasattr(SimpleHashTable, \"_hash\"), \"В классе SimpleHashTable должен быть метод/свойство _hash\"\n_cl_nodes_SimpleHashTable__hash = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SimpleHashTable\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"_hash\"]\nassert _cl_nodes_SimpleHashTable__hash and not (len(_cl_nodes_SimpleHashTable__hash[0].body) == 1 and isinstance(_cl_nodes_SimpleHashTable__hash[0].body[0], _ast.Pass)), \"Реализуйте метод SimpleHashTable._hash()\"\nassert hasattr(SimpleHashTable, \"put\"), \"В классе SimpleHashTable должен быть метод/свойство put\"\n_cl_nodes_SimpleHashTable_put = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SimpleHashTable\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"put\"]\nassert _cl_nodes_SimpleHashTable_put and not (len(_cl_nodes_SimpleHashTable_put[0].body) == 1 and isinstance(_cl_nodes_SimpleHashTable_put[0].body[0], _ast.Pass)), \"Реализуйте метод SimpleHashTable.put()\"\nassert hasattr(SimpleHashTable, \"get\"), \"В классе SimpleHashTable должен быть метод/свойство get\"\n_cl_nodes_SimpleHashTable_get = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"SimpleHashTable\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"get\"]\nassert _cl_nodes_SimpleHashTable_get and not (len(_cl_nodes_SimpleHashTable_get[0].body) == 1 and isinstance(_cl_nodes_SimpleHashTable_get[0].body[0], _ast.Pass)), \"Реализуйте метод SimpleHashTable.get()\"", "code": "# Напишите хэш-таблицу с коллизиями методом цепочек\nclass SimpleHashTable:\n    def __init__(self, size=100):\n        self.size = size\n        self.table = [[] for _ in range(size)]\n\n    def _hash(self, key):\n        return hash(key) % self.size\n\n    def put(self, key, value):\n        bucket = self.table[self._hash(key)]\n        for i, (k, v) in enumerate(bucket):\n            if k == key:\n                bucket[i] = (key, value)\n                return\n        bucket.append((key, value))\n\n    def get(self, key):\n        bucket = self.table[self._hash(key)]\n        for k, v in bucket:\n            if k == key:\n                return v\n        raise KeyError(key)"}, {"id": 165, "title": "Воспроизведите ситуацию Deadlock в двух параллельных сессиях", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Воспроизведите ситуацию Deadlock в двух параллельных сессиях.</p>", "initialCode": "# Напишите ваше решение\n", "solution": "# Воспроизведите ситуацию Deadlock в двух параллельных сессиях\n# Сессия 1: блокирует счет A, затем запрашивает B\n# Сессия 2: блокирует счет B, затем запрашивает A\n# Решение: всегда упорядочивать id ресурсов при блокировке (min(id), max(id))", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert len([l for l in __USER_CODE__.splitlines() if l.strip() and not l.strip().startswith(\"# Задач\") and not l.strip().startswith(\"# Напишите ваше\") and not l.strip().startswith(\"from \") and not l.strip().startswith(\"import \")]) >= 1, \"Добавьте решение задачи\"", "code": "# Воспроизведите ситуацию Deadlock в двух параллельных сессиях\n# Сессия 1: блокирует счет A, затем запрашивает B\n# Сессия 2: блокирует счет B, затем запрашивает A\n# Решение: всегда упорядочивать id ресурсов при блокировке (min(id), max(id))"}, {"id": 166, "title": "Создайте пул асинхронных HTTP-запросов с rate-limiter", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте пул асинхронных HTTP-запросов с rate-limiter.</p>", "initialCode": "import asyncio\nimport httpx\nasync def limited_fetch(urls: list[str], max_concurrent: int=3) -> list[int]:\n    pass\nasync def main():\n    pass", "solution": "# Создайте пул асинхронных HTTP-запросов с rate-limiter\nimport asyncio\nimport httpx\n\nasync def limited_fetch(urls: list[str], max_concurrent: int = 3) -> list[int]:\n    semaphore = asyncio.Semaphore(max_concurrent)\n    async with httpx.AsyncClient() as client:\n        async def fetch(url: str) -> int:\n            async with semaphore:\n                resp = await client.get(url)\n                return resp.status_code\n        return await asyncio.gather(*(fetch(u) for u in urls))\n\nasync def main():\n    urls = [f\"https://api.example.com/items/{i}\" for i in range(6)]\n    statuses = await limited_fetch(urls, max_concurrent=2)\n    print(\"Статус-коды:\", statuses)\n    assert statuses == [200] * 6\n\nasyncio.run(main())\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"limited_fetch\" in globals() and callable(limited_fetch), \"Функция limited_fetch() должна быть определена\"\n_fn_nodes_limited_fetch = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"limited_fetch\"]\nassert _fn_nodes_limited_fetch and not (len(_fn_nodes_limited_fetch[0].body) == 1 and isinstance(_fn_nodes_limited_fetch[0].body[0], _ast.Pass)), \"Реализуйте тело функции limited_fetch() (сейчас там только pass)\"\nassert \"main\" in globals() and callable(main), \"Функция main() должна быть определена\"\n_fn_nodes_main = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"main\"]\nassert _fn_nodes_main and not (len(_fn_nodes_main[0].body) == 1 and isinstance(_fn_nodes_main[0].body[0], _ast.Pass)), \"Реализуйте тело функции main() (сейчас там только pass)\"\nasyncio.run(main())", "code": "# Создайте пул асинхронных HTTP-запросов с rate-limiter\nimport asyncio\nimport httpx\n\nasync def limited_fetch(urls: list[str], max_concurrent: int = 3) -> list[int]:\n    semaphore = asyncio.Semaphore(max_concurrent)\n    async with httpx.AsyncClient() as client:\n        async def fetch(url: str) -> int:\n            async with semaphore:\n                resp = await client.get(url)\n                return resp.status_code\n        return await asyncio.gather(*(fetch(u) for u in urls))\n\nasync def main():\n    urls = [f\"https://api.example.com/items/{i}\" for i in range(6)]\n    statuses = await limited_fetch(urls, max_concurrent=2)\n    print(\"Статус-коды:\", statuses)\n    assert statuses == [200] * 6\n\nasyncio.run(main())\n"}, {"id": 167, "title": "Реализуйте фабрику экспортеров отчетов (CSV, JSON, PDF)", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте фабрику экспортеров отчетов (CSV, JSON, PDF).</p>", "initialCode": "class ExporterFactory:\n    _exporters = {}\n\n    @classmethod\n    def register(cls, fmt, exporter_cls):\n        pass\n\n    @classmethod\n    def create(cls, fmt):\n        pass", "solution": "# Реализуйте фабрику экспортеров отчетов (CSV, JSON, PDF)\nclass ExporterFactory:\n    _exporters = {}\n\n    @classmethod\n    def register(cls, fmt, exporter_cls):\n        cls._exporters[fmt] = exporter_cls\n\n    @classmethod\n    def create(cls, fmt):\n        exporter = cls._exporters.get(fmt)\n        if not exporter:\n            raise ValueError(f\"Неизвестный формат экспорта: {fmt}\")\n        return exporter()", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"ExporterFactory\" in globals() and isinstance(ExporterFactory, type), \"Класс ExporterFactory должен быть определён\"\n_cl_def_ExporterFactory = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ExporterFactory\"]\nassert _cl_def_ExporterFactory and not (len(_cl_def_ExporterFactory[0].body) == 1 and isinstance(_cl_def_ExporterFactory[0].body[0], _ast.Pass)), \"Реализуйте тело класса ExporterFactory (сейчас там только pass)\"\nassert hasattr(ExporterFactory, \"register\"), \"В классе ExporterFactory должен быть метод/свойство register\"\n_cl_nodes_ExporterFactory_register = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ExporterFactory\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"register\"]\nassert _cl_nodes_ExporterFactory_register and not (len(_cl_nodes_ExporterFactory_register[0].body) == 1 and isinstance(_cl_nodes_ExporterFactory_register[0].body[0], _ast.Pass)), \"Реализуйте метод ExporterFactory.register()\"\nassert hasattr(ExporterFactory, \"create\"), \"В классе ExporterFactory должен быть метод/свойство create\"\n_cl_nodes_ExporterFactory_create = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"ExporterFactory\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"create\"]\nassert _cl_nodes_ExporterFactory_create and not (len(_cl_nodes_ExporterFactory_create[0].body) == 1 and isinstance(_cl_nodes_ExporterFactory_create[0].body[0], _ast.Pass)), \"Реализуйте метод ExporterFactory.create()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Реализуйте фабрику экспортеров отчетов (CSV, JSON, PDF)\nclass ExporterFactory:\n    _exporters = {}\n\n    @classmethod\n    def register(cls, fmt, exporter_cls):\n        cls._exporters[fmt] = exporter_cls\n\n    @classmethod\n    def create(cls, fmt):\n        exporter = cls._exporters.get(fmt)\n        if not exporter:\n            raise ValueError(f\"Неизвестный формат экспорта: {fmt}\")\n        return exporter()"}, {"id": 168, "title": "Объедините результаты двух запросов через UNION ALL", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Объедините результаты двух запросов через UNION ALL.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Объедините результаты двух запросов через UNION ALL\nsql = \"\"\"\nSELECT id, amount, 'card' AS source, created_at FROM card_transactions\nUNION ALL\nSELECT id, amount, 'crypto' AS source, created_at FROM crypto_transactions\nORDER BY created_at DESC;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"SELECT\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'SELECT'\"\nassert isinstance(sql, str) and \"amount\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'amount'\"\nassert isinstance(sql, str) and \"card\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'card'\"", "code": "# Объедините результаты двух запросов через UNION ALL\nsql = \"\"\"\nSELECT id, amount, 'card' AS source, created_at FROM card_transactions\nUNION ALL\nSELECT id, amount, 'crypto' AS source, created_at FROM crypto_transactions\nORDER BY created_at DESC;\n\"\"\""}, {"id": 169, "title": "Постройте рекурсивный CTE для обхода дерева категорий", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Постройте рекурсивный CTE для обхода дерева категорий.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Постройте рекурсивный CTE для обхода дерева категорий\nsql = \"\"\"\nWITH RECURSIVE CategoryTree AS (\n    SELECT id, parent_id, name, 1 as depth\n    FROM categories WHERE parent_id IS NULL\n    UNION ALL\n    SELECT c.id, c.parent_id, c.name, ct.depth + 1\n    FROM categories c\n    JOIN CategoryTree ct ON c.parent_id = ct.id\n)\nSELECT * FROM CategoryTree ORDER BY depth, parent_id;\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"WITH\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'WITH'\"\nassert isinstance(sql, str) and \"RECURSIVE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'RECURSIVE'\"\nassert isinstance(sql, str) and \"CategoryTree\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'CategoryTree'\"", "code": "# Постройте рекурсивный CTE для обхода дерева категорий\nsql = \"\"\"\nWITH RECURSIVE CategoryTree AS (\n    SELECT id, parent_id, name, 1 as depth\n    FROM categories WHERE parent_id IS NULL\n    UNION ALL\n    SELECT c.id, c.parent_id, c.name, ct.depth + 1\n    FROM categories c\n    JOIN CategoryTree ct ON c.parent_id = ct.id\n)\nSELECT * FROM CategoryTree ORDER BY depth, parent_id;\n\"\"\""}, {"id": 170, "title": "Напишите вычисление обратной польской нотации через стек", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите вычисление обратной польской нотации через стек.</p>", "initialCode": "def evaluate_reverse_polish(expr: str) -> float:\n    pass", "solution": "# Напишите вычисление обратной польской нотации через стек\ndef evaluate_reverse_polish(expr: str) -> float:\n    stack = []\n    for token in expr.split():\n        if token in '+-*/':\n            b = stack.pop()\n            a = stack.pop()\n            if token == '+': stack.append(a + b)\n            elif token == '-': stack.append(a - b)\n            elif token == '*': stack.append(a * b)\n            elif token == '/': stack.append(a / b)\n        else:\n            stack.append(float(token))\n    return stack[-1]", "hint": "Шаг 1: Храни элементы во внутреннем списке self._items. Шаг 2: push добавляет через append(), pop удаляет с конца через pop() с проверкой на пустоту, peek возвращает последний элемент.", "tests": "import ast as _ast\nassert \"evaluate_reverse_polish\" in globals() and callable(evaluate_reverse_polish), \"Функция evaluate_reverse_polish() должна быть определена\"\n_fn_nodes_evaluate_reverse_polish = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"evaluate_reverse_polish\"]\nassert _fn_nodes_evaluate_reverse_polish and not (len(_fn_nodes_evaluate_reverse_polish[0].body) == 1 and isinstance(_fn_nodes_evaluate_reverse_polish[0].body[0], _ast.Pass)), \"Реализуйте тело функции evaluate_reverse_polish() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Напишите вычисление обратной польской нотации через стек\ndef evaluate_reverse_polish(expr: str) -> float:\n    stack = []\n    for token in expr.split():\n        if token in '+-*/':\n            b = stack.pop()\n            a = stack.pop()\n            if token == '+': stack.append(a + b)\n            elif token == '-': stack.append(a - b)\n            elif token == '*': stack.append(a * b)\n            elif token == '/': stack.append(a / b)\n        else:\n            stack.append(float(token))\n    return stack[-1]"}, {"id": 171, "title": "Создайте лидерборд на базе Redis Sorted Set (ZSET)", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Создайте лидерборд на базе Redis Sorted Set (ZSET).</p>", "initialCode": "top_3 = r.zrevrange('leaderboard', 0, 2, withscores=True)\nrank = None", "solution": "# Создайте лидерборд на базе Redis Sorted Set (ZSET)\nr.zadd('leaderboard', {'player1': 1500, 'player2': 2100, 'player3': 1800})\ntop_3 = r.zrevrange('leaderboard', 0, 2, withscores=True)\nrank = r.zrevrank('leaderboard', 'player1')", "hint": "Используй стандартные команды Redis-клиента: r.set(key, value), r.get(key) и r.expire(key, seconds).", "tests": "import ast as _ast\nassert \"top_3\" in globals() and top_3 is not None, \"Переменная top_3 должна быть определена и не равна None\"\nassert top_3 != \"__TODO__\", \"Заполните значение переменной top_3\"\nassert \"rank\" in globals() and rank is not None, \"Переменная rank должна быть определена и не равна None\"\nassert rank != \"__TODO__\", \"Заполните значение переменной rank\"", "code": "# Создайте лидерборд на базе Redis Sorted Set (ZSET)\nr.zadd('leaderboard', {'player1': 1500, 'player2': 2100, 'player3': 1800})\ntop_3 = r.zrevrange('leaderboard', 0, 2, withscores=True)\nrank = r.zrevrank('leaderboard', 'player1')"}, {"id": 172, "title": "Реализуйте кастомный Permission класс проверки автора", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте кастомный Permission класс проверки автора.</p>", "initialCode": "from types import SimpleNamespace\nfrom rest_framework.permissions import BasePermission, SAFE_METHODS\nclass IsAuthorOrReadOnly(BasePermission):\n\n    def has_object_permission(self, request, view, obj) -> bool:\n        pass", "solution": "# Реализуйте кастомный Permission класс проверки автора\nfrom types import SimpleNamespace\nfrom rest_framework.permissions import BasePermission, SAFE_METHODS\n\nclass IsAuthorOrReadOnly(BasePermission):\n    def has_object_permission(self, request, view, obj) -> bool:\n        if request.method in SAFE_METHODS:\n            return True\n        return obj.author == request.user\n\nperm = IsAuthorOrReadOnly()\npost = SimpleNamespace(author=\"alice\")\nget_req = SimpleNamespace(method=\"GET\", user=\"bob\")\ndel_bob = SimpleNamespace(method=\"DELETE\", user=\"bob\")\ndel_alice = SimpleNamespace(method=\"DELETE\", user=\"alice\")\n\nprint(\"GET (bob):\", perm.has_object_permission(get_req, None, post),\n      \"| DELETE (bob):\", perm.has_object_permission(del_bob, None, post),\n      \"| DELETE (alice):\", perm.has_object_permission(del_alice, None, post))\nassert perm.has_object_permission(get_req, None, post) is True\nassert perm.has_object_permission(del_bob, None, post) is False\nassert perm.has_object_permission(del_alice, None, post) is True\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"IsAuthorOrReadOnly\" in globals() and isinstance(IsAuthorOrReadOnly, type), \"Класс IsAuthorOrReadOnly должен быть определён\"\n_cl_def_IsAuthorOrReadOnly = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"IsAuthorOrReadOnly\"]\nassert _cl_def_IsAuthorOrReadOnly and not (len(_cl_def_IsAuthorOrReadOnly[0].body) == 1 and isinstance(_cl_def_IsAuthorOrReadOnly[0].body[0], _ast.Pass)), \"Реализуйте тело класса IsAuthorOrReadOnly (сейчас там только pass)\"\nassert hasattr(IsAuthorOrReadOnly, \"has_object_permission\"), \"В классе IsAuthorOrReadOnly должен быть метод/свойство has_object_permission\"\n_cl_nodes_IsAuthorOrReadOnly_has_object_permission = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"IsAuthorOrReadOnly\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"has_object_permission\"]\nassert _cl_nodes_IsAuthorOrReadOnly_has_object_permission and not (len(_cl_nodes_IsAuthorOrReadOnly_has_object_permission[0].body) == 1 and isinstance(_cl_nodes_IsAuthorOrReadOnly_has_object_permission[0].body[0], _ast.Pass)), \"Реализуйте метод IsAuthorOrReadOnly.has_object_permission()\"\nperm = IsAuthorOrReadOnly()\npost = SimpleNamespace(author=\"alice\")\nget_req = SimpleNamespace(method=\"GET\", user=\"bob\")\ndel_bob = SimpleNamespace(method=\"DELETE\", user=\"bob\")\ndel_alice = SimpleNamespace(method=\"DELETE\", user=\"alice\")\nprint(\"GET (bob):\", perm.has_object_permission(get_req, None, post),\n      \"| DELETE (bob):\", perm.has_object_permission(del_bob, None, post),\n      \"| DELETE (alice):\", perm.has_object_permission(del_alice, None, post))\nassert perm.has_object_permission(get_req, None, post) is True\nassert perm.has_object_permission(del_bob, None, post) is False\nassert perm.has_object_permission(del_alice, None, post) is True\nassert \"perm\" in globals(), \"Переменная perm должна быть вычислена\"\nassert \"post\" in globals(), \"Переменная post должна быть вычислена\"\nassert \"get_req\" in globals(), \"Переменная get_req должна быть вычислена\"\nassert \"del_bob\" in globals(), \"Переменная del_bob должна быть вычислена\"\nassert \"del_alice\" in globals(), \"Переменная del_alice должна быть вычислена\"", "code": "# Реализуйте кастомный Permission класс проверки автора\nfrom types import SimpleNamespace\nfrom rest_framework.permissions import BasePermission, SAFE_METHODS\n\nclass IsAuthorOrReadOnly(BasePermission):\n    def has_object_permission(self, request, view, obj) -> bool:\n        if request.method in SAFE_METHODS:\n            return True\n        return obj.author == request.user\n\nperm = IsAuthorOrReadOnly()\npost = SimpleNamespace(author=\"alice\")\nget_req = SimpleNamespace(method=\"GET\", user=\"bob\")\ndel_bob = SimpleNamespace(method=\"DELETE\", user=\"bob\")\ndel_alice = SimpleNamespace(method=\"DELETE\", user=\"alice\")\n\nprint(\"GET (bob):\", perm.has_object_permission(get_req, None, post),\n      \"| DELETE (bob):\", perm.has_object_permission(del_bob, None, post),\n      \"| DELETE (alice):\", perm.has_object_permission(del_alice, None, post))\nassert perm.has_object_permission(get_req, None, post) is True\nassert perm.has_object_permission(del_bob, None, post) is False\nassert perm.has_object_permission(del_alice, None, post) is True\n"}, {"id": 173, "title": "Найдите самую длинную подстроку без повторений", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Найдите самую длинную подстроку без повторений.</p>", "initialCode": "def length_of_longest_substring(s: str) -> int:\n    pass", "solution": "# Найдите самую длинную подстроку без повторений\ndef length_of_longest_substring(s: str) -> int:\n    char_map = {}\n    max_len = left = 0\n    for right, char in enumerate(s):\n        if char in char_map and char_map[char] >= left:\n            left = char_map[char] + 1\n        char_map[char] = right\n        max_len = max(max_len, right - left + 1)\n    return max_len", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"length_of_longest_substring\" in globals() and callable(length_of_longest_substring), \"Функция length_of_longest_substring() должна быть определена\"\n_fn_nodes_length_of_longest_substring = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"length_of_longest_substring\"]\nassert _fn_nodes_length_of_longest_substring and not (len(_fn_nodes_length_of_longest_substring[0].body) == 1 and isinstance(_fn_nodes_length_of_longest_substring[0].body[0], _ast.Pass)), \"Реализуйте тело функции length_of_longest_substring() (сейчас там только pass)\"", "code": "# Найдите самую длинную подстроку без повторений\ndef length_of_longest_substring(s: str) -> int:\n    char_map = {}\n    max_len = left = 0\n    for right, char in enumerate(s):\n        if char in char_map and char_map[char] >= left:\n            left = char_map[char] + 1\n        char_map[char] = right\n        max_len = max(max_len, right - left + 1)\n    return max_len"}, {"id": 174, "title": "Реализуйте защиту от timing attack через hmac.compare_digest", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализуйте защиту от timing attack через hmac.compare_digest.</p>", "initialCode": "import hmac\ndef check_auth_token(user_provided_token: str, real_token: str) -> bool:\n    pass", "solution": "# Реализуйте защиту от timing attack через hmac.compare_digest\nimport hmac\n\ndef check_auth_token(user_provided_token: str, real_token: str) -> bool:\n    # Предотвращает утечку информации через разницу во времени побайтового сравнения строк\n    return hmac.compare_digest(\n        user_provided_token.encode(\"utf-8\"),\n        real_token.encode(\"utf-8\"),\n    )\n\nok = check_auth_token(\"secret-token-123\", \"secret-token-123\")\nfail = check_auth_token(\"secret-token-124\", \"secret-token-123\")\nprint(\"Токен верный:\", ok, \"| Токен неверный:\", fail)\nassert ok is True and fail is False\n", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"check_auth_token\" in globals() and callable(check_auth_token), \"Функция check_auth_token() должна быть определена\"\n_fn_nodes_check_auth_token = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"check_auth_token\"]\nassert _fn_nodes_check_auth_token and not (len(_fn_nodes_check_auth_token[0].body) == 1 and isinstance(_fn_nodes_check_auth_token[0].body[0], _ast.Pass)), \"Реализуйте тело функции check_auth_token() (сейчас там только pass)\"\nok = check_auth_token(\"secret-token-123\", \"secret-token-123\")\nfail = check_auth_token(\"secret-token-124\", \"secret-token-123\")\nprint(\"Токен верный:\", ok, \"| Токен неверный:\", fail)\nassert ok is True and fail is False\nassert \"ok\" in globals(), \"Переменная ok должна быть вычислена\"\nassert \"fail\" in globals(), \"Переменная fail должна быть вычислена\"", "code": "# Реализуйте защиту от timing attack через hmac.compare_digest\nimport hmac\n\ndef check_auth_token(user_provided_token: str, real_token: str) -> bool:\n    # Предотвращает утечку информации через разницу во времени побайтового сравнения строк\n    return hmac.compare_digest(\n        user_provided_token.encode(\"utf-8\"),\n        real_token.encode(\"utf-8\"),\n    )\n\nok = check_auth_token(\"secret-token-123\", \"secret-token-123\")\nfail = check_auth_token(\"secret-token-124\", \"secret-token-123\")\nprint(\"Токен верный:\", ok, \"| Токен неверный:\", fail)\nassert ok is True and fail is False\n"}, {"id": 175, "title": "Подключите Celery к приложению с Redis в качестве брокера", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Подключите Celery к приложению с Redis в качестве брокера.</p>", "initialCode": "from celery import Celery\ncelery_app = Celery('worker', broker='redis://localhost:6379/0', backend='redis://localhost:6379/1')\n@celery_app.task\ndef add(x, y):\n    pass", "solution": "# Подключите Celery к приложению с Redis в качестве брокера\nfrom celery import Celery\n\ncelery_app = Celery(\n    'worker',\n    broker='redis://localhost:6379/0',\n    backend='redis://localhost:6379/1'\n)\n\n@celery_app.task\ndef add(x, y):\n    return x + y", "hint": "Используй стандартные команды Redis-клиента: r.set(key, value), r.get(key) и r.expire(key, seconds).", "tests": "import ast as _ast\nassert \"add\" in globals() and callable(add), \"Функция add() должна быть определена\"\n_fn_nodes_add = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"add\"]\nassert _fn_nodes_add and not (len(_fn_nodes_add[0].body) == 1 and isinstance(_fn_nodes_add[0].body[0], _ast.Pass)), \"Реализуйте тело функции add() (сейчас там только pass)\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Подключите Celery к приложению с Redis в качестве брокера\nfrom celery import Celery\n\ncelery_app = Celery(\n    'worker',\n    broker='redis://localhost:6379/0',\n    backend='redis://localhost:6379/1'\n)\n\n@celery_app.task\ndef add(x, y):\n    return x + y"}, {"id": 176, "title": "Напишите запрос к полю JSONB с использованием оператора @>", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите запрос к полю JSONB с использованием оператора @&gt;.</p>", "initialCode": "sql = \"\"\"\n\n\"\"\"", "solution": "# Напишите запрос к полю JSONB с использованием оператора @>\nsql = \"\"\"\nCREATE INDEX idx_users_metadata_gin ON users USING gin (metadata jsonb_path_ops);\nSELECT id, metadata \nFROM users \nWHERE metadata @> '{\"settings\": {\"notifications\": true}}';\n\"\"\"", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"sql\" in globals() and sql is not None, \"Переменная sql должна быть определена и не равна None\"\nassert isinstance(sql, str) and \"CREATE\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'CREATE'\"\nassert isinstance(sql, str) and \"INDEX\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'INDEX'\"\nassert isinstance(sql, str) and \"idx_users_metadata_gin\".lower() in sql.lower(), \"Строка sql должна содержать ключевой элемент 'idx_users_metadata_gin'\"", "code": "# Напишите запрос к полю JSONB с использованием оператора @>\nsql = \"\"\"\nCREATE INDEX idx_users_metadata_gin ON users USING gin (metadata jsonb_path_ops);\nSELECT id, metadata \nFROM users \nWHERE metadata @> '{\"settings\": {\"notifications\": true}}';\n\"\"\""}, {"id": 177, "title": "Реализация операторов сложения и сравнения (add, eq)", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Реализация операторов сложения и сравнения (add, eq).</p>", "initialCode": "class Vector2D:\n\n    def __init__(self, x: float, y: float):\n        pass\n\n    def __add__(self, other):\n        pass\n\n    def __eq__(self, other):\n        pass", "solution": "# Реализация операторов сложения и сравнения (add, eq)\nclass Vector2D:\n    def __init__(self, x: float, y: float):\n        self.x = x\n        self.y = y\n\n    def __add__(self, other):\n        if isinstance(other, Vector2D):\n            return Vector2D(self.x + other.x, self.y + other.y)\n        return NotImplemented\n\n    def __eq__(self, other):\n        if isinstance(other, Vector2D):\n            return self.x == other.x and self.y == other.y\n        return False", "hint": "Шаг 1: Проверь сигнатуру и входные типы данных (🦅 Уровень 5). Шаг 2: Обработай граничные случаи (пустые коллекции, None, неверные типы). Шаг 3: Сформируй и верни ожидаемый результат.", "tests": "import ast as _ast\nassert \"Vector2D\" in globals() and isinstance(Vector2D, type), \"Класс Vector2D должен быть определён\"\n_cl_def_Vector2D = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Vector2D\"]\nassert _cl_def_Vector2D and not (len(_cl_def_Vector2D[0].body) == 1 and isinstance(_cl_def_Vector2D[0].body[0], _ast.Pass)), \"Реализуйте тело класса Vector2D (сейчас там только pass)\"\nassert hasattr(Vector2D, \"__init__\"), \"В классе Vector2D должен быть метод/свойство __init__\"\n_cl_nodes_Vector2D___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Vector2D\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_Vector2D___init__ and not (len(_cl_nodes_Vector2D___init__[0].body) == 1 and isinstance(_cl_nodes_Vector2D___init__[0].body[0], _ast.Pass)), \"Реализуйте метод Vector2D.__init__()\"\nassert hasattr(Vector2D, \"__add__\"), \"В классе Vector2D должен быть метод/свойство __add__\"\n_cl_nodes_Vector2D___add__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Vector2D\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__add__\"]\nassert _cl_nodes_Vector2D___add__ and not (len(_cl_nodes_Vector2D___add__[0].body) == 1 and isinstance(_cl_nodes_Vector2D___add__[0].body[0], _ast.Pass)), \"Реализуйте метод Vector2D.__add__()\"\nassert hasattr(Vector2D, \"__eq__\"), \"В классе Vector2D должен быть метод/свойство __eq__\"\n_cl_nodes_Vector2D___eq__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"Vector2D\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__eq__\"]\nassert _cl_nodes_Vector2D___eq__ and not (len(_cl_nodes_Vector2D___eq__[0].body) == 1 and isinstance(_cl_nodes_Vector2D___eq__[0].body[0], _ast.Pass)), \"Реализуйте метод Vector2D.__eq__()\"\nif \"r\" in globals() and hasattr(r, \"_store\"): r._store.clear()\nif \"r\" in globals() and hasattr(r, \"store\"): r.store.clear()", "code": "# Реализация операторов сложения и сравнения (add, eq)\nclass Vector2D:\n    def __init__(self, x: float, y: float):\n        self.x = x\n        self.y = y\n\n    def __add__(self, other):\n        if isinstance(other, Vector2D):\n            return Vector2D(self.x + other.x, self.y + other.y)\n        return NotImplemented\n\n    def __eq__(self, other):\n        if isinstance(other, Vector2D):\n            return self.x == other.x and self.y == other.y\n        return False"}, {"id": 178, "title": "Замокируйте внешнее API в тестах благодаря DIP", "level": 5, "tier": "🦅 Уровень 5", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Замокируйте внешнее API в тестах благодаря DIP.</p>", "initialCode": "class ExternalApiClient(ABC):\n\n    @abstractmethod\n    def get_rates(self) -> dict:\n        pass\nclass MockApiClient(ExternalApiClient):\n\n    def get_rates(self) -> dict:\n        pass\ndef test_converter():\n    pass", "solution": "# Замокируйте внешнее API в тестах благодаря DIP\nclass ExternalApiClient(ABC):\n    @abstractmethod\n    def get_rates(self) -> dict: pass\n\nclass MockApiClient(ExternalApiClient):\n   
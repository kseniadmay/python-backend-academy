ncPriorityEventBus:\n    def __init__(self):\n        self._handlers = {}\n        self._seq = 0\n\n    def subscribe(self, event_name: str, priority: int, handler):\n        # Меньший номер приоритета выполняется раньше\n        self._handlers.setdefault(event_name, [])\n        heapq.heappush(self._handlers[event_name], (priority, self._seq, handler))\n        self._seq += 1\n\n    async def publish(self, event_name: str, data):\n        for _, _, handler in sorted(self._handlers.get(event_name, [])):\n            await handler(data)"}, {"id": 225, "title": "Напишите middleware валидации CSRF-токена в заголовке", "level": 7, "tier": "👑 Уровень 7", "topic": "🌐 Backend & SQL", "desc": "<p><strong>Задание:</strong> Напишите middleware валидации CSRF-токена в заголовке.</p>", "initialCode": "import asyncio\nfrom types import SimpleNamespace\nfrom starlette.middleware.base import BaseHTTPMiddleware\nfrom starlette.responses import JSONResponse\nclass CSRFMiddleware(BaseHTTPMiddleware):\n\n    async def dispatch(self, request, call_next):\n        pass\nasync def main():\n    pass", "solution": "# Напишите middleware валидации CSRF-токена в заголовке\nimport asyncio\nfrom types import SimpleNamespace\nfrom starlette.middleware.base import BaseHTTPMiddleware\nfrom starlette.responses import JSONResponse\n\nclass CSRFMiddleware(BaseHTTPMiddleware):\n    async def dispatch(self, request, call_next):\n        if request.method in (\"POST\", \"PUT\", \"DELETE\", \"PATCH\"):\n            token = request.headers.get(\"X-CSRF-Token\")\n            cookie_token = request.cookies.get(\"csrf_token\")\n            if not token or not cookie_token or token != cookie_token:\n                return JSONResponse({\"error\": \"CSRF validation failed\"}, status_code=403)\n        return await call_next(request)\n\nasync def main():\n    mw = CSRFMiddleware(app=None)\n    async def ok_next(req): return JSONResponse({\"status\": \"ok\"}, status_code=200)\n\n    bad_req = SimpleNamespace(method=\"POST\", headers={}, cookies={\"csrf_token\": \"abc\"})\n    good_req = SimpleNamespace(method=\"POST\", headers={\"X-CSRF-Token\": \"abc\"}, cookies={\"csrf_token\": \"abc\"})\n\n    r_bad = await mw.dispatch(bad_req, ok_next)\n    r_good = await mw.dispatch(good_req, ok_next)\n    print(\"Без CSRF-заголовка:\", r_bad.status_code, \"| С валидным CSRF:\", r_good.status_code)\n    assert r_bad.status_code == 403 and r_good.status_code == 200\n\nasyncio.run(main())\n", "hint": "Шаг 1: Используй CREATE TABLE name (колонка ТИП ОГРАНИЧЕНИЕ). Шаг 2: Задай PRIMARY KEY и связи с родительскими таблицами через REFERENCES.", "tests": "import ast as _ast\nassert \"main\" in globals() and callable(main), \"Функция main() должна быть определена\"\n_fn_nodes_main = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and n.name == \"main\"]\nassert _fn_nodes_main and not (len(_fn_nodes_main[0].body) == 1 and isinstance(_fn_nodes_main[0].body[0], _ast.Pass)), \"Реализуйте тело функции main() (сейчас там только pass)\"\nassert \"CSRFMiddleware\" in globals() and isinstance(CSRFMiddleware, type), \"Класс CSRFMiddleware должен быть определён\"\n_cl_def_CSRFMiddleware = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CSRFMiddleware\"]\nassert _cl_def_CSRFMiddleware and not (len(_cl_def_CSRFMiddleware[0].body) == 1 and isinstance(_cl_def_CSRFMiddleware[0].body[0], _ast.Pass)), \"Реализуйте тело класса CSRFMiddleware (сейчас там только pass)\"\nassert hasattr(CSRFMiddleware, \"dispatch\"), \"В классе CSRFMiddleware должен быть метод/свойство dispatch\"\n_cl_nodes_CSRFMiddleware_dispatch = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"CSRFMiddleware\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"dispatch\"]\nassert _cl_nodes_CSRFMiddleware_dispatch and not (len(_cl_nodes_CSRFMiddlewa
Database должен быть метод/свойство query\"\n_cl_nodes_HeavyDatabase_query = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"HeavyDatabase\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"query\"]\nassert _cl_nodes_HeavyDatabase_query and not (len(_cl_nodes_HeavyDatabase_query[0].body) == 1 and isinstance(_cl_nodes_HeavyDatabase_query[0].body[0], _ast.Pass)), \"Реализуйте метод HeavyDatabase.query()\"\nassert \"LazyDatabaseProxy\" in globals() and isinstance(LazyDatabaseProxy, type), \"Класс LazyDatabaseProxy должен быть определён\"\n_cl_def_LazyDatabaseProxy = [n for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LazyDatabaseProxy\"]\nassert _cl_def_LazyDatabaseProxy and not (len(_cl_def_LazyDatabaseProxy[0].body) == 1 and isinstance(_cl_def_LazyDatabaseProxy[0].body[0], _ast.Pass)), \"Реализуйте тело класса LazyDatabaseProxy (сейчас там только pass)\"\nassert hasattr(LazyDatabaseProxy, \"__init__\"), \"В классе LazyDatabaseProxy должен быть метод/свойство __init__\"\n_cl_nodes_LazyDatabaseProxy___init__ = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LazyDatabaseProxy\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"__init__\"]\nassert _cl_nodes_LazyDatabaseProxy___init__ and not (len(_cl_nodes_LazyDatabaseProxy___init__[0].body) == 1 and isinstance(_cl_nodes_LazyDatabaseProxy___init__[0].body[0], _ast.Pass)), \"Реализуйте метод LazyDatabaseProxy.__init__()\"\nassert hasattr(LazyDatabaseProxy, \"query\"), \"В классе LazyDatabaseProxy должен быть метод/свойство query\"\n_cl_nodes_LazyDatabaseProxy_query = [m for n in _ast.walk(_ast.parse(__USER_CODE__)) if isinstance(n, _ast.ClassDef) and n.name == \"LazyDatabaseProxy\" for m in n.body if isinstance(m, (_ast.FunctionDef, _ast.AsyncFunctionDef)) and m.name == \"query\"]\nassert _cl_nodes
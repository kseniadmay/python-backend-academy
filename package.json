{
  "name": "python-backend-academy-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Python Backend Academy web app and cross-device progress sync API",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node scripts/server.js",
    "test": "node scripts/test_pwa_offline.js",

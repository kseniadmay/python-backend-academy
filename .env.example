# PostgreSQL connection string (optional; keep your actual value private).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Choose a private access code and enter the same value on PC and phone.
SYNC_TOKEN=replace-with-a-long-random-access-code

# Local server bind settings (defaults are 127.0.0.1:8080; PBA_PORT is also supported).
HOST=127.0.0.1
PORT=8080

# Local dev-only exec() runner for Zen IDE tasks; set false in any public deployment.
ALLOW_CODE_RUNNER=true

# Site-wide lock & personal profile (keep SITE_LOCK_ENABLED=false for local dev).
SITE_LOCK_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-strong-password
SESSION_SECRET=change-me-to-long-random-secret
SESSION_TTL_DAYS=30
PRIVATE_PROFILE_PATH=data/private/personal_profile.json

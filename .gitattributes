# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.env.example text eol=lf

# Windows command and batch files
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.mp4 binary
*.webm binary
*.pdf binary
